<div class="container-fluid p-0">

  <!-- PAGE HEADER -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 pb-3 border-bottom gap-3">
    <div>
      <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
        <h3 class="fw-bold text-dark mb-0">Program Feedbacks</h3>
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 fw-semibold"><%= @training_program.title %></span>
      </div>
      <p class="text-muted small mb-0">Review feedback submissions, rating distributions, and user comments.</p>
    </div>
    <div class="header-actions d-flex flex-wrap align-items-center gap-2">
      <%= link_to institute_admin_training_program_training_program_feedbacks_path(@training_program, format: :pdf, rating: params[:rating], participant_type: params[:participant_type], search: params[:search], date_range: params[:date_range], start_date: params[:start_date], end_date: params[:end_date]), 
                  class: "btn btn-outline-danger d-inline-flex align-items-center gap-2 shadow-sm rounded-3 px-3 py-2 fw-medium", 
                  target: "_blank", 
                  title: "Export PDF Report" do %>
        <i class="bi bi-file-earmark-pdf-fill"></i>
        <span>Export PDF</span>
      <% end %>

      <%= link_to institute_admin_training_program_training_program_feedbacks_path(@training_program, format: :csv, rating: params[:rating], participant_type: params[:participant_type], search: params[:search], date_range: params[:date_range], start_date: params[:start_date], end_date: params[:end_date]), 
                  class: "btn btn-outline-success d-inline-flex align-items-center gap-2 shadow-sm rounded-3 px-3 py-2 fw-medium", 
                  title: "Export CSV Data" do %>
        <i class="bi bi-file-earmark-spreadsheet-fill"></i>
        <span>Export CSV</span>
      <% end %>

      <%= link_to institute_admin_training_programs_path(view: 'feedbacks'), class: "btn btn-outline-secondary d-inline-flex align-items-center gap-2 shadow-sm rounded-3 px-3 py-2 fw-medium" do %>
        <i class="bi bi-arrow-left"></i>
        <span>Back to Programs</span>
      <% end %>
    </div>
  </div>

  <!-- KPI SUMMARY ROW -->
  <div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="inst-kpi-card">
        <div>
          <div class="text-uppercase text-muted fw-semibold mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">Total Feedbacks</div>
          <div class="h4 fw-bold mb-0 text-dark"><%= @total_feedbacks_count %></div>
        </div>
        <div class="inst-kpi-icon inst-kpi-icon-primary">
          <i class="bi bi-chat-square-text"></i>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="inst-kpi-card">
        <div>
          <div class="text-uppercase text-muted fw-semibold mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">Average Rating</div>
          <div class="h4 fw-bold mb-0 text-warning d-flex align-items-center gap-1">
            <span><%= @avg_rating %></span>
            <i class="bi bi-star-fill fs-6"></i>
          </div>
        </div>
        <div class="inst-kpi-icon inst-kpi-icon-warning">
          <i class="bi bi-star"></i>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="inst-kpi-card">
        <div>
          <div class="text-uppercase text-muted fw-semibold mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">5-Star Reviews</div>
          <div class="h4 fw-bold mb-0 text-success"><%= @five_star_count %></div>
        </div>
        <div class="inst-kpi-icon inst-kpi-icon-success">
          <i class="bi bi-hand-thumbs-up"></i>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="inst-kpi-card">
        <div>
          <div class="text-uppercase text-muted fw-semibold mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">User Categories</div>
          <div class="h4 fw-bold mb-0 text-info"><%= @participant_types_count %></div>
        </div>
        <div class="inst-kpi-icon inst-kpi-icon-info">
          <i class="bi bi-people"></i>
        </div>
      </div>
    </div>
  </div>

  <!-- RATING OVERVIEW & HORIZONTAL DISTRIBUTION CARD -->
  <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden rating-analytics-card">
    <div class="card-body p-4">
      <div class="row g-4 align-items-center">
        <!-- Left: Overall Rating Hero -->
        <div class="col-12 col-lg-4 text-center border-lg-end pe-lg-4">
          <div class="rating-hero-wrapper py-2">
            <div class="text-uppercase text-muted fw-semibold mb-2" style="font-size: 0.75rem; letter-spacing: 0.5px;">Overall Rating</div>
            <div class="display-3 fw-bold text-dark mb-1 rating-hero-score"><%= @program_avg_rating %></div>
            <div class="d-flex justify-content-center align-items-center gap-1 text-warning fs-4 mb-2">
              <% @program_avg_rating.floor.times do %>
                <i class="bi bi-star-fill"></i>
              <% end %>
              <% if @program_avg_rating - @program_avg_rating.floor >= 0.5 %>
                <i class="bi bi-star-half"></i>
                <% (4 - @program_avg_rating.floor).times do %>
                  <i class="bi bi-star text-light-emphasis"></i>
                <% end %>
              <% else %>
                <% (5 - @program_avg_rating.floor).times do %>
                  <i class="bi bi-star text-light-emphasis"></i>
                <% end %>
              <% end %>
            </div>
            <div class="text-muted small fw-medium mb-3">
              Based on <strong class="text-dark"><%= @program_total_feedbacks %></strong> <%= "review".pluralize(@program_total_feedbacks) %>
            </div>
            <% if @positive_rating_pct > 0 %>
              <div class="d-inline-flex align-items-center gap-1.5 px-3 py-1.5 bg-success bg-opacity-10 text-success rounded-pill small fw-semibold">
                <i class="bi bi-patch-check-fill"></i>
                <span><%= @positive_rating_pct %>% Positive Reviews (4-5 ★)</span>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Right: Horizontal Breakdown Bars (5 to 1 Stars) -->
        <div class="col-12 col-lg-8 ps-lg-4">
          <div class="d-flex align-items-center justify-content-between mb-3">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-bar-chart-line-fill text-primary fs-5"></i>
              <h6 class="fw-bold text-dark mb-0">Feedback Rating Distribution</h6>
            </div>
            <% if params[:rating].present? %>
              <%= link_to institute_admin_training_program_training_program_feedbacks_path(@training_program, participant_type: params[:participant_type], search: params[:search], date_range: params[:date_range], start_date: params[:start_date], end_date: params[:end_date]), 
                  class: "badge bg-primary bg-opacity-10 text-primary border border-primary-subtle text-decoration-none d-inline-flex align-items-center gap-1 py-1 px-2.5 rounded-pill",
                  title: "Clear rating filter" do %>
                <span>Active: <%= params[:rating] %> ★</span>
                <i class="bi bi-x-circle-fill"></i>
              <% end %>
            <% else %>
              <span class="text-muted small">Click any star tier to filter</span>
            <% end %>
          </div>

          <div class="rating-breakdown-list d-flex flex-column gap-2.5">
            <% @rating_distribution.each do |item| %>
              <% 
                is_selected = params[:rating].to_s == item[:stars].to_s
                bar_color_class = case item[:stars]
                                  when 5 then "rating-bar-5"
                                  when 4 then "rating-bar-4"
                                  when 3 then "rating-bar-3"
                                  when 2 then "rating-bar-2"
                                  when 1 then "rating-bar-1"
                                  end
              %>
              <div class="rating-breakdown-row <%= 'rating-row-active' if is_selected %> d-flex align-items-center gap-3 p-2 rounded-3"
                   onclick="filterByRating(<%= item[:stars] %>)"
                   role="button"
                   tabindex="0"
                   title="Click to filter by <%= item[:stars] %> star ratings">
                
                <!-- Star Label -->
                <div class="rating-star-label d-flex align-items-center gap-1 fw-bold text-secondary flex-shrink-0" style="width: 75px; font-size: 0.875rem;">
                  <span><%= item[:stars] %></span>
                  <i class="bi bi-star-fill text-warning" style="font-size: 0.85rem;"></i>
                  <span class="text-muted fw-normal" style="font-size: 0.75rem;"><%= item[:stars] == 1 ? 'star' : 'stars' %></span>
                </div>

                <!-- Horizontal Progress Bar -->
                <div class="progress flex-grow-1 rating-progress-track" style="height: 12px; background-color: #f1f5f9; border-radius: 999px; overflow: hidden; box-shadow: inset 0 1px 2px rgba(0,0,0,0.05);">
                  <div class="progress-bar <%= bar_color_class %>" 
                       role="progressbar" 
                       style="width: <%= item[:percentage] %>%; border-radius: 999px; transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);" 
                       aria-valuenow="<%= item[:percentage] %>" 
                       aria-valuemin="0" 
                       aria-valuemax="100">
                  </div>
                </div>

                <!-- Count and Percentage -->
                <div class="rating-count-label text-end text-nowrap flex-shrink-0" style="width: 100px;">
                  <span class="fw-bold text-dark small"><%= item[:count] %></span>
                  <span class="text-muted small ms-1" style="font-size: 0.75rem;">(<%= item[:percentage] %>%)</span>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- FILLED MULTI-CRITERIA FILTER TOOLBAR -->
  <div class="filled-toolbar mb-4">
    <%= form_with url: institute_admin_training_program_training_program_feedbacks_path(@training_program), method: :get, local: true, id: "feedbackFilterForm" do |f| %>
      <div class="row g-3 align-items-center">
        <!-- Search Input -->
        <div class="col-12 col-md-4 col-lg-3">
          <div class="input-group">
            <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-search"></i></span>
            <input type="text" name="search" id="feedbackSearchInput" class="form-control border-start-0 ps-0" placeholder="Search name or comment..." value="<%= params[:search] %>">
          </div>
        </div>

        <!-- User Type Filter -->
        <div class="col-12 col-sm-6 col-md-3 col-lg-2">
          <div class="input-group">
            <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-person-badge"></i></span>
            <select name="participant_type" id="userTypeFilter" class="form-select border-start-0 ps-0" onchange="this.form.submit()">
              <option value="" <%= 'selected' if params[:participant_type].blank? %>>All User Types</option>
              <option value="student" <%= 'selected' if params[:participant_type] == 'student' %>>Student</option>
              <option value="guardian" <%= 'selected' if params[:participant_type] == 'guardian' %>>Guardian</option>
              <option value="employee" <%= 'selected' if params[:participant_type] == 'employee' %>>Employee</option>
            </select>
          </div>
        </div>

        <!-- Rating Filter -->
        <div class="col-12 col-sm-6 col-md-3 col-lg-2">
          <div class="input-group">
            <span class="input-group-text bg-white text-warning border-end-0"><i class="bi bi-star-fill"></i></span>
            <select name="rating" id="ratingFilter" class="form-select border-start-0 ps-0" onchange="this.form.submit()">
              <option value="" <%= 'selected' if params[:rating].blank? %>>All Ratings</option>
              <option value="5" <%= 'selected' if params[:rating] == '5' %>>5 Stars ★★★★★</option>
              <option value="4" <%= 'selected' if params[:rating] == '4' %>>4 Stars ★★★★☆</option>
              <option value="3" <%= 'selected' if params[:rating] == '3' %>>3 Stars ★★★☆☆</option>
              <option value="2" <%= 'selected' if params[:rating] == '2' %>>2 Stars ★★☆☆☆</option>
              <option value="1" <%= 'selected' if params[:rating] == '1' %>>1 Star ★☆☆☆☆</option>
            </select>
          </div>
        </div>

        <!-- Submitted Date Filter -->
        <div class="col-12 col-sm-6 col-md-3 col-lg-3">
          <div class="input-group">
            <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-calendar-event"></i></span>
            <select name="date_range" id="dateRangeFilter" class="form-select border-start-0 ps-0" onchange="toggleCustomDateInputs(this)">
              <option value="all" <%= 'selected' if params[:date_range].blank? || params[:date_range] == 'all' %>>All Submitted Dates</option>
              <option value="today" <%= 'selected' if params[:date_range] == 'today' %>>Today</option>
              <option value="yesterday" <%= 'selected' if params[:date_range] == 'yesterday' %>>Yesterday</option>
              <option value="last_7_days" <%= 'selected' if params[:date_range] == 'last_7_days' %>>Last 7 Days</option>
              <option value="this_month" <%= 'selected' if params[:date_range] == 'this_month' %>>This Month</option>
              <option value="custom" <%= 'selected' if params[:date_range] == 'custom' %>>Custom Date Range</option>
            </select>
          </div>
        </div>

        <!-- Submit & Reset Action Buttons -->
        <div class="col-12 col-md-2 col-lg-2 d-flex gap-2">
          <button type="submit" class="btn btn-primary flex-grow-1 d-inline-flex align-items-center justify-content-center gap-1 shadow-sm">
            <i class="bi bi-funnel-fill"></i>
            <span>Filter</span>
          </button>
          <%= link_to institute_admin_training_program_training_program_feedbacks_path(@training_program), class: "btn btn-outline-secondary d-inline-flex align-items-center justify-content-center px-2.5", title: "Reset All Filters" do %>
            <i class="bi bi-arrow-counterclockwise"></i>
          <% end %>
        </div>
      </div>

      <!-- CUSTOM DATE RANGE INPUTS (Collapsible row when Custom is selected) -->
      <div id="customDateRow" class="row g-3 mt-1 align-items-center <%= 'd-none' unless params[:date_range] == 'custom' %>">
        <div class="col-12 col-sm-6 col-md-4 col-lg-3 offset-lg-7">
          <div class="input-group input-group-sm">
            <span class="input-group-text bg-white text-muted">From</span>
            <input type="date" name="start_date" id="startDateInput" class="form-control" value="<%= params[:start_date] %>">
          </div>
        </div>
        <div class="col-12 col-sm-6 col-md-4 col-lg-2">
          <div class="input-group input-group-sm">
            <span class="input-group-text bg-white text-muted">To</span>
            <input type="date" name="end_date" id="endDateInput" class="form-control" value="<%= params[:end_date] %>">
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <script>
    function toggleCustomDateInputs(selectElem) {
      const customRow = document.getElementById('customDateRow');
      if (selectElem.value === 'custom') {
        customRow.classList.remove('d-none');
      } else {
        customRow.classList.add('d-none');
        selectElem.form.submit();
      }
    }
  </script>

  <!-- MAIN DATA CARD (GOOGLE PLAY STORE REVIEW STYLE) -->
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <!-- Header Info Bar -->
    <div class="card-header bg-white border-bottom py-3 px-4 d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-3">
      <div class="d-flex align-items-center gap-2.5">
        <div class="d-flex align-items-center justify-content-center rounded-3 bg-primary-subtle text-primary" style="width: 38px; height: 38px;">
          <i class="bi bi-chat-left-heart-fill fs-5"></i>
        </div>
        <div>
          <div class="d-flex align-items-center gap-2">
            <h6 class="fw-bold mb-0 text-dark" style="font-size: 1.05rem;">Feedback Reviews</h6>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-0.5 fw-semibold" style="font-size: 0.75rem;">
              <%= @total_feedbacks_count %> Reviews
            </span>
          </div>
          <p class="text-muted small mb-0" style="font-size: 0.75rem;">Participant comments and star ratings in Google Play Store review style</p>
        </div>
      </div>
      
      <div class="d-flex align-items-center gap-3 flex-wrap">
        <!-- View Switcher (Feed / Table) -->
        <div class="btn-group btn-group-sm p-1 bg-light rounded-pill border" role="group" aria-label="View Switcher">
          <button type="button" class="btn btn-sm rounded-pill fw-medium px-3 active-view-btn" id="btnViewFeed" onclick="switchFeedbackView('feed')" title="Google Play Review Feed View">
            <i class="bi bi-view-list me-1"></i> Reviews Feed
          </button>
          <button type="button" class="btn btn-sm rounded-pill fw-medium px-3 text-muted" id="btnViewTable" onclick="switchFeedbackView('table')" title="Tabular View">
            <i class="bi bi-table me-1"></i> Table
          </button>
        </div>

        <span class="badge bg-light text-secondary border px-2.5 py-1.5 rounded-3 fw-medium" id="visibleFeedbackCount">
          Showing <%= @feedbacks.count %> of <%= @total_feedbacks_count %>
        </span>
      </div>
    </div>

    <!-- 1. GOOGLE PLAY STORE REVIEW FEED VIEW (DEFAULT) -->
    <div id="playReviewFeed" class="play-reviews-list">
      <% if @feedbacks.empty? %>
        <div class="text-center py-5" id="playEmptyState">
          <div class="text-muted mb-2"><i class="bi bi-chat-square-quote fs-1"></i></div>
          <h6 class="fw-bold text-dark mb-1">No Feedback Records Found</h6>
          <p class="text-muted small mb-0">No feedbacks match the current filters or none have been submitted yet.</p>
        </div>
      <% else %>
        <div class="text-center py-5 d-none" id="playEmptyFilteredState">
          <div class="text-muted mb-2"><i class="bi bi-search fs-1"></i></div>
          <h6 class="fw-bold text-dark mb-1">No Matching Reviews</h6>
          <p class="text-muted small mb-0">No reviews found matching your filter criteria.</p>
        </div>

        <% @feedbacks.each_with_index do |feedback, idx| %>
          <% 
            participant = feedback.participant
            user = participant&.user
            user_type = participant&.participant_type.presence || 'student'
            avatar_initial = user&.first_name.to_s.first.upcase.presence || "P"
            
            avatar_style = case user_type.downcase
                           when 'student' then 'background: #e0f2fe; color: #0284c7; border: 1.5px solid #bae6fd;'
                           when 'guardian' then 'background: #fef3c7; color: #d97706; border: 1.5px solid #fde68a;'
                           when 'employee' then 'background: #d1fae5; color: #059669; border: 1.5px solid #a7f3d0;'
                           else 'background: #f1f5f9; color: #475569; border: 1.5px solid #e2e8f0;'
                           end
          %>
          <div class="play-review-item"
               data-name="<%= user&.full_name.to_s.downcase %>"
               data-content="<%= feedback.content.to_s.downcase %>"
               data-user-type="<%= user_type.downcase %>"
               data-rating="<%= feedback.rating %>">
            
            <div class="d-flex align-items-start gap-3">
              <!-- Google Play Avatar Circle -->
              <div class="play-avatar" style="<%= avatar_style %>">
                <%= avatar_initial %>
              </div>

              <!-- Main Review Content Block -->
              <div class="flex-grow-1 min-w-0">
                <!-- User Details + Rating Header Row -->
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-1 mb-1.5">
                  <div class="d-flex align-items-center gap-2 flex-wrap">
                    <%= link_to institute_admin_participant_path(participant), class: "play-user-name text-decoration-none hover-primary" do %>
                      <%= user&.full_name.presence || "Unknown User" %>
                    <% end %>

                    <% case user_type.downcase %>
                    <% when 'student' %>
                      <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-0.5 play-user-badge">
                        <i class="bi bi-mortarboard-fill me-1"></i>Student
                      </span>
                    <% when 'guardian' %>
                      <span class="badge bg-warning-subtle text-dark border border-warning-subtle rounded-pill px-2.5 py-0.5 play-user-badge">
                        <i class="bi bi-person-heart me-1"></i>Guardian
                      </span>
                    <% when 'employee' %>
                      <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill px-2.5 py-0.5 play-user-badge">
                        <i class="bi bi-briefcase-fill me-1"></i>Employee
                      </span>
                    <% else %>
                      <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2.5 py-0.5 play-user-badge">
                        <i class="bi bi-person-fill me-1"></i><%= user_type.titleize %>
                      </span>
                    <% end %>

                    <% if user&.email.present? %>
                      <span class="text-muted d-none d-md-inline" style="font-size: 0.78rem;">• <%= user.email %></span>
                    <% elsif participant&.phone_number.present? %>
                      <span class="text-muted d-none d-md-inline" style="font-size: 0.78rem;">• <%= participant.phone_number %></span>
                    <% end %>
                  </div>

                  <!-- Stars + Date in Google Play Style -->
                  <div class="d-flex align-items-center gap-2 flex-shrink-0">
                    <div class="play-stars" title="<%= feedback.rating %> out of 5 stars">
                      <% feedback.rating.times do %>
                        <i class="bi bi-star-fill"></i>
                      <% end %>
                      <% (5 - feedback.rating).times do %>
                        <i class="bi bi-star text-light-emphasis"></i>
                      <% end %>
                    </div>
                    <span class="play-date">• <%= feedback.created_at.strftime("%b %d, %Y at %I:%M %p") %></span>
                  </div>
                </div>

                <!-- HIGHLIGHTED FEEDBACK COMMENT CARD -->
                <div class="play-comment-card mt-2">
                  <div class="d-flex align-items-start gap-2">
                    <i class="bi bi-chat-left-quote-fill text-primary opacity-75 flex-shrink-0 mt-1" style="font-size: 0.82rem;"></i>
                    <div class="play-comment-text flex-grow-1">
                      <% if feedback.content.present? %>
                        <%= feedback.content %>
                      <% else %>
                        <span class="text-muted fst-italic small">No written comment provided.</span>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>

    <!-- 2. TABULAR VIEW (Accessible via view toggle, with Comment as a clean full-width row) -->
    <div id="feedbacksTableView" class="table-responsive d-none">
      <table class="table align-middle mb-0" id="feedbacksTable">
        <thead class="table-light">
          <tr>
            <th style="width: 50px;" class="text-center">#</th>
            <th style="min-width: 220px;">Participant</th>
            <th style="min-width: 140px;">User Type</th>
            <th style="min-width: 140px;">Rating</th>
            <th style="min-width: 160px;">Submitted On</th>
          </tr>
        </thead>
        <% if @feedbacks.empty? %>
          <tbody>
            <tr id="emptyTableStateRow">
              <td colspan="5" class="text-center py-5">
                <div class="text-muted mb-2"><i class="bi bi-chat-square-quote fs-1"></i></div>
                <h6 class="fw-bold text-dark mb-1">No Feedback Records Found</h6>
                <p class="text-muted small mb-0">No feedbacks match the current filters or none have been submitted yet.</p>
              </td>
            </tr>
          </tbody>
        <% else %>
          <% @feedbacks.each_with_index do |feedback, idx| %>
            <% 
              participant = feedback.participant
              user = participant&.user
              user_type = participant&.participant_type.presence || 'student'
            %>
            <tbody class="feedback-table-group"
                   data-name="<%= user&.full_name.to_s.downcase %>"
                   data-content="<%= feedback.content.to_s.downcase %>"
                   data-user-type="<%= user_type.downcase %>"
                   data-rating="<%= feedback.rating %>">
              <tr class="feedback-meta-row border-bottom-0">
                <td class="text-center fw-semibold text-secondary" style="font-size: 0.85rem;"><%= idx + 1 %></td>
                <td>
                  <div class="d-flex align-items-center gap-2.5">
                    <div class="institute-avatar bg-light text-primary border fw-bold">
                      <%= user&.first_name.to_s.first.upcase.presence || "P" %>
                    </div>
                    <div>
                      <%= link_to institute_admin_participant_path(participant), class: "fw-semibold text-dark text-decoration-none hover-primary d-block" do %>
                        <%= user&.full_name.presence || "Unknown User" %>
                      <% end %>
                      <% if user&.email.present? %>
                        <div class="text-muted small" style="font-size: 0.75rem;"><%= user.email %></div>
                      <% elsif participant&.phone_number.present? %>
                        <div class="text-muted small" style="font-size: 0.75rem;"><%= participant.phone_number %></div>
                      <% end %>
                    </div>
                  </div>
                </td>
                <td>
                  <% case user_type.downcase %>
                  <% when 'student' %>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 fw-medium">
                      <i class="bi bi-mortarboard-fill me-1"></i> Student
                    </span>
                  <% when 'guardian' %>
                    <span class="badge bg-warning-subtle text-dark border border-warning-subtle rounded-pill px-3 py-1 fw-medium">
                      <i class="bi bi-person-heart me-1"></i> Guardian
                    </span>
                  <% when 'employee' %>
                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill px-3 py-1 fw-medium">
                      <i class="bi bi-briefcase-fill me-1"></i> Employee
                    </span>
                  <% else %>
                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-1 fw-medium">
                      <i class="bi bi-person-fill me-1"></i> <%= user_type.titleize %>
                    </span>
                  <% end %>
                </td>
                <td>
                  <div class="d-flex align-items-center gap-2">
                    <div class="d-inline-flex gap-1 text-warning" style="font-size: 0.9rem;">
                      <% feedback.rating.times do %>
                        <i class="bi bi-star-fill"></i>
                      <% end %>
                      <% (5 - feedback.rating).times do %>
                        <i class="bi bi-star text-light-emphasis"></i>
                      <% end %>
                    </div>
                    <span class="fw-bold small text-secondary"><%= feedback.rating %>.0</span>
                  </div>
                </td>
                <td class="text-muted small">
                  <div class="d-flex align-items-center gap-1 text-dark fw-medium">
                    <i class="bi bi-calendar-event text-secondary"></i>
                    <span><%= feedback.created_at.strftime("%b %d, %Y") %></span>
                  </div>
                  <span class="d-block text-muted ms-3" style="font-size: 0.725rem;"><%= feedback.created_at.strftime("%I:%M %p") %></span>
                </td>
              </tr>
              <!-- COMMENT AS FULL-WIDTH ROW -->
              <tr class="feedback-comment-row">
                <td class="border-top-0 pt-0 pb-3 text-center">
                  <i class="bi bi-chat-quote-fill text-primary opacity-40 fs-5"></i>
                </td>
                <td colspan="4" class="border-top-0 pt-0 pb-3 pe-4">
                  <div class="feedback-table-card">
                    <div class="d-flex align-items-start gap-2">
                      <i class="bi bi-chat-left-quote-fill text-primary opacity-75 flex-shrink-0 mt-1" style="font-size: 0.82rem;"></i>
                      <div class="feedback-full-text flex-grow-1">
                        <%= feedback.content.presence || content_tag(:span, "No written comment provided.", class: "text-muted fst-italic small") %>
                      </div>
                    </div>
                  </div>
                </td>
              </tr>
            </tbody>
          <% end %>
        <% end %>
      </table>
    </div>
  </div>
</div>

<!-- LIVE CLIENT-SIDE FILTERING & VIEW SWITCHER SCRIPT -->
<script>
  function switchFeedbackView(mode) {
    const feed = document.getElementById('playReviewFeed');
    const table = document.getElementById('feedbacksTableView');
    const btnFeed = document.getElementById('btnViewFeed');
    const btnTable = document.getElementById('btnViewTable');

    if (!feed || !table || !btnFeed || !btnTable) return;

    if (mode === 'table') {
      feed.classList.add('d-none');
      table.classList.remove('d-none');
      btnTable.classList.add('active-view-btn');
      btnTable.classList.remove('text-muted');
      btnFeed.classList.remove('active-view-btn');
      btnFeed.classList.add('text-muted');
      try { localStorage.setItem('soul_feedback_view', 'table'); } catch(e) {}
    } else {
      table.classList.add('d-none');
      feed.classList.remove('d-none');
      btnFeed.classList.add('active-view-btn');
      btnFeed.classList.remove('text-muted');
      btnTable.classList.remove('active-view-btn');
      btnTable.classList.add('text-muted');
      try { localStorage.setItem('soul_feedback_view', 'feed'); } catch(e) {}
    }
  }

  function filterFeedbacksTable() {
    const searchVal = document.getElementById('feedbackSearchInput').value.toLowerCase().trim();
    const typeVal = document.getElementById('userTypeFilter').value.toLowerCase();
    const ratingVal = document.getElementById('ratingFilter').value;

    // Filter Play Store Feed Items
    const playItems = document.querySelectorAll('#playReviewFeed .play-review-item');
    let visibleCount = 0;

    playItems.forEach(item => {
      const name = item.getAttribute('data-name') || '';
      const content = item.getAttribute('data-content') || '';
      const userType = item.getAttribute('data-user-type') || '';
      const rating = item.getAttribute('data-rating') || '';

      const matchesSearch = !searchVal || name.includes(searchVal) || content.includes(searchVal);
      const matchesType = (typeVal === 'all' || typeVal === '') || (userType === typeVal);
      const matchesRating = (ratingVal === 'all' || ratingVal === '') || (rating === ratingVal);

      if (matchesSearch && matchesType && matchesRating) {
        item.style.display = '';
        visibleCount++;
      } else {
        item.style.display = 'none';
      }
    });

    // Also filter Table Groups in sync
    const tableGroups = document.querySelectorAll('#feedbacksTableView tbody.feedback-table-group');
    tableGroups.forEach(group => {
      const name = group.getAttribute('data-name') || '';
      const content = group.getAttribute('data-content') || '';
      const userType = group.getAttribute('data-user-type') || '';
      const rating = group.getAttribute('data-rating') || '';

      const matchesSearch = !searchVal || name.includes(searchVal) || content.includes(searchVal);
      const matchesType = (typeVal === 'all' || typeVal === '') || (userType === typeVal);
      const matchesRating = (ratingVal === 'all' || ratingVal === '') || (rating === ratingVal);

      group.style.display = (matchesSearch && matchesType && matchesRating) ? '' : 'none';
    });

    // Empty states
    const playEmpty = document.getElementById('playEmptyFilteredState');
    if (playEmpty) {
      playEmpty.classList.toggle('d-none', visibleCount > 0 || playItems.length === 0);
    }
    const emptyTableState = document.getElementById('emptyTableStateRow');
    if (emptyTableState) {
      emptyTableState.style.display = (visibleCount === 0 && playItems.length > 0) ? '' : 'none';
    }

    const countBadge = document.getElementById('visibleFeedbackCount');
    if (countBadge) {
      countBadge.textContent = `Showing ${visibleCount} of <%= @total_feedbacks_count %>`;
    }
  }

  function resetFeedbackFilters() {
    document.getElementById('feedbackSearchInput').value = '';
    document.getElementById('userTypeFilter').value = '';
    document.getElementById('ratingFilter').value = '';
    filterFeedbacksTable();
  }

  function filterByRating(stars) {
    const ratingSelect = document.getElementById('ratingFilter');
    if (ratingSelect) {
      if (ratingSelect.value == stars) {
        ratingSelect.value = '';
      } else {
        ratingSelect.value = stars;
      }
      ratingSelect.form.submit();
    }
  }

  // Restore preferred view from localStorage if saved
  document.addEventListener('DOMContentLoaded', function() {
    try {
      const saved = localStorage.getItem('soul_feedback_view');
      if (saved === 'table') {
        switchFeedbackView('table');
      }
    } catch(e) {}
  });
</script>

