  function saveQuestionEdits(catId, qId, categoryDuration) {
    const titleInput = document.getElementById(`modal_q_title_${catId}_${qId}`);
    const dispInput = document.getElementById(`modal_q_disp_name_${catId}_${qId}`);
    const fromInput = document.getElementById(`modal_q_from_${catId}_${qId}`);
    const toInput = document.getElementById(`modal_q_to_${catId}_${qId}`);
    const errorBox = document.getElementById(`q_modal_error_${catId}_${qId}`);

    if (!titleInput || !fromInput || !toInput) return;

    const titleVal = titleInput.value.trim();
    const dispVal = dispInput ? dispInput.value.trim() : '';
    const fromVal = parseInt(fromInput.value, 10);
    const toVal = parseInt(toInput.value, 10);

    if (!titleVal) {
      showBundleModalError(errorBox, "Question title is required.");
      return;
    }

    if (isNaN(fromVal) || fromVal < 1) {
      showBundleModalError(errorBox, "From Day must be at least 1.");
      return;
    }

    if (isNaN(toVal) || toVal < fromVal) {
      showBundleModalError(errorBox, `To Day (${toVal}) must be greater than or equal to From Day (${fromVal}).`);
      return;
    }

    if (categoryDuration && categoryDuration > 0) {
      if (fromVal > categoryDuration || toVal > categoryDuration) {
        showBundleModalError(errorBox, `Day range cannot exceed category duration of ${categoryDuration} days.`);
        return;
      }
    }

    hideBundleModalError(errorBox);

    const catCard = document.getElementById(`category_card_${catId}`);
    if (catCard && catCard.dataset.categoryDuration) {
      categoryDuration = parseInt(catCard.dataset.categoryDuration, 10);
    }

    // Update displays in Pool
    const poolTitle = document.getElementById(`q_title_display_${catId}_${qId}`);
    const poolDisp = document.getElementById(`q_disp_display_${catId}_${qId}`);
    const poolSched = document.getElementById(`q_schedule_display_${catId}_${qId}`);

    if (poolTitle) poolTitle.textContent = titleVal;
    if (poolDisp) poolDisp.textContent = dispVal;
    if (poolSched) poolSched.textContent = (fromVal === toVal) ? `Day ${fromVal}` : `Day ${fromVal} - ${toVal}`;

    // Update displays & schedule badges in Bundle Items
    const bundleTitles = document.querySelectorAll(`[id^="bundle_item_title_${catId}_${qId}"]`);
    bundleTitles.forEach(t => t.textContent = titleVal);

    document.querySelectorAll(`[id^="bundle_item_card_${catId}_"][id$="_${qId}"]`).forEach(itemCard => {
      const idParts = itemCard.id.split('_');
      if (idParts.length >= 6) {
        const bId = idParts[4];
        const bFromInput = document.getElementById(`bundle_input_from_${catId}_${bId}`);
        const bToInput = document.getElementById(`bundle_input_to_${catId}_${bId}`);

        let bFrom = 1;
        let bTo = categoryDuration || 30;
        if (bFromInput && bToInput) {
          bFrom = parseInt(bFromInput.value, 10) || 1;
          bTo = parseInt(bToInput.value, 10) || (categoryDuration || 30);
        }

        const effFrom = Math.max(fromVal, bFrom);
        const effTo = Math.min(toVal, bTo);

        let effSchedText = '';
        let daysInBundle = 0;

        if (effFrom <= effTo) {
          daysInBundle = effTo - effFrom + 1;
          if (effFrom === effTo) {
            effSchedText = `Day ${getOrdinal(effFrom)}`;
          } else {
            effSchedText = `Day ${getOrdinal(effFrom)} - ${getOrdinal(effTo)} Day`;
          }
        } else {
          effSchedText = (fromVal === toVal) ? `Day ${getOrdinal(fromVal)}` : `Day ${getOrdinal(fromVal)} - ${getOrdinal(toVal)} Day`;
          daysInBundle = 0;
        }

        const effSchedEl = itemCard.querySelector(`[id^="bundle_item_eff_sched_"]`);
        const daysEl = itemCard.querySelector(`[id^="bundle_item_days_"]`);

        if (effSchedEl) effSchedEl.textContent = effSchedText;
        if (daysEl) daysEl.textContent = `${daysInBundle} ${daysInBundle === 1 ? 'day' : 'days'} in bundle`;
      }
    });

    // Persist question overrides as hidden form inputs
    let qOverridesContainer = document.getElementById(`q_overrides_container_${catId}`);
    if (!qOverridesContainer) {
      const catCard = document.getElementById(`category_card_${catId}`);
      if (catCard) {
        qOverridesContainer = document.createElement('div');
        qOverridesContainer.id = `q_overrides_container_${catId}`;
        qOverridesContainer.style.display = 'none';
        catCard.appendChild(qOverridesContainer);
      }
    }

    if (qOverridesContainer) {
      let qBlock = document.getElementById(`q_override_${catId}_${qId}`);
      if (!qBlock) {
        qBlock = document.createElement('div');
        qBlock.id = `q_override_${catId}_${qId}`;
        qOverridesContainer.appendChild(qBlock);
      }
      qBlock.innerHTML = '';
      
      const inTitle = document.createElement('input');
      inTitle.type = 'hidden';
      inTitle.name = `assignments[${catId}][questions][${qId}][title]`;
      inTitle.value = titleVal;
      qBlock.appendChild(inTitle);

      const inDisp = document.createElement('input');
      inDisp.type = 'hidden';
      inDisp.name = `assignments[${catId}][questions][${qId}][display_name]`;
      inDisp.value = dispVal;
      qBlock.appendChild(inDisp);

      const inFrom = document.createElement('input');
      inFrom.type = 'hidden';
      inFrom.name = `assignments[${catId}][questions][${qId}][from_day]`;
      inFrom.value = fromVal;
      qBlock.appendChild(inFrom);

      const inTo = document.createElement('input');
      inTo.type = 'hidden';
      inTo.name = `assignments[${catId}][questions][${qId}][to_day]`;
      inTo.value = toVal;
      qBlock.appendChild(inTo);
    }

    // Hide Modal
    const modalEl = document.getElementById(`editQuestionModal_${catId}_${qId}`);
    if (modalEl) {
      const modalInstance = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
      modalInstance.hide();
    }
  }

  function handleQuestionBundleSelect(catId, qId, selectEl) {
    const bundleId = selectEl.value;
    if (!bundleId) return;

    const selectedOpt = selectEl.options[selectEl.selectedIndex];
    const baseName = selectedOpt.dataset.bundleBaseName || selectedOpt.textContent.replace(/\s*-\s*Assigned$/, '');
    const bundleName = baseName ? baseName.split(' (')[0] : 'Bundle';

    const bundleItemsContainer = document.getElementById(`bundle_items_${catId}_${bundleId}`);
    if (!bundleItemsContainer) return;

    // Check if item already exists in bundle
    const existingCard = document.getElementById(`bundle_item_card_${catId}_${bundleId}_${qId}`);
    if (existingCard) {
      selectEl.value = "";
      return;
    }

    const qTitleEl = document.getElementById(`q_title_display_${catId}_${qId}`);
    const qTitle = qTitleEl ? qTitleEl.textContent.trim() : 'Question Title';
    const qTypeEl = document.getElementById(`bundle_item_type_${catId}_${qId}`);
    const qType = qTypeEl ? qTypeEl.textContent.trim() : 'Short Answer';

    // Calculate Question Schedule Range [qFrom, qTo]
    let qFrom = 1, qTo = 30;
    const qFromInput = document.getElementById(`modal_q_from_${catId}_${qId}`);
    const qToInput = document.getElementById(`modal_q_to_${catId}_${qId}`);
    if (qFromInput && qToInput && qFromInput.value && qToInput.value) {
      qFrom = parseInt(qFromInput.value, 10);
      qTo = parseInt(qToInput.value, 10);
    } else {
      const qSchedEl = document.getElementById(`q_schedule_display_${catId}_${qId}`);
      if (qSchedEl) {
        const text = qSchedEl.textContent.trim();
        const numbers = text.match(/\d+/g);
        if (numbers && numbers.length >= 2) {
          qFrom = parseInt(numbers[0], 10);
          qTo = parseInt(numbers[1], 10);
        } else if (numbers && numbers.length === 1) {
          qFrom = parseInt(numbers[0], 10);
          qTo = parseInt(numbers[0], 10);
        }
      }
    }

    // Calculate Bundle Schedule Range [bFrom, bTo]
    let bFrom = 1, bTo = 30;
    const bFromInput = document.getElementById(`bundle_input_from_${catId}_${bundleId}`);
    const bToInput = document.getElementById(`bundle_input_to_${catId}_${bundleId}`);
    if (bFromInput && bToInput && bFromInput.value && bToInput.value) {
      bFrom = parseInt(bFromInput.value, 10);
      bTo = parseInt(bToInput.value, 10);
    } else {
      const bSchedEl = document.getElementById(`bundle_schedule_display_${catId}_${bundleId}`);
      if (bSchedEl) {
        const text = bSchedEl.textContent.trim();
        const numbers = text.match(/\d+/g);
        if (numbers && numbers.length >= 2) {
          bFrom = parseInt(numbers[0], 10);
          bTo = parseInt(numbers[1], 10);
        } else if (numbers && numbers.length === 1) {
          bFrom = parseInt(numbers[0], 10);
          bTo = parseInt(numbers[0], 10);
        }
      }
    }

    const effFrom = Math.max(qFrom, bFrom);
    const effTo = Math.min(qTo, bTo);

    let effSchedText = '';
    let daysInBundle = 0;

    if (effFrom <= effTo) {
      daysInBundle = effTo - effFrom + 1;
      if (effFrom === effTo) {
        effSchedText = `Day ${getOrdinal(effFrom)}`;
      } else {
        effSchedText = `Day ${getOrdinal(effFrom)} - ${getOrdinal(effTo)} Day`;
      }
    } else {
      effSchedText = (qFrom === qTo) ? `Day ${getOrdinal(qFrom)}` : `Day ${getOrdinal(qFrom)} - ${getOrdinal(qTo)} Day`;
      daysInBundle = 0;
    }

    const itemCount = bundleItemsContainer.querySelectorAll('.bundle-question-item').length + 1;

    const newCardHtml = `
      <div class="bundle-question-item bg-white p-3 rounded-3 border shadow-xs position-relative hover-shadow-sm transition-all mb-2" id="bundle_item_card_${catId}_${bundleId}_${qId}">
        <div class="d-flex align-items-start gap-2">
          <div class="d-flex align-items-center gap-2 flex-shrink-0 pt-0.5">
            <input type="hidden" name="assignments[${catId}][bundle_items][][question_id]" value="${qId}">
            <input type="hidden" name="assignments[${catId}][bundle_items][][bundle_name]" value="${bundleName}" class="bundle-item-name-input-${catId}-${bundleId}">
            <input type="hidden" name="assignments[${catId}][question_ids][]" value="${qId}" id="cat_q_${catId}_${qId}" class="cat-q-cb-${catId} bundle-q-cb-${catId}-${bundleId}">
            <i class="bi bi-list fs-5 text-secondary drag-handle me-1" title="Drag to reorder" style="cursor: grab;"></i>
            <span class="badge bg-dark text-white rounded-pill px-2.5 py-1.5 fw-bold bundle-item-serial me-1" style="font-size: 0.75rem;">#${itemCount}</span>
            <div class="btn-group btn-group-sm rounded-2 bg-light border p-0.5 me-2">
              <button type="button" class="btn btn-xs btn-link text-secondary p-0 px-1.5 border-0" title="Move Up" onclick="moveQuestionItemUp(this)">
                <i class="bi bi-chevron-up" style="font-size: 0.75rem;"></i>
              </button>
              <button type="button" class="btn btn-xs btn-link text-secondary p-0 px-1.5 border-0" title="Move Down" onclick="moveQuestionItemDown(this)">
                <i class="bi bi-chevron-down" style="font-size: 0.75rem;"></i>
              </button>
            </div>
          </div>
          <div class="flex-grow-1 min-w-0">
            <div class="d-flex align-items-start justify-content-between gap-2">
              <label for="cat_q_${catId}_${qId}" class="fw-bold text-dark mb-0 cursor-pointer text-break pe-1" style="font-size: 0.925rem; line-height: 1.35;" id="bundle_item_title_${catId}_${qId}">
                ${qTitle}
              </label>
              <button type="button" class="btn btn-sm btn-outline-danger rounded-circle p-0 d-flex align-items-center justify-content-center shadow-xs flex-shrink-0 ms-1" style="width: 24px; height: 24px; min-width: 24px;" title="Remove from bundle" onclick="removeQuestionFromBundle(${catId}, ${qId}, '${bundleId}')">
                <i class="bi bi-x-lg" style="font-size: 0.7rem;"></i>
              </button>
            </div>
            <div class="d-flex align-items-center flex-wrap gap-1.5 mt-2">
              <span class="badge bg-secondary-subtle text-dark border px-2 py-0.5" style="font-size: 0.68rem;" id="bundle_item_type_${catId}_${qId}">${qType}</span>
              <span class="badge bg-primary-subtle text-primary rounded-pill px-2 py-0.5 fw-semibold" style="font-size: 0.68rem;">
                <i class="bi bi-clock-history me-1 text-primary"></i><span id="bundle_item_eff_sched_${catId}_${qId}">${effSchedText}</span>
              </span>
              <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-0.5 fw-semibold" style="font-size: 0.68rem;">
                <i class="bi bi-calendar-check me-1 text-success"></i><span id="bundle_item_days_${catId}_${qId}">${daysInBundle} ${daysInBundle === 1 ? 'day' : 'days'} in bundle</span>
              </span>
            </div>
          </div>
        </div>
      </div>
    `;

    bundleItemsContainer.insertAdjacentHTML('beforeend', newCardHtml);

    // Add pill under pool question
    const badgesContainer = document.getElementById(`q_assigned_bundle_badges_${catId}_${qId}`);
    if (badgesContainer) {
      const pillHtml = `<span class="badge bg-primary-subtle text-primary rounded-pill px-2.5 py-1 text-truncate q-bundle-pill-${catId}-${qId}-${bundleId}" style="max-width: 140px;"><i class="bi bi-layers me-1"></i>${bundleName}</span>`;
      badgesContainer.insertAdjacentHTML('beforeend', pillHtml);
    }

    // Disable option in select dropdown & mark as Assigned
    selectedOpt.disabled = true;
    selectedOpt.textContent = `${baseName} - Assigned`;
    selectEl.value = "";

    // Update bundle serials and count pill
    updateBundleSerials(bundleItemsContainer);
    const countPill = document.getElementById(`bundle_q_count_pill_${catId}_${bundleId}`);
    if (countPill) {
      const cnt = bundleItemsContainer.querySelectorAll('.bundle-question-item').length;
      countPill.textContent = `${cnt} ${cnt === 1 ? 'question' : 'questions'}`;
    }
  }

  function removeQuestionFromBundle(catId, qId, bundleId) {
    const card = document.getElementById(`bundle_item_card_${catId}_${bundleId}_${qId}`);
    if (card) {
      const container = card.parentNode;
      card.remove();
      updateBundleSerials(container);

      const countPill = document.getElementById(`bundle_q_count_pill_${catId}_${bundleId}`);
      if (countPill && container) {
        const cnt = container.querySelectorAll('.bundle-question-item').length;
        countPill.textContent = `${cnt} ${cnt === 1 ? 'question' : 'questions'}`;
      }
    }

    // Remove pill under pool question
    const pill = document.querySelector(`.q-bundle-pill-${catId}-${qId}-${bundleId}`);
    if (pill) pill.remove();

    // Re-enable dropdown option and restore base text (removing " - Assigned")
    const opt = document.getElementById(`q_select_opt_${catId}_${qId}_${bundleId}`);
    if (opt) {
      opt.disabled = false;
      const baseName = opt.dataset.bundleBaseName || opt.textContent.replace(/\s*-\s*Assigned$/, '');
      opt.textContent = baseName;
    }
  }

  function autoAssignQuestionsToBundles(catId) {
    const bundleContainers = document.querySelectorAll(`.cat-bundle-hidden-inputs-${catId}`);
    if (bundleContainers.length === 0) {
      alert("No custom bundles found in this category. Please create a bundle first.");
      return;
    }

    if (!confirm("Are you sure you want to auto-assign matching questions to bundles based on schedule day ranges?")) {
      return;
    }

    let assignedCount = 0;
    const poolCards = document.querySelectorAll(`.pool-question-card-${catId}`);

    poolCards.forEach(card => {
      const qIdMatch = card.id.match(/pool_card_\d+_(\d+)/);
      if (!qIdMatch) return;
      const qId = qIdMatch[1];

      const qFromInput = document.getElementById(`modal_q_from_${catId}_${qId}`);
      const qToInput = document.getElementById(`modal_q_to_${catId}_${qId}`);

      const qFrom = qFromInput ? parseInt(qFromInput.value, 10) : 1;
      const qTo = qToInput ? parseInt(qToInput.value, 10) : 30;

      const selectEl = document.querySelector(`.q-bundle-assign-select-${catId}-${qId}`);
      if (!selectEl) return;

      bundleContainers.forEach(bContainer => {
        const bundleId = bContainer.dataset.bundleId;
        const bFromInput = document.getElementById(`bundle_input_from_${catId}_${bundleId}`);
        const bToInput = document.getElementById(`bundle_input_to_${catId}_${bundleId}`);

        if (bFromInput && bToInput) {
          const bFrom = parseInt(bFromInput.value, 10) || 1;
          const bTo = parseInt(bToInput.value, 10) || 30;

          const overlapFrom = Math.max(qFrom, bFrom);
          const overlapTo = Math.min(qTo, bTo);

          if (overlapFrom <= overlapTo) {
            const existingCard = document.getElementById(`bundle_item_card_${catId}_${bundleId}_${qId}`);
            if (!existingCard) {
              const opt = document.getElementById(`q_select_opt_${catId}_${qId}_${bundleId}`);
              if (opt && !opt.disabled) {
                selectEl.value = bundleId;
                handleQuestionBundleSelect(catId, qId, selectEl);
                assignedCount++;
              }
            }
          }
        }
      });
    });

    if (assignedCount > 0) {
      alert(`Auto-assigned matching questions to bundles based on schedule day ranges (${assignedCount} question-bundle assignments created).`);
    } else {
      alert("All questions are already assigned to their matching bundles, or no new schedule overlaps were found.");
    }
  }

  function prepareNewBundleModal(catId) {
    const catCard = document.getElementById(`category_card_${catId}`);
    let categoryDuration = 30;
    if (catCard && catCard.dataset.categoryDuration) {
      categoryDuration = parseInt(catCard.dataset.categoryDuration, 10) || 30;
    }

    let maxExistingTo = 0;
    document.querySelectorAll(`.cat-bundle-hidden-inputs-${catId}`).forEach(container => {
      const bId = container.dataset.bundleId;
      const otherToInput = document.getElementById(`bundle_input_to_${catId}_${bId}`);
      if (otherToInput) {
        const tVal = parseInt(otherToInput.value, 10) || 0;
        if (tVal > maxExistingTo) maxExistingTo = tVal;
      }
    });

    const nameInput = document.getElementById(`new_bundle_name_${catId}`);
    const fromInput = document.getElementById(`new_bundle_from_${catId}`);
    const toInput = document.getElementById(`new_bundle_to_${catId}`);
    const descInput = document.getElementById(`new_bundle_desc_${catId}`);
    const errorBox = document.getElementById(`new_bundle_error_${catId}`);

    if (errorBox) hideBundleModalError(errorBox);
    if (nameInput) nameInput.value = '';
    if (descInput) descInput.value = '';

    const nextFrom = Math.min(maxExistingTo + 1, categoryDuration);
    if (fromInput) fromInput.value = nextFrom > 0 ? nextFrom : 1;
    if (toInput) toInput.value = categoryDuration;
  }

  function addNewBundleCard(catId, categoryDuration) {
    const nameInput = document.getElementById(`new_bundle_name_${catId}`);
    const fromInput = document.getElementById(`new_bundle_from_${catId}`);
    const toInput = document.getElementById(`new_bundle_to_${catId}`);
    const descInput = document.getElementById(`new_bundle_desc_${catId}`);
    const errorBox = document.getElementById(`new_bundle_error_${catId}`);

    const catCard = document.getElementById(`category_card_${catId}`);
    if (catCard && catCard.dataset.categoryDuration) {
      categoryDuration = parseInt(catCard.dataset.categoryDuration, 10);
    }

    if (!nameInput || !fromInput || !toInput) return;

    const nameVal = nameInput.value.trim();
    const fromVal = parseInt(fromInput.value, 10);
    const toVal = parseInt(toInput.value, 10);
    const descVal = descInput ? descInput.value.trim() : '';

    if (!nameVal) {
      showBundleModalError(errorBox, "Bundle name is required.");
      return;
    }

    if (isNaN(fromVal) || fromVal < 1) {
      showBundleModalError(errorBox, "From Day must be at least 1.");
      return;
    }

    if (isNaN(toVal) || toVal < fromVal) {
      showBundleModalError(errorBox, `To Day (${toVal}) must be greater than or equal to From Day (${fromVal}).`);
      return;
    }

    if (categoryDuration && categoryDuration > 0) {
      if (fromVal > categoryDuration || toVal > categoryDuration) {
        showBundleModalError(errorBox, `Bundle day range cannot exceed category duration of ${categoryDuration} days.`);
        return;
      }
    }

    // Overlap check with existing bundles under category catId
    let overlapFound = false;
    let overlapBundleName = '';
    let overlapRangeText = '';

    document.querySelectorAll(`.cat-bundle-hidden-inputs-${catId}`).forEach(container => {
      const bId = container.dataset.bundleId;
      const otherFromInput = document.getElementById(`bundle_input_from_${catId}_${bId}`);
      const otherToInput = document.getElementById(`bundle_input_to_${catId}_${bId}`);
      const otherNameInput = document.getElementById(`bundle_input_name_${catId}_${bId}`);

      if (otherFromInput && otherToInput) {
        const otherF = parseInt(otherFromInput.value, 10) || 1;
        const otherT = parseInt(otherToInput.value, 10) || categoryDuration || 30;

        if (fromVal <= otherT && toVal >= otherF) {
          overlapFound = true;
          overlapBundleName = (otherNameInput && otherNameInput.value.trim()) ? otherNameInput.value.trim() : `Bundle #${bId}`;
          overlapRangeText = (otherF === otherT) ? `Day ${otherF}` : `Day ${otherF} - ${otherT}`;
        }
      }
    });

    if (overlapFound) {
      showBundleModalError(errorBox, `Bundle day range (Day ${fromVal} - ${toVal}) overlaps with existing bundle '${overlapBundleName}' (${overlapRangeText}). Please choose a non-overlapping day range.`);
      return;
    }

    hideBundleModalError(errorBox);

    const bundleId = 'new_' + Date.now();
    const scheduleText = (fromVal === toVal) ? `Day ${fromVal}` : `Day ${fromVal} - ${toVal}`;

    const bundlesContainer = document.getElementById(`cat_bundles_container_${catId}`);
    if (!bundlesContainer) return;

    const bundleCardHtml = `
      <div class="card border rounded-4 bg-white shadow-sm p-3 border-light-subtle position-relative bundle-card-${catId}" id="bundle_card_${catId}_${bundleId}">
        <div class="cat-bundle-hidden-inputs-${catId}" data-bundle-id="${bundleId}">
          <input type="hidden" name="assignments[${catId}][bundles][${bundleId}][name]" id="bundle_input_name_${catId}_${bundleId}" value="${nameVal}">
          <input type="hidden" name="assignments[${catId}][bundles][${bundleId}][from_day]" id="bundle_input_from_${catId}_${bundleId}" value="${fromVal}">
          <input type="hidden" name="assignments[${catId}][bundles][${bundleId}][to_day]" id="bundle_input_to_${catId}_${bundleId}" value="${toVal}">
          <input type="hidden" name="assignments[${catId}][bundles][${bundleId}][description]" id="bundle_input_desc_${catId}_${bundleId}" value="${descVal}">
        </div>
        <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom flex-wrap gap-2">
          <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="badge bg-primary text-white rounded-pill px-3 py-1.5 fw-semibold" style="font-size: 0.85rem;">
              <i class="bi bi-layers-fill me-1"></i><span id="bundle_name_display_${catId}_${bundleId}">${nameVal}</span>
            </span>
            <span class="badge bg-light text-dark border rounded-pill px-2.5 py-1" id="bundle_q_count_pill_${catId}_${bundleId}">
              0 questions
            </span>
            <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-2.5 py-1">
              <i class="bi bi-calendar-event me-1"></i><span id="bundle_schedule_display_${catId}_${bundleId}">${scheduleText}</span>
            </span>
          </div>
          <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-sm btn-outline-danger rounded-2 px-2 py-1" title="Delete Bundle" onclick="deleteBundleCard(${catId}, '${bundleId}')">
              <i class="bi bi-trash"></i>
            </button>
          </div>
        </div>
        <div class="card-body bg-light-subtle rounded-3 p-2.5 min-vh-10" style="min-height: 100px; border: 2px dashed #94a3b8 !important;">
          <div class="d-flex flex-column gap-2 bundle-items-container" id="bundle_items_${catId}_${bundleId}"></div>
        </div>
      </div>
    `;

    bundlesContainer.insertAdjacentHTML('beforeend', bundleCardHtml);

    // Add option to select dropdowns
    const selects = document.querySelectorAll(`[class*="q-bundle-assign-select-${catId}-"]`);
    selects.forEach(select => {
      const opt = document.createElement('option');
      opt.value = bundleId;
      opt.textContent = `${nameVal} (${scheduleText})`;
      opt.id = `q_select_opt_${catId}_${select.dataset.qId || 'x'}_${bundleId}`;
      select.appendChild(opt);
    });

    // Reset modal form inputs
    nameInput.value = '';
    fromInput.value = '1';
    toInput.value = categoryDuration || '30';
    if (descInput) descInput.value = '';

    // Hide Modal
    const modalEl = document.getElementById(`newBundleModal_${catId}`);
    if (modalEl) {
      const modalInstance = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
      modalInstance.hide();
    }

    initBundleSortables();
  }

  function deleteBundleCard(catId, bundleId) {
    if (!confirm("Are you sure you want to delete this custom bundle? Questions assigned to it will remain in the pool.")) return;

    const card = document.getElementById(`bundle_card_${catId}_${bundleId}`);
    if (card) card.remove();

    // Remove pills
    const pills = document.querySelectorAll(`[class*="q-bundle-pill-${catId}-"][class*="-${bundleId}"]`);
    pills.forEach(p => p.remove());

    // Remove options
    const opts = document.querySelectorAll(`[id*="q_select_opt_${catId}_"][id*="_${bundleId}"]`);
    opts.forEach(o => o.remove());
  }

  function setupGlobalCollapseIconListener() {
    const globalCollapseEl = document.getElementById('globalRecipientsCollapse');
    const globalCollapseIcon = document.getElementById('globalCollapseIcon');
    if (globalCollapseEl && globalCollapseIcon) {
      globalCollapseEl.addEventListener('show.bs.collapse', function () {
        globalCollapseIcon.className = 'bi bi-chevron-double-up fs-6';
      });
      globalCollapseEl.addEventListener('hide.bs.collapse', function () {
        globalCollapseIcon.className = 'bi bi-chevron-double-down fs-6';
      });
    }
  }

  function handleImportFinalizeSubmit(e) {
    const errorContainer = document.getElementById('import_setup_error_container');
    const errorMsg = document.getElementById('import_setup_error_message');
    
    if (errorContainer) errorContainer.classList.add('d-none');

    const catCards = document.querySelectorAll('.category-assignment-card');
    let hasError = false;
    let errorMessages = [];

    catCards.forEach(card => {
      const catId = card.id.replace('category_card_', '');
      const titleInput = document.getElementById('title_' + catId);
      const startDateInput = document.querySelector(`input[name="assignments[${catId}][start_date]"]`);
      const endDateInput = document.querySelector(`input[name="assignments[${catId}][end_date]"]`);

      if (titleInput && !titleInput.value.trim()) {
        hasError = true;
        errorMessages.push(`Assignment Title is required.`);
      }

      if (startDateInput && endDateInput) {
        const start = parseInputDate(startDateInput.value);
        const end = parseInputDate(endDateInput.value);
        if (!start || isNaN(start.getTime()) || !end || isNaN(end.getTime())) {
          hasError = true;
          errorMessages.push(`Please provide valid start and end dates.`);
        } else if (end < start) {
          hasError = true;
          errorMessages.push(`End date cannot be earlier than start date for "${titleInput ? titleInput.value : 'Assignment'}".`);
        }
      }

      // Validate that no bundles in this category have overlapping day ranges
      const bundleContainers = card.querySelectorAll(`.cat-bundle-hidden-inputs-${catId}`);
      const bundlesList = [];
      bundleContainers.forEach(container => {
        const bId = container.dataset.bundleId;
        const fInput = document.getElementById(`bundle_input_from_${catId}_${bId}`);
        const tInput = document.getElementById(`bundle_input_to_${catId}_${bId}`);
        const nInput = document.getElementById(`bundle_input_name_${catId}_${bId}`);
        if (fInput && tInput) {
          bundlesList.push({
            id: bId,
            name: (nInput && nInput.value.trim()) ? nInput.value.trim() : `Bundle #${bId}`,
            from: parseInt(fInput.value, 10) || 1,
            to: parseInt(tInput.value, 10) || 30
          });
        }
      });

      for (let i = 0; i < bundlesList.length; i++) {
        for (let j = i + 1; j < bundlesList.length; j++) {
          const bA = bundlesList[i];
          const bB = bundlesList[j];
          if (bA.from <= bB.to && bA.to >= bB.from) {
            hasError = true;
            const catTitle = titleInput ? titleInput.value : `Category #${catId}`;
            const bARange = (bA.from === bA.to) ? `Day ${bA.from}` : `Day ${bA.from} - ${bA.to}`;
            const bBRange = (bB.from === bB.to) ? `Day ${bB.from}` : `Day ${bB.from} - ${bB.to}`;
            errorMessages.push(`In "${catTitle}": Bundle '${bA.name}' (${bARange}) overlaps with bundle '${bB.name}' (${bBRange}). Please ensure bundle day ranges do not overlap.`);
          }
        }
      }
    });

    if (hasError) {
      if (e) {
        e.preventDefault();
        e.stopPropagation();
      }
      if (errorContainer && errorMsg) {
        errorMsg.innerHTML = errorMessages.map(m => `<div class="mb-1"><i class="bi bi-x-circle me-1.5"></i>${m}</div>`).join('');
        errorContainer.classList.remove('d-none');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } else {
        alert(errorMessages.join('\n'));
      }
      return false;
    }

    // Submit state feedback
    const submitBtns = document.querySelectorAll('#import_finalize_form button[type="submit"]');
    submitBtns.forEach(btn => {
      btn.disabled = true;
      btn.innerHTML = `<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Creating Assignment(s)...`;
    });

    return true;
  }

  function setupNewBundleModalListeners() {
    document.querySelectorAll('[id^="newBundleModal_"]').forEach(modalEl => {
      if (!modalEl.dataset.listenerAttached) {
        modalEl.dataset.listenerAttached = 'true';
        modalEl.addEventListener('show.bs.modal', function () {
          const catId = modalEl.id.replace('newBundleModal_', '');
          prepareNewBundleModal(catId);
        });
      }
    });
  }

  document.addEventListener('DOMContentLoaded', function() {
    setupFlatpickrInstances();
    initBundleSortables();
    setupGlobalCollapseIconListener();
    setupNewBundleModalListeners();
    const catCards = document.querySelectorAll('.category-assignment-card');
    catCards.forEach(card => {
      const catId = card.id.replace('category_card_', '');
      updateCardRecipientCount(catId);
    });
  });

  document.addEventListener('turbo:load', function() {
    setupFlatpickrInstances();
    initBundleSortables();
    setupGlobalCollapseIconListener();
    setupNewBundleModalListeners();
  });
</script>
