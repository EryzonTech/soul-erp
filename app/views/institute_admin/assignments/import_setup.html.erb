  function switchCategoryMobileTab(catId, target) {
    const poolCol = document.getElementById(`question_pool_col_${catId}`);
    const bundlesCol = document.getElementById(`bundles_col_${catId}`);
    const poolBtn = document.querySelector(`.cat-tab-btn-pool-${catId}`);
    const bundleBtn = document.querySelector(`.cat-tab-btn-bundles-${catId}`);

    if (target === 'pool') {
      if (poolCol) poolCol.classList.remove('d-none');
      if (bundlesCol) bundlesCol.classList.add('d-none');
      if (poolBtn) { poolBtn.classList.add('btn-primary', 'active'); poolBtn.classList.remove('btn-outline-primary'); }
      if (bundleBtn) { bundleBtn.classList.remove('btn-primary', 'active'); bundleBtn.classList.add('btn-outline-primary'); }
    } else {
      if (poolCol) poolCol.classList.add('d-none');
      if (bundlesCol) bundlesCol.classList.remove('d-none');
      if (bundleBtn) { bundleBtn.classList.add('btn-primary', 'active'); bundleBtn.classList.remove('btn-outline-primary'); }
      if (poolBtn) { poolBtn.classList.remove('btn-primary', 'active'); poolBtn.classList.add('btn-outline-primary'); }
    }
  }

