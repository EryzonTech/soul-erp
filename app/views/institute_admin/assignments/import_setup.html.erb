  function filterCategoryBundles(catId, query) {
    const q = query.trim().toLowerCase();
    const cards = document.querySelectorAll(`.bundle-card-${catId}`);
    cards.forEach(card => {
      const nameEl = card.querySelector(`[id*="bundle_name_display_${catId}_"]`);
      const bundleName = nameEl ? nameEl.textContent.trim().toLowerCase() : '';
      if (!q || bundleName.includes(q)) {
        card.classList.remove('d-none');
      } else {
        card.classList.add('d-none');
      }
