<% content_for :styles do %>
  <style>
    .reports-card {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(226, 232, 240, 0.8);
      border-radius: 20px;
      padding: 1.85rem;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
      position: relative;
      overflow: hidden;
    }

    .reports-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: transparent;
      transition: background 0.3s ease;
    }

    .reports-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 20px 35px -10px rgba(0, 0, 0, 0.08), 0 10px 15px -5px rgba(0, 0, 0, 0.04);
      border-color: rgba(199, 210, 254, 0.6);
    }

    .reports-card-gold:hover::before { background: linear-gradient(90deg, #f59e0b, #d97706); }
    .reports-card-teal:hover::before { background: linear-gradient(90deg, #14b8a6, #0d9488); }
    .reports-card-purple:hover::before { background: linear-gradient(90deg, #a855f7, #7e22ce); }
    .reports-card-indigo:hover::before { background: linear-gradient(90deg, #6366f1, #4f46e5); }

    .icon-wrapper {
      width: 60px;
      height: 60px;
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.65rem;
      margin-bottom: 1.25rem;
      transition: transform 0.35s ease, box-shadow 0.35s ease;
    }

    .reports-card:hover .icon-wrapper {
      transform: scale(1.1) rotate(-4deg);
    }

    .icon-gold { background: #fffbeb; color: #d97706; }
    .icon-teal { background: #ccfbf1; color: #0d9488; }
    .icon-purple { background: #f3e8ff; color: #9333ea; }
    .icon-indigo { background: #e0e7ff; color: #4f46e5; }

    .reports-card h4 {
      font-weight: 700;
      color: #0f172a;
      font-size: 1.2rem;
      margin-bottom: 0.5rem;
    }

    .reports-card p {
      color: #64748b;
      font-size: 0.9rem;
      line-height: 1.6;
      margin-bottom: 1.5rem;
    }

    .btn-report-action {
      border-radius: 12px;
      padding: 0.65rem 1.25rem;
      font-weight: 600;
      font-size: 0.875rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      transition: all 0.25s ease;
      width: 100%;
      text-decoration: none;
    }

    .btn-gold { background: #fffcf4; color: #b45309; border: 1px solid #fcd34d; }
    .btn-gold:hover { background: #f59e0b; color: #ffffff; border-color: #f59e0b; box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3); }

    .btn-teal { background: #f0fdfa; color: #0f766e; border: 1px solid #5eead4; }
    .btn-teal:hover { background: #14b8a6; color: #ffffff; border-color: #14b8a6; box-shadow: 0 4px 12px rgba(20, 184, 166, 0.3); }

    .btn-purple { background: #faf5ff; color: #7e22ce; border: 1px solid #d8b4fe; }
    .btn-purple:hover { background: #a855f7; color: #ffffff; border-color: #a855f7; box-shadow: 0 4px 12px rgba(168, 85, 247, 0.3); }

    .btn-indigo { background: #eef2ff; color: #4338ca; border: 1px solid #c7d2fe; }
    .btn-indigo:hover { background: #6366f1; color: #ffffff; border-color: #6366f1; box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3); }

    .active-report-card {
      background: #ffffff;
      border-radius: 20px;
      padding: 2rem;
      margin-top: 2rem;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
      border: 1px solid #e2e8f0;
      animation: fadeIn 0.4s ease-out;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
<% end %>

<div class="container-fluid px-4 py-4">
  <!-- BREADCRUMBS & PAGE HEADER -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb breadcrumb-custom mb-1">
          <li class="breadcrumb-item"><%= link_to institute_admin_root_path do %><i class="bi bi-house-door me-1"></i>Home<% end %></li>
          <li class="breadcrumb-item active" aria-current="page">Reports & Analytics</li>
        </ol>
      </nav>
      <h3 class="fw-bold text-dark mb-0">Reports & Analytics Hub</h3>
    </div>
  </div>

  <!-- REPORT MODULE CARDS GRID -->
  <div class="row g-4">
    <!-- Certificates -->
    <div class="col-12 col-md-6 col-xl-3">
      <div class="reports-card reports-card-gold">
        <div>
          <div class="icon-wrapper icon-gold">
            <i class="bi bi-award-fill"></i>
          </div>
          <h4>Certificates</h4>
          <p>Generate, issue, and verify official completion certificates for institute participants.</p>
        </div>
        <%= link_to certificates_institute_admin_reports_path, class: "btn-report-action btn-gold" do %>
          <span>Manage Certificates</span>
          <i class="bi bi-arrow-right fs-6"></i>
        <% end %>
      </div>
    </div>

    <!-- Assignment Reports -->
    <div class="col-12 col-md-6 col-xl-3">
      <div class="reports-card reports-card-teal">
        <div>
          <div class="icon-wrapper icon-teal">
            <i class="bi bi-clipboard-data-fill"></i>
          </div>
          <h4>Assignment Reports</h4>
          <p>Analyze evaluation submissions, response completion rates, and participant scores.</p>
        </div>
        <%= link_to assignment_reports_menu_institute_admin_reports_path, class: "btn-report-action btn-teal" do %>
          <span>View Analytics</span>
          <i class="bi bi-arrow-right fs-6"></i>
        <% end %>
      </div>
    </div>

    <!-- Consolidated Response Report -->
    <div class="col-12 col-md-6 col-xl-3">
      <div class="reports-card reports-card-indigo">
        <div>
          <div class="icon-wrapper icon-indigo">
            <i class="bi bi-collection-fill"></i>
          </div>
          <h4>Consolidated Responses</h4>
          <p>Multi-assignment response matrices, question breakdown, and Excel export pipeline.</p>
        </div>
        <%= link_to consolidated_matrix_report_institute_admin_reports_path(date_range: :today), class: "btn-report-action btn-indigo" do %>
          <span>Open Consolidated Report</span>
          <i class="bi bi-arrow-right fs-6"></i>
        <% end %>
      </div>
    </div>

    <!-- Feedback Insights -->
    <div class="col-12 col-md-6 col-xl-3">
      <div class="reports-card reports-card-purple">
        <div>
          <div class="icon-wrapper icon-purple">
            <i class="bi bi-chat-square-quote-fill"></i>
          </div>
          <h4>Feedback Insights</h4>
          <p>Review participant satisfaction scores, course feedback, and trainer ratings.</p>
        </div>
        <%= link_to feedback_reports_menu_institute_admin_reports_path, class: "btn-report-action btn-purple" do %>
          <span>Read Feedback</span>
          <i class="bi bi-arrow-right fs-6"></i>
        <% end %>
      </div>
    </div>
  </div>

  <!-- ACTIVE REPORT INNER PANEL -->
  <% if @report_type.present? %>
    <div class="active-report-card">
      <% if @report_type == 'certificates' %>
        <%= render 'certificate_options' %>
      <% elsif @report_type == 'assignments' %>
        <%= render 'assignment_reports' %>
      <% elsif @report_type == 'feedbacks' %>
        <%= render 'feedback_reports' %>
      <% end %>
    </div>
  <% end %>
</div>