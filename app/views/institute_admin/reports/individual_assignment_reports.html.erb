<div class="container-fluid px-0 pt-3 pb-4">
  <!-- PAGE HEADER & BREADCRUMB -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mt-1 mb-4">
    <div>
      <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb breadcrumb-modern mb-0">
          <li class="breadcrumb-item"><%= link_to institute_admin_root_path do %><i class="bi bi-house-door-fill"></i><% end %></li>
          <li class="breadcrumb-item"><%= link_to "Reports", institute_admin_reports_path %></li>
          <li class="breadcrumb-item"><%= link_to "Assignment Reports", assignment_reports_menu_institute_admin_reports_path %></li>
          <li class="breadcrumb-item active" aria-current="page">Individual Assignments</li>
        </ol>
      </nav>
      <h3 class="fw-bold text-dark mb-0" style="letter-spacing: -0.3px;">Individual Assignment Reports</h3>
    </div>
    <div class="header-actions d-flex flex-wrap align-items-center gap-2">
      <!-- Background Job Export Buttons -->
      <button type="button" 
              class="btn btn-outline-danger d-inline-flex align-items-center gap-2 shadow-sm rounded-3 px-3 py-2 fw-medium" 
              onclick="startAsyncExport('individual_assignment_pdf');"
              title="Export PDF Report">
        <i class="bi bi-file-earmark-pdf-fill"></i>
        <span>Export PDF</span>
      </button>

      <button type="button" 
              class="btn btn-outline-success d-inline-flex align-items-center gap-2 shadow-sm rounded-3 px-3 py-2 fw-medium" 
              onclick="startAsyncExport('individual_assignment_csv');"
              title="Export CSV Data">
        <i class="bi bi-file-earmark-spreadsheet-fill"></i>
        <span>Export CSV</span>
      </button>

      <%= link_to assignment_reports_menu_institute_admin_reports_path, class: "btn btn-outline-secondary d-inline-flex align-items-center gap-1.5 rounded-3 px-3 py-2 fw-medium" do %>
        <i class="bi bi-arrow-left"></i>
        <span>Back</span>
      <% end %>
    </div>
  </div>

  <!-- KPI SUMMARY METRICS ROW -->
  <div class="row g-3 mb-4">
    <!-- Card 1: Total Assigned -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="inst-kpi-card flex-column justify-content-between h-100 p-3">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <div>
            <div class="text-uppercase text-muted fw-semibold mb-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">Total Assigned</div>
            <div class="h3 fw-bold mb-0 text-dark"><%= @total_assigned_count || 0 %></div>
          </div>
          <div class="inst-kpi-icon inst-kpi-icon-primary">
            <i class="bi bi-journal-text"></i>
          </div>
        </div>
        <div class="inst-kpi-breakdown">
          <span class="inst-kpi-pill inst-kpi-pill-stu" title="Students Assigned">
            <i class="bi bi-mortarboard"></i>Stu: <%= @total_assigned_by_type&.fetch('student', 0) || 0 %>
          </span>
          <span class="inst-kpi-pill inst-kpi-pill-gua" title="Guardians Assigned">
            <i class="bi bi-shield-shaded"></i>Gua: <%= @total_assigned_by_type&.fetch('guardian', 0) || 0 %>
          </span>
          <span class="inst-kpi-pill inst-kpi-pill-emp" title="Employees Assigned">
            <i class="bi bi-briefcase"></i>Emp: <%= @total_assigned_by_type&.fetch('employee', 0) || 0 %>
          </span>
        </div>
      </div>
    </div>

    <!-- Card 2: Submitted -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="inst-kpi-card flex-column justify-content-between h-100 p-3">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <div>
            <div class="text-uppercase text-muted fw-semibold mb-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">Submitted</div>
            <div class="h3 fw-bold mb-0 text-success"><%= @submitted_count || 0 %></div>
          </div>
          <div class="inst-kpi-icon inst-kpi-icon-success">
            <i class="bi bi-check-circle"></i>
          </div>
        </div>
        <div class="inst-kpi-breakdown">
          <span class="inst-kpi-pill inst-kpi-pill-stu" title="Students Submitted">
            <i class="bi bi-mortarboard"></i>Stu: <%= @submitted_by_type&.fetch('student', 0) || 0 %>
          </span>
          <span class="inst-kpi-pill inst-kpi-pill-gua" title="Guardians Submitted">
            <i class="bi bi-shield-shaded"></i>Gua: <%= @submitted_by_type&.fetch('guardian', 0) || 0 %>
          </span>
          <span class="inst-kpi-pill inst-kpi-pill-emp" title="Employees Submitted">
            <i class="bi bi-briefcase"></i>Emp: <%= @submitted_by_type&.fetch('employee', 0) || 0 %>
          </span>
        </div>
      </div>
    </div>

    <!-- Card 3: Pending -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="inst-kpi-card flex-column justify-content-between h-100 p-3">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <div>
            <div class="text-uppercase text-muted fw-semibold mb-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">Pending</div>
            <div class="h3 fw-bold mb-0 text-warning"><%= @pending_count || 0 %></div>
          </div>
          <div class="inst-kpi-icon inst-kpi-icon-warning">
            <i class="bi bi-clock-history"></i>
          </div>
        </div>
        <div class="inst-kpi-breakdown">
          <span class="inst-kpi-pill inst-kpi-pill-stu" title="Students Pending">
            <i class="bi bi-mortarboard"></i>Stu: <%= @pending_by_type&.fetch('student', 0) || 0 %>
          </span>
          <span class="inst-kpi-pill inst-kpi-pill-gua" title="Guardians Pending">
            <i class="bi bi-shield-shaded"></i>Gua: <%= @pending_by_type&.fetch('guardian', 0) || 0 %>
          </span>
          <span class="inst-kpi-pill inst-kpi-pill-emp" title="Employees Pending">
            <i class="bi bi-briefcase"></i>Emp: <%= @pending_by_type&.fetch('employee', 0) || 0 %>
          </span>
        </div>
      </div>
    </div>

    <!-- Card 4: Completion Rate -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="inst-kpi-card flex-column justify-content-between h-100 p-3">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <div>
            <div class="text-uppercase text-muted fw-semibold mb-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">Completion Rate</div>
            <div class="h3 fw-bold mb-0 text-info"><%= sprintf("%g%%", (@participation_rate || 0).to_f.round(1)) %></div>
          </div>
          <div class="inst-kpi-icon inst-kpi-icon-info">
            <i class="bi bi-pie-chart"></i>
          </div>
        </div>
        <div class="inst-kpi-breakdown">
          <span class="inst-kpi-pill inst-kpi-pill-stu" title="Student Completion Rate">
            <i class="bi bi-mortarboard"></i>Stu: <%= sprintf("%g%%", (@completion_rate_by_type&.fetch('student', 0) || 0).to_f.round(1)) %>
          </span>
          <span class="inst-kpi-pill inst-kpi-pill-gua" title="Guardian Completion Rate">
            <i class="bi bi-shield-shaded"></i>Gua: <%= sprintf("%g%%", (@completion_rate_by_type&.fetch('guardian', 0) || 0).to_f.round(1)) %>
          </span>
          <span class="inst-kpi-pill inst-kpi-pill-emp" title="Employee Completion Rate">
            <i class="bi bi-briefcase"></i>Emp: <%= sprintf("%g%%", (@completion_rate_by_type&.fetch('employee', 0) || 0).to_f.round(1)) %>
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- FILLED FILTER TOOLBAR -->
  <%
    active_filters_count = 0
    active_filters_count += 1 if params[:search].present?
    active_filters_count += 1 if @selected_section_ids.present? && !@selected_section_ids.include?('all')
    active_filters_count += 1 if @selected_participant_ids.present? && !@selected_participant_ids.include?('all')
    active_filters_count += 1 if @selected_assignment_ids.present? && !@selected_assignment_ids.include?('all')
    active_filters_count += 1 if @selected_statuses.present? && @selected_statuses.size == 1
    active_filters_count += 1 if params[:specific_date].present?
    active_filters_count += 1 if params[:date_range].present? && params[:date_range] != ''
  %>
  <div class="filter-toolbar-card bg-white rounded-4 shadow-sm border mb-4 p-3 p-md-4">
    <%= form_tag individual_assignment_reports_institute_admin_reports_path, method: :get, id: "individualReportsForm" do %>
      <!-- TOP ROW: Defined Search & Action Buttons -->
      <div class="row g-2 g-md-3 align-items-center mb-3">
        <!-- Search Keyword Input with Submit and Clear -->
        <div class="col-12 col-md-7 col-lg-8">
          <div class="input-group">
            <span class="input-group-text bg-white border-end-0 ps-3 pe-2">
              <i class="bi bi-search text-primary"></i>
            </span>
            <input type="text" 
                   name="search" 
                   id="reportSearchInput" 
                   class="form-control border-start-0 border-end-0 ps-1 text-dark fw-medium" 
                   placeholder="Search participant name, email, section, assignment, mobile..." 
                   value="<%= params[:search] %>"
                   autocomplete="off">
            <% if params[:search].present? %>
              <button type="button" 
                      class="btn btn-link text-muted pe-3 text-decoration-none border-start-0 border-end-0" 
                      onclick="document.getElementById('reportSearchInput').value=''; document.getElementById('individualReportsForm').submit();" 
                      title="Clear search">
                <i class="bi bi-x-circle-fill"></i>
              </button>
            <% end %>
            <button type="submit" class="btn btn-primary px-3 rounded-end-3 d-inline-flex align-items-center gap-1.5 fw-semibold shadow-sm">
              <i class="bi bi-search"></i>
              <span>Search</span>
            </button>
          </div>
        </div>

        <!-- Action Buttons (Reset & Apply Filters) -->
        <div class="col-12 col-md-5 col-lg-4 d-flex align-items-center justify-content-md-end gap-2">
          <%= link_to individual_assignment_reports_institute_admin_reports_path, class: "btn btn-outline-secondary px-3 rounded-3 d-inline-flex align-items-center justify-content-center gap-1.5 w-50 w-md-auto flex-md-grow-0", title: "Reset All Filters" do %>
            <i class="bi bi-arrow-counterclockwise"></i>
            <span>Reset</span>
            <% if active_filters_count > 0 %>
              <span class="badge bg-secondary text-white rounded-pill ms-1" style="font-size: 0.72rem;"><%= active_filters_count %></span>
            <% end %>
          <% end %>

          <button type="submit" class="btn btn-primary px-3 px-sm-4 rounded-3 d-inline-flex align-items-center justify-content-center gap-1.5 fw-semibold shadow-sm w-50 w-md-auto flex-md-grow-0">
            <i class="bi bi-funnel-fill"></i>
            <span>Apply Filters</span>
          </button>
        </div>
      </div>

      <!-- BOTTOM ROW: Multi-Select Filter Dropdowns & Dates -->
      <div class="row g-2 g-md-3 align-items-center">
        <!-- 1. Sections Multi-Select Dropdown -->
        <div class="col-12 col-sm-6 col-md-4 col-xl">
          <div class="dropdown multiselect-dropdown">
            <button class="filter-dropdown-btn dropdown-toggle w-100 text-start d-flex align-items-center justify-content-between <%= 'filter-active-indigo' if @selected_section_ids.present? && !@selected_section_ids.include?('all') %>" 
                    type="button" 
                    data-bs-toggle="dropdown" 
                    data-bs-display="static"
                    data-bs-auto-close="outside"
                    aria-expanded="false">
              <span class="d-inline-flex align-items-center text-truncate">
                <i class="bi bi-people me-2 text-primary flex-shrink-0"></i>
                <span class="dropdown-label text-truncate" id="secLabel">
                  Sections (<%= @selected_section_ids.blank? || @selected_section_ids.include?('all') ? 'All' : @selected_section_ids.size %>)
                </span>
              </span>
            </button>
            <div class="dropdown-menu dropdown-menu-start p-2 shadow-lg rounded-3 border" style="width: 280px; max-width: min(320px, calc(100vw - 2rem));">
              <div class="px-1 mb-2">
                <input type="text" class="form-control form-control-sm multiselect-search" placeholder="Search sections..." oninput="filterDropdownList(this)">
              </div>
              <div class="d-flex justify-content-between px-1 mb-2 pb-1 border-bottom">
                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none fw-semibold text-primary" style="font-size: 0.75rem;" onclick="selectAllDropdownCheckboxes(this, true, 'secLabel', 'Sections', 'section_ids[]')">Select All</button>
                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none text-muted" style="font-size: 0.75rem;" onclick="selectAllDropdownCheckboxes(this, false, 'secLabel', 'Sections', 'section_ids[]')">Clear</button>
              </div>
              <div class="multiselect-options-list">
                <% (@available_sections || current_institute.sections.order(:name)).each do |sec| %>
                  <div class="form-check dropdown-item rounded px-2 py-1.5 multiselect-item d-flex align-items-start gap-2">
                    <input class="form-check-input mt-1 flex-shrink-0" 
                           type="checkbox" 
                           name="section_ids[]" 
                           value="<%= sec.id %>" 
                           id="sec_cb_<%= sec.id %>" 
                           <%= 'checked' if @selected_section_ids&.include?(sec.id.to_s) %>
                           onchange="updateDropdownCounter('secLabel', 'Sections', 'section_ids[]')">
                    <label class="form-check-label flex-grow-1 cursor-pointer small" for="sec_cb_<%= sec.id %>" title="<%= sec.name %>">
                      <%= sec.name %>
                    </label>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <!-- 2. Participants Multi-Select Dropdown -->
        <div class="col-12 col-sm-6 col-md-4 col-xl">
          <div class="dropdown multiselect-dropdown">
            <button class="filter-dropdown-btn dropdown-toggle w-100 text-start d-flex align-items-center justify-content-between <%= 'filter-active-indigo' if @selected_participant_ids.present? && !@selected_participant_ids.include?('all') %>" 
                    type="button" 
                    data-bs-toggle="dropdown" 
                    data-bs-display="static"
                    data-bs-auto-close="outside"
                    aria-expanded="false">
              <span class="d-inline-flex align-items-center text-truncate">
                <i class="bi bi-person me-2 text-primary flex-shrink-0"></i>
                <span class="dropdown-label text-truncate" id="partLabel">
                  Participants (<%= @selected_participant_ids.blank? || @selected_participant_ids.include?('all') ? 'All' : @selected_participant_ids.size %>)
                </span>
              </span>
            </button>
            <div class="dropdown-menu dropdown-menu-start p-2 shadow-lg rounded-3 border" style="width: 320px; max-width: min(360px, calc(100vw - 2rem));">
              <div class="px-1 mb-2">
                <input type="text" class="form-control form-control-sm multiselect-search" placeholder="Search participants..." oninput="filterDropdownList(this)">
              </div>
              <div class="d-flex justify-content-between px-1 mb-2 pb-1 border-bottom">
                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none fw-semibold text-primary" style="font-size: 0.75rem;" onclick="selectAllDropdownCheckboxes(this, true, 'partLabel', 'Participants', 'participant_ids[]')">Select All</button>
                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none text-muted" style="font-size: 0.75rem;" onclick="selectAllDropdownCheckboxes(this, false, 'partLabel', 'Participants', 'participant_ids[]')">Clear</button>
              </div>
              <div class="multiselect-options-list">
                <% (@participants || []).each do |part| %>
                  <div class="form-check dropdown-item rounded px-2 py-1.5 multiselect-item d-flex align-items-start gap-2">
                    <input class="form-check-input mt-1 flex-shrink-0" 
                           type="checkbox" 
                           name="participant_ids[]" 
                           value="<%= part.id %>" 
                           id="part_cb_<%= part.id %>" 
                           <%= 'checked' if @selected_participant_ids&.include?(part.id.to_s) %>
                           onchange="updateDropdownCounter('partLabel', 'Participants', 'participant_ids[]')">
                    <label class="form-check-label flex-grow-1 cursor-pointer small" for="part_cb_<%= part.id %>" title="<%= part.full_name %>">
                      <%= part.full_name %>
                      <% if part.section&.name.present? %>
                        <span class="text-muted" style="font-size: 0.75rem;">(<%= part.section.name %>)</span>
                      <% end %>
                    </label>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <!-- 3. Assignments Multi-Select Dropdown -->
        <div class="col-12 col-sm-6 col-md-4 col-xl">
          <div class="dropdown multiselect-dropdown">
            <button class="filter-dropdown-btn dropdown-toggle w-100 text-start d-flex align-items-center justify-content-between <%= 'filter-active-indigo' if @selected_assignment_ids.present? && !@selected_assignment_ids.include?('all') %>" 
                    type="button" 
                    data-bs-toggle="dropdown" 
                    data-bs-display="static"
                    data-bs-auto-close="outside"
                    aria-expanded="false">
              <span class="d-inline-flex align-items-center text-truncate">
                <i class="bi bi-file-earmark-text me-2 text-primary flex-shrink-0"></i>
                <span class="dropdown-label text-truncate" id="asgLabel">
                  Assignments (<%= @selected_assignment_ids.blank? || @selected_assignment_ids.include?('all') ? 'All' : @selected_assignment_ids.size %>)
                </span>
              </span>
            </button>
            <div class="dropdown-menu dropdown-menu-start p-2 shadow-lg rounded-3 border" style="width: 320px; max-width: min(360px, calc(100vw - 2rem));">
              <div class="px-1 mb-2">
                <input type="text" class="form-control form-control-sm multiselect-search" placeholder="Search assignments..." oninput="filterDropdownList(this)">
              </div>
              <div class="d-flex justify-content-between px-1 mb-2 pb-1 border-bottom">
                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none fw-semibold text-primary" style="font-size: 0.75rem;" onclick="selectAllDropdownCheckboxes(this, true, 'asgLabel', 'Assignments', 'assignment_ids[]')">Select All</button>
                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none text-muted" style="font-size: 0.75rem;" onclick="selectAllDropdownCheckboxes(this, false, 'asgLabel', 'Assignments', 'assignment_ids[]')">Clear</button>
              </div>
              <div class="multiselect-options-list">
                <% (@available_assignments || current_institute.assignments.order(start_date: :desc, title: :asc)).each do |asg| %>
                  <div class="form-check dropdown-item rounded px-2 py-1.5 multiselect-item d-flex align-items-start gap-2">
                    <input class="form-check-input mt-1 flex-shrink-0" 
                           type="checkbox" 
                           name="assignment_ids[]" 
                           value="<%= asg.id %>" 
                           id="asg_cb_<%= asg.id %>" 
                           <%= 'checked' if @selected_assignment_ids&.include?(asg.id.to_s) %>
                           onchange="updateDropdownCounter('asgLabel', 'Assignments', 'assignment_ids[]')">
                    <label class="form-check-label flex-grow-1 cursor-pointer small" for="asg_cb_<%= asg.id %>" title="<%= asg.title %>">
                      <%= asg.title %>
                    </label>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <!-- 4. Status Multi-Select Dropdown -->
        <div class="col-12 col-sm-6 col-md-4 col-xl">
          <div class="dropdown multiselect-dropdown">
            <button class="filter-dropdown-btn dropdown-toggle w-100 text-start d-flex align-items-center justify-content-between <%= 'filter-active-indigo' if @selected_statuses.present? && @selected_statuses.size == 1 %>" 
                    type="button" 
                    data-bs-toggle="dropdown" 
                    data-bs-display="static"
                    data-bs-auto-close="outside"
                    aria-expanded="false">
              <span class="d-inline-flex align-items-center text-truncate">
                <i class="bi bi-check-circle me-2 text-primary flex-shrink-0"></i>
                <span class="dropdown-label text-truncate" id="statusLabel">
                  Status (<%= @selected_statuses.blank? || @selected_statuses.size == 2 ? 'All' : @selected_statuses.map { |s| s == 'not_submitted' ? 'Pending' : 'Submitted' }.join(', ') %>)
                </span>
              </span>
            </button>
            <div class="dropdown-menu dropdown-menu-start p-2 shadow-lg rounded-3 border" style="width: 240px; max-width: min(280px, calc(100vw - 2rem));">
              <div class="d-flex justify-content-between px-1 mb-2 pb-1 border-bottom">
                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none fw-semibold text-primary" style="font-size: 0.75rem;" onclick="selectAllDropdownCheckboxes(this, true, 'statusLabel', 'Status', 'submission_statuses[]')">Select All</button>
                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none text-muted" style="font-size: 0.75rem;" onclick="selectAllDropdownCheckboxes(this, false, 'statusLabel', 'Status', 'submission_statuses[]')">Clear</button>
              </div>
              <div class="multiselect-options-list">
                <div class="form-check dropdown-item rounded px-2 py-1.5 multiselect-item d-flex align-items-center gap-2">
                  <input class="form-check-input flex-shrink-0" 
                         type="checkbox" 
                         name="submission_statuses[]" 
                         value="submitted" 
                         id="status_cb_submitted" 
                         <%= 'checked' if @selected_statuses.blank? || @selected_statuses.include?('submitted') %>
                         onchange="updateStatusDropdownCounter()">
                  <label class="form-check-label flex-grow-1 cursor-pointer small" for="status_cb_submitted">
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-0.5 rounded-pill me-1">Submitted</span>
                  </label>
                </div>
                <div class="form-check dropdown-item rounded px-2 py-1.5 multiselect-item d-flex align-items-center gap-2">
                  <input class="form-check-input flex-shrink-0" 
                         type="checkbox" 
                         name="submission_statuses[]" 
                         value="not_submitted" 
                         id="status_cb_not_submitted" 
                         <%= 'checked' if @selected_statuses.blank? || @selected_statuses.include?('not_submitted') %>
                         onchange="updateStatusDropdownCounter()">
                  <label class="form-check-label flex-grow-1 cursor-pointer small" for="status_cb_not_submitted">
                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-0.5 rounded-pill me-1">Pending</span>
                  </label>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 5. Exact Date Filter -->
        <div class="col-12 col-sm-6 col-md-4 col-xl">
          <div class="input-group" title="Filter by Specific Date">
            <span class="input-group-text bg-white"><i class="bi bi-calendar-event text-secondary"></i></span>
            <input type="date" name="specific_date" class="form-control" value="<%= params[:specific_date] %>" onchange="this.form.submit()" placeholder="Specific Date">
          </div>
        </div>

        <!-- 6. Date Range Filter -->
        <div class="col-12 col-sm-6 col-md-4 col-xl">
          <div class="input-group">
            <span class="input-group-text bg-white"><i class="bi bi-calendar-range text-secondary"></i></span>
            <select name="date_range" id="dateRangeFilter" class="form-select" onchange="toggleCustomDates(this.value); if (this.value !== 'custom') { this.form.submit(); }">
              <option value="" <%= 'selected' if params[:date_range].blank? %>>All Ranges</option>
              <option value="today" <%= 'selected' if params[:date_range] == 'today' %>>Today</option>
              <option value="yesterday" <%= 'selected' if params[:date_range] == 'yesterday' %>>Yesterday</option>
              <option value="last_7_days" <%= 'selected' if params[:date_range] == 'last_7_days' %>>Last 7 Days</option>
              <option value="this_month" <%= 'selected' if params[:date_range] == 'this_month' %>>This Month</option>
              <option value="custom" <%= 'selected' if params[:date_range] == 'custom' %>>Custom Range</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Custom Date Row (Toggled when Custom is selected) -->
      <div id="customDateRow" class="row g-3 mt-2 align-items-center <%= 'd-none' unless params[:date_range] == 'custom' %>">
        <div class="col-12 col-md-4">
          <div class="input-group">
            <span class="input-group-text">From</span>
            <input type="date" name="start_date" class="form-control" value="<%= @start_date.to_s %>">
          </div>
        </div>
        <div class="col-12 col-md-4">
          <div class="input-group">
            <span class="input-group-text">To</span>
            <input type="date" name="end_date" class="form-control" value="<%= @end_date.to_s %>">
          </div>
        </div>
        <div class="col-12 col-md-4 d-flex gap-2">
          <button type="submit" class="btn btn-primary flex-grow-1 shadow-sm">Apply Range</button>
          <%= link_to individual_assignment_reports_institute_admin_reports_path, class: "btn btn-outline-secondary", title: "Reset Filters" do %>
            <i class="bi bi-arrow-counterclockwise"></i>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- MAIN DATA TABLE CARD -->
  <div class="table-card">
    <div class="table-card-header d-flex align-items-center justify-content-between py-3 px-4">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-person-lines-fill text-primary fs-5"></i>
        <h6 class="fw-bold mb-0 text-dark">Individual Submission Logs</h6>
      </div>
      <span class="badge bg-light text-secondary border px-3 py-1.5 fw-medium">
        Showing <%= @report_rows&.size || 0 %> Total Records
      </span>
    </div>

    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead>
          <tr>
            <th class="ps-4 text-center" style="width: 50px;">#</th>
            <th style="min-width: 140px;">DATE</th>
            <th style="min-width: 200px;">PARTICIPANT</th>
            <th style="min-width: 150px;">SECTION</th>
            <th style="min-width: 220px;">ASSIGNMENT</th>
            <th style="min-width: 120px;" class="text-center">STATUS</th>
            <th style="min-width: 140px;" class="pe-4 text-center">ACTIONS</th>
          </tr>
        </thead>
        <tbody>
          <% if @paginated_rows.present? && @paginated_rows.any? %>
            <% @paginated_rows.each_with_index do |row, index| %>
              <% row_num = (@pagy ? @pagy.from : 1) + index %>
              <tr>
                <td class="ps-4 text-center fw-semibold text-muted" style="font-size: 0.85rem;"><%= row_num %></td>
                <td class="text-nowrap fw-medium text-secondary">
                  <%= row[:date].present? ? row[:date].strftime("%b %d, %Y") : "Pending" %>
                </td>
                <td>
                  <div class="fw-semibold text-dark"><%= row[:participant_name] %></div>
                  <div class="small text-muted"><%= row[:participant_email] %></div>
                </td>
                <td>
                  <span class="badge bg-light text-dark border px-2.5 py-1.5 fw-medium">
                    <i class="bi bi-people me-1 text-muted"></i><%= row[:section_name] %>
                  </span>
                </td>
                <td class="fw-medium text-dark"><%= row[:assignment_title] %></td>
                <td class="text-center">
                  <% if row[:status] == "submitted" %>
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1.5 fw-semibold">
                      <i class="bi bi-check-circle-fill me-1"></i>Submitted
                    </span>
                  <% else %>
                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-3 py-1.5 fw-semibold">
                      <i class="bi bi-clock-history me-1"></i>Pending
                    </span>
                  <% end %>
                </td>
                <td class="pe-4 text-center">
                  <% if row[:status] == 'submitted' && row[:participant_id].present? && row[:assignment_id].present? %>
                    <%= link_to assignment_response_details_institute_admin_reports_path(
                          participant_id: row[:participant_id],
                          assignment_id: row[:assignment_id],
                          date: row[:date]
                        ),
                        class: "btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1.5 px-3 py-1 rounded-pill fw-semibold shadow-sm",
                        title: "View Submission Details" do %>
                      <i class="bi bi-eye-fill"></i> View Details
                    <% end %>
                  <% elsif row[:status] == 'pending' && row[:participant_email].present? %>
                    <%= mail_to row[:participant_email], 
                                class: "btn btn-sm btn-outline-warning d-inline-flex align-items-center gap-1 px-2.5 py-1 rounded-pill fw-medium", 
                                subject: "Assignment Submission Reminder" do %>
                      <i class="bi bi-envelope-at"></i> Remind
                    <% end %>
                  <% else %>
                    <span class="text-muted small">-</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="5" class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                No individual assignment records found for the selected criteria.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- PAGY PAGINATION FOOTER -->
    <% if @pagy.present? %>
      <div class="table-card-footer d-flex flex-column flex-md-row align-items-center justify-content-between py-3 px-4 bg-white border-top gap-3">
        <div class="text-secondary small fw-medium">
          Showing <span class="fw-semibold text-dark"><%= @pagy.from %></span> to <span class="fw-semibold text-dark"><%= @pagy.to %></span> of <span class="fw-semibold text-dark"><%= @pagy.count %></span> records
        </div>
        <div class="pagy-bootstrap-nav">
          <%== pagy_bootstrap_nav(@pagy) if @pagy.pages > 1 %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<!-- ASYNC BACKGROUND EXPORT PROGRESS MODAL -->
<div class="modal fade" id="asyncExportModal" tabindex="-1" aria-labelledby="asyncExportModalLabel" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden" style="background: #ffffff;">
      <div class="modal-header border-0 pb-0 pt-4 px-4">
        <div class="d-flex align-items-center gap-3">
          <div class="p-3 rounded-3" style="background: rgba(99, 102, 241, 0.1); color: #6366f1;">
            <i class="bi bi-cpu-fill fs-3" id="asyncExportIcon"></i>
          </div>
          <div>
            <h5 class="modal-title fw-bold text-dark mb-0" id="asyncExportModalLabel">Exporting Report</h5>
          </div>
        </div>
        <button type="button" class="btn-close" aria-label="Close" id="asyncExportCloseBtn" onclick="minimizeAsyncModal();"></button>
      </div>

      <div class="modal-body p-4 text-center">
        <!-- Progress Percentage Header -->
        <div class="d-flex justify-content-between align-items-center mb-2 px-1">
          <span class="text-secondary small fw-semibold" id="asyncExportStage">Initializing worker...</span>
          <span class="badge bg-indigo text-white fw-bold px-2.5 py-1 rounded-pill" id="asyncExportPercent" style="background-color: #6366f1;">0%</span>
        </div>

        <!-- Animated Modern Progress Bar -->
        <div class="progress rounded-pill mb-3" style="height: 12px; background-color: #f1f5f9;">
          <div class="progress-bar progress-bar-striped progress-bar-animated" 
               id="asyncProgressBar" 
               role="progressbar" 
               style="width: 0%; background: linear-gradient(90deg, #6366f1 0%, #4f46e5 100%); transition: width 0.4s ease;"></div>
        </div>

        <p class="text-muted small mb-0" id="asyncExportMessage">Your request has been enqueued. Please wait while the background worker builds the export file.</p>
      </div>

      <div class="modal-footer border-0 pt-0 pb-4 px-4 d-flex justify-content-center">
        <a href="#" id="asyncDownloadBtn" class="btn btn-success d-none d-inline-flex align-items-center gap-2 px-4 py-2 rounded-3 shadow-sm fw-semibold">
          <i class="bi bi-cloud-arrow-down-fill fs-5"></i>
          <span>Download File Now</span>
        </a>
        <button type="button" class="btn btn-outline-secondary px-3 py-1.5 rounded-3 small text-muted d-inline-flex align-items-center gap-1.5" id="asyncCancelBtn" onclick="minimizeAsyncModal();">
          <span>Minimize Window</span>
        </button>
      </div>
    </div>
  </div>
</div>

<!-- MINIMIZED FLOATING PROGRESS WIDGET -->
<div id="minimizedProgressWidget" 
     class="d-none position-fixed bottom-0 end-0 m-4 p-3 bg-white rounded-4 shadow-lg border d-flex align-items-center gap-3" 
     style="z-index: 1065; min-width: 300px; border-color: rgba(99, 102, 241, 0.25) !important;">
  <div class="p-2 rounded-3 text-white" style="background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);" id="minimizedIconBox">
    <i class="bi bi-cpu-fill fs-5" id="minimizedIcon"></i>
  </div>
  <div class="flex-grow-1 overflow-hidden">
    <div class="d-flex align-items-center justify-content-between">
      <span class="fw-bold text-dark small" id="minimizedTitle">Exporting...</span>
      <span class="badge bg-indigo text-white fw-bold px-2 py-0.5 rounded-pill small" id="minimizedPercent" style="background-color: #6366f1;">0%</span>
    </div>
    <div class="progress rounded-pill mt-1" style="height: 6px; background-color: #f1f5f9;">
      <div class="progress-bar progress-bar-striped progress-bar-animated" id="minimizedProgressBar" style="width: 0%; background: #6366f1; transition: width 0.4s ease;"></div>
    </div>
  </div>
  <button type="button" class="btn btn-sm btn-light rounded-circle p-1.5 lh-1 shadow-sm" title="Maximize Progress Window" onclick="maximizeAsyncModal();">
    <i class="bi bi-arrows-angle-expand text-primary fs-6"></i>
  </button>
  <button type="button" class="btn btn-sm btn-light rounded-circle p-1.5 lh-1 text-muted shadow-sm" title="Dismiss Widget" onclick="dismissWidget();">
    <i class="bi bi-x-lg"></i>
  </button>
</div>

<script>
  let pollInterval = null;

  function showAsyncModal() {
    const modalElement = document.getElementById('asyncExportModal');
    if (!modalElement) return;
    if (window.bootstrap && window.bootstrap.Modal) {
      try {
        const modal = bootstrap.Modal.getInstance(modalElement) || new bootstrap.Modal(modalElement);
        modal.show();
        return;
      } catch (e) { console.warn('Bootstrap modal init error, using fallback', e); }
    }
    modalElement.classList.add('show');
    modalElement.style.display = 'block';
    document.body.classList.add('modal-open');
    let backdrop = document.getElementById('customModalBackdrop');
    if (!backdrop) {
      backdrop = document.createElement('div');
      backdrop.id = 'customModalBackdrop';
      backdrop.className = 'modal-backdrop fade show';
      document.body.appendChild(backdrop);
    }
  }

  function hideAsyncModal() {
    const modalElement = document.getElementById('asyncExportModal');
    if (!modalElement) return;
    if (window.bootstrap && window.bootstrap.Modal) {
      try {
        const modal = bootstrap.Modal.getInstance(modalElement);
        if (modal) modal.hide();
      } catch (e) { /* ignore */ }
    }
    modalElement.classList.remove('show');
    modalElement.style.display = 'none';
    document.body.classList.remove('modal-open');
    const backdrop = document.getElementById('customModalBackdrop');
    if (backdrop) backdrop.remove();
  }

  function toggleCustomDates(value) {
    const customRow = document.getElementById('customDateRow');
    if (customRow) {
      if (value === 'custom') {
        customRow.classList.remove('d-none');
      } else {
        customRow.classList.add('d-none');
      }
    }
  }

  function onSectionChange(sectionId) {
    const form = document.getElementById('individualReportsForm');
    const participantSelect = document.getElementById('participantFilter');

    if (!sectionId || sectionId === 'all') {
      participantSelect.innerHTML = '<option value="">All Participants</option>';
      form.submit();
      return;
    }

    fetch(`/institute_admin/sections/${sectionId}/participants?format=json`)
      .then(response => response.json())
      .then(data => {
        participantSelect.innerHTML = '<option value="">All Participants</option>';
        data.forEach(participant => {
          const option = document.createElement('option');
          option.value = participant.id;
          option.textContent = participant.full_name;
          participantSelect.appendChild(option);
        });
        form.submit();
      })
      .catch(error => {
        console.error('Error fetching participants:', error);
        form.submit();
      });
  }

  function minimizeAsyncModal() {
    hideAsyncModal();
    const widget = document.getElementById('minimizedProgressWidget');
    if (widget) widget.classList.remove('d-none');
  }

  function maximizeAsyncModal() {
    dismissWidget();
    showAsyncModal();
  }

  function dismissWidget() {
    const widget = document.getElementById('minimizedProgressWidget');
    if (widget) widget.classList.add('d-none');
  }

  let exportPollTimer = null;
  let isExportRunning = false;
  let exportDownloaded = false;

  function startAsyncExport(exportType) {
    if (isExportRunning) {
      console.warn("Export already in progress.");
      showAsyncModal();
      return;
    }

    isExportRunning = true;
    exportDownloaded = false;
    if (exportPollTimer) {
      clearTimeout(exportPollTimer);
      exportPollTimer = null;
    }

    const progressBar = document.getElementById('asyncProgressBar');
    progressBar.style.width = '5%';
    progressBar.className = 'progress-bar progress-bar-striped progress-bar-animated';
    document.getElementById('asyncExportPercent').innerText = '5%';
    document.getElementById('asyncExportStage').innerText = 'Preparing Export...';
    document.getElementById('asyncExportMessage').innerText = 'Initializing report compilation...';
    document.getElementById('asyncDownloadBtn').classList.add('d-none');
    document.getElementById('asyncExportIcon').className = 'bi bi-cpu-fill fs-3';

    const minBar = document.getElementById('minimizedProgressBar');
    minBar.style.width = '5%';
    minBar.className = 'progress-bar progress-bar-striped progress-bar-animated';
    document.getElementById('minimizedPercent').innerText = '5%';
    document.getElementById('minimizedIcon').className = 'bi bi-cpu-fill fs-5';

    showAsyncModal();

    // Collect current filter parameters
    const form = document.getElementById('individualReportsForm');
    const formData = new FormData(form || undefined);
    formData.delete('_method');
    formData.append('export_type', exportType);

    // Merge any active query parameters from the URL that may not be present in form
    const urlParams = new URLSearchParams(window.location.search);
    for (const [key, value] of urlParams.entries()) {
      if (key !== 'page' && key !== 'format' && !formData.has(key)) {
        formData.append(key, value);
      }
    }

    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;

    fetch('/institute_admin/reports/export_async', {
      method: 'POST',
      headers: {
        'X-CSRF-Token': csrfToken,
        'Accept': 'application/json'
      },
      body: formData
    })
    .then(res => res.json())
    .then(data => {
      if (data.export_token) {
        pollExportStatus(data.export_token);
      } else {
        isExportRunning = false;
        document.getElementById('asyncExportStage').innerText = 'Export Failed';
        document.getElementById('asyncExportMessage').innerText = 'Failed to start export job. Please try again.';
        progressBar.className = 'progress-bar bg-danger';
        minBar.className = 'progress-bar bg-danger';
      }
    })
    .catch(err => {
      console.error('Export enqueue error:', err);
      isExportRunning = false;
      document.getElementById('asyncExportStage').innerText = 'Export Failed';
      document.getElementById('asyncExportMessage').innerText = 'Network error while triggering export. Please try again.';
      progressBar.className = 'progress-bar bg-danger';
      minBar.className = 'progress-bar bg-danger';
    });
  }

  function pollExportStatus(exportToken) {
    if (!isExportRunning || exportDownloaded) return;

    fetch(`/institute_admin/reports/export_status?export_token=${exportToken}`)
      .then(res => res.json())
      .then(data => {
        if (!isExportRunning || exportDownloaded) return;

        const percent = data.progress || 0;
        document.getElementById('asyncProgressBar').style.width = `${percent}%`;
        document.getElementById('asyncExportPercent').innerText = `${percent}%`;
        document.getElementById('asyncExportMessage').innerText = data.message || 'Processing...';

        document.getElementById('minimizedProgressBar').style.width = `${percent}%`;
        document.getElementById('minimizedPercent').innerText = `${percent}%`;

        if (data.status === 'processing' || data.status === 'queued') {
          document.getElementById('asyncExportStage').innerText = 'Generating Report...';
          exportPollTimer = setTimeout(() => {
            pollExportStatus(exportToken);
          }, 1500);
        } else if (data.status === 'completed') {
          exportDownloaded = true;
          isExportRunning = false;
          if (exportPollTimer) {
            clearTimeout(exportPollTimer);
            exportPollTimer = null;
          }

          document.getElementById('asyncExportStage').innerText = 'Report Ready!';
          document.getElementById('asyncExportIcon').className = 'bi bi-check-circle-fill text-success fs-3';
          document.getElementById('minimizedIcon').className = 'bi bi-check-circle-fill text-success fs-5';
          
          const downloadBtn = document.getElementById('asyncDownloadBtn');
          downloadBtn.href = data.download_url;
          downloadBtn.classList.remove('d-none');

          // Trigger direct file download via isolated iframe to prevent Turbo navigation or redirect loops
          triggerFileDownload(data.download_url);

          // Automatically dismiss both modal & widget after brief completion visual indicator
          setTimeout(() => {
            hideAsyncModal();
            dismissWidget();
          }, 2000);
        } else if (data.status === 'failed') {
          isExportRunning = false;
          if (exportPollTimer) {
            clearTimeout(exportPollTimer);
            exportPollTimer = null;
          }
          document.getElementById('asyncExportStage').innerText = 'Export Failed';
          document.getElementById('asyncExportMessage').innerText = data.message || 'Export failed. Please check filters and try again.';
          document.getElementById('asyncExportIcon').className = 'bi bi-exclamation-triangle-fill text-danger fs-3';
          document.getElementById('minimizedIcon').className = 'bi bi-exclamation-triangle-fill text-danger fs-5';
          document.getElementById('asyncProgressBar').className = 'progress-bar bg-danger';
          document.getElementById('minimizedProgressBar').className = 'progress-bar bg-danger';
        }
      })
      .catch(err => {
        console.error('Error polling status:', err);
        if (isExportRunning && !exportDownloaded) {
          exportPollTimer = setTimeout(() => {
            pollExportStatus(exportToken);
          }, 2000);
        }
      });
  }

  function triggerFileDownload(downloadUrl) {
    const iframe = document.createElement('iframe');
    iframe.style.display = 'none';
    iframe.src = downloadUrl;
    document.body.appendChild(iframe);
    setTimeout(() => {
      if (iframe.parentNode) {
        iframe.parentNode.removeChild(iframe);
      }
    }, 15000);
  }

  function filterDropdownList(input) {
    const term = input.value.toLowerCase().trim();
    const dropdownMenu = input.closest('.dropdown-menu');
    const items = dropdownMenu.querySelectorAll('.multiselect-item');
    items.forEach(item => {
      const text = item.textContent.toLowerCase();
      item.style.display = text.includes(term) ? 'flex' : 'none';
    });
  }

  function selectAllDropdownCheckboxes(btn, selectAll, labelId, prefix, inputName) {
    const dropdownMenu = btn.closest('.dropdown-menu');
    const checkboxes = dropdownMenu.querySelectorAll(`.multiselect-options-list input[name="${inputName}"]`);
    checkboxes.forEach(cb => {
      const itemWrapper = cb.closest('.multiselect-item');
      if (!itemWrapper || itemWrapper.style.display !== 'none') {
        cb.checked = selectAll;
      }
    });
    if (inputName === 'submission_statuses[]') {
      updateStatusDropdownCounter();
    } else {
      updateDropdownCounter(labelId, prefix, inputName);
    }
  }

  function updateDropdownCounter(labelId, prefix, inputName) {
    if (!inputName) return;
    const checkedBoxes = document.querySelectorAll(`input[name="${inputName}"]:checked`);
    const allBoxes = document.querySelectorAll(`input[name="${inputName}"]`);
    const labelEl = document.getElementById(labelId);
    if (!labelEl) return;

    const btn = labelEl.closest('.filter-dropdown-btn');

    if (checkedBoxes.length === 0 || checkedBoxes.length === allBoxes.length) {
      labelEl.innerText = `${prefix} (All)`;
      if (btn) btn.classList.remove('filter-active-indigo');
    } else {
      labelEl.innerText = `${prefix} (${checkedBoxes.length})`;
      if (btn) btn.classList.add('filter-active-indigo');
    }
  }

  function updateStatusDropdownCounter() {
    const checked = document.querySelectorAll('input[name="submission_statuses[]"]:checked');
    const labelEl = document.getElementById('statusLabel');
    if (!labelEl) return;

    const btn = labelEl.closest('.filter-dropdown-btn');

    if (checked.length === 0 || checked.length === 2) {
      labelEl.innerText = 'Status (All)';
      if (btn) btn.classList.remove('filter-active-indigo');
    } else {
      const statuses = Array.from(checked).map(c => c.value === 'not_submitted' ? 'Pending' : 'Submitted').join(', ');
      labelEl.innerText = `Status (${statuses})`;
      if (btn) btn.classList.add('filter-active-indigo');
    }
  }

  document.addEventListener('turbo:before-cache', function() {
    if (exportPollTimer) {
      clearTimeout(exportPollTimer);
      exportPollTimer = null;
    }
    isExportRunning = false;
  });
</script>

