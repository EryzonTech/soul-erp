  .filter-dropdown-btn.show,
  .show > .filter-dropdown-btn.dropdown-toggle {
    background-color: #ffffff !important;
    border-color: #6366f1 !important;
    color: #0f172a !important;
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15) !important;
  }

  .filter-dropdown-btn .dropdown-label {
    color: #1e293b !important;
    font-weight: 500;
  }

  .filter-dropdown-btn.filter-active-indigo {
    border-color: #6366f1 !important;
    background-color: #eef2ff !important;
    color: #4338ca !important;
  }

  .filter-dropdown-btn.filter-active-indigo .dropdown-label {
    color: #4338ca !important;
    font-weight: 600 !important;
  }

  .filter-dropdown-btn::after {
    margin-left: 0.5rem;
    color: #64748b !important;
    vertical-align: middle;
    transition: transform 0.2s ease;
  }

  .filter-dropdown-btn.show::after {
    transform: rotate(180deg);
  }

  /* Multi-Select Dropdown & Checkbox Alignment Fixes */
  .multiselect-dropdown {
    position: relative;
  }

  .multiselect-dropdown .dropdown-menu {
    z-index: 1060 !important;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12), 0 4px 10px rgba(0, 0, 0, 0.05) !important;
    border: 1px solid #e2e8f0 !important;
    border-radius: 12px !important;
    padding: 0.5rem !important;
    overflow: hidden;
  }

  .multiselect-dropdown .multiselect-search {
    border-radius: 8px !important;
