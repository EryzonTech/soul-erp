<div class="arm-page-wrapper">
  <!-- Hero Header -->
  <div class="arm-hero">
    <div class="arm-hero-content">
      <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb arm-breadcrumb mb-0">
          <li class="breadcrumb-item">
            <%= link_to institute_admin_root_path do %>
              <i class="bi bi-house-door-fill"></i>
            <% end %>
          </li>
          <li class="breadcrumb-item"><%= link_to "Reports", institute_admin_reports_path %></li>
          <li class="breadcrumb-item active" aria-current="page">Assignment Reports</li>
        </ol>
      </nav>

      <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3">
        <div>
          <h1 class="arm-hero-title">
            <span class="arm-title-icon"><i class="bi bi-bar-chart-line-fill"></i></span>
            Assignment Performance Hub
          </h1>
          <p class="arm-hero-subtitle">Choose a report module to analyze section aggregations or individual participant submissions.</p>
        </div>
        <%= link_to institute_admin_reports_path, class: "arm-back-btn flex-shrink-0" do %>
          <i class="bi bi-arrow-left-circle-fill"></i>
          <span class="d-none d-sm-inline">Back to Reports</span>
          <span class="d-inline d-sm-none">Back</span>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Report Cards Grid -->
  <div class="arm-cards-grid">

    <!-- Section-wise Reports Card -->
    <div class="arm-card arm-card-emerald">
      <%= link_to assignment_reports_institute_admin_reports_path, class: "arm-card-link", title: "Open Section-wise Reports" do %><% end %>

      <div class="arm-card-deco-circle"></div>
      <div class="arm-card-deco-ring"></div>

      <div class="arm-card-top">
        <div class="arm-icon-block arm-icon-emerald">
          <i class="bi bi-people-fill"></i>
        </div>
        <span class="arm-badge arm-badge-emerald">
          <i class="bi bi-diagram-3-fill"></i>
          Section Mode
        </span>
      </div>

      <div class="arm-card-body">
        <h5 class="arm-card-title">
          Section-wise Reports
          <i class="bi bi-arrow-right-circle-fill arm-arrow-icon"></i>
        </h5>
        <p class="arm-card-desc">
          Comprehensive overview of assignment performance grouped by class sections. Monitor submission metrics and completion rates across your organization.
        </p>
      </div>

      <div class="arm-card-footer">
        <span class="arm-footer-cta">
          <i class="bi bi-graph-up-arrow"></i>
          View Section Analytics
        </span>
        <span class="arm-footer-chip">
          <i class="bi bi-layers"></i> Aggregate
        </span>
      </div>
    </div>

    <!-- Individual Reports Card -->
    <div class="arm-card arm-card-indigo">
      <%= link_to individual_assignment_reports_institute_admin_reports_path, class: "arm-card-link", title: "Open Individual Assignment Reports" do %><% end %>

      <div class="arm-card-deco-circle"></div>
      <div class="arm-card-deco-ring"></div>

      <div class="arm-card-top">
        <div class="arm-icon-block arm-icon-indigo">
          <i class="bi bi-person-vcard-fill"></i>
        </div>
        <span class="arm-badge arm-badge-indigo">
          <i class="bi bi-person-lines-fill"></i>
          Individual Mode
        </span>
      </div>

      <div class="arm-card-body">
        <h5 class="arm-card-title">
          Individual Reports
          <i class="bi bi-arrow-right-circle-fill arm-arrow-icon"></i>
        </h5>
        <p class="arm-card-desc">
          Granular participant-level reporting. Drill into individual response logs, submission timelines, pending tasks, and evaluation scores.
        </p>
      </div>

      <div class="arm-card-footer">
        <span class="arm-footer-cta">
          <i class="bi bi-card-checklist"></i>
          View Individual Logs
        </span>
        <span class="arm-footer-chip">
          <i class="bi bi-person"></i> Per Participant
        </span>
      </div>
    </div>

    <!-- Consolidated Response Report Card -->
    <div class="arm-card arm-card-purple">
      <%= link_to consolidated_response_report_institute_admin_reports_path(view: :detailed, date_range: :today), class: "arm-card-link", title: "Open Consolidated Response Report" do %><% end %>

      <div class="arm-card-deco-circle"></div>
      <div class="arm-card-deco-ring"></div>

      <div class="arm-card-top">
        <div class="arm-icon-block arm-icon-purple">
          <i class="bi bi-journals"></i>
        </div>
        <span class="arm-badge arm-badge-purple">
          <i class="bi bi-stack"></i>
          Detailed Log Mode
        </span>
      </div>

      <div class="arm-card-body">
        <h5 class="arm-card-title">
          Consolidated Responses
          <i class="bi bi-arrow-right-circle-fill arm-arrow-icon"></i>
        </h5>
        <p class="arm-card-desc">
          Analyze consolidated participant responses across multiple assignments with multi-select filters, question breakdowns, and Excel exports.
        </p>
      </div>

      <div class="arm-card-footer">
        <span class="arm-footer-cta">
          <i class="bi bi-table"></i>
          View Response Logs
        </span>
        <span class="arm-footer-chip">
          <i class="bi bi-file-earmark-spreadsheet"></i> Excel
        </span>
      </div>
    </div>

    <!-- Question Matrix Report Card -->
    <div class="arm-card arm-card-sky">
      <%= link_to consolidated_matrix_report_institute_admin_reports_path(date_range: :today), class: "arm-card-link", title: "Open Question Matrix Report" do %><% end %>

      <div class="arm-card-deco-circle"></div>
      <div class="arm-card-deco-ring"></div>

      <div class="arm-card-top">
        <div class="arm-icon-block arm-icon-sky">
          <i class="bi bi-grid-3x3-gap-fill"></i>
        </div>
        <span class="arm-badge arm-badge-sky">
          <i class="bi bi-layout-three-columns"></i>
          Pivot Matrix Mode
        </span>
      </div>

      <div class="arm-card-body">
        <h5 class="arm-card-title">
          Question Matrix Report
          <i class="bi bi-arrow-right-circle-fill arm-arrow-icon"></i>
        </h5>
        <p class="arm-card-desc">
          Cross-tabular pivot view with questions as column headers and participant responses side-by-side, with multi-column Excel exports.
        </p>
      </div>

      <div class="arm-card-footer">
        <span class="arm-footer-cta">
          <i class="bi bi-grid-3x3"></i>
          View Question Matrix
        </span>
        <span class="arm-footer-chip">
          <i class="bi bi-distribute-horizontal"></i> Pivot
        </span>
      </div>
    </div>

  </div><!-- /.arm-cards-grid -->
</div><!-- /.arm-page-wrapper -->

<style>
  /* ─── Page Wrapper ─────────────────────────────────────────────────── */
  .arm-page-wrapper {
    padding: 1.5rem 1.75rem 2.5rem;
    /* Enable container queries so grid responds to content-area width,
       not viewport width — this fixes sidebar-expanded breakage */
    container-type: inline-size;
    container-name: arm-wrapper;
  }
  @media (max-width: 767.98px) {
    .arm-page-wrapper { padding: 1rem 1rem 2rem; }
  }

  /* ─── Hero Header ───────────────────────────────────────────────────── */
  .arm-hero {
    background: linear-gradient(135deg, #f0fdf4 0%, #eff6ff 50%, #faf5ff 100%);
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 2rem 2rem 1.75rem;
    margin-bottom: 2rem;
    position: relative;
    overflow: hidden;
  }
  .arm-hero::before {
    content: '';
    position: absolute;
    top: -40px;
    right: -40px;
    width: 220px;
    height: 220px;
    background: radial-gradient(circle, rgba(16,185,129,0.08) 0%, transparent 70%);
    pointer-events: none;
  }
  .arm-hero::after {
    content: '';
    position: absolute;
    bottom: -30px;
    left: 30%;
    width: 160px;
    height: 160px;
    background: radial-gradient(circle, rgba(99,102,241,0.07) 0%, transparent 70%);
    pointer-events: none;
  }
  @media (max-width: 767.98px) {
    .arm-hero { padding: 1.25rem 1.25rem 1.25rem; }
  }

  /* ─── Breadcrumb ────────────────────────────────────────────────────── */
  .arm-breadcrumb {
    font-size: 0.8rem;
  }
  .arm-breadcrumb .breadcrumb-item a {
    color: #64748b;
    text-decoration: none;
    transition: color 0.2s;
  }
  .arm-breadcrumb .breadcrumb-item a:hover { color: #10b981; }
  .arm-breadcrumb .breadcrumb-item.active { color: #94a3b8; }
  .arm-breadcrumb .breadcrumb-item + .breadcrumb-item::before { color: #cbd5e1; }

  /* ─── Hero Title ────────────────────────────────────────────────────── */
  .arm-hero-title {
    font-size: 1.6rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 0.35rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  @media (max-width: 575.98px) {
    .arm-hero-title { font-size: 1.3rem; }
  }
  .arm-title-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: linear-gradient(135deg, #10b981, #059669);
    color: #fff;
    font-size: 1.1rem;
    flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(16,185,129,0.3);
  }
  .arm-hero-subtitle {
    font-size: 0.875rem;
    color: #64748b;
    margin: 0;
    line-height: 1.55;
  }

  /* ─── Back Button ───────────────────────────────────────────────────── */
  .arm-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.1rem;
    border: 1.5px solid #cbd5e1;
    border-radius: 50px;
    background: #ffffff;
    color: #475569;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    white-space: nowrap;
    box-shadow: 0 1px 4px rgba(15,23,42,0.06);
  }
  .arm-back-btn i { font-size: 1.05rem; color: #94a3b8; transition: color 0.2s, transform 0.2s; }
  .arm-back-btn:hover {
    border-color: #10b981;
    color: #065f46;
    background: #f0fdf4;
    box-shadow: 0 3px 10px rgba(16,185,129,0.15);
  }
  .arm-back-btn:hover i { color: #10b981; transform: translateX(-2px); }

  /* ─── Cards Grid ────────────────────────────────────────────────────── */
  .arm-cards-grid {
    display: grid;
    /* Default: 4 columns for wide content areas */
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  /* Container query: drop to 2 columns when content area ≤ 920px
     (triggers when sidebar is expanded on mid-size screens) */
  @container arm-wrapper (max-width: 920px) {
    .arm-cards-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @container arm-wrapper (max-width: 520px) {
    .arm-cards-grid { grid-template-columns: 1fr; gap: 1rem; }
  }

  /* Viewport-based fallback for browsers without container query support */
  @supports not (container-type: inline-size) {
    @media (max-width: 1199.98px) {
      .arm-cards-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 575.98px) {
      .arm-cards-grid { grid-template-columns: 1fr; gap: 1rem; }
    }
  }

  /* ─── Card Base ─────────────────────────────────────────────────────── */
  .arm-card {
    position: relative;
    background: #ffffff;
    border: 1.5px solid #e8edf4;
    border-radius: 20px;
    padding: 1.6rem 1.5rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    overflow: hidden;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
                box-shadow 0.3s ease,
                border-color 0.3s ease;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
  }
  @media (max-width: 767.98px) {
    .arm-card { padding: 1.25rem 1.2rem; gap: 0.9rem; }
  }

  .arm-card-link {
    position: absolute;
    inset: 0;
    z-index: 10;
    border-radius: 20px;
  }

  /* ─── Decorative elements ───────────────────────────────────────────── */
  .arm-card-deco-circle {
    position: absolute;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    bottom: -35px;
    right: -35px;
    opacity: 0.06;
    transition: opacity 0.3s, transform 0.4s;
    pointer-events: none;
  }
  .arm-card-deco-ring {
    position: absolute;
    width: 70px;
    height: 70px;
    border-radius: 50%;
    border: 14px solid currentColor;
    top: -18px;
    right: 55px;
    opacity: 0.05;
    pointer-events: none;
    transition: opacity 0.3s;
  }
  .arm-card:hover .arm-card-deco-circle {
    opacity: 0.12;
    transform: scale(1.1);
  }
  .arm-card:hover .arm-card-deco-ring { opacity: 0.09; }

  /* Emerald */
  .arm-card-emerald .arm-card-deco-circle { background: #10b981; }
  .arm-card-emerald .arm-card-deco-ring  { color: #10b981; }
  /* Indigo */
  .arm-card-indigo  .arm-card-deco-circle { background: #6366f1; }
  .arm-card-indigo  .arm-card-deco-ring  { color: #6366f1; }
  /* Purple */
  .arm-card-purple  .arm-card-deco-circle { background: #a855f7; }
  .arm-card-purple  .arm-card-deco-ring  { color: #a855f7; }
  /* Sky */
  .arm-card-sky     .arm-card-deco-circle { background: #0ea5e9; }
  .arm-card-sky     .arm-card-deco-ring  { color: #0ea5e9; }

  /* ─── Card Hover States ─────────────────────────────────────────────── */
  .arm-card:hover { transform: translateY(-6px) scale(1.01); }

  .arm-card-emerald:hover { box-shadow: 0 16px 36px rgba(16,185,129,0.18); border-color: #6ee7b7; }
  .arm-card-indigo:hover  { box-shadow: 0 16px 36px rgba(99,102,241,0.18); border-color: #a5b4fc; }
  .arm-card-purple:hover  { box-shadow: 0 16px 36px rgba(168,85,247,0.18); border-color: #d8b4fe; }
  .arm-card-sky:hover     { box-shadow: 0 16px 36px rgba(14,165,233,0.18); border-color: #7dd3fc; }

  /* ─── Card Top Row ──────────────────────────────────────────────────── */
  .arm-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    flex-wrap: wrap; /* allow badge to wrap below icon on very narrow cards */
  }

  /* ─── Icon Block ────────────────────────────────────────────────────── */
  .arm-icon-block {
    width: 58px;
    height: 58px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.65rem;
    flex-shrink: 0;
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @media (max-width: 575.98px) {
    .arm-icon-block { width: 50px; height: 50px; font-size: 1.45rem; border-radius: 14px; }
  }
  .arm-card:hover .arm-icon-block { transform: scale(1.12) rotate(-6deg); }

  .arm-icon-emerald {
    background: linear-gradient(135deg, #34d399 0%, #059669 100%);
    color: #fff;
    box-shadow: 0 6px 18px rgba(16,185,129,0.35);
  }
  .arm-icon-indigo {
    background: linear-gradient(135deg, #818cf8 0%, #4f46e5 100%);
    color: #fff;
    box-shadow: 0 6px 18px rgba(99,102,241,0.35);
  }
  .arm-icon-purple {
    background: linear-gradient(135deg, #c084fc 0%, #7e22ce 100%);
    color: #fff;
    box-shadow: 0 6px 18px rgba(168,85,247,0.35);
  }
  .arm-icon-sky {
    background: linear-gradient(135deg, #38bdf8 0%, #0284c7 100%);
    color: #fff;
    box-shadow: 0 6px 18px rgba(14,165,233,0.35);
  }

  /* ─── Badges ────────────────────────────────────────────────────────── */
  .arm-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.3rem 0.75rem;
    border-radius: 50px;
    white-space: nowrap;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    /* Safety net: never clip beyond its own padding box */
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .arm-badge i { font-size: 0.78rem; flex-shrink: 0; }

  .arm-badge-emerald { background: #ecfdf5; color: #065f46; border: 1.5px solid #a7f3d0; }
  .arm-badge-indigo  { background: #eef2ff; color: #3730a3; border: 1.5px solid #c7d2fe; }
  .arm-badge-purple  { background: #faf5ff; color: #6b21a8; border: 1.5px solid #e9d5ff; }
  .arm-badge-sky     { background: #f0f9ff; color: #075985; border: 1.5px solid #bae6fd; }

  /* ─── Card Body ─────────────────────────────────────────────────────── */
  .arm-card-body { flex: 1; }

  .arm-card-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 0.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  @media (max-width: 575.98px) {
    .arm-card-title { font-size: 1rem; }
  }

  .arm-arrow-icon {
    font-size: 1.3rem;
    flex-shrink: 0;
    transition: transform 0.3s ease, opacity 0.3s;
    opacity: 0.4;
  }
  .arm-card:hover .arm-arrow-icon { transform: translateX(5px); opacity: 1; }

  .arm-card-emerald .arm-arrow-icon { color: #059669; }
  .arm-card-indigo  .arm-arrow-icon { color: #4f46e5; }
  .arm-card-purple  .arm-arrow-icon { color: #7e22ce; }
  .arm-card-sky     .arm-arrow-icon { color: #0284c7; }

  .arm-card-desc {
    font-size: 0.835rem;
    color: #64748b;
    margin: 0;
    line-height: 1.65;
  }

  /* ─── Card Footer ───────────────────────────────────────────────────── */
  .arm-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-top: 0.9rem;
    border-top: 1.5px solid #f1f5f9;
    flex-wrap: wrap;
  }

  .arm-footer-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    transition: gap 0.2s;
  }
  .arm-card:hover .arm-footer-cta { gap: 0.55rem; }

  .arm-card-emerald .arm-footer-cta { color: #059669; }
  .arm-card-indigo  .arm-footer-cta { color: #4f46e5; }
  .arm-card-purple  .arm-footer-cta { color: #7e22ce; }
  .arm-card-sky     .arm-footer-cta { color: #0284c7; }

  .arm-footer-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: #94a3b8;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 50px;
    padding: 0.2rem 0.6rem;
  }
  .arm-footer-chip i { font-size: 0.75rem; }
</style>