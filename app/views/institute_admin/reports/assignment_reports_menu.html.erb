<div class="container-fluid px-4 py-4">
  <!-- Modern Header & Breadcrumb Bar -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <nav aria-label="breadcrumb" class="mb-2">
        <ol class="breadcrumb breadcrumb-modern mb-0">
          <li class="breadcrumb-item">
            <%= link_to institute_admin_root_path do %>
              <i class="bi bi-house-door"></i>
            <% end %>
          </li>
          <li class="breadcrumb-item"><%= link_to "Reports", institute_admin_reports_path %></li>
          <li class="breadcrumb-item active" aria-current="page">Assignment Reports</li>
        </ol>
      </nav>
      <h3 class="fw-bold text-dark mb-1">Assignment Performance Hub</h3>
      <p class="text-muted small mb-0">Select a report module to analyze section aggregations or individual participant submissions.</p>
    </div>

    <div>
      <%= link_to institute_admin_reports_path, class: "btn btn-outline-secondary d-inline-flex align-items-center gap-2 rounded-3 px-3 py-2 fw-medium shadow-sm" do %>
        <i class="bi bi-arrow-left"></i>
        <span>Back to Reports</span>
      <% end %>
    </div>
  </div>

  <!-- Modern Interactive Report Cards Grid -->
  <div class="row g-4 mt-1">
    <!-- Section-wise Reports Card -->
    <div class="col-12 col-md-6 col-xl-3">
      <div class="report-menu-card card-emerald">
        <%= link_to assignment_reports_institute_admin_reports_path, class: "card-overlay-link", title: "Open Section-wise Reports" do %><% end %>
        
        <div class="d-flex align-items-start justify-content-between mb-3">
          <div class="report-icon-wrapper icon-emerald">
            <i class="bi bi-people-fill"></i>
          </div>
          <span class="badge badge-emerald rounded-pill px-3 py-1.5 fw-semibold">
            <i class="bi bi-diagram-3-fill me-1"></i> Section Mode
          </span>
        </div>

        <div class="report-card-content">
          <h5 class="fw-bold text-dark mb-2 d-flex align-items-center justify-content-between">
            <span>Section-wise Reports</span>
            <i class="bi bi-arrow-right action-arrow text-emerald"></i>
          </h5>
          <p class="text-muted small mb-0 leading-relaxed">
            Comprehensive overview of assignment performance grouped by class sections. Monitor section submission metrics and completion rates.
          </p>
        </div>

        <div class="report-card-footer mt-4 pt-3 border-top d-flex align-items-center justify-content-between">
          <span class="text-emerald fw-semibold small d-inline-flex align-items-center gap-1">
            <i class="bi bi-graph-up-arrow"></i> View Section Analytics
          </span>
          <i class="bi bi-chevron-right text-muted small"></i>
        </div>
      </div>
    </div>

    <!-- Individual Reports Card -->
    <div class="col-12 col-md-6 col-xl-3">
      <div class="report-menu-card card-indigo">
        <%= link_to individual_assignment_reports_institute_admin_reports_path, class: "card-overlay-link", title: "Open Individual Assignment Reports" do %><% end %>
        
        <div class="d-flex align-items-start justify-content-between mb-3">
          <div class="report-icon-wrapper icon-indigo">
            <i class="bi bi-person-badge-fill"></i>
          </div>
          <span class="badge badge-indigo rounded-pill px-3 py-1.5 fw-semibold">
            <i class="bi bi-person-lines-fill me-1"></i> Individual Mode
          </span>
        </div>

        <div class="report-card-content">
          <h5 class="fw-bold text-dark mb-2 d-flex align-items-center justify-content-between">
            <span>Individual Reports</span>
            <i class="bi bi-arrow-right action-arrow text-indigo"></i>
          </h5>
          <p class="text-muted small mb-0 leading-relaxed">
            Granular participant-level reporting. Drill down into individual response logs, submission dates, pending tasks, and evaluation scores.
          </p>
        </div>

        <div class="report-card-footer mt-4 pt-3 border-top d-flex align-items-center justify-content-between">
          <span class="text-indigo fw-semibold small d-inline-flex align-items-center gap-1">
            <i class="bi bi-card-checklist"></i> View Individual Logs
          </span>
          <i class="bi bi-chevron-right text-muted small"></i>
        </div>
      </div>
    </div>

    <!-- Consolidated Response Report Card -->
    <div class="col-12 col-md-6 col-xl-3">
      <div class="report-menu-card card-purple">
        <%= link_to consolidated_response_report_institute_admin_reports_path(view: :detailed, date_range: :today), class: "card-overlay-link", title: "Open Consolidated Response Report" do %><% end %>
        
        <div class="d-flex align-items-start justify-content-between mb-3">
          <div class="report-icon-wrapper icon-purple">
            <i class="bi bi-collection-fill"></i>
          </div>
          <span class="badge badge-purple rounded-pill px-3 py-1.5 fw-semibold">
            <i class="bi bi-layers-fill me-1"></i> Detailed Log Mode
          </span>
        </div>

        <div class="report-card-content">
          <h5 class="fw-bold text-dark mb-2 d-flex align-items-center justify-content-between">
            <span>Consolidated Responses</span>
            <i class="bi bi-arrow-right action-arrow text-purple"></i>
          </h5>
          <p class="text-muted small mb-0 leading-relaxed">
            Analyze consolidated participant responses across multiple assignments with multi-select filters, question breakdowns, and Excel downloads.
          </p>
        </div>

        <div class="report-card-footer mt-4 pt-3 border-top d-flex align-items-center justify-content-between">
          <span class="text-purple fw-semibold small d-inline-flex align-items-center gap-1">
            <i class="bi bi-table"></i> View Response Logs
          </span>
          <i class="bi bi-chevron-right text-muted small"></i>
        </div>
      </div>
    </div>

    <!-- Consolidated Question Matrix Report Card -->
    <div class="col-12 col-md-6 col-xl-3">
      <div class="report-menu-card card-sky">
        <%= link_to consolidated_matrix_report_institute_admin_reports_path(date_range: :today), class: "card-overlay-link", title: "Open Question Matrix Report" do %><% end %>
        
        <div class="d-flex align-items-start justify-content-between mb-3">
          <div class="report-icon-wrapper icon-sky">
            <i class="bi bi-grid-3x3-gap-fill"></i>
          </div>
          <span class="badge badge-sky rounded-pill px-3 py-1.5 fw-semibold">
            <i class="bi bi-layout-three-columns me-1"></i> Pivot Matrix Mode
          </span>
        </div>

        <div class="report-card-content">
          <h5 class="fw-bold text-dark mb-2 d-flex align-items-center justify-content-between">
            <span>Question Matrix Report</span>
            <i class="bi bi-arrow-right action-arrow text-sky"></i>
          </h5>
          <p class="text-muted small mb-0 leading-relaxed">
            Cross-tabular pivot view with questions as column headers and participant responses side-by-side with multi-column Excel exports.
          </p>
        </div>

        <div class="report-card-footer mt-4 pt-3 border-top d-flex align-items-center justify-content-between">
          <span class="text-sky fw-semibold small d-inline-flex align-items-center gap-1">
            <i class="bi bi-grid-3x3"></i> View Question Matrix
          </span>
          <i class="bi bi-chevron-right text-muted small"></i>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Base Glassmorphic Card Container */
  .report-menu-card {
    position: relative;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 1.75rem;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.03);
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    overflow: hidden;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .card-overlay-link {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 5;
  }

  .report-menu-card:hover {
    transform: translateY(-5px) scale(1.01);
    border-color: #cbd5e1;
  }

  /* Emerald Variant (Section-wise) */
  .card-emerald:hover {
    box-shadow: 0 12px 28px rgba(16, 185, 129, 0.15);
    border-color: #a7f3d0;
  }

  .icon-emerald {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    color: #ffffff;
    box-shadow: 0 6px 16px rgba(16, 185, 129, 0.3);
  }

  .badge-emerald {
    background-color: #ecfdf5;
    color: #047857;
    border: 1px solid #a7f3d0;
  }

  .text-emerald {
    color: #059669 !important;
  }

  /* Indigo Variant (Individual) */
  .card-indigo:hover {
    box-shadow: 0 12px 28px rgba(99, 102, 241, 0.15);
    border-color: #c7d2fe;
  }

  .icon-indigo {
    background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
    color: #ffffff;
    box-shadow: 0 6px 16px rgba(99, 102, 241, 0.3);
  }

  .badge-indigo {
    background-color: #eef2ff;
    color: #4338ca;
    border: 1px solid #c7d2fe;
  }

  .text-indigo {
    color: #4f46e5 !important;
  }

  /* Purple Variant (Consolidated) */
  .card-purple:hover {
    box-shadow: 0 12px 28px rgba(168, 85, 247, 0.18);
    border-color: #e9d5ff;
  }

  .icon-purple {
    background: linear-gradient(135deg, #a855f7 0%, #7e22ce 100%);
    color: #ffffff;
    box-shadow: 0 6px 16px rgba(168, 85, 247, 0.3);
  }

  .badge-purple {
    background-color: #faf5ff;
    color: #7e22ce;
    border: 1px solid #e9d5ff;
  }

  .text-purple {
    color: #7e22ce !important;
  }

  /* Sky / Teal Variant (Question Matrix) */
  .card-sky:hover {
    box-shadow: 0 12px 28px rgba(14, 165, 233, 0.18);
    border-color: #bae6fd;
  }

  .icon-sky {
    background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
    color: #ffffff;
    box-shadow: 0 6px 16px rgba(14, 165, 233, 0.3);
  }

  .badge-sky {
    background-color: #f0f9ff;
    color: #0369a1;
    border: 1px solid #bae6fd;
  }

  .text-sky {
    color: #0284c7 !important;
  }

  /* Icon Wrapper */
  .report-icon-wrapper {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .report-menu-card:hover .report-icon-wrapper {
    transform: scale(1.1) rotate(-5deg);
  }

  /* Animated Arrow */
  .action-arrow {
    font-size: 1.25rem;
    transition: transform 0.3s ease;
  }

  .report-menu-card:hover .action-arrow {
    transform: translateX(6px);
  }

  .report-card-footer {
    border-color: #f1f5f9 !important;
  }

  .leading-relaxed {
    line-height: 1.6;
  }
</style> 