  var currentMatrixPage = <%= (@pagy ? @pagy.page : 1) %>;
  var hasMoreMatrixPages = <%= (@pagy ? (@pagy.page < @pagy.pages) : false) %>;
  var isMatrixLoading = false;
  var matrixScrollObserver = null;

  function initMatrixScrollPagination() {
    const sentinel = document.getElementById('infiniteScrollSentinel');
    const scrollContainer = document.getElementById('matrixScrollContainer');

    if (!sentinel) return;

    if ('IntersectionObserver' in window) {
      if (matrixScrollObserver) matrixScrollObserver.disconnect();

      matrixScrollObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting && hasMoreMatrixPages && !isMatrixLoading) {
            loadNextMatrixPage();
          }
        });
      }, {
        root: null, // window or viewport
        rootMargin: '250px',
        threshold: 0.1
      });

      matrixScrollObserver.observe(sentinel);
    }

    // Also listen to internal container scroll
    if (scrollContainer) {
      scrollContainer.addEventListener('scroll', () => {
        if (!hasMoreMatrixPages || isMatrixLoading) return;
        const scrollBottom = scrollContainer.scrollHeight - scrollContainer.scrollTop - scrollContainer.clientHeight;
        if (scrollBottom < 200) {
          loadNextMatrixPage();
        }
      });
    }
  }

  function loadNextMatrixPage() {
    if (isMatrixLoading || !hasMoreMatrixPages) return;

    isMatrixLoading = true;
    const nextPage = currentMatrixPage + 1;
    const loadingIndicator = document.getElementById('scrollLoadingIndicator');
    const loadMoreBtn = document.getElementById('manualLoadMoreBtn');

    if (loadingIndicator) loadingIndicator.classList.remove('d-none');
    if (loadMoreBtn) loadMoreBtn.classList.add('d-none');

    // Build URL with current query parameters
    const form = document.getElementById('consolidatedMatrixReportForm');
    const formData = new FormData(form || undefined);
    const searchParams = new URLSearchParams(formData);
    searchParams.set('page', nextPage);
    searchParams.set('scroll', '1');

    fetch(`/institute_admin/reports/consolidated_matrix_report?${searchParams.toString()}`, {
      headers: {
        'Accept': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      }
    })
    .then(res => res.json())
    .then(data => {
      isMatrixLoading = false;
      if (loadingIndicator) loadingIndicator.classList.add('d-none');

      if (data.html && data.html.trim().length > 0) {
        const tbody = document.getElementById('matrixTableBody');
        if (tbody) {
          // Check if noRecordsRow is present and remove it
          const noRec = document.getElementById('noRecordsRow');
          if (noRec) noRec.remove();

          tbody.insertAdjacentHTML('beforeend', data.html);
        }

        currentMatrixPage = data.page;
        hasMoreMatrixPages = data.has_more;

        // Update counters
        const loadedEl = document.getElementById('matrixLoadedCount');
        const footerLoadedEl = document.getElementById('footerLoadedCount');
        if (loadedEl) loadedEl.innerText = data.loaded_count;
        if (footerLoadedEl) footerLoadedEl.innerText = data.loaded_count;

        if (hasMoreMatrixPages) {
          if (loadMoreBtn) loadMoreBtn.classList.remove('d-none');
        } else {
          if (loadMoreBtn) loadMoreBtn.classList.add('d-none');
          const allLoadedMsg = document.getElementById('allLoadedMessage');
          if (allLoadedMsg) allLoadedMsg.classList.remove('d-none');
          if (matrixScrollObserver) matrixScrollObserver.disconnect();
        }
      } else {
        hasMoreMatrixPages = false;
        if (loadMoreBtn) loadMoreBtn.classList.add('d-none');
        const allLoadedMsg = document.getElementById('allLoadedMessage');
        if (allLoadedMsg) allLoadedMsg.classList.remove('d-none');
      }
    })
    .catch(err => {
      console.error('Error fetching next matrix page:', err);
      isMatrixLoading = false;
      if (loadingIndicator) loadingIndicator.classList.add('d-none');
      if (loadMoreBtn) loadMoreBtn.classList.remove('d-none');
    });
  }

  // =========================================================
  // FULL SCREEN TABLE ENGINE
  // =========================================================
  window.toggleTableFullscreen = function() {
    const card = document.getElementById('matrixTableCard');
    if (!card) return;
    const btn = document.getElementById('toggleFullscreenBtn');
    const btnText = document.getElementById('fullscreenBtnText');
    const btnIcon = document.getElementById('fullscreenIcon');
    const hasFsClass = card.classList.contains('table-card-fullscreen');
    const hasNativeFs = Boolean(document.fullscreenElement || document.webkitFullscreenElement || document.mozFullScreenElement || document.msFullscreenElement);
    const isCurrentlyFullscreen = hasFsClass || hasNativeFs;

    if (!isCurrentlyFullscreen) {
      // Enter Fullscreen: CSS Viewport expansion + Native Fullscreen API
      card.classList.add('table-card-fullscreen');
      document.body.style.overflow = 'hidden';
      if (btn) btn.classList.add('is-active-fullscreen');
      if (btnText) btnText.innerText = 'Exit Full Screen';
      if (btnIcon) btnIcon.className = 'bi bi-fullscreen-exit';

      const requestFs = card.requestFullscreen || card.webkitRequestFullscreen || card.mozRequestFullScreen || card.msRequestFullscreen;
      if (requestFs) {
        try {
          const res = requestFs.call(card);
          if (res && typeof res.catch === 'function') {
            res.catch(() => {});
          }
        } catch (e) {}
      }
    } else {
      // Exit Fullscreen
      window.exitTableFullscreen();
    }
  };

  window.exitTableFullscreen = function() {
    const card = document.getElementById('matrixTableCard');
    const btn = document.getElementById('toggleFullscreenBtn');
    const btnText = document.getElementById('fullscreenBtnText');
    const btnIcon = document.getElementById('fullscreenIcon');

    if (card) card.classList.remove('table-card-fullscreen');
    document.body.style.removeProperty('overflow');
    if (btn) btn.classList.remove('is-active-fullscreen');
    if (btnText) btnText.innerText = 'Full Screen';
    if (btnIcon) btnIcon.className = 'bi bi-arrows-fullscreen';

    const hasNativeFs = Boolean(document.fullscreenElement || document.webkitFullscreenElement || document.mozFullScreenElement || document.msFullscreenElement);
    if (hasNativeFs) {
      try {
        const exitFs = document.exitFullscreen || document.webkitExitFullscreen || document.mozCancelFullScreen || document.msExitFullscreen;
        if (exitFs) {
          const res = exitFs.call(document);
          if (res && typeof res.catch === 'function') {
            res.catch(() => {});
          }
        }
      } catch (e) {}
    }
  };

  // Safe global event listeners (registered only once across Turbo visits)
  if (!window._reportsFullscreenListenersAttached) {
    window._reportsFullscreenListenersAttached = true;

    const onFullscreenChange = function() {
      const isNativeFs = Boolean(document.fullscreenElement || document.webkitFullscreenElement || document.mozFullScreenElement || document.msFullscreenElement);
      if (!isNativeFs) {
        if (typeof window.exitTableFullscreen === 'function') window.exitTableFullscreen();
        if (typeof window.exitResponseTableFullscreen === 'function') window.exitResponseTableFullscreen();
      }
    };

    document.addEventListener('fullscreenchange', onFullscreenChange);
    document.addEventListener('webkitfullscreenchange', onFullscreenChange);
    document.addEventListener('mozfullscreenchange', onFullscreenChange);
    document.addEventListener('MSFullscreenChange', onFullscreenChange);

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' || e.key === 'Esc') {
        if (typeof window.exitTableFullscreen === 'function') window.exitTableFullscreen();
        if (typeof window.exitResponseTableFullscreen === 'function') window.exitResponseTableFullscreen();
      }
    });
  }

  // =========================================================
  // MULTI-SELECT DROPDOWN HELPERS
  // =========================================================
  function filterDropdownList(input) {
    const term = input.value.toLowerCase().trim();
    const dropdownMenu = input.closest('.dropdown-menu');
    const items = dropdownMenu.querySelectorAll('.multiselect-item');
    items.forEach(item => {
      const text = item.textContent.toLowerCase();
      const isMatch = !term || text.includes(term);
      if (isMatch) {
        item.classList.remove('d-none', 'is-hidden');
        item.style.setProperty('display', 'flex', 'important');
        item.hidden = false;
      } else {
        item.classList.add('d-none', 'is-hidden');
        item.style.setProperty('display', 'none', 'important');
        item.hidden = true;
      }
    });
  }

  // Question Filter Date Filter state & logic
  function selectQuestionDatePill(btn, range) {
    const dropdownMenu = btn.closest('.dropdown-menu');
    if (!dropdownMenu) return;

    dropdownMenu.querySelectorAll('.q-date-pill').forEach(p => p.classList.remove('active'));
    btn.classList.add('active');

    const customRow = dropdownMenu.querySelector('.q-custom-date-row');
    if (customRow) {
      if (range === 'custom') {
        customRow.classList.remove('d-none');
        customRow.classList.add('d-flex');
        const fromInput = customRow.querySelector('.q-custom-from');
        const toInput = customRow.querySelector('.q-custom-to');
        const todayStr = dropdownMenu.dataset.today || new Date().toISOString().slice(0, 10);
        if (toInput && !toInput.value) toInput.value = todayStr;
        if (fromInput && !fromInput.value) {
          const parts = todayStr.split('-').map(Number);
          const d = (parts.length === 3) ? new Date(parts[0], parts[1] - 1, parts[2]) : new Date();
          d.setDate(d.getDate() - 7);
          const ym = String(d.getMonth() + 1).padStart(2, '0');
          const yd = String(d.getDate()).padStart(2, '0');
          fromInput.value = `${d.getFullYear()}-${ym}-${yd}`;
        }
      } else {
        customRow.classList.add('d-none');
        customRow.classList.remove('d-flex');
      }
    }

    applyQuestionFilters(dropdownMenu, true);
  }

  function onQuestionCustomDateChange(input) {
    const dropdownMenu = input.closest('.dropdown-menu');
    if (!dropdownMenu) return;
    applyQuestionFilters(dropdownMenu, true);
  }

  function resetQuestionDateFilter(btn) {
    const dropdownMenu = btn.closest('.dropdown-menu');
    if (!dropdownMenu) return;

    const allPill = dropdownMenu.querySelector('.q-date-pill[data-date-range="all"]');
    if (allPill) {
      dropdownMenu.querySelectorAll('.q-date-pill').forEach(p => p.classList.remove('active'));
      allPill.classList.add('active');
    }

    const customRow = dropdownMenu.querySelector('.q-custom-date-row');
    if (customRow) {
      customRow.classList.add('d-none');
      customRow.classList.remove('d-flex');
      const fromInput = customRow.querySelector('.q-custom-from');
      const toInput = customRow.querySelector('.q-custom-to');
      if (fromInput) fromInput.value = '';
      if (toInput) toInput.value = '';
    }

    applyQuestionFilters(dropdownMenu, true);
  }

  function filterQuestionsWithDateAndSearch(input) {
    const dropdownMenu = input.closest('.dropdown-menu');
    if (!dropdownMenu) return;
    applyQuestionFilters(dropdownMenu, false);
  }

  function applyQuestionFilters(dropdownMenu, syncCheckboxes = false) {
    const searchInput = dropdownMenu.querySelector('.multiselect-search');
    const term = searchInput ? searchInput.value.toLowerCase().trim() : '';

    const activePill = dropdownMenu.querySelector('.q-date-pill.active');
    const range = activePill ? activePill.dataset.dateRange : 'all';

    const todayStr = dropdownMenu.dataset.today || (function() {
      const now = new Date();
      return `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
    })();

    const yesterdayStr = dropdownMenu.dataset.yesterday || (function() {
      const parts = todayStr.split('-').map(Number);
      const d = (parts.length === 3) ? new Date(parts[0], parts[1] - 1, parts[2]) : new Date();
      d.setDate(d.getDate() - 1);
      return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    })();

    let startDate = '';
    let endDate = '';

    const parts = todayStr.split('-').map(Number);
    const baseDate = (parts.length === 3) ? new Date(parts[0], parts[1] - 1, parts[2]) : new Date();

    if (range === 'today') {
      startDate = todayStr;
      endDate = todayStr;
    } else if (range === 'yesterday') {
      startDate = yesterdayStr;
      endDate = yesterdayStr;
    } else if (range === 'last_7_days') {
      const d7 = new Date(baseDate);
      d7.setDate(baseDate.getDate() - 6);
      startDate = `${d7.getFullYear()}-${String(d7.getMonth() + 1).padStart(2, '0')}-${String(d7.getDate()).padStart(2, '0')}`;
      endDate = todayStr;
    } else if (range === 'this_month') {
      const dMonth = new Date(baseDate.getFullYear(), baseDate.getMonth(), 1);
      startDate = `${dMonth.getFullYear()}-${String(dMonth.getMonth() + 1).padStart(2, '0')}-${String(dMonth.getDate()).padStart(2, '0')}`;
      endDate = todayStr;
    } else if (range === 'custom') {
      const fromInput = dropdownMenu.querySelector('.q-custom-from');
      const toInput = dropdownMenu.querySelector('.q-custom-to');
      startDate = fromInput ? fromInput.value : '';
      endDate = toInput ? toInput.value : '';
    }

    const items = dropdownMenu.querySelectorAll('.multiselect-item');
    let visibleCount = 0;
    const totalCount = items.length;

    items.forEach(item => {
      const text = item.textContent.toLowerCase();
      const matchesSearch = !term || text.includes(term);

      let matchesDate = true;
      if (range !== 'all') {
        const datesStr = item.dataset.dates || '';
        const dates = datesStr.split(',').map(s => s.trim()).filter(Boolean);
        if (dates.length === 0) {
          matchesDate = false;
        } else {
          matchesDate = dates.some(d => {
            if (startDate && d < startDate) return false;
            if (endDate && d > endDate) return false;
            return true;
          });
        }
      }

      const isVisible = matchesSearch && matchesDate;
      const cb = item.querySelector('input[type="checkbox"]');

      if (isVisible) {
        item.classList.remove('d-none', 'is-hidden');
        item.style.setProperty('display', 'flex', 'important');
        item.hidden = false;
        visibleCount++;
        if (syncCheckboxes && cb) {
          cb.checked = true;
        }
      } else {
        item.classList.add('d-none', 'is-hidden');
        item.style.setProperty('display', 'none', 'important');
        item.hidden = true;
        if (syncCheckboxes && cb) {
          cb.checked = false;
        }
      }
    });

    const showingCountEl = dropdownMenu.querySelector('.q-showing-count');
    if (showingCountEl) {
      showingCountEl.textContent = `Showing ${visibleCount} of ${totalCount}`;
    }

    if (syncCheckboxes) {
      updateDropdownCounter('qLabel', 'Questions', 'question_ids[]');
    }
  }

  function selectAllDropdownCheckboxes(btn, selectAll, labelId, prefix, inputName) {
    const dropdownMenu = btn.closest('.dropdown-menu');
    if (!dropdownMenu) return;
    const checkboxes = dropdownMenu.querySelectorAll(`.multiselect-options-list input[name="${inputName}"]`);
    
    if (selectAll) {
      checkboxes.forEach(cb => {
        const itemWrapper = cb.closest('.multiselect-item');
        const isVisible = itemWrapper && !itemWrapper.hidden && !itemWrapper.classList.contains('d-none') && !itemWrapper.classList.contains('is-hidden') && !itemWrapper.style.display.includes('none');
        if (isVisible) {
          cb.checked = true;
        } else {
          cb.checked = false;
        }
      });
    } else {
      checkboxes.forEach(cb => {
        cb.checked = false;
      });
    }
    updateDropdownCounter(labelId, prefix, inputName);
  }

  function updateDropdownCounter(labelId, prefix, inputName) {
    if (!inputName) return;
    const checkedBoxes = document.querySelectorAll(`input[name="${inputName}"]:checked`);
    const allBoxes = document.querySelectorAll(`input[name="${inputName}"]`);
    const labelEl = document.getElementById(labelId);
    if (!labelEl) return;

    const btn = labelEl.closest('.filter-dropdown-btn');

    if (checkedBoxes.length === 0 || checkedBoxes.length === allBoxes.length) {
      labelEl.innerText = `${prefix} (All)`;
      if (btn) btn.classList.remove('filter-active');
    } else {
      labelEl.innerText = `${prefix} (${checkedBoxes.length})`;
      if (btn) btn.classList.add('filter-active');
    }
  }

  function updateTypeCounter() {
    const checked = document.querySelectorAll('input[name="participant_types[]"]:checked');
    const labelEl = document.getElementById('typeLabel');
    if (!labelEl) return;

    const btn = labelEl.closest('.filter-dropdown-btn');

    if (checked.length === 0 || checked.length === 3) {
      labelEl.innerText = 'Type (All)';
      if (btn) btn.classList.remove('filter-active');
    } else {
      const types = Array.from(checked).map(c => c.value.charAt(0).toUpperCase() + c.value.slice(1)).join(', ');
      labelEl.innerText = `Type (${types})`;
      if (btn) btn.classList.add('filter-active');
    }
  }

  function updateStatusCounter() {
    const checked = document.querySelectorAll('input[name="submission_statuses[]"]:checked');
    const labelEl = document.getElementById('statusLabel');
    if (!labelEl) return;

    const btn = labelEl.closest('.filter-dropdown-btn');

    if (checked.length === 1 && checked[0].value === 'submitted') {
      labelEl.innerText = 'Status (Submitted)';
      if (btn) btn.classList.remove('filter-active');
    } else if (checked.length === 0 || checked.length === 2) {
      labelEl.innerText = 'Status (All)';
      if (btn) btn.classList.add('filter-active');
    } else {
      const val = checked[0].value === 'submitted' ? 'Submitted' : 'Pending';
      labelEl.innerText = `Status (${val})`;
      if (btn) btn.classList.add('filter-active');
    }
  }

  function toggleResponseReadMore(elementId, btn) {
    const el = document.getElementById(elementId);
    if (!el) return;
    const isClamped = el.classList.contains('clamped-text');
    const label = btn.querySelector('.toggle-label');
    const icon = btn.querySelector('.toggle-icon');

    if (isClamped) {
      el.classList.remove('clamped-text');
      if (label) label.innerText = 'Show less';
      if (icon) {
        icon.classList.remove('bi-chevron-down');
        icon.classList.add('bi-chevron-up');
      }
    } else {
      el.classList.add('clamped-text');
      if (label) label.innerText = 'Read more';
      if (icon) {
        icon.classList.remove('bi-chevron-up');
        icon.classList.add('bi-chevron-down');
      }
    }
  }

  function toggleMatrixCustomDates(val) {
    const row = document.getElementById('matrixCustomDateRow');
    if (!row) return;
    if (val === 'custom') {
      row.classList.remove('d-none');
    } else {
      row.classList.add('d-none');
    }
  }

  // =========================================================
  // ASYNC EXPORT ENGINE
  // =========================================================
  function showAsyncModal() {
    const modalElement = document.getElementById('asyncExportModal');
    if (!modalElement) return;
    if (window.bootstrap && window.bootstrap.Modal) {
      try {
        const modal = bootstrap.Modal.getInstance(modalElement) || new bootstrap.Modal(modalElement);
        modal.show();
        return;
      } catch (e) { console.warn('Bootstrap modal fallback', e); }
    }
    modalElement.classList.add('show');
    modalElement.style.display = 'block';
    document.body.classList.add('modal-open');
    let backdrop = document.getElementById('customModalBackdrop');
    if (!backdrop) {
      backdrop = document.createElement('div');
      backdrop.id = 'customModalBackdrop';
      backdrop.className = 'modal-backdrop fade show';
      document.body.appendChild(backdrop);
    }
  }

  function hideAsyncModal() {
    const modalElement = document.getElementById('asyncExportModal');
    if (!modalElement) return;
    if (window.bootstrap && window.bootstrap.Modal) {
      try {
        const modal = bootstrap.Modal.getInstance(modalElement);
        if (modal) modal.hide();
      } catch (e) { /* ignore */ }
    }
    modalElement.classList.remove('show');
    modalElement.style.display = 'none';
    document.body.classList.remove('modal-open');
    const backdrop = document.getElementById('customModalBackdrop');
    if (backdrop) backdrop.remove();
  }

  function minimizeAsyncModal() {
    hideAsyncModal();
    const widget = document.getElementById('minimizedProgressWidget');
    if (widget) widget.classList.remove('d-none');
  }

  function maximizeAsyncModal() {
    dismissWidget();
    showAsyncModal();
  }

  function dismissWidget() {
    const widget = document.getElementById('minimizedProgressWidget');
    if (widget) widget.classList.add('d-none');
  }

  var exportPollTimer = null;
  var isExportRunning = false;
  var exportDownloaded = false;

  function startAsyncExport(exportType) {
    if (isExportRunning) {
      console.warn("Export already in progress.");
      showAsyncModal();
      return;
    }

    isExportRunning = true;
    exportDownloaded = false;
    if (exportPollTimer) {
      clearTimeout(exportPollTimer);
      exportPollTimer = null;
    }

    const progressBar = document.getElementById('asyncProgressBar');
    progressBar.style.width = '5%';
    progressBar.className = 'progress-bar progress-bar-striped progress-bar-animated';
    document.getElementById('asyncExportPercent').innerText = '5%';
    document.getElementById('asyncExportStage').innerText = 'Preparing Export...';
    document.getElementById('asyncExportMessage').innerText = 'Initializing report compilation...';
    document.getElementById('asyncDownloadBtn').classList.add('d-none');
    document.getElementById('asyncExportIcon').className = 'bi bi-cpu-fill fs-3';

    const minBar = document.getElementById('minimizedProgressBar');
    minBar.style.width = '5%';
    minBar.className = 'progress-bar progress-bar-striped progress-bar-animated';
    document.getElementById('minimizedPercent').innerText = '5%';
    document.getElementById('minimizedIcon').className = 'bi bi-cpu-fill fs-5';

    showAsyncModal();

    const form = document.getElementById('consolidatedMatrixReportForm');
    const formData = new FormData(form || undefined);
    formData.delete('_method');
    formData.append('export_type', exportType);

    const urlParams = new URLSearchParams(window.location.search);
    for (const [key, value] of urlParams.entries()) {
      if (key !== 'page' && key !== 'format' && !formData.has(key)) {
        formData.append(key, value);
      }
    }

    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;

    fetch('/institute_admin/reports/export_async', {
      method: 'POST',
      headers: {
        'X-CSRF-Token': csrfToken,
        'Accept': 'application/json'
      },
      body: formData
    })
    .then(res => res.json())
    .then(data => {
      if (data.export_token) {
        pollExportStatus(data.export_token);
      } else {
        isExportRunning = false;
        document.getElementById('asyncExportStage').innerText = 'Export Failed';
        document.getElementById('asyncExportMessage').innerText = 'Failed to start export job. Please try again.';
        progressBar.className = 'progress-bar bg-danger';
        minBar.className = 'progress-bar bg-danger';
      }
    })
    .catch(err => {
      console.error('Export enqueue error:', err);
      isExportRunning = false;
      document.getElementById('asyncExportStage').innerText = 'Export Failed';
      document.getElementById('asyncExportMessage').innerText = 'Network error while triggering export. Please try again.';
      progressBar.className = 'progress-bar bg-danger';
      minBar.className = 'progress-bar bg-danger';
    });
  }

  function pollExportStatus(exportToken) {
    if (!isExportRunning || exportDownloaded) return;

    fetch(`/institute_admin/reports/export_status?export_token=${exportToken}`)
      .then(res => res.json())
      .then(data => {
        if (!isExportRunning || exportDownloaded) return;

        const percent = data.progress || 0;
        document.getElementById('asyncProgressBar').style.width = `${percent}%`;
        document.getElementById('asyncExportPercent').innerText = `${percent}%`;
        document.getElementById('asyncExportMessage').innerText = data.message || 'Processing...';

        document.getElementById('minimizedProgressBar').style.width = `${percent}%`;
        document.getElementById('minimizedPercent').innerText = `${percent}%`;

        if (data.status === 'processing' || data.status === 'queued') {
          document.getElementById('asyncExportStage').innerText = 'Generating Question Matrix...';
          exportPollTimer = setTimeout(() => {
            pollExportStatus(exportToken);
          }, 1500);
        } else if (data.status === 'completed') {
          exportDownloaded = true;
          isExportRunning = false;
          if (exportPollTimer) {
            clearTimeout(exportPollTimer);
            exportPollTimer = null;
          }

          document.getElementById('asyncExportStage').innerText = 'Report Ready!';
          document.getElementById('asyncExportIcon').className = 'bi bi-check-circle-fill text-success fs-3';
          document.getElementById('minimizedIcon').className = 'bi bi-check-circle-fill text-success fs-5';
          
          const downloadBtn = document.getElementById('asyncDownloadBtn');
          downloadBtn.href = data.download_url;
          downloadBtn.classList.remove('d-none');

          triggerFileDownload(data.download_url);

          setTimeout(() => {
            hideAsyncModal();
            dismissWidget();
          }, 2000);
        } else if (data.status === 'failed') {
          isExportRunning = false;
          if (exportPollTimer) {
            clearTimeout(exportPollTimer);
            exportPollTimer = null;
          }
          document.getElementById('asyncExportStage').innerText = 'Export Failed';
          document.getElementById('asyncExportMessage').innerText = data.message || 'Export failed. Please check filters and try again.';
          document.getElementById('asyncExportIcon').className = 'bi bi-exclamation-triangle-fill text-danger fs-3';
          document.getElementById('minimizedIcon').className = 'bi bi-exclamation-triangle-fill text-danger fs-5';
          document.getElementById('asyncProgressBar').className = 'progress-bar bg-danger';
          document.getElementById('minimizedProgressBar').className = 'progress-bar bg-danger';
        }
      })
      .catch(err => {
        console.error('Error polling status:', err);
        if (isExportRunning && !exportDownloaded) {
          exportPollTimer = setTimeout(() => {
            pollExportStatus(exportToken);
          }, 2000);
        }
      });
  }

  function triggerFileDownload(downloadUrl) {
    const iframe = document.createElement('iframe');
    iframe.style.display = 'none';
    iframe.src = downloadUrl;
    document.body.appendChild(iframe);
    setTimeout(() => {
      if (iframe.parentNode) {
        iframe.parentNode.removeChild(iframe);
      }
    }, 15000);
  }

  // Initialize Scroll Pagination and cleanup on Turbo navigation
  document.addEventListener('turbo:load', initMatrixScrollPagination);
  document.addEventListener('DOMContentLoaded', initMatrixScrollPagination);

  document.addEventListener('turbo:before-cache', function() {
    if (exportPollTimer) {
      clearTimeout(exportPollTimer);
      exportPollTimer = null;
    }
    isExportRunning = false;
    if (matrixScrollObserver) {
      matrixScrollObserver.disconnect();
    }
    if (typeof window.exitTableFullscreen === 'function') {
      window.exitTableFullscreen();
    }
  });
</script>
