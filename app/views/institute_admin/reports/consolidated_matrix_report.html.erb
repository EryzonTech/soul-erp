<div class="container-fluid px-0 pt-2 pb-4">
  <!-- MODERN PAGE HEADER CARD -->
  <div class="card border-0 shadow-sm rounded-4 mb-4 page-header-card">
    <div class="card-body p-3 p-md-4">
      <!-- Top Breadcrumb Bar -->
      <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom border-light-subtle">
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb breadcrumb-modern mb-0">
            <li class="breadcrumb-item"><%= link_to institute_admin_root_path do %><i class="bi bi-house-door-fill"></i><% end %></li>
            <li class="breadcrumb-item"><%= link_to "Reports", institute_admin_reports_path %></li>
            <li class="breadcrumb-item"><%= link_to "Assignment Reports", assignment_reports_menu_institute_admin_reports_path %></li>
            <li class="breadcrumb-item active" aria-current="page">Question Matrix Report</li>
          </ol>
        </nav>
        <span class="badge bg-light text-muted border px-2.5 py-1 small fw-medium d-none d-sm-inline-flex align-items-center gap-1">
          <i class="bi bi-shield-check text-success"></i>
          <span>Institute Admin</span>
        </span>
      </div>

      <!-- Main Header Row: Icon + Title/Subtitle + Action Toolbar -->
      <div class="d-flex flex-column flex-xl-row justify-content-between align-items-xl-center gap-3">
        <div class="d-flex align-items-center gap-3">
          <div class="header-icon-box matrix-theme shadow-sm">
            <i class="bi bi-grid-3x3-gap-fill fs-3"></i>
          </div>
          <div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
              <h3 class="fw-bold text-dark mb-0" style="letter-spacing: -0.3px;">Consolidated Question Matrix Report</h3>
              <span class="badge rounded-pill bg-info-subtle text-info border border-info-subtle px-2.5 py-1 fw-semibold" style="font-size: 0.72rem;">
                <i class="bi bi-table me-1"></i>Pivot Matrix View
              </span>
            </div>
            <p class="text-secondary small mb-0 mt-1">Cross-tabular response matrix with questions as column headers and consolidated participant submissions</p>
          </div>
        </div>

        <div class="header-actions d-flex flex-wrap align-items-center gap-2">
          <!-- Switch to Detailed Log View -->
          <%= link_to consolidated_response_report_institute_admin_reports_path(request.query_parameters.except("format", :format)), 
                      class: "btn btn-outline-indigo d-inline-flex align-items-center gap-1.5 shadow-sm rounded-3 px-3 py-2 fw-medium", 
                      title: "Switch to Detailed Response Log View" do %>
            <i class="bi bi-list-columns-reverse text-indigo"></i>
            <span>Detailed View</span>
          <% end %>

          <!-- Direct Excel Download (.xls SpreadsheetML) -->
          <%= link_to consolidated_matrix_report_institute_admin_reports_path(request.query_parameters.merge(format: :xls)), 
                      class: "btn btn-outline-success d-inline-flex align-items-center gap-2 shadow-sm rounded-3 px-3 py-2 fw-medium", 
                      data: { turbo: false }, 
                      download: "", 
                      title: "Download Question Matrix as Excel (.xls)" do %>
            <i class="bi bi-file-earmark-excel-fill text-success"></i>
            <span>Download Excel</span>
          <% end %>

          <!-- Full Background Export Button -->
          <button type="button" 
                  class="btn btn-outline-primary d-inline-flex align-items-center gap-2 shadow-sm rounded-3 px-3 py-2 fw-medium" 
                  onclick="startAsyncExport('consolidated_matrix_excel');"
                  title="Generate and download complete question matrix in the background with live progress">
            <i class="bi bi-cloud-arrow-down-fill"></i>
            <span>Export Full Report</span>
          </button>

          <!-- Direct CSV Download -->
          <%= link_to consolidated_matrix_report_institute_admin_reports_path(request.query_parameters.merge(format: :csv)), 
                      class: "btn btn-outline-secondary d-inline-flex align-items-center gap-1.5 shadow-sm rounded-3 px-3 py-2 fw-medium", 
                      data: { turbo: false }, 
                      download: "", 
                      title: "Download CSV Matrix" do %>
            <i class="bi bi-file-earmark-spreadsheet"></i>
            <span>CSV</span>
          <% end %>

          <%= link_to assignment_reports_menu_institute_admin_reports_path, class: "btn btn-light border d-inline-flex align-items-center gap-1.5 rounded-3 px-3 py-2 fw-medium text-secondary shadow-sm" do %>
            <i class="bi bi-arrow-left"></i>
            <span>Back</span>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- KPI SUMMARY METRICS ROW -->
  <div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
      <div class="inst-kpi-card">
        <div>
          <div class="text-uppercase text-muted fw-semibold mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">Assignments</div>
          <div class="h4 fw-bold mb-0 text-dark"><%= @total_filtered_assignments || 0 %></div>
        </div>
        <div class="inst-kpi-icon inst-kpi-icon-primary">
          <i class="bi bi-journal-text"></i>
        </div>
      </div>
    </div>

    <div class="col-12 col-md-4">
      <div class="inst-kpi-card">
        <div>
          <div class="text-uppercase text-muted fw-semibold mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">Participants</div>
          <div class="h4 fw-bold mb-0 text-indigo"><%= @filtered_participants_count || 0 %></div>
        </div>
        <div class="inst-kpi-icon inst-kpi-icon-indigo" style="background-color: #e0e7ff; color: #4f46e5;">
          <i class="bi bi-people-fill"></i>
        </div>
      </div>
    </div>

    <div class="col-12 col-md-4">
      <div class="inst-kpi-card">
        <div>
          <div class="text-uppercase text-muted fw-semibold mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">Questions in Matrix</div>
          <div class="h4 fw-bold mb-0 text-primary"><%= @total_matrix_questions_count || 0 %></div>
        </div>
        <div class="inst-kpi-icon inst-kpi-icon-primary" style="background-color: #e0f2fe; color: #0284c7;">
          <i class="bi bi-question-circle-fill"></i>
        </div>
      </div>
    </div>
  </div>

  <!-- MULTI-SELECT CHECKBOX FILTER TOOLBAR -->
  <%
    active_filters_count = 0
    active_filters_count += 1 if params[:search].present?
    active_filters_count += 1 if @selected_assignment_ids.present?
    active_filters_count += 1 if @selected_section_ids.present?
    active_filters_count += 1 if @selected_participant_ids.present?
    active_filters_count += 1 if @selected_statuses.present? && @selected_statuses.size == 1
    active_filters_count += 1 if @date_range.present? && @date_range != 'all_time'
  %>
  <div class="filter-toolbar-card bg-white rounded-4 shadow-sm border mb-4 p-3 p-md-4">
    <%= form_tag consolidated_matrix_report_institute_admin_reports_path, method: :get, id: "consolidatedMatrixReportForm" do %>
      <!-- TOP ROW: Search Input & Action Buttons -->
      <div class="row g-2 g-md-3 align-items-center mb-3">
        <!-- Search Keyword -->
        <div class="col-12 col-md-7 col-lg-8">
          <div class="input-group filter-input-group">
            <span class="input-group-text bg-white border-end-0 ps-3 pe-2">
              <i class="bi bi-search text-primary"></i>
            </span>
            <input type="text" 
                   name="search" 
                   id="consolidatedMatrixSearchInput" 
                   class="form-control border-start-0 ps-1 text-dark fw-medium" 
                   placeholder="Search by participant, email, assignment..." 
                   value="<%= params[:search] %>"
                   aria-label="Search by participant, email, assignment..."
                   autocomplete="off">
            <% if params[:search].present? %>
              <button type="button" 
                      class="btn btn-link text-muted pe-3 text-decoration-none border-start-0" 
                      onclick="document.getElementById('consolidatedMatrixSearchInput').value=''; document.getElementById('consolidatedMatrixReportForm').submit();" 
                      title="Clear search">
                <i class="bi bi-x-circle-fill"></i>
              </button>
            <% end %>
          </div>
        </div>

        <!-- Action Buttons (Reset & Apply Filters) -->
        <div class="col-12 col-md-5 col-lg-4 d-flex align-items-center justify-content-md-end gap-2">
          <%= link_to consolidated_matrix_report_institute_admin_reports_path, class: "btn btn-filter-reset px-3 rounded-3 d-inline-flex align-items-center justify-content-center gap-1.5 flex-grow-1 flex-md-grow-0", title: "Reset All Filters" do %>
            <i class="bi bi-arrow-counterclockwise"></i>
            <span>Reset</span>
            <% if active_filters_count > 0 %>
              <span class="badge bg-secondary-subtle text-secondary rounded-pill ms-1" style="font-size: 0.72rem;"><%= active_filters_count %></span>
            <% end %>
          <% end %>

          <button type="submit" class="btn btn-filter-apply px-4 rounded-3 d-inline-flex align-items-center justify-content-center gap-1.5 fw-semibold shadow-sm flex-grow-1 flex-md-grow-0">
            <i class="bi bi-funnel-fill"></i>
            <span>Apply Filters</span>
          </button>
        </div>
      </div>

      <!-- BOTTOM ROW: 5 Dimension Multi-Select Dropdowns -->
      <div class="row g-2 g-md-3 align-items-center">
        <!-- Assignments Multi-Select Dropdown -->
        <div class="col-12 col-sm-6 col-md-4 col-lg">
          <div class="dropdown multiselect-dropdown">
            <button class="filter-dropdown-btn dropdown-toggle w-100 text-start d-flex align-items-center justify-content-between <%= 'filter-active' if @selected_assignment_ids.present? %>" 
                    type="button" 
                    data-bs-toggle="dropdown" 
                    data-bs-auto-close="outside"
                    aria-expanded="false">
              <span class="d-inline-flex align-items-center text-truncate">
                <i class="bi bi-journal-check me-2 text-primary flex-shrink-0"></i>
                <span class="dropdown-label text-truncate" id="asgLabel">
                  Assignments (<%= @selected_assignment_ids.empty? ? 'All' : @selected_assignment_ids.size %>)
                </span>
              </span>
            </button>
            <div class="dropdown-menu p-2 shadow-lg rounded-3 border" style="min-width: 270px; max-height: 320px; overflow-y: auto;">
              <div class="px-1 mb-2">
                <input type="text" class="form-control form-control-sm multiselect-search" placeholder="Search assignments..." oninput="filterDropdownList(this)">
              </div>
              <div class="d-flex justify-content-between px-1 mb-2 pb-1 border-bottom">
                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none fw-semibold" style="font-size: 0.75rem;" onclick="selectAllDropdownCheckboxes(this, true, 'asgLabel', 'Assignments')">Select All</button>
                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none text-muted" style="font-size: 0.75rem;" onclick="selectAllDropdownCheckboxes(this, false, 'asgLabel', 'Assignments')">Clear</button>
              </div>
              <div class="multiselect-options-list">
                <% @available_assignments.each do |asg| %>
                  <div class="form-check dropdown-item rounded px-2 py-1 multiselect-item">
                    <input class="form-check-input ms-0 me-2" 
                           type="checkbox" 
                           name="assignment_ids[]" 
                           value="<%= asg.id %>" 
                           id="asg_cb_<%= asg.id %>" 
                           <%= 'checked' if @selected_assignment_ids.include?(asg.id.to_s) %>
                           onchange="updateDropdownCounter('asgLabel', 'Assignments', 'assignment_ids[]')">
                    <label class="form-check-label text-truncate cursor-pointer small" for="asg_cb_<%= asg.id %>" title="<%= asg.title %>">
                      <%= asg.title %>
                    </label>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <!-- Sections Multi-Select Dropdown -->
        <div class="col-12 col-sm-6 col-md-4 col-lg">
          <div class="dropdown multiselect-dropdown">
            <button class="filter-dropdown-btn dropdown-toggle w-100 text-start d-flex align-items-center justify-content-between <%= 'filter-active' if @selected_section_ids.present? %>" 
                    type="button" 
                    data-bs-toggle="dropdown" 
                    data-bs-auto-close="outside"
                    aria-expanded="false">
              <span class="d-inline-flex align-items-center text-truncate">
                <i class="bi bi-people me-2 text-info flex-shrink-0"></i>
                <span class="dropdown-label text-truncate" id="secLabel">
                  Sections (<%= @selected_section_ids.empty? ? 'All' : @selected_section_ids.size %>)
                </span>
              </span>
            </button>
            <div class="dropdown-menu p-2 shadow-lg rounded-3 border" style="min-width: 250px; max-height: 320px; overflow-y: auto;">
              <div class="px-1 mb-2">
                <input type="text" class="form-control form-control-sm multiselect-search" placeholder="Search sections..." oninput="filterDropdownList(this)">
              </div>
              <div class="d-flex justify-content-between px-1 mb-2 pb-1 border-bottom">
                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none fw-semibold" style="font-size: 0.75rem;" onclick="selectAllDropdownCheckboxes(this, true, 'secLabel', 'Sections')">Select All</button>
                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none text-muted" style="font-size: 0.75rem;" onclick="selectAllDropdownCheckboxes(this, false, 'secLabel', 'Sections')">Clear</button>
              </div>
              <div class="multiselect-options-list">
                <% @available_sections.each do |sec| %>
                  <div class="form-check dropdown-item rounded px-2 py-1 multiselect-item">
                    <input class="form-check-input ms-0 me-2" 
                           type="checkbox" 
                           name="section_ids[]" 
                           value="<%= sec.id %>" 
                           id="sec_cb_<%= sec.id %>" 
                           <%= 'checked' if @selected_section_ids.include?(sec.id.to_s) %>
                           onchange="updateDropdownCounter('secLabel', 'Sections', 'section_ids[]')">
                    <label class="form-check-label text-truncate cursor-pointer small" for="sec_cb_<%= sec.id %>">
                      <%= sec.name %>
                    </label>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <!-- Participants Multi-Select Dropdown -->
        <div class="col-12 col-sm-6 col-md-4 col-lg">
          <div class="dropdown multiselect-dropdown">
            <button class="filter-dropdown-btn dropdown-toggle w-100 text-start d-flex align-items-center justify-content-between <%= 'filter-active' if @selected_participant_ids.present? %>" 
                    type="button" 
                    data-bs-toggle="dropdown" 
                    data-bs-auto-close="outside"
                    aria-expanded="false">
              <span class="d-inline-flex align-items-center text-truncate">
                <i class="bi bi-person me-2 text-success flex-shrink-0"></i>
                <span class="dropdown-label text-truncate" id="partLabel">
                  Participants (<%= @selected_participant_ids.empty? ? 'All' : @selected_participant_ids.size %>)
                </span>
              </span>
            </button>
            <div class="dropdown-menu p-2 shadow-lg rounded-3 border" style="min-width: 280px; max-height: 320px; overflow-y: auto;">
              <div class="px-1 mb-2">
                <input type="text" class="form-control form-control-sm multiselect-search" placeholder="Search participants..." oninput="filterDropdownList(this)">
              </div>
              <div class="d-flex justify-content-between px-1 mb-2 pb-1 border-bottom">
                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none fw-semibold" style="font-size: 0.75rem;" onclick="selectAllDropdownCheckboxes(this, true, 'partLabel', 'Participants')">Select All</button>
                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none text-muted" style="font-size: 0.75rem;" onclick="selectAllDropdownCheckboxes(this, false, 'partLabel', 'Participants')">Clear</button>
              </div>
              <div class="multiselect-options-list">
                <% @available_participants.each do |p| %>
                  <div class="form-check dropdown-item rounded px-2 py-1 multiselect-item">
                    <input class="form-check-input ms-0 me-2" 
                           type="checkbox" 
                           name="participant_ids[]" 
                           value="<%= p.id %>" 
                           id="part_cb_<%= p.id %>" 
                           <%= 'checked' if @selected_participant_ids.include?(p.id.to_s) %>
                           onchange="updateDropdownCounter('partLabel', 'Participants', 'participant_ids[]')">
                    <label class="form-check-label text-truncate cursor-pointer small" for="part_cb_<%= p.id %>" title="<%= p.email %>">
                      <%= p.full_name %> <span class="text-muted" style="font-size: 0.75rem;">(<%= p.section&.name || 'No Sec' %>)</span>
                    </label>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <!-- Status Multi-Select Checkbox Dropdown -->
        <div class="col-12 col-sm-6 col-md-4 col-lg">
          <div class="dropdown multiselect-dropdown">
            <button class="filter-dropdown-btn dropdown-toggle w-100 text-start d-flex align-items-center justify-content-between <%= 'filter-active' if @selected_statuses.present? && @selected_statuses.size == 1 %>" 
                    type="button" 
                    data-bs-toggle="dropdown" 
                    data-bs-auto-close="outside"
                    aria-expanded="false">
              <span class="d-inline-flex align-items-center text-truncate">
                <i class="bi bi-check2-circle me-2 text-warning flex-shrink-0"></i>
                <span class="dropdown-label text-truncate" id="statusLabel">
                  Status (<%= @selected_statuses.size == 2 ? 'All' : @selected_statuses.map(&:titleize).join(', ') %>)
                </span>
              </span>
            </button>
            <div class="dropdown-menu p-2 shadow-lg rounded-3 border" style="min-width: 200px;">
              <div class="multiselect-options-list">
                <div class="form-check dropdown-item rounded px-2 py-1">
                  <input class="form-check-input ms-0 me-2" 
                         type="checkbox" 
                         name="submission_statuses[]" 
                         value="submitted" 
                         id="matrix_status_cb_sub" 
                         <%= 'checked' if @selected_statuses.include?('submitted') %>
                         onchange="updateStatusCounter()">
                  <label class="form-check-label cursor-pointer small fw-medium text-success" for="matrix_status_cb_sub">
                    <i class="bi bi-check-circle-fill me-1"></i> Submitted
                  </label>
                </div>
                <div class="form-check dropdown-item rounded px-2 py-1">
                  <input class="form-check-input ms-0 me-2" 
                         type="checkbox" 
                         name="submission_statuses[]" 
                         value="pending" 
                         id="matrix_status_cb_pend" 
                         <%= 'checked' if @selected_statuses.include?('pending') %>
                         onchange="updateStatusCounter()">
                  <label class="form-check-label cursor-pointer small fw-medium text-warning" for="matrix_status_cb_pend">
                    <i class="bi bi-clock-fill me-1"></i> Pending Only
                  </label>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Date Range Filter -->
        <div class="col-12 col-sm-6 col-md-4 col-lg">
          <div class="input-group filter-input-group">
            <span class="input-group-text bg-white border-end-0 ps-3 pe-2">
              <i class="bi bi-calendar-range text-secondary flex-shrink-0"></i>
            </span>
            <select name="date_range" 
                    id="matrixDateRange" 
                    class="form-select border-start-0 ps-1 pe-4 text-truncate filter-select <%= 'filter-active' if @date_range.present? && @date_range != 'all_time' %>" 
                    onchange="toggleMatrixCustomDates(this.value); this.classList.toggle('filter-active', this.value !== 'all_time');">
              <option value="all_time" <%= 'selected' if @date_range == 'all_time' %>>All Time</option>
              <option value="today" <%= 'selected' if @date_range == 'today' %>>Today</option>
              <option value="yesterday" <%= 'selected' if @date_range == 'yesterday' %>>Yesterday</option>
              <option value="last_7_days" <%= 'selected' if @date_range == 'last_7_days' %>>Last 7 Days</option>
              <option value="this_month" <%= 'selected' if @date_range == 'this_month' %>>This Month</option>
              <option value="custom" <%= 'selected' if @date_range == 'custom' %>>Custom Range</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Custom Date Pickers (Shown if Custom Range is selected) -->
      <div id="matrixCustomDateRow" class="row g-2 g-md-3 mt-3 pt-3 border-top align-items-center <%= 'd-none' unless @date_range == 'custom' %>">
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
          <div class="input-group filter-input-group">
            <span class="input-group-text bg-white text-muted small fw-semibold">From</span>
            <input type="date" name="start_date" class="form-control" value="<%= @start_date.to_s %>">
          </div>
        </div>
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
          <div class="input-group filter-input-group">
            <span class="input-group-text bg-white text-muted small fw-semibold">To</span>
            <input type="date" name="end_date" class="form-control" value="<%= @end_date.to_s %>">
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <!-- CONSOLIDATED QUESTION MATRIX TABLE CARD -->
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
    <div class="card-header bg-white py-3 px-4 border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2">
      <div class="d-flex align-items-center gap-2">
        <div class="p-1.5 bg-primary-subtle text-primary rounded-2">
          <i class="bi bi-table fs-5"></i>
        </div>
        <div>
          <h6 class="fw-bold mb-0 text-dark">Participant Question Response Matrix</h6>
          <span class="text-muted small" style="font-size: 0.78rem;">
            <%= @matrix_questions.size %> Questions across <%= @total_filtered_assignments %> Assignment<%= 's' if @total_filtered_assignments != 1 %>
          </span>
        </div>
      </div>
      <span class="badge bg-light text-secondary border px-3 py-1.5 fw-medium">
        Showing <%= @paginated_matrix_rows&.size || 0 %> of <%= @total_matrix_count || 0 %> Submissions
      </span>
    </div>

    <!-- HORIZONTALLY SCROLLABLE RESPONSIVE MATRIX TABLE -->
    <div class="table-responsive matrix-table-container">
      <table class="table align-middle mb-0 table-hover table-bordered border-light-subtle">
        <thead class="table-light">
          <tr>
            <!-- STICKY INFO HEADERS -->
            <th style="min-width: 50px; width: 50px;" class="text-center sticky-col sticky-col-num">#</th>
            <th style="min-width: 100px;" class="sticky-col sticky-col-date">Date</th>
            <th style="min-width: 180px;" class="sticky-col sticky-col-part">Participant</th>
            <th style="min-width: 110px;">Section</th>
            <th style="min-width: 160px;">Assignment</th>
            <th style="min-width: 95px;" class="text-center">Status</th>
            <th style="min-width: 95px;" class="text-center">Submitted At</th>

            <!-- DYNAMIC QUESTION HEADERS -->
            <% @matrix_questions.each_with_index do |q, q_idx| %>
              <th style="min-width: 200px; max-width: 280px; background-color: #f8fafc;" 
                  class="question-header-th" 
                  title="<%= q[:title] %> (<%= q[:assignments_text] %>)">
                <div class="d-flex flex-column gap-1">
                  <div class="d-flex align-items-center justify-content-between gap-1">
                    <span class="badge bg-indigo-subtle text-indigo fw-bold" style="font-size: 0.7rem;">
                      Q<%= q_idx + 1 %>
                    </span>
                    <span class="badge bg-light text-muted border text-capitalize" style="font-size: 0.65rem;">
                      <%= q[:question_type].to_s.humanize %>
                    </span>
                  </div>
                  <div class="fw-semibold text-dark text-truncate small" style="max-width: 250px;" title="<%= q[:title] %>">
                    <%= q[:title] %>
                  </div>
                  <% if @total_filtered_assignments > 1 && q[:assignments_text].present? %>
                    <span class="text-muted text-truncate" style="font-size: 0.68rem;" title="<%= q[:assignments_text] %>">
                      <i class="bi bi-journal-bookmark me-0.5"></i><%= q[:assignments_text] %>
                    </span>
                  <% end %>
                </div>
              </th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% display_rows = @paginated_matrix_rows.presence || [] %>
          <% if display_rows.blank? %>
            <tr>
              <td colspan="<%= 7 + (@matrix_questions.size.nonzero? || 1) %>" class="text-center py-5">
                <div class="text-muted mb-2"><i class="bi bi-inbox fs-1"></i></div>
                <h6 class="fw-bold text-dark mb-1">No Matrix Submissions Found</h6>
                <p class="text-muted small mb-0">No participant responses match the selected filters. Try adjusting your assignment, section, or date criteria.</p>
              </td>
            </tr>
          <% else %>
            <% display_rows.each_with_index do |row, index| %>
              <% row_num = (@pagy ? @pagy.from : 1) + index %>
              <tr>
                <!-- STICKY ROW CELLS -->
                <td class="text-center fw-semibold text-secondary sticky-col sticky-col-num bg-white" style="font-size: 0.85rem;"><%= row_num %></td>
                <td class="sticky-col sticky-col-date bg-white">
                  <span class="fw-medium text-dark"><%= row[:date].present? ? row[:date].strftime("%b %d, %Y") : "-" %></span>
                </td>
                <td class="sticky-col sticky-col-part bg-white">
                  <div class="fw-semibold text-dark text-truncate" style="max-width: 170px;"><%= row[:participant_name] %></div>
                  <div class="text-muted text-truncate" style="font-size: 0.75rem; max-width: 170px;"><%= row[:participant_email] %></div>
                </td>
                <td>
                  <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1 fw-medium text-truncate" style="max-width: 110px;">
                    <%= row[:section_name] %>
                  </span>
                </td>
                <td>
                  <span class="badge bg-indigo-subtle text-indigo border border-indigo-subtle px-2.5 py-1 rounded-pill fw-medium text-wrap text-start" style="max-width: 160px;">
                    <%= row[:assignment_title] %>
                  </span>
                </td>
                <td class="text-center">
                  <% if row[:status] == 'submitted' %>
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 fw-medium">
                      <i class="bi bi-check-circle me-1"></i>Submitted
                    </span>
                  <% else %>
                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-2.5 py-1 fw-medium">
                      <i class="bi bi-clock me-1"></i>Pending
                    </span>
                  <% end %>
                </td>
                <td class="text-center text-muted small">
                  <%= row[:submitted_at].present? ? row[:submitted_at].strftime("%I:%M %p") : "-" %>
                </td>

                <!-- DYNAMIC QUESTION RESPONSE CELLS -->
                <% row_answers = row[:answers] || {} %>
                <% @matrix_questions.each do |q| %>
                  <% ans_info = row_answers[q[:id]] %>
                  <td class="matrix-cell align-middle" style="min-width: 200px; max-width: 280px;">
                    <% if row[:status] == 'pending' %>
                      <span class="text-muted fst-italic small" style="font-size: 0.75rem;">Pending submission</span>
                    <% elsif ans_info.blank? %>
                      <span class="text-muted fst-italic small" title="Not answered / Not part of this assignment">-</span>
                    <% else %>
                      <% raw_ans = ans_info[:answer].to_s %>
                      <% q_type = ans_info[:question_type] || q[:question_type] %>

                      <% if q_type == 'rating' %>
                        <div class="d-flex align-items-center gap-1">
                          <span class="text-warning fs-6">
                            <% rating_val = raw_ans.to_i %>
                            <% (1..5).each do |star| %>
                              <i class="bi <%= star <= rating_val ? 'bi-star-fill' : 'bi-star' %>"></i>
                            <% end %>
                          </span>
                          <span class="badge bg-warning-subtle text-dark border border-warning-subtle font-monospace px-1.5 py-0.5 small" style="font-size: 0.72rem;">
                            <%= raw_ans %>/5
                          </span>
                        </div>
                      <% elsif q_type == 'checkboxes' %>
                        <div class="d-flex flex-wrap gap-1">
                          <% raw_ans.split(',').map(&:strip).each do |opt| %>
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-0.5 rounded-pill small" style="font-size: 0.72rem;">
                              <%= opt %>
                            </span>
                          <% end %>
                        </div>
                      <% elsif q_type == 'yes_or_no' %>
                        <% is_yes = raw_ans.downcase.in?(['yes', 'true', '1']) %>
                        <span class="badge <%= is_yes ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-danger-subtle text-danger border border-danger-subtle' %> rounded-pill px-2 py-0.5 fw-medium" style="font-size: 0.75rem;">
                          <i class="bi <%= is_yes ? 'bi-check-circle-fill' : 'bi-x-circle-fill' %> me-1"></i><%= raw_ans %>
                        </span>
                      <% else %>
                        <div class="text-dark small text-wrap text-break" style="line-height: 1.4; max-height: 80px; overflow-y: auto;" title="<%= raw_ans %>">
                          <%= raw_ans %>
                        </div>
                      <% end %>
                    <% end %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- PAGINATION FOOTER -->
    <% if @pagy && @pagy.pages > 1 %>
      <div class="card-footer bg-white border-top py-3 px-4 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
        <div class="text-muted small">
          Showing <strong><%= @pagy.from %></strong> to <strong><%= @pagy.to %></strong> of <strong><%= @pagy.count %></strong> submissions
        </div>
        <div class="pagy-bootstrap-nav">
          <%== pagy_bootstrap_nav(@pagy) %>
        </div>
      </div>
    <% end %>
  </div>
</div>

