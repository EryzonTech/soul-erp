<div class="container-fluid px-0 pt-2 pb-4">
  <!-- MODERN PAGE HEADER CARD -->
  <div class="card border-0 shadow-sm rounded-4 mb-4 page-header-card">
    <div class="card-body p-3 p-md-4">
      <!-- Top Breadcrumb Bar -->
      <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 pb-2 border-bottom border-light-subtle gap-2">
        <nav aria-label="breadcrumb" class="flex-grow-1" style="min-width: 0;">
          <ol class="breadcrumb breadcrumb-modern mb-0 flex-wrap" style="row-gap: 0.25rem;">
            <li class="breadcrumb-item"><%= link_to institute_admin_root_path do %><i class="bi bi-house-door-fill"></i><% end %></li>
            <li class="breadcrumb-item"><%= link_to "Reports", institute_admin_reports_path %></li>
            <li class="breadcrumb-item"><%= link_to "Assignment Reports", assignment_reports_menu_institute_admin_reports_path %></li>
            <li class="breadcrumb-item active text-truncate" aria-current="page">Question Matrix Report</li>
          </ol>
        </nav>
        <div class="d-flex align-items-center gap-2 flex-shrink-0">
          <% if @date_range == 'today' %>
            <span class="badge bg-primary text-white px-2.5 py-1 small fw-semibold d-inline-flex align-items-center gap-1.5 shadow-xs">
              <i class="bi bi-clock-history"></i>
              <span>Today's Responses Focus</span>
            </span>
          <% end %>
          <span class="badge bg-light text-muted border px-2.5 py-1 small fw-medium d-none d-sm-inline-flex align-items-center gap-1">
            <i class="bi bi-shield-check text-success"></i>
            <span>Institute Admin</span>
          </span>
        </div>
      </div>

      <!-- Main Header Row: Icon + Title/Subtitle + Action Toolbar -->
      <div class="d-flex flex-column flex-xl-row justify-content-between align-items-xl-center gap-3">
        <div class="d-flex align-items-center gap-3">
          <div class="header-icon-box matrix-theme shadow-sm">
            <i class="bi bi-grid-3x3-gap-fill fs-3"></i>
          </div>
          <div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
              <h3 class="fw-bold text-dark mb-0" style="letter-spacing: -0.3px;">Consolidated Question Matrix Report</h3>
              <span class="badge rounded-pill bg-info-subtle text-info border border-info-subtle px-2.5 py-1 fw-semibold" style="font-size: 0.72rem;">
                <i class="bi bi-table me-1"></i>Pivot Matrix View (Default)
              </span>
              <% if @date_range == 'today' %>
                <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1 fw-semibold" style="font-size: 0.72rem;">
                  <i class="bi bi-calendar-check me-1"></i>Today: <%= Date.current.strftime("%b %d, %Y") %>
                </span>
              <% end %>
            </div>
            <p class="text-secondary small mb-0 mt-1">Cross-tabular response matrix with questions as column headers and consolidated participant submissions</p>
          </div>
        </div>

        <div class="header-actions d-flex flex-wrap align-items-center gap-2">
          <!-- Switch to Detailed Log View -->
          <%= link_to consolidated_response_report_institute_admin_reports_path(request.query_parameters.merge(view: :detailed).except("format", :format)), 
                      class: "btn btn-outline-indigo d-inline-flex align-items-center gap-1.5 shadow-sm rounded-3 px-3 py-2 fw-medium", 
                      title: "Switch to Detailed Response Log View" do %>
            <i class="bi bi-list-columns-reverse text-indigo"></i>
            <span>Detailed View</span>
          <% end %>

          <!-- Direct Excel Download (.xls SpreadsheetML) -->
          <%= link_to consolidated_matrix_report_institute_admin_reports_path(request.query_parameters.merge(format: :xls)), 
                      class: "btn btn-outline-success d-inline-flex align-items-center gap-2 shadow-sm rounded-3 px-3 py-2 fw-medium", 
                      data: { turbo: false }, 
                      download: "", 
                      title: "Download Question Matrix as Excel (.xls)" do %>
            <i class="bi bi-file-earmark-excel-fill text-success"></i>
            <span>Download Excel</span>
          <% end %>

          <!-- Full Background Export Button -->
          <button type="button" 
                  class="btn btn-outline-primary d-inline-flex align-items-center gap-2 shadow-sm rounded-3 px-3 py-2 fw-medium" 
                  onclick="startAsyncExport('consolidated_matrix_excel');"
                  title="Generate and download complete question matrix in the background with live progress">
            <i class="bi bi-cloud-arrow-down-fill"></i>
            <span>Export Full Report</span>
          </button>

          <!-- Direct CSV Download -->
          <%= link_to consolidated_matrix_report_institute_admin_reports_path(request.query_parameters.merge(format: :csv)), 
                      class: "btn btn-outline-secondary d-inline-flex align-items-center gap-1.5 shadow-sm rounded-3 px-3 py-2 fw-medium", 
                      data: { turbo: false }, 
                      download: "", 
                      title: "Download CSV Matrix" do %>
            <i class="bi bi-file-earmark-spreadsheet"></i>
            <span>CSV</span>
          <% end %>

          <%= link_to assignment_reports_menu_institute_admin_reports_path, class: "btn btn-light border d-inline-flex align-items-center gap-1.5 rounded-3 px-3 py-2 fw-medium text-secondary shadow-sm" do %>
            <i class="bi bi-arrow-left"></i>
            <span>Back</span>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- KPI SUMMARY METRICS ROW (4 Filter-Aware Dynamic Score Cards) -->
  <div class="row g-3 mb-4">
    <!-- Card 1: Filtered Assignments -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="report-kpi-card">
        <div class="d-flex align-items-start justify-content-between mb-2">
          <div>
            <div class="text-uppercase text-muted fw-semibold" style="font-size: 0.7rem; letter-spacing: 0.6px;">Assignments</div>
            <div class="h3 fw-bold mb-0 text-dark mt-1"><%= @total_filtered_assignments || 0 %></div>
          </div>
          <div class="report-kpi-icon icon-primary">
            <i class="bi bi-journal-text"></i>
          </div>
        </div>
        <div class="mt-auto pt-2 border-top border-light-subtle d-flex align-items-center justify-content-between text-muted" style="font-size: 0.75rem;">
          <span>In current filter scope</span>
          <span class="badge bg-light text-secondary border px-2 py-0.5 rounded-pill fw-medium">Active</span>
        </div>
      </div>
    </div>

    <!-- Card 2: Participants with Type Distribution Breakdown -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="report-kpi-card">
        <div class="d-flex align-items-start justify-content-between mb-2">
          <div>
            <div class="text-uppercase text-muted fw-semibold" style="font-size: 0.7rem; letter-spacing: 0.6px;">Participants</div>
            <div class="h3 fw-bold mb-0 text-indigo mt-1"><%= @filtered_participants_count || 0 %></div>
          </div>
          <div class="report-kpi-icon icon-indigo">
            <i class="bi bi-people-fill"></i>
          </div>
        </div>

        <!-- Participant Type Distribution Breakdown -->
        <%
          dist = @participant_type_distribution || {}
          students_cnt = dist['student'] || 0
          guardians_cnt = dist['guardian'] || 0
          employees_cnt = dist['employee'] || 0
        %>
        <div class="mt-auto pt-2 border-top border-light-subtle d-flex align-items-center justify-content-between flex-wrap gap-1" style="font-size: 0.72rem;">
          <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-0.5 fw-medium" title="Students">
            <i class="bi bi-mortarboard me-1"></i>Stu: <%= students_cnt %>
          </span>
          <span class="badge bg-purple-subtle text-purple border border-purple-subtle rounded-pill px-2 py-0.5 fw-medium" style="background-color: #f3e8ff; color: #7e22ce;" title="Guardians">
            <i class="bi bi-shield-shaded me-1"></i>Gua: <%= guardians_cnt %>
          </span>
          <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-2 py-0.5 fw-medium" title="Employees">
            <i class="bi bi-briefcase me-1"></i>Emp: <%= employees_cnt %>
          </span>
        </div>
      </div>
    </div>

    <!-- Card 3: Questions in Matrix & Active Today -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="report-kpi-card">
        <div class="d-flex align-items-start justify-content-between mb-2">
          <div>
            <div class="text-uppercase text-muted fw-semibold" style="font-size: 0.7rem; letter-spacing: 0.6px;">Questions in Matrix</div>
            <div class="h3 fw-bold mb-0 text-primary mt-1"><%= @total_matrix_questions_count || 0 %></div>
          </div>
          <div class="report-kpi-icon icon-sky">
            <i class="bi bi-question-circle-fill"></i>
          </div>
        </div>
        <div class="mt-auto pt-2 border-top border-light-subtle d-flex align-items-center justify-content-between text-muted" style="font-size: 0.75rem;">
          <span>Active Today:</span>
          <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-0.5 fw-semibold">
            <i class="bi bi-lightning-charge-fill me-0.5"></i><%= @today_active_question_ids&.size || 0 %> Questions
          </span>
        </div>
      </div>
    </div>

    <!-- Card 4: Submissions & Completion Rate -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="report-kpi-card">
        <div class="d-flex align-items-start justify-content-between mb-2">
          <div>
            <div class="text-uppercase text-muted fw-semibold" style="font-size: 0.7rem; letter-spacing: 0.6px;">Submissions</div>
            <div class="h3 fw-bold mb-0 text-success mt-1"><%= @total_submissions_count || 0 %></div>
          </div>
          <div class="report-kpi-icon icon-success">
            <i class="bi bi-check-circle-fill"></i>
          </div>
        </div>
        <div class="mt-auto pt-2 border-top border-light-subtle d-flex align-items-center justify-content-between text-muted" style="font-size: 0.75rem;">
          <span>Completion:</span>
          <div class="d-flex align-items-center gap-1.5">
            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-0.5 fw-semibold">
              <%= @overall_completion_rate || 0.0 %>%
            </span>
            <span class="text-muted" style="font-size: 0.7rem;">(<%= @total_pending_count || 0 %> pend)</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- MULTI-SELECT CHECKBOX FILTER TOOLBAR -->
  <%
    active_filters_count = 0
    active_filters_count += 1 if params[:search].present?
    active_filters_count += 1 if @selected_assignment_ids.present?
    active_filters_count += 1 if @selected_question_ids.present?
    active_filters_count += 1 if @selected_section_ids.present?
    active_filters_count += 1 if @selected_participant_ids.present?
    active_filters_count += 1 if @selected_participant_types.present?
    active_filters_count += 1 if @selected_statuses.present? && @selected_statuses != ['submitted']
    active_filters_count += 1 if @date_range.present? && @date_range != 'today'
  %>
  <div class="filter-toolbar-card bg-white rounded-4 shadow-sm border mb-4 p-3 p-md-4">
    <%= form_tag consolidated_matrix_report_institute_admin_reports_path, method: :get, id: "consolidatedMatrixReportForm" do %>
      <!-- TOP ROW: Search Input & Action Buttons -->
      <div class="row g-2 g-md-3 align-items-center mb-3">
        <!-- Search Keyword (Searches participant, email, assignment, question) -->
        <div class="col-12 col-md-7 col-lg-8">
          <div class="input-group filter-input-group">
            <span class="input-group-text bg-white border-end-0 ps-3 pe-2">
              <i class="bi bi-search text-primary"></i>
            </span>
            <input type="text" 
                   name="search" 
                   id="consolidatedMatrixSearchInput" 
                   class="form-control border-start-0 ps-1 text-dark fw-medium" 
                   placeholder="Search by participant, email, assignment, question..." 
                   value="<%= params[:search] %>"
                   aria-label="Search by participant, email, assignment, question..."
                   autocomplete="off">
            <% if params[:search].present? %>
              <button type="button" 
                      class="btn btn-link text-muted pe-3 text-decoration-none border-start-0" 
                      onclick="document.getElementById('consolidatedMatrixSearchInput').value=''; document.getElementById('consolidatedMatrixReportForm').submit();" 
                      title="Clear search">
                <i class="bi bi-x-circle-fill"></i>
              </button>
            <% end %>
          </div>
        </div>

        <!-- Action Buttons (Reset & Apply Filters) -->
        <div class="col-12 col-md-5 col-lg-4 d-flex align-items-center justify-content-md-end gap-2">
          <%= link_to consolidated_matrix_report_institute_admin_reports_path(date_range: :today), class: "btn btn-filter-reset px-3 rounded-3 d-inline-flex align-items-center justify-content-center gap-1.5 w-50 w-md-auto flex-md-grow-0", title: "Reset All Filters to Default (Today)" do %>
            <i class="bi bi-arrow-counterclockwise"></i>
            <span>Reset</span>
            <% if active_filters_count > 0 %>
              <span class="badge bg-secondary-subtle text-secondary rounded-pill ms-1" style="font-size: 0.72rem;"><%= active_filters_count %></span>
            <% end %>
          <% end %>

          <button type="submit" class="btn btn-filter-apply px-3 px-sm-4 rounded-3 d-inline-flex align-items-center justify-content-center gap-1.5 fw-semibold shadow-sm w-50 w-md-auto flex-md-grow-0">
            <i class="bi bi-funnel-fill"></i>
            <span>Apply Filters</span>
          </button>
        </div>
      </div>

      <!-- BOTTOM ROW: 7 Dimension Multi-Select Dropdowns -->
      <div class="row g-2 g-md-3 align-items-center">
        <!-- 1. Assignments Multi-Select Dropdown -->
        <div class="col-12 col-sm-6 col-md-4 col-xl">
          <div class="dropdown multiselect-dropdown">
            <button class="filter-dropdown-btn dropdown-toggle w-100 text-start d-flex align-items-center justify-content-between <%= 'filter-active' if @selected_assignment_ids.present? %>" 
                    type="button" 
                    data-bs-toggle="dropdown" 
                    data-bs-display="static"
                    data-bs-auto-close="outside"
                    aria-expanded="false">
              <span class="d-inline-flex align-items-center text-truncate">
                <i class="bi bi-journal-check me-2 text-primary flex-shrink-0"></i>
                <span class="dropdown-label text-truncate" id="asgLabel">
                  Assignments (<%= @selected_assignment_ids.empty? ? 'All' : @selected_assignment_ids.size %>)
                </span>
              </span>
            </button>
            <div class="dropdown-menu dropdown-menu-start p-2 shadow-lg rounded-3 border" style="width: 320px; max-width: min(360px, calc(100vw - 2rem)); max-height: 360px; overflow-y: auto;">
              <div class="px-1 mb-2">
                <input type="text" class="form-control form-control-sm multiselect-search" placeholder="Search assignments..." oninput="filterDropdownList(this)">
              </div>
              <div class="d-flex justify-content-between px-1 mb-2 pb-1 border-bottom">
                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none fw-semibold" style="font-size: 0.75rem;" onclick="selectAllDropdownCheckboxes(this, true, 'asgLabel', 'Assignments', 'assignment_ids[]')">Select All</button>
                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none text-muted" style="font-size: 0.75rem;" onclick="selectAllDropdownCheckboxes(this, false, 'asgLabel', 'Assignments', 'assignment_ids[]')">Clear</button>
              </div>
              <div class="multiselect-options-list">
                <% @available_assignments.each do |asg| %>
                  <div class="form-check dropdown-item rounded px-2 py-1.5 multiselect-item d-flex align-items-start gap-2">
                    <input class="form-check-input mt-1 flex-shrink-0" 
                           type="checkbox" 
                           name="assignment_ids[]" 
                           value="<%= asg.id %>" 
                           id="asg_cb_<%= asg.id %>" 
                           <%= 'checked' if @selected_assignment_ids.include?(asg.id.to_s) %>
                           onchange="updateDropdownCounter('asgLabel', 'Assignments', 'assignment_ids[]')">
                    <label class="form-check-label flex-grow-1 cursor-pointer small" for="asg_cb_<%= asg.id %>" title="<%= asg.title %>">
                      <%= asg.title %>
                    </label>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <!-- 2. Questions Multi-Select Dropdown [NEW] -->
        <div class="col-12 col-sm-6 col-md-4 col-xl">
          <div class="dropdown multiselect-dropdown">
            <button class="filter-dropdown-btn dropdown-toggle w-100 text-start d-flex align-items-center justify-content-between <%= 'filter-active' if @selected_question_ids.present? && @selected_question_ids.size != (@available_questions&.size || 0) %>" 
                    type="button" 
                    data-bs-toggle="dropdown" 
                    data-bs-display="static"
                    data-bs-auto-close="outside"
                    aria-expanded="false">
              <span class="d-inline-flex align-items-center text-truncate">
                <i class="bi bi-question-circle me-2 text-indigo flex-shrink-0"></i>
                <span class="dropdown-label text-truncate" id="qLabel">
                  Questions (<%= (@selected_question_ids.empty? || @selected_question_ids.size == (@available_questions&.size || 0)) ? 'All' : @selected_question_ids.size %>)
                </span>
              </span>
            </button>
            <div class="dropdown-menu dropdown-menu-start p-0 shadow-lg rounded-3 border q-filter-dropdown-menu" 
                 data-today="<%= Date.current.to_s %>" 
                 data-yesterday="<%= Date.yesterday.to_s %>" 
                 style="width: 440px; max-width: min(460px, calc(100vw - 1.5rem));">
              <!-- Search bar -->
              <div class="p-3 pb-2">
                <div class="position-relative mb-3 multiselect-search-wrapper">
                  <i class="bi bi-search"></i>
                  <input type="text" class="form-control form-control-sm multiselect-search" style="padding-left: 34px !important;" placeholder="Search questions..." oninput="filterQuestionsWithDateAndSearch(this)">
                </div>

                <!-- Date filter card section inside question dropdown -->
                <div class="q-date-filter-section p-3 rounded-3 border bg-light-subtle mb-3">
                  <div class="d-flex align-items-center justify-content-between mb-2.5">
                    <div class="d-flex align-items-center gap-2">
                      <i class="bi bi-calendar3 text-primary" style="font-size: 0.8rem;"></i>
                      <span class="text-uppercase fw-bold text-secondary" style="font-size: 0.68rem; letter-spacing: 0.6px;">Filter by Date</span>
                    </div>
                    <button type="button" class="btn btn-link btn-xs p-0 text-muted text-decoration-none d-inline-flex align-items-center gap-1.5 q-reset-btn" style="font-size: 0.72rem;" onclick="resetQuestionDateFilter(this)">
                      <i class="bi bi-arrow-counterclockwise" style="font-size: 0.75rem;"></i>
                      <span>Reset Date</span>
                    </button>
                  </div>

                  <!-- 3x2 Grid for balanced pills -->
                  <div class="q-date-pills-grid">
                    <button type="button" class="btn q-date-pill active" data-date-range="all" onclick="selectQuestionDatePill(this, 'all')">All</button>
                    <button type="button" class="btn q-date-pill" data-date-range="today" onclick="selectQuestionDatePill(this, 'today')">Today</button>
                    <button type="button" class="btn q-date-pill" data-date-range="yesterday" onclick="selectQuestionDatePill(this, 'yesterday')">Yesterday</button>
                    <button type="button" class="btn q-date-pill" data-date-range="last_7_days" onclick="selectQuestionDatePill(this, 'last_7_days')">Last 7 Days</button>
                    <button type="button" class="btn q-date-pill" data-date-range="this_month" onclick="selectQuestionDatePill(this, 'this_month')">This Month</button>
                    <button type="button" class="btn q-date-pill" data-date-range="custom" onclick="selectQuestionDatePill(this, 'custom')">
                      <i class="bi bi-calendar-event me-1.5"></i>Custom
                    </button>
                  </div>

                  <!-- Collapsible Custom Date Range Picker -->
                  <div class="row g-2 mt-2.5 pt-2.5 border-top d-none align-items-center q-custom-date-row">
                    <div class="col-6">
                      <label class="form-label mb-1 text-muted fw-semibold" style="font-size: 0.68rem;">From Date</label>
                      <input type="date" class="form-control form-control-sm text-secondary q-custom-from" style="font-size: 0.78rem; height: 32px;" onchange="onQuestionCustomDateChange(this)">
                    </div>
                    <div class="col-6">
                      <label class="form-label mb-1 text-muted fw-semibold" style="font-size: 0.68rem;">To Date</label>
                      <input type="date" class="form-control form-control-sm text-secondary q-custom-to" style="font-size: 0.78rem; height: 32px;" onchange="onQuestionCustomDateChange(this)">
                    </div>
                  </div>
                </div>

                <!-- Action Bar: Select All / Clear & Visible Count (Fully Wrapped Border) -->
                <div class="d-flex justify-content-between align-items-center px-3 py-2.5 mb-2 bg-light-subtle border rounded-2 q-action-bar">
                  <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none fw-semibold text-primary q-select-all-btn" style="font-size: 0.76rem;" onclick="selectAllDropdownCheckboxes(this, true, 'qLabel', 'Questions', 'question_ids[]')">Select All</button>
                    <span class="text-muted opacity-50">•</span>
                    <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none text-secondary q-clear-btn" style="font-size: 0.76rem;" onclick="selectAllDropdownCheckboxes(this, false, 'qLabel', 'Questions', 'question_ids[]')">Clear</button>
                  </div>
                  <span class="text-secondary fw-medium q-showing-count" style="font-size: 0.74rem;">
                    Showing <%= (@available_questions || []).size %> of <%= (@available_questions || []).size %>
                  </span>
                </div>
              </div>

              <!-- Question items list -->
              <div class="multiselect-options-list px-2.5 py-1" style="max-height: 260px; overflow-y: auto; -webkit-overflow-scrolling: touch;">
                <% (@available_questions || []).each do |q| %>
                  <% q_dates = (@question_dates_map && @question_dates_map[q.id]) || [] %>
                  <div class="form-check dropdown-item rounded px-2.5 py-2 mb-1 multiselect-item d-flex align-items-start gap-2.5"
                       data-question-id="<%= q.id %>"
                       data-dates="<%= q_dates.join(',') %>">
                    <input class="form-check-input mt-1 flex-shrink-0" 
                           type="checkbox" 
                           name="question_ids[]" 
                           value="<%= q.id %>" 
                           id="q_cb_<%= q.id %>" 
                           <%= 'checked' if @selected_question_ids.include?(q.id.to_s) %>
                           onchange="updateDropdownCounter('qLabel', 'Questions', 'question_ids[]')">
                    <label class="form-check-label flex-grow-1 cursor-pointer" for="q_cb_<%= q.id %>" title="<%= q.title %>">
                      <div class="d-flex align-items-start justify-content-between gap-2">
                        <span class="text-wrap flex-grow-1" style="font-size: 0.82rem; line-height: 1.45;"><%= q.title %></span>
                        <% if @today_active_question_ids&.include?(q.id) %>
                          <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-0.5 ms-1 flex-shrink-0" style="font-size: 0.62rem;">Today</span>
                        <% elsif @yesterday_active_question_ids&.include?(q.id) %>
                          <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-2 py-0.5 ms-1 flex-shrink-0" style="font-size: 0.62rem;">Yesterday</span>
                        <% end %>
                      </div>
                    </label>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <!-- 3. Sections Multi-Select Dropdown -->
        <div class="col-12 col-sm-6 col-md-4 col-xl">
          <div class="dropdown multiselect-dropdown">
            <button class="filter-dropdown-btn dropdown-toggle w-100 text-start d-flex align-items-center justify-content-between <%= 'filter-active' if @selected_section_ids.present? %>" 
                    type="button" 
                    data-bs-toggle="dropdown" 
                    data-bs-display="static"
                    data-bs-auto-close="outside"
                    aria-expanded="false">
              <span class="d-inline-flex align-items-center text-truncate">
                <i class="bi bi-people me-2 text-info flex-shrink-0"></i>
                <span class="dropdown-label text-truncate" id="secLabel">
                  Sections (<%= @selected_section_ids.empty? ? 'All' : @selected_section_ids.size %>)
                </span>
              </span>
            </button>
            <div class="dropdown-menu dropdown-menu-start p-2 shadow-lg rounded-3 border" style="width: 280px; max-width: min(320px, calc(100vw - 2rem)); max-height: 360px; overflow-y: auto;">
              <div class="px-1 mb-2">
                <input type="text" class="form-control form-control-sm multiselect-search" placeholder="Search sections..." oninput="filterDropdownList(this)">
              </div>
              <div class="d-flex justify-content-between px-1 mb-2 pb-1 border-bottom">
                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none fw-semibold" style="font-size: 0.75rem;" onclick="selectAllDropdownCheckboxes(this, true, 'secLabel', 'Sections', 'section_ids[]')">Select All</button>
                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none text-muted" style="font-size: 0.75rem;" onclick="selectAllDropdownCheckboxes(this, false, 'secLabel', 'Sections', 'section_ids[]')">Clear</button>
              </div>
              <div class="multiselect-options-list">
                <% @available_sections.each do |sec| %>
                  <div class="form-check dropdown-item rounded px-2 py-1.5 multiselect-item d-flex align-items-start gap-2">
                    <input class="form-check-input mt-1 flex-shrink-0" 
                           type="checkbox" 
                           name="section_ids[]" 
                           value="<%= sec.id %>" 
                           id="sec_cb_<%= sec.id %>" 
                           <%= 'checked' if @selected_section_ids.include?(sec.id.to_s) %>
                           onchange="updateDropdownCounter('secLabel', 'Sections', 'section_ids[]')">
                    <label class="form-check-label flex-grow-1 cursor-pointer small" for="sec_cb_<%= sec.id %>">
                      <%= sec.name %>
                    </label>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <!-- 4. Participants Multi-Select Dropdown -->
        <div class="col-12 col-sm-6 col-md-4 col-xl">
          <div class="dropdown multiselect-dropdown">
            <button class="filter-dropdown-btn dropdown-toggle w-100 text-start d-flex align-items-center justify-content-between <%= 'filter-active' if @selected_participant_ids.present? %>" 
                    type="button" 
                    data-bs-toggle="dropdown" 
                    data-bs-display="static"
                    data-bs-auto-close="outside"
                    aria-expanded="false">
              <span class="d-inline-flex align-items-center text-truncate">
                <i class="bi bi-person me-2 text-success flex-shrink-0"></i>
                <span class="dropdown-label text-truncate" id="partLabel">
                  Participants (<%= @selected_participant_ids.empty? ? 'All' : @selected_participant_ids.size %>)
                </span>
              </span>
            </button>
            <div class="dropdown-menu dropdown-menu-start p-2 shadow-lg rounded-3 border" style="width: 340px; max-width: min(380px, calc(100vw - 2rem)); max-height: 380px; overflow-y: auto;">
              <div class="px-1 mb-2">
                <input type="text" class="form-control form-control-sm multiselect-search" placeholder="Search participants..." oninput="filterDropdownList(this)">
              </div>
              <div class="d-flex justify-content-between px-1 mb-2 pb-1 border-bottom">
                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none fw-semibold" style="font-size: 0.75rem;" onclick="selectAllDropdownCheckboxes(this, true, 'partLabel', 'Participants', 'participant_ids[]')">Select All</button>
                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none text-muted" style="font-size: 0.75rem;" onclick="selectAllDropdownCheckboxes(this, false, 'partLabel', 'Participants', 'participant_ids[]')">Clear</button>
              </div>
              <div class="multiselect-options-list">
                <% @available_participants.each do |p| %>
                  <div class="form-check dropdown-item rounded px-2 py-1.5 multiselect-item d-flex align-items-start gap-2">
                    <input class="form-check-input mt-1 flex-shrink-0" 
                           type="checkbox" 
                           name="participant_ids[]" 
                           value="<%= p.id %>" 
                           id="part_cb_<%= p.id %>" 
                           <%= 'checked' if @selected_participant_ids.include?(p.id.to_s) %>
                           onchange="updateDropdownCounter('partLabel', 'Participants', 'participant_ids[]')">
                    <label class="form-check-label flex-grow-1 cursor-pointer small" for="part_cb_<%= p.id %>" title="<%= p.email %>">
                      <%= p.full_name %> 
                      <% if p.participant_type.present? %>
                        <span class="badge bg-light text-muted border text-capitalize" style="font-size: 0.65rem;"><%= p.participant_type %></span>
                      <% end %>
                      <span class="text-muted" style="font-size: 0.72rem;">(<%= p.section&.name || 'No Sec' %>)</span>
                    </label>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <!-- 5. Participant Type Filter Dropdown [NEW] -->
        <div class="col-12 col-sm-6 col-md-4 col-xl">
          <div class="dropdown multiselect-dropdown">
            <button class="filter-dropdown-btn dropdown-toggle w-100 text-start d-flex align-items-center justify-content-between <%= 'filter-active' if @selected_participant_types.present? %>" 
                    type="button" 
                    data-bs-toggle="dropdown" 
                    data-bs-display="static"
                    data-bs-auto-close="outside"
                    aria-expanded="false">
              <span class="d-inline-flex align-items-center text-truncate">
                <i class="bi bi-person-badge me-2 text-purple flex-shrink-0" style="color: #9333ea;"></i>
                <span class="dropdown-label text-truncate" id="typeLabel">
                  Type (<%= @selected_participant_types.blank? ? 'All' : @selected_participant_types.map(&:titleize).join(', ') %>)
                </span>
              </span>
            </button>
            <div class="dropdown-menu dropdown-menu-end p-2 shadow-lg rounded-3 border" style="width: 240px; max-width: min(280px, calc(100vw - 2rem));">
              <div class="multiselect-options-list">
                <% (@available_participant_types || ['student', 'guardian', 'employee']).each do |ptype| %>
                  <div class="form-check dropdown-item rounded px-2 py-1.5 multiselect-item d-flex align-items-center gap-2">
                    <input class="form-check-input flex-shrink-0" 
                           type="checkbox" 
                           name="participant_types[]" 
                           value="<%= ptype %>" 
                           id="type_cb_<%= ptype %>" 
                           <%= 'checked' if @selected_participant_types.include?(ptype) %>
                           onchange="updateTypeCounter()">
                    <label class="form-check-label flex-grow-1 cursor-pointer small fw-medium text-capitalize" for="type_cb_<%= ptype %>">
                      <% case ptype %>
                      <% when 'student' %>
                        <i class="bi bi-mortarboard text-primary me-1"></i> Student
                      <% when 'guardian' %>
                        <i class="bi bi-shield-shaded text-purple me-1" style="color: #9333ea;"></i> Guardian
                      <% when 'employee' %>
                        <i class="bi bi-briefcase text-info me-1"></i> Employee
                      <% else %>
                        <%= ptype.titleize %>
                      <% end %>
                    </label>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <!-- 6. Status Multi-Select Checkbox Dropdown -->
        <div class="col-12 col-sm-6 col-md-4 col-xl">
          <div class="dropdown multiselect-dropdown">
            <button class="filter-dropdown-btn dropdown-toggle w-100 text-start d-flex align-items-center justify-content-between <%= 'filter-active' if @selected_statuses.present? && @selected_statuses != ['submitted'] %>" 
                    type="button" 
                    data-bs-toggle="dropdown" 
                    data-bs-display="static"
                    data-bs-auto-close="outside"
                    aria-expanded="false">
              <span class="d-inline-flex align-items-center text-truncate">
                <i class="bi bi-check2-circle me-2 text-warning flex-shrink-0"></i>
                <span class="dropdown-label text-truncate" id="statusLabel">
                  Status (<%= @selected_statuses == ['submitted'] ? 'Submitted' : (@selected_statuses.size == 2 ? 'All' : @selected_statuses.map(&:titleize).join(', ')) %>)
                </span>
              </span>
            </button>
            <div class="dropdown-menu dropdown-menu-end p-2 shadow-lg rounded-3 border" style="width: 220px; max-width: min(260px, calc(100vw - 2rem));">
              <div class="multiselect-options-list">
                <div class="form-check dropdown-item rounded px-2 py-1.5 multiselect-item d-flex align-items-center gap-2">
                  <input class="form-check-input flex-shrink-0" 
                         type="checkbox" 
                         name="submission_statuses[]" 
                         value="submitted" 
                         id="matrix_status_cb_sub" 
                         <%= 'checked' if @selected_statuses.include?('submitted') %>
                         onchange="updateStatusCounter()">
                  <label class="form-check-label flex-grow-1 cursor-pointer small fw-medium text-success" for="matrix_status_cb_sub">
                    <i class="bi bi-check-circle-fill me-1"></i> Submitted
                  </label>
                </div>
                <div class="form-check dropdown-item rounded px-2 py-1.5 multiselect-item d-flex align-items-center gap-2">
                  <input class="form-check-input flex-shrink-0" 
                         type="checkbox" 
                         name="submission_statuses[]" 
                         value="pending" 
                         id="matrix_status_cb_pend" 
                         <%= 'checked' if @selected_statuses.include?('pending') %>
                         onchange="updateStatusCounter()">
                  <label class="form-check-label flex-grow-1 cursor-pointer small fw-medium text-warning" for="matrix_status_cb_pend">
                    <i class="bi bi-clock-fill me-1"></i> Pending Only
                  </label>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 7. Date Range Filter (Defaults to Today) -->
        <div class="col-12 col-sm-6 col-md-4 col-xl">
          <div class="input-group filter-input-group">
            <span class="input-group-text bg-white border-end-0 ps-3 pe-2">
              <i class="bi bi-calendar-range text-secondary flex-shrink-0"></i>
            </span>
            <select name="date_range" 
                    id="matrixDateRange" 
                    class="form-select border-start-0 ps-1 pe-4 text-truncate filter-select <%= 'filter-active' if @date_range.present? %>" 
                    onchange="toggleMatrixCustomDates(this.value);">
              <option value="today" <%= 'selected' if @date_range == 'today' %>>Today (Default)</option>
              <option value="yesterday" <%= 'selected' if @date_range == 'yesterday' %>>Yesterday</option>
              <option value="last_7_days" <%= 'selected' if @date_range == 'last_7_days' %>>Last 7 Days</option>
              <option value="this_month" <%= 'selected' if @date_range == 'this_month' %>>This Month</option>
              <option value="all_time" <%= 'selected' if @date_range == 'all_time' %>>All Time</option>
              <option value="custom" <%= 'selected' if @date_range == 'custom' %>>Custom Range</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Custom Date Pickers (Shown if Custom Range is selected) -->
      <div id="matrixCustomDateRow" class="row g-2 g-md-3 mt-3 pt-3 border-top align-items-center <%= 'd-none' unless @date_range == 'custom' %>">
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
          <div class="input-group filter-input-group">
            <span class="input-group-text bg-white text-muted small fw-semibold">From</span>
            <input type="date" name="start_date" class="form-control" value="<%= @start_date.to_s %>">
          </div>
        </div>
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
          <div class="input-group filter-input-group">
            <span class="input-group-text bg-white text-muted small fw-semibold">To</span>
            <input type="date" name="end_date" class="form-control" value="<%= @end_date.to_s %>">
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <!-- CONSOLIDATED QUESTION MATRIX TABLE CARD (Supports Fullscreen Mode) -->
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4" id="matrixTableCard">
    <div class="card-header bg-white py-3 px-3 px-md-4 border-bottom d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-2.5">
      <div class="d-flex align-items-center gap-2">
        <div class="p-1.5 bg-primary-subtle text-primary rounded-2 flex-shrink-0">
          <i class="bi bi-table fs-5"></i>
        </div>
        <div>
          <h6 class="fw-bold mb-0 text-dark">Participant Question Response Matrix</h6>
          <span class="text-muted small" style="font-size: 0.78rem;">
            <%= @matrix_questions.size %> Questions across <%= @total_filtered_assignments %> Assignment<%= 's' if @total_filtered_assignments != 1 %>
            <% if @date_range == 'today' %>
              • <strong class="text-primary">Showing Today's Responses</strong>
            <% end %>
          </span>
        </div>
      </div>

      <div class="d-flex align-items-center justify-content-between justify-content-md-end gap-2 w-100 w-md-auto flex-wrap">
        <!-- Live Record Counter -->
        <span class="badge bg-light text-secondary border px-2.5 px-sm-3 py-2 fw-medium rounded-3" id="matrixRecordsBadge" style="font-size: 0.78rem;">
          Showing <span id="matrixLoadedCount" class="fw-semibold text-dark"><%= @paginated_matrix_rows&.size || 0 %></span> of <span id="matrixTotalCount" class="fw-semibold text-dark"><%= @total_matrix_count || 0 %></span> Submissions
        </span>

        <!-- FULLSCREEN TOGGLE BUTTON -->
        <button type="button" 
                class="btn btn-table-fullscreen flex-shrink-0" 
                id="toggleFullscreenBtn" 
                onclick="toggleTableFullscreen();" 
                title="Expand table to full screen for maximum viewing area">
          <span class="fullscreen-icon-wrap">
            <i class="bi bi-arrows-fullscreen" id="fullscreenIcon"></i>
          </span>
          <span id="fullscreenBtnText">Full Screen</span>
        </button>
      </div>
    </div>

    <!-- MOBILE / TABLET SWIPE HINT BANNER -->
    <div class="d-lg-none px-3 py-1.5 bg-light-subtle border-bottom d-flex align-items-center justify-content-between text-muted" style="font-size: 0.74rem;">
      <span class="d-inline-flex align-items-center">
        <i class="bi bi-arrow-left-right text-primary me-1.5"></i>
        <span>Swipe table horizontally to view questions &rarr;</span>
      </span>
      <span class="badge bg-secondary-subtle text-secondary rounded-pill" style="font-size: 0.65rem;">Scrollable</span>
    </div>

    <!-- HORIZONTALLY SCROLLABLE RESPONSIVE MATRIX TABLE -->
    <div class="table-responsive matrix-table-container" id="matrixScrollContainer">
      <table class="table align-middle mb-0 table-hover table-bordered border-light-subtle" id="matrixDataTable">
        <thead class="table-light">
          <tr>
            <!-- STICKY INFO HEADERS (frozen horizontally & vertically) -->
            <th style="width: 44px; min-width: 44px;" class="text-center sticky-col sticky-col-num">#</th>
            <th style="min-width: 175px;" class="sticky-col sticky-col-part">Participant</th>
            <th style="min-width: 95px;">Date</th>
            <th style="min-width: 110px;">Section</th>
            <th style="min-width: 160px;">Assignment</th>
            <th style="min-width: 95px;" class="text-center">Status</th>
            <th style="min-width: 95px;" class="text-center">Submitted At</th>

            <!-- DYNAMIC QUESTION HEADERS -->
            <% @matrix_questions.each_with_index do |q, q_idx| %>
              <% has_today_resp = @today_active_question_ids&.include?(q[:id]) %>
              <th style="min-width: 200px; max-width: 280px;" 
                  class="question-header-th <%= 'active-today-header' if has_today_resp %>" 
                  title="<%= q[:title] %> (<%= q[:assignments_text] %>)">
                <div class="d-flex flex-column gap-1">
                  <div class="d-flex align-items-center justify-content-between gap-1">
                    <span class="badge <%= has_today_resp ? 'bg-primary text-white' : 'bg-indigo-subtle text-indigo' %> fw-bold" style="font-size: 0.7rem;">
                      Q<%= q_idx + 1 %>
                    </span>
                    <% if has_today_resp %>
                      <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-1.5 py-0.5 fw-semibold" style="font-size: 0.64rem;">
                        <i class="bi bi-lightning-charge-fill me-0.5"></i>Today
                      </span>
                    <% end %>
                    <span class="badge bg-light text-muted border text-capitalize" style="font-size: 0.65rem;">
                      <%= q[:question_type].to_s.humanize %>
                    </span>
                  </div>
                  <div class="fw-semibold text-dark text-truncate small" style="max-width: 250px;" title="<%= q[:title] %>">
                    <%= q[:title] %>
                  </div>
                  <% if @total_filtered_assignments > 1 && q[:assignments_text].present? %>
                    <span class="text-muted text-truncate" style="font-size: 0.68rem;" title="<%= q[:assignments_text] %>">
                      <i class="bi bi-journal-bookmark me-0.5"></i><%= q[:assignments_text] %>
                    </span>
                  <% end %>
                </div>
              </th>
            <% end %>
          </tr>
        </thead>
        <tbody id="matrixTableBody">
          <%= render partial: "consolidated_matrix_rows", locals: { rows: @paginated_matrix_rows, start_index: (@pagy ? @pagy.from : 1), matrix_questions: @matrix_questions } %>
        </tbody>
      </table>
    </div>

    <!-- SCROLL PAGINATION / INFINITE SCROLL BAR -->
    <div id="scrollPaginationWrapper" class="py-3 px-3 px-md-4 bg-white border-top d-flex align-items-center justify-content-between flex-wrap gap-2">
      <div class="text-muted small">
        Showing <strong id="footerLoadedCount"><%= @paginated_matrix_rows&.size || 0 %></strong> of <strong id="footerTotalCount"><%= @total_matrix_count || 0 %></strong> submissions
      </div>
      <div id="scrollStatusBox" class="d-flex align-items-center gap-2">
        <div id="scrollLoadingIndicator" class="d-none text-primary small fw-medium d-inline-flex align-items-center gap-2">
          <div class="spinner-border spinner-border-sm" role="status"></div>
          <span>Loading more submissions...</span>
        </div>
        <button type="button" 
                id="manualLoadMoreBtn" 
                class="btn btn-sm btn-outline-primary rounded-3 px-3 py-1 <%= 'd-none' if (@pagy ? @pagy.pages <= 1 : true) %>" 
                onclick="loadNextMatrixPage();">
          <i class="bi bi-arrow-down-circle me-1"></i>Load More Submissions
        </button>
        <span id="allLoadedMessage" class="badge bg-light text-muted border px-2.5 py-1 small <%= 'd-none' if (@pagy ? @pagy.pages > 1 : false) %>">
          <i class="bi bi-check2-all text-success me-1"></i>All <%= @total_matrix_count || 0 %> submissions loaded
        </span>
      </div>
    </div>
    <!-- Infinite Scroll Sentinel Target -->
    <div id="infiniteScrollSentinel" style="height: 10px; width: 100%;"></div>
  </div>
</div>

<!-- ASYNC EXPORT PROGRESS MODAL -->
<div class="modal fade" id="asyncExportModal" tabindex="-1" aria-labelledby="asyncExportModalLabel" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
      <div class="modal-header border-0 pb-0 pt-4 px-4 d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2.5">
          <div class="p-2 rounded-3 text-white" style="background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);" id="asyncExportIconBox">
            <i class="bi bi-cpu-fill fs-3" id="asyncExportIcon"></i>
          </div>
          <div>
            <h5 class="modal-title fw-bold text-dark mb-0" id="asyncExportModalLabel">Exporting Question Matrix</h5>
          </div>
        </div>
        <button type="button" class="btn-close" aria-label="Close" id="asyncExportCloseBtn" onclick="minimizeAsyncModal();"></button>
      </div>

      <div class="modal-body p-4 text-center">
        <div class="d-flex justify-content-between align-items-center mb-2 px-1">
          <span class="text-secondary small fw-semibold" id="asyncExportStage">Preparing report export...</span>
          <span class="badge bg-primary text-white fw-bold px-2.5 py-1 rounded-pill" id="asyncExportPercent" style="background-color: #0ea5e9;">0%</span>
        </div>

        <div class="progress rounded-pill mb-3" style="height: 12px; background-color: #f1f5f9;">
          <div class="progress-bar progress-bar-striped progress-bar-animated" 
               id="asyncProgressBar" 
               role="progressbar" 
               style="width: 0%; background: linear-gradient(90deg, #0ea5e9 0%, #0284c7 100%); transition: width 0.4s ease;"></div>
        </div>

        <p class="text-muted small mb-0" id="asyncExportMessage">Compiling question matrix and participant responses...</p>
      </div>

      <div class="modal-footer border-0 pt-0 pb-4 px-4 d-flex justify-content-center">
        <a href="#" id="asyncDownloadBtn" class="btn btn-success d-none d-inline-flex align-items-center gap-2 px-4 py-2 rounded-3 shadow-sm fw-semibold">
          <i class="bi bi-cloud-arrow-down-fill fs-5"></i>
          <span>Download Excel File</span>
        </a>
        <button type="button" class="btn btn-outline-secondary px-3 py-1.5 rounded-3 small text-muted d-inline-flex align-items-center gap-1.5" id="asyncCancelBtn" onclick="minimizeAsyncModal();">
          <span>Minimize Window</span>
        </button>
      </div>
    </div>
  </div>
</div>

<!-- MINIMIZED FLOATING PROGRESS WIDGET -->
<div id="minimizedProgressWidget" 
     class="d-none position-fixed bottom-0 end-0 m-4 p-3 bg-white rounded-4 shadow-lg border d-flex align-items-center gap-3" 
     style="z-index: 1065; min-width: 300px; border-color: rgba(14, 165, 233, 0.25) !important;">
  <div class="p-2 rounded-3 text-white" style="background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);" id="minimizedIconBox">
    <i class="bi bi-cpu-fill fs-5" id="minimizedIcon"></i>
  </div>
  <div class="flex-grow-1 overflow-hidden">
    <div class="d-flex align-items-center justify-content-between">
      <span class="fw-bold text-dark small" id="minimizedTitle">Exporting Matrix...</span>
      <span class="badge bg-primary text-white fw-bold px-2 py-0.5 rounded-pill small" id="minimizedPercent" style="background-color: #0ea5e9;">0%</span>
    </div>
    <div class="progress rounded-pill mt-1" style="height: 6px; background-color: #f1f5f9;">
      <div class="progress-bar progress-bar-striped progress-bar-animated" id="minimizedProgressBar" style="width: 0%; background: #0ea5e9; transition: width 0.4s ease;"></div>
    </div>
  </div>
  <button type="button" class="btn btn-sm btn-light rounded-circle p-1.5 lh-1 shadow-sm" title="Maximize Progress Window" onclick="maximizeAsyncModal();">
    <i class="bi bi-arrows-angle-expand text-primary fs-6"></i>
  </button>
  <button type="button" class="btn btn-sm btn-light rounded-circle p-1.5 lh-1 text-muted shadow-sm" title="Dismiss Widget" onclick="dismissWidget();">
    <i class="bi bi-x-lg"></i>
  </button>
</div>

<style>
  /* ========================================================= */
  /* FROZEN QUESTION ROW HEADERS & PARTICIPANT COLUMN STYLES */
  /* ========================================================= */
  .matrix-table-container table {
    border-collapse: separate !important;
    border-spacing: 0 !important;
  }

  /* 1. VERTICAL FROZEN QUESTION ROW HEADERS (Sticky at Top) */
  .matrix-table-container thead th,
  .table thead th,
  .table-responsive thead th,
  thead.table-light th,
  .table-light th,
  #matrixDataTable thead th {
    position: sticky !important;
    top: 0 !important;
    z-index: 10 !important;
    background-color: #f8fafc !important;
    color: #1e293b !important;
    border-bottom: 2px solid #cbd5e1 !important;
    border-top: 1px solid #e2e8f0 !important;
