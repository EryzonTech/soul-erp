<% 
  display_rows = local_assigns[:rows] || []
  start_idx = local_assigns[:start_index] || 1
%>

<% if display_rows.blank? && start_idx == 1 %>
  <tr id="noResponseRecordsRow">
    <td colspan="9" class="text-center py-5">
      <div class="text-muted mb-2"><i class="bi bi-inbox fs-1"></i></div>
      <h6 class="fw-bold text-dark mb-1">No Response Records Found</h6>
      <p class="text-muted small mb-0">No participant responses match the selected filters. Try adjusting your assignment, question, section, or date criteria.</p>
    </td>
  </tr>
<% else %>
  <% display_rows.each_with_index do |row, index| %>
    <% 
      row_num = start_idx + index 
      is_today = row[:date].present? && row[:date].to_date == Date.current
    %>
    <tr class="response-data-row <%= 'row-today-active' if is_today %>" id="resp_row_<%= row[:id] || "pend_#{index}" %>">
      <td class="sticky-col sticky-col-num text-center fw-semibold text-secondary bg-white" style="font-size: 0.85rem;"><%= row_num %></td>

      <td class="sticky-col sticky-col-part bg-white">
        <div class="d-flex align-items-center justify-content-between gap-1">
          <div class="fw-semibold text-dark text-truncate" title="<%= row[:participant_name] %>"><%= row[:participant_name] %></div>
          <% p_type = row[:participant_type].to_s.downcase %>
          <% if p_type.present? %>
            <% 
              badge_class, badge_style = case p_type
                                         when 'student'
                                           ['badge-type-student', 'background-color: #eff6ff !important; color: #1d4ed8 !important; border: 1px solid #bfdbfe !important;']
                                         when 'guardian'
                                           ['badge-type-guardian', 'background-color: #f3e8ff !important; color: #7e22ce !important; border: 1px solid #e9d5ff !important;']
                                         when 'employee'
                                           ['badge-type-employee', 'background-color: #ecfdf5 !important; color: #047857 !important; border: 1px solid #a7f3d0 !important;']
                                         else
                                           ['badge-type-other', 'background-color: #f8fafc !important; color: #475569 !important; border: 1px solid #cbd5e1 !important;']
                                         end
            %>
            <span class="badge <%= badge_class %> rounded-pill px-2 py-0.5 text-capitalize flex-shrink-0" style="font-size: 0.68rem; font-weight: 600; line-height: 1.2; <%= badge_style %>">
              <%= p_type %>
            </span>
          <% end %>
        </div>
        <div class="text-muted small text-truncate" style="font-size: 0.78rem;" title="<%= row[:participant_email] %>"><%= row[:participant_email] %></div>
      </td>

      <td>
        <% if is_today %>
          <div class="d-flex flex-column gap-0.5">
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-0.5 fw-semibold" style="font-size: 0.72rem; width: fit-content;">
              <i class="bi bi-clock-history me-1"></i>Today
            </span>
            <span class="small text-muted" style="font-size: 0.72rem;"><%= row[:date].strftime("%b %d") %></span>
          </div>
        <% else %>
          <span class="fw-medium text-dark"><%= row[:date].present? ? row[:date].strftime("%b %d, %Y") : "-" %></span>
        <% end %>
      </td>

      <td>
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1 fw-medium">
          <%= row[:section_name] %>
        </span>
      </td>

      <td>
        <span class="badge bg-indigo-subtle text-indigo border border-indigo-subtle px-2.5 py-1 rounded-pill fw-medium text-wrap text-start" style="max-width: 190px;">
          <%= row[:assignment_title] %>
        </span>
      </td>

      <td class="col-response-question">
        <div class="fw-medium text-dark text-wrap" style="max-width: 240px;"><%= row[:question_title] %></div>
        <% if row[:question_type].present? && row[:question_type] != '-' %>
          <span class="badge bg-light text-muted border px-1.5 py-0.5 rounded small text-capitalize mt-0.5" style="font-size: 0.7rem;">
            <%= row[:question_type].humanize %>
          </span>
        <% end %>
      </td>

      <td class="response-answer-cell align-top">
        <% if row[:status] == 'submitted' %>
          <% if row[:question_type] == 'rating' %>
            <div class="d-flex align-items-center gap-1.5">
              <span class="text-warning fs-6">
                <% rating_val = row[:answer].to_i %>
                <% (1..5).each do |star| %>
                  <i class="bi <%= star <= rating_val ? 'bi-star-fill' : 'bi-star' %>"></i>
                <% end %>
              </span>
              <span class="badge bg-warning-subtle text-dark border border-warning-subtle font-monospace px-1.5 py-0.5 small">
                <%= row[:answer] %>/5
              </span>
            </div>
          <% elsif row[:question_type] == 'checkboxes' %>
            <div class="d-flex flex-wrap gap-1">
              <% row[:answer].to_s.split(',').map(&:strip).each do |opt| %>
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-0.5 rounded-pill small">
                  <%= opt %>
                </span>
              <% end %>
            </div>
          <% elsif row[:question_type] == 'yes_or_no' %>
            <% is_yes = row[:answer].to_s.downcase.in?(['yes', 'true', '1']) %>
            <span class="badge <%= is_yes ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-danger-subtle text-danger border border-danger-subtle' %> rounded-pill px-2.5 py-1 fw-medium">
              <i class="bi <%= is_yes ? 'bi-check-circle-fill' : 'bi-x-circle-fill' %> me-1"></i><%= row[:answer] %>
            </span>
          <% else %>
            <%
              ans_id = "ans_r_#{row[:id] || index}"
              ans_text = row[:answer].to_s
              is_long = ans_text.length > 120 || ans_text.count("\n") >= 3
            %>
            <div class="response-reading-box">
              <div class="response-reading-text small text-break <%= 'clamped-text' if is_long %>" 
                   id="<%= ans_id %>"
                   title="<%= ans_text %>">
                <%= ans_text %>
              </div>
              <% if is_long %>
                <button type="button" 
                        class="btn btn-link btn-read-toggle p-0 text-decoration-none fw-semibold text-indigo d-inline-flex align-items-center gap-1 mt-1" 
                        style="font-size: 0.72rem;"
                        onclick="toggleResponseReadMore('<%= ans_id %>', this)">
                  <span class="toggle-label">Read more</span>
                  <i class="bi bi-chevron-down toggle-icon" style="font-size: 0.65rem;"></i>
                </button>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <span class="text-muted fst-italic small">Pending submission</span>
        <% end %>
      </td>

      <td class="text-center">
        <% if row[:status] == 'submitted' %>
          <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 fw-medium">
            <i class="bi bi-check-circle-fill me-1"></i>Submitted
          </span>
        <% else %>
          <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-2.5 py-1 fw-medium">
            <i class="bi bi-clock-fill me-1"></i>Pending
          </span>
        <% end %>
      </td>

      <td class="text-center text-muted small">
        <%= row[:submitted_at].present? ? row[:submitted_at].strftime("%I:%M %p") : "-" %>
      </td>
    </tr>
  <% end %>
<% end %>
