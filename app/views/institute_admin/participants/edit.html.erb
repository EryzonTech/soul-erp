<div class="card card-custom">
  <div class="card-header card-header-custom d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div class="d-flex align-items-center gap-2">
      <h5 class="mb-0">Edit Participant</h5>
      <% if @participant.suspended? %>
        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2.5 py-1">
          <i class="bi bi-pause-circle me-1"></i>Suspended
        </span>
      <% elsif @user.active? %>
        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1">
          <i class="bi bi-check-circle me-1"></i>Active
        </span>
      <% else %>
        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2.5 py-1">
          <i class="bi bi-clock me-1"></i>Pending Approval
        </span>
      <% end %>
    </div>
    <div class="d-flex align-items-center gap-2">
      <% if @participant.suspended? %>
        <%= button_to toggle_status_institute_admin_participant_path(@participant), method: :patch, class: "btn btn-outline-success btn-sm d-inline-flex align-items-center gap-1", data: { turbo_confirm: "Are you sure you want to reactivate #{@user.full_name}? They will regain access to the system." } do %>
          <i class="bi bi-play-circle"></i> Reactivate / Un-suspend
        <% end %>
      <% elsif @user.active? %>
        <%= button_to toggle_status_institute_admin_participant_path(@participant), method: :patch, class: "btn btn-outline-warning btn-sm d-inline-flex align-items-center gap-1", data: { turbo_confirm: "Are you sure you want to suspend #{@user.full_name}? They will be marked suspended and cannot log in." } do %>
          <i class="bi bi-pause-circle"></i> Deactivate / Suspend
        <% end %>
      <% else %>
        <%= button_to toggle_status_institute_admin_participant_path(@participant), method: :patch, class: "btn btn-outline-success btn-sm d-inline-flex align-items-center gap-1", data: { turbo_confirm: "Are you sure you want to approve #{@user.full_name}?" } do %>
          <i class="bi bi-check-circle"></i> Activate / Approve
        <% end %>
      <% end %>
      <%
        back_url = if @participant.suspended?
                     institute_admin_participants_path(status: 'suspended')
                   elsif @user.active?
                     institute_admin_participants_path(approved: 'true')
                   else
                     institute_admin_participants_path(approved: 'false')
                   end
      %>
      <%= link_to back_url, class: "btn btn-outline-secondary btn-sm" do %>
        <i class="bi bi-arrow-left"></i> Back
      <% end %>
    </div>
  </div>
  
  <div class="card-body">
    <%= render 'form' %>
  </div>
</div> 