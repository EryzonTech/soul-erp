<div class="card card-custom">
  <div class="card-header card-header-custom py-3">
    <div class="d-flex justify-content-between align-items-center">
      <div>
        <h5 class="mb-0">
          <% if params[:status] == 'suspended' %>
            Suspended Participants
          <% elsif params[:approved] == 'false' %>
            Not Approved Participants
          <% else %>
            Approved Participants
          <% end %>
        </h5>
      </div>
      <% if params[:status] == 'suspended' %>
        <% if @participants.any? %>
          <div class="d-flex gap-2">
            <button type="button" class="btn btn-approve" id="reactivateSelectedBtn" onclick="reactivateSelected()" style="display: none;">
              <i class="bi bi-play-circle-fill me-2"></i><span id="suspendedSelectedCount">0</span> Selected - Reactivate
            </button>
          </div>
        <% end %>
      <% elsif params[:approved] == 'false' %>
        <% if @participants.any? %>
          <div class="d-flex gap-2">
            <button type="button" class="btn btn-approve" id="approveSelectedBtn" onclick="approveSelected()" style="display: none;">
              <i class="bi bi-check-circle-fill me-2"></i><span id="selectedCount">0</span> Selected - Approve
            </button>
            <button type="button" class="btn btn-approve" onclick="showApproveAllModal()">
              <i class="bi bi-check-circle"></i> Approve All
            </button>
          </div>
        <% end %>
      <% else %>
        <div class="d-flex gap-2">
          <button type="button" class="btn btn-suspend-selected" id="deactivateSelectedBtn" onclick="deactivateSelected()" style="display: none;">
            <i class="bi bi-pause-circle-fill me-2"></i><span id="approvedSelectedCount">0</span> Selected - Suspend
          </button>
          <%= link_to new_institute_admin_participant_path, class: "btn btn-primary" do %>
            <i class="bi bi-plus-lg"></i> Add Participant
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

<style>
  .action-btn {
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    transition: all 0.3s ease;
    border: none;
    position: relative;
    overflow: hidden;
  }
  
  .action-btn::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    transform: translate(-50%, -50%);
    transition: width 0.6s, height 0.6s;
  }
  
  .action-btn:hover::before {
    width: 100px;
    height: 100px;
  }
  
  .action-btn i {
    font-size: 16px;
    position: relative;
    z-index: 1;
  }
  
  .btn-view {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    box-shadow: 0 4px 6px rgba(102, 126, 234, 0.3);
  }
  
  .btn-view:hover {
    background: linear-gradient(135deg, #5568d3 0%, #5a3a7f 100%);
    transform: translateY(-2px);
    box-shadow: 0 6px 12px rgba(102, 126, 234, 0.4);
    color: white;
  }
  
  .btn-edit {
    background: linear-gradient(135deg, #141c2f 0%, #ea02e9 100%);
    color: white;
    box-shadow: 0 4px 6px rgba(234, 2, 233, 0.3);
  }
  
  .btn-edit:hover {
    background: linear-gradient(135deg, #141c2f 0%, #ea02e9 100%);
    transform: translateY(-2px);
    box-shadow: 0 6px 12px rgba(234, 2, 233, 0.4);
    color: white;
  }
  
  .btn-delete {
    background: linear-gradient(135deg, #ff6b6b 0%, #c92a2a 100%);
    color: white;
    box-shadow: 0 4px 6px rgba(255, 107, 107, 0.3);
  }
  
  .btn-delete:hover {
    background: linear-gradient(135deg, #ee5a5a 0%, #b81919 100%);
    transform: translateY(-2px);
    box-shadow: 0 6px 12px rgba(255, 107, 107, 0.4);
    color: white;
  }
  
  .btn-approve {
    background: linear-gradient(135deg, #4ade80 0%, #16a34a 100%);
    color: white;
    padding: 8px 16px;
    border-radius: 8px;
    transition: all 0.3s ease;
    border: none;
    box-shadow: 0 4px 6px rgba(74, 222, 128, 0.3);
    position: relative;
    overflow: hidden;
  }
  
  .btn-approve::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    transform: translate(-50%, -50%);
    transition: width 0.6s, height 0.6s;
  }
  
  .btn-approve:hover::before {
    width: 200px;
    height: 200px;
  }
  
  .btn-approve:hover {
    background: linear-gradient(135deg, #22c55e 0%, #15803d 100%);
    transform: translateY(-2px);
    box-shadow: 0 6px 12px rgba(74, 222, 128, 0.4);
    color: white;
  }
  
  .btn-approve i {
    position: relative;
    z-index: 1;
  }

  .btn-suspend {
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    color: white;
    box-shadow: 0 4px 6px rgba(245, 158, 11, 0.3);
  }

  .btn-suspend:hover {
    background: linear-gradient(135deg, #d97706 0%, #b45309 100%);
    transform: translateY(-2px);
    box-shadow: 0 6px 12px rgba(245, 158, 11, 0.4);
    color: white;
  }

  .btn-suspend-selected {
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    color: white;
    padding: 8px 16px;
    border-radius: 8px;
    transition: all 0.3s ease;
    border: none;
    box-shadow: 0 4px 6px rgba(245, 158, 11, 0.3);
    position: relative;
    overflow: hidden;
    font-weight: 500;
  }

  .btn-suspend-selected::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    transform: translate(-50%, -50%);
    transition: width 0.6s, height 0.6s;
  }

  .btn-suspend-selected:hover::before {
    width: 200px;
    height: 200px;
  }

  .btn-suspend-selected:hover {
    background: linear-gradient(135deg, #d97706 0%, #b45309 100%);
    transform: translateY(-2px);
    box-shadow: 0 6px 12px rgba(245, 158, 11, 0.4);
    color: white;
  }

  .btn-suspend-selected i {
    position: relative;
    z-index: 1;
  }
  
  .action-btn:active {
    transform: translateY(0);
  }
  
  /* Mobile optimization */
  @media (max-width: 768px) {
    .action-btn {
      width: 32px;
      height: 32px;
      margin: 2px;
    }
    
    .action-btn i {
      font-size: 14px;
    }
    
    .btn-approve,
    .btn-suspend-selected {
      padding: 6px 12px;
      font-size: 14px;
    }
  }
  
  /* Ensure buttons don't wrap */
  td:last-child {
    white-space: nowrap;
  }
  
  /* Filter Section Styling */
  .filter-section {
    background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
    border-radius: 12px;
    padding: 1.5rem;
    border: 1px solid #e2e8f0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  }
  
  .filter-header h6 {
    color: #475569;
    font-weight: 600;
  }
  
  .filter-form .form-floating > label {
    color: #64748b;
  }
  
  .filter-form .filter-input {
    height: 38px;
    border-radius: 8px;
    border: 1px solid #cbd5e1;
    transition: all 0.3s ease;
    font-size: 14px;
    padding: 0.375rem 0.75rem;
    background-color: #ffffff;
  }
  
  .filter-form .form-select.filter-input {
    padding: 0.375rem 2.25rem 0.375rem 0.75rem;
    background-position: right 0.75rem center;
    background-size: 16px 12px;
  }
  
  .filter-form .filter-input:focus {
    border-color: #6366f1;
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
    outline: 0;
  }
  
  .filter-form .filter-btn {
    height: 38px;
    border-radius: 8px;
    font-size: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.375rem 1rem;
  }
  
  /* Mobile optimization for filters */
  @media (max-width: 768px) {
    .filter-section {
      padding: 1rem;
    }
    
    .filter-header {
      flex-direction: column;
      align-items: flex-start !important;
      gap: 0.75rem;
    }
    
    .filter-header button {
      align-self: flex-end;
    }
  }

  .badge-student {
    background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%) !important;
    color: white !important;
    padding: 0.5em 0.85em;
    font-weight: 600;
    border-radius: 6px;
    letter-spacing: 0.3px;
  }
  .badge-guardian {
    background: linear-gradient(135deg, #a855f7 0%, #7e22ce 100%) !important;
    color: white !important;
    padding: 0.5em 0.85em;
    font-weight: 600;
    border-radius: 6px;
    letter-spacing: 0.3px;
  }
  .badge-employee {
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%) !important;
    color: white !important;
    padding: 0.5em 0.85em;
    font-weight: 600;
    border-radius: 6px;
    letter-spacing: 0.3px;
  }
</style>

  <% if params[:status] == 'suspended' %>
    <!-- Suspended Participants Section -->
    <div class="card-body">
      <!-- 4 TOP SCORE CARDS FOR SUSPENDED -->
      <div class="row g-3 mb-4">
        <!-- Card 1: Total Suspended -->
        <div class="col-12 col-sm-6 col-xl-3">
          <div class="inst-kpi-card flex-column justify-content-between h-100 p-3">
            <div class="d-flex align-items-center justify-content-between mb-3">
              <div>
                <div class="text-uppercase text-muted fw-semibold mb-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">Total Suspended</div>
                <div class="h3 fw-bold mb-0 text-warning"><%= @total_suspended_count || 0 %></div>
              </div>
              <div class="inst-kpi-icon inst-kpi-icon-warning">
                <i class="bi bi-pause-circle-fill"></i>
              </div>
            </div>
            <div class="inst-kpi-breakdown">
              <span class="inst-kpi-pill inst-kpi-pill-stu" title="Students">
                <i class="bi bi-mortarboard"></i>Stu: <%= @suspended_by_type&.fetch('student', 0) || 0 %>
              </span>
              <span class="inst-kpi-pill inst-kpi-pill-gua" title="Guardians">
                <i class="bi bi-shield-shaded"></i>Gua: <%= @suspended_by_type&.fetch('guardian', 0) || 0 %>
              </span>
              <span class="inst-kpi-pill inst-kpi-pill-emp" title="Employees">
                <i class="bi bi-briefcase"></i>Emp: <%= @suspended_by_type&.fetch('employee', 0) || 0 %>
              </span>
            </div>
          </div>
        </div>

        <!-- Card 2: Students -->
        <div class="col-12 col-sm-6 col-xl-3">
          <div class="inst-kpi-card flex-column justify-content-between h-100 p-3">
            <div class="d-flex align-items-center justify-content-between mb-3">
              <div>
                <div class="text-uppercase text-muted fw-semibold mb-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">Students Suspended</div>
                <div class="h3 fw-bold mb-0 text-primary"><%= @suspended_by_type&.fetch('student', 0) || 0 %></div>
              </div>
              <div class="inst-kpi-icon inst-kpi-icon-primary">
                <i class="bi bi-mortarboard-fill"></i>
              </div>
            </div>
            <div class="pt-2 border-top border-light-subtle d-flex align-items-center justify-content-between text-muted mt-auto" style="font-size: 0.75rem;">
              <span class="fw-medium text-secondary">Share of suspended</span>
              <span class="badge bg-primary-subtle text-primary rounded-pill fw-semibold px-2.5 py-1">
                <%= @total_suspended_count && @total_suspended_count > 0 ? sprintf("%g%%", (((@suspended_by_type&.fetch('student', 0) || 0).to_f / @total_suspended_count) * 100).round(1)) : "0%" %>
              </span>
            </div>
          </div>
        </div>

        <!-- Card 3: Guardians -->
        <div class="col-12 col-sm-6 col-xl-3">
          <div class="inst-kpi-card flex-column justify-content-between h-100 p-3">
            <div class="d-flex align-items-center justify-content-between mb-3">
              <div>
                <div class="text-uppercase text-muted fw-semibold mb-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">Guardians Suspended</div>
                <div class="h3 fw-bold mb-0" style="color: #7e22ce;"><%= @suspended_by_type&.fetch('guardian', 0) || 0 %></div>
              </div>
              <div class="inst-kpi-icon inst-kpi-icon-purple">
                <i class="bi bi-shield-shaded"></i>
              </div>
            </div>
            <div class="pt-2 border-top border-light-subtle d-flex align-items-center justify-content-between text-muted mt-auto" style="font-size: 0.75rem;">
              <span class="fw-medium text-secondary">Share of suspended</span>
              <span class="badge rounded-pill fw-semibold px-2.5 py-1" style="background-color: #f3e8ff; color: #7e22ce; border: 1px solid #e9d5ff;">
                <%= @total_suspended_count && @total_suspended_count > 0 ? sprintf("%g%%", (((@suspended_by_type&.fetch('guardian', 0) || 0).to_f / @total_suspended_count) * 100).round(1)) : "0%" %>
              </span>
            </div>
          </div>
        </div>

        <!-- Card 4: Employees -->
        <div class="col-12 col-sm-6 col-xl-3">
          <div class="inst-kpi-card flex-column justify-content-between h-100 p-3">
            <div class="d-flex align-items-center justify-content-between mb-3">
              <div>
                <div class="text-uppercase text-muted fw-semibold mb-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">Employees Suspended</div>
                <div class="h3 fw-bold mb-0 text-warning"><%= @suspended_by_type&.fetch('employee', 0) || 0 %></div>
              </div>
              <div class="inst-kpi-icon inst-kpi-icon-warning">
                <i class="bi bi-briefcase-fill"></i>
              </div>
            </div>
            <div class="pt-2 border-top border-light-subtle d-flex align-items-center justify-content-between text-muted mt-auto" style="font-size: 0.75rem;">
              <span class="fw-medium text-secondary">Share of suspended</span>
              <span class="badge bg-warning-subtle text-warning rounded-pill fw-semibold px-2.5 py-1 border border-warning-subtle">
                <%= @total_suspended_count && @total_suspended_count > 0 ? sprintf("%g%%", (((@suspended_by_type&.fetch('employee', 0) || 0).to_f / @total_suspended_count) * 100).round(1)) : "0%" %>
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Filter Section -->
      <div class="filter-section mb-4">
        <div class="filter-header d-flex justify-content-between align-items-center mb-3">
          <h6 class="mb-0"><i class="bi bi-funnel me-2"></i>Filter Suspended Participants</h6>
          <button type="button" class="btn btn-sm btn-outline-secondary" onclick="clearFilters()">
            <i class="bi bi-x-circle me-1"></i>Clear Filters
          </button>
        </div>
        
        <%= form_with url: institute_admin_participants_path, method: :get, local: true, class: "filter-form" do |f| %>
          <%= hidden_field_tag :status, params[:status] %>
          
          <div class="row g-3 align-items-center">
            <!-- Search by Name or Mobile -->
            <div class="col-lg-3 col-md-6">
              <%= text_field_tag :search, params[:search], class: "form-control filter-input", placeholder: "Search by name or mobile..." %>
            </div>
            
            <!-- Filter by Type -->
            <div class="col-lg-2 col-md-6">
              <%= select_tag :participant_type, 
                  options_for_select([
                    ['All Types', ''],
                    ['Student', 'student'],
                    ['Guardian', 'guardian'],
                    ['Employee', 'employee']
                  ], params[:participant_type]), 
                  class: "form-select filter-input" %>
            </div>
            
            <!-- Filter by Section -->
            <div class="col-lg-3 col-md-6">
              <%= select_tag :section_id, 
                  options_for_select([['All Sections', '']] + @sections.map { |s| [s.name, s.id] }, params[:section_id]), 
                  class: "form-select filter-input" %>
            </div>
            
            <!-- Action Buttons -->
            <div class="col-lg-4 col-md-6">
              <div class="d-flex gap-2">
                <%= button_tag type: 'submit', class: 'btn btn-primary flex-grow-1 filter-btn' do %>
                  <i class="bi bi-funnel-fill me-2"></i>Apply Filters
                <% end %>
                <%= link_to institute_admin_participants_path(status: 'suspended'), class: 'btn btn-outline-secondary flex-grow-1 filter-btn' do %>
                  <i class="bi bi-arrow-clockwise me-2"></i>Reset
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
      
      <% if @participants.any? %>
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead>
              <tr>
                <th style="width: 40px;">
                  <input type="checkbox" id="selectAllSuspended" class="form-check-input" onchange="toggleSelectAllSuspended(this)">
                </th>
                <th>Name</th>
                <th>Type</th>
                <th>Section</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @participants.each do |participant| %>
                <tr>
                  <td>
                    <input type="checkbox" class="form-check-input suspended-participant-checkbox" 
                           value="<%= participant.id %>" 
                           onchange="updateSuspendedSelectedCount()">
                  </td>
                  <td>
                    <div class="fw-semibold text-dark"><%= participant.user.full_name %></div>
                    <div class="text-muted small"><%= participant.user.email %></div>
                    <% if participant.phone_number.present? || participant.user.phone.present? %>
                      <div class="text-muted small"><i class="bi bi-telephone me-1"></i><%= participant.phone_number.presence || participant.user.phone %></div>
                    <% end %>
                  </td>
                  <td>
                    <% badge_class = case participant.participant_type&.downcase
                                     when 'student', nil then 'badge-student'
                                     when 'guardian'     then 'badge-guardian'
                                     when 'employee'     then 'badge-employee'
                                     else 'bg-secondary'
                                     end %>
                    <span class="badge <%= badge_class %>">
                      <%= participant.participant_type&.titleize || "Student" %>
                    </span>
                  </td>
                  <td>
                    <% if participant.student? || participant.participant_type.nil? || participant.employee? %>
                      <%= participant.section&.name || 'Not Assigned' %>
                    <% elsif participant.guardian? %>
                      <% if participant.guardian_for_participant&.section %>
                        <%= participant.guardian_for_participant.section.name %>
                      <% else %>
                        <span class="text-muted">Student's Section</span>
                      <% end %>
                    <% end %>
                  </td>
                  <td>
                    <span class="badge rounded-pill fw-semibold px-2.5 py-1" style="background-color: #fef3c7; color: #b45309; border: 1px solid #fde68a;">
                      <i class="bi bi-pause-circle me-1"></i>Suspended
                    </span>
                  </td>
                  <td>
                    <%= link_to institute_admin_participant_path(participant), class: "btn action-btn btn-view me-2", title: "View" do %>
                      <i class="bi bi-eye"></i>
                    <% end %>
                    <%= link_to edit_institute_admin_participant_path(participant), class: "btn action-btn btn-edit me-2", title: "Edit" do %>
                      <i class="bi bi-pencil"></i>
                    <% end %>
                    <button type="button" class="btn action-btn btn-delete me-2" title="Delete" 
                            onclick="showDeleteModal('<%= escape_javascript(participant.user.full_name) %>', '<%= institute_admin_participant_path(participant) %>')">
                      <i class="bi bi-trash"></i>
                    </button>
                    <button type="button" class="btn btn-approve" title="Reactivate"
                            onclick="showReactivateModal('<%= escape_javascript(participant.user.full_name) %>', '<%= toggle_status_institute_admin_participant_path(participant) %>')">
                      <i class="bi bi-play-circle"></i> Reactivate
                    </button>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        
        <!-- Pagination for Suspended -->
        <% if @participants.total_pages > 1 %>
          <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="text-muted">
              Showing <%= @participants.offset_value + 1 %> to <%= [@participants.offset_value + @participants.limit_value, @participants.total_count].min %> of <%= @participants.total_count %> participants
            </div>
            <div>
              <%= paginate @participants, params: { status: 'suspended', search: params[:search], participant_type: params[:participant_type], section_id: params[:section_id] } %>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="text-center py-4">
          <i class="bi bi-pause-circle fs-1 text-muted mb-3"></i>
          <p class="text-muted mb-0">No suspended participants found</p>
        </div>
      <% end %>
    </div>
  <% elsif params[:approved] == 'false' %>
    <!-- Not Approved Participants Section -->
    <div class="card-body">
      <!-- Filter Section -->
      <div class="filter-section mb-4">
        <div class="filter-header d-flex justify-content-between align-items-center mb-3">
          <h6 class="mb-0"><i class="bi bi-funnel me-2"></i>Filter Participants</h6>
          <button type="button" class="btn btn-sm btn-outline-secondary" onclick="clearFilters()">
            <i class="bi bi-x-circle me-1"></i>Clear Filters
          </button>
        </div>
        
        <%= form_with url: institute_admin_participants_path, method: :get, local: true, class: "filter-form" do |f| %>
          <%= hidden_field_tag :approved, params[:approved] %>
          
          <div class="row g-3 align-items-center">
            <!-- Search by Name -->
            <div class="col-lg-3 col-md-6">
              <%= text_field_tag :search, params[:search], class: "form-control filter-input", placeholder: "Search by name..." %>
            </div>
            
            <!-- Filter by Type -->
            <div class="col-lg-2 col-md-6">
              <%= select_tag :participant_type, 
                  options_for_select([
                    ['All Types', ''],
                    ['Student', 'student'],
                    ['Guardian', 'guardian'],
                    ['Employee', 'employee']
                  ], params[:participant_type]), 
                  class: "form-select filter-input" %>
            </div>
            
            <!-- Filter by Section -->
            <div class="col-lg-3 col-md-6">
              <%= select_tag :section_id, 
                  options_for_select([['All Sections', '']] + @sections.map { |s| [s.name, s.id] }, params[:section_id]), 
                  class: "form-select filter-input" %>
            </div>
            
            <!-- Action Buttons -->
            <div class="col-lg-4 col-md-6">
              <div class="d-flex gap-2">
                <%= button_tag type: 'submit', class: 'btn btn-primary flex-grow-1 filter-btn' do %>
                  <i class="bi bi-funnel-fill me-2"></i>Apply Filters
                <% end %>
                <%= link_to institute_admin_participants_path(approved: params[:approved]), class: 'btn btn-outline-secondary flex-grow-1 filter-btn' do %>
                  <i class="bi bi-arrow-clockwise me-2"></i>Reset
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
      
      <% if @participants.any? %>
        <div class="table-responsive">
          <table class="table table-hover">
            <thead>
              <tr>
                <th style="width: 40px;">
                  <input type="checkbox" id="selectAll" class="form-check-input" onchange="toggleSelectAll(this)">
                </th>
                <th>Name</th>
                <th>Type</th>
                <th>Section</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @participants.each do |participant| %>
                <tr>
                  <td>
                    <input type="checkbox" class="form-check-input participant-checkbox" 
                           value="<%= participant.id %>" 
                           onchange="updateSelectedCount()">
                  </td>
                  <td><%= participant.user.full_name %></td>
                  <td>
                    <% badge_class = case participant.participant_type&.downcase
                                     when 'student', nil then 'badge-student'
                                     when 'guardian'     then 'badge-guardian'
                                     when 'employee'     then 'badge-employee'
                                     else 'bg-secondary'
                                     end %>
                    <span class="badge <%= badge_class %>">
                      <%= participant.participant_type&.titleize || "Student" %>
                    </span>
                  </td>
                  <td>
                    <% if participant.student? || participant.participant_type.nil? %>
                      <%= participant.section&.name || 'Not Assigned' %>
                    <% elsif participant.employee? %>
                      <%= participant.section&.name || 'Not Assigned' %>
                    <% elsif participant.guardian? %>
                      <% if participant.guardian_for_participant&.section %>
                        <%= participant.guardian_for_participant.section.name %>
                      <% else %>
                        <span class="text-muted">Student's Section</span>
                      <% end %>
                    <% end %>
                  </td>
                  <td>
                    <%= link_to institute_admin_participant_path(participant), class: "btn action-btn btn-view me-2", title: "View" do %>
                      <i class="bi bi-eye"></i>
                    <% end %>
                    <%= link_to edit_institute_admin_participant_path(participant), class: "btn action-btn btn-edit me-2", title: "Edit" do %>
                      <i class="bi bi-pencil"></i>
                    <% end %>
                    <button type="button" class="btn action-btn btn-delete me-2" title="Delete" 
                            onclick="showDeleteModal('<%= participant.user.full_name %>', '<%= institute_admin_participant_path(participant) %>')">
                      <i class="bi bi-trash"></i>
                    </button>
                    <button type="button" class="btn btn-approve" 
                            onclick="showApproveModal('<%= participant.user.full_name %>', '<%= toggle_status_institute_admin_participant_path(participant) %>')">
                      <i class="bi bi-check-circle"></i> Approve
                    </button>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        
        <!-- Pagination for Not Approved -->
        <% if @participants.total_pages > 1 %>
          <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="text-muted">
              Showing <%= @participants.offset_value + 1 %> to <%= [@participants.offset_value + @participants.limit_value, @participants.total_count].min %> of <%= @participants.total_count %> participants
            </div>
            <div>
              <%= paginate @participants, params: { approved: 'false', search: params[:search], participant_type: params[:participant_type], section_id: params[:section_id] } %>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="text-center py-4">
          <i class="bi bi-people fs-1 text-muted mb-3"></i>
          <p class="text-muted mb-0">No pending approval participants found</p>
        </div>
      <% end %>
    </div>
  <% else %>
    <!-- Approved Participants Section -->
    <div class="card-body">
      <!-- 4 TOP SCORE CARDS (ITEM 19c) -->
      <div class="row g-3 mb-4">
        <!-- Card 1: Total Approved -->
        <div class="col-12 col-sm-6 col-xl-3">
          <div class="inst-kpi-card flex-column justify-content-between h-100 p-3">
            <div class="d-flex align-items-center justify-content-between mb-3">
              <div>
                <div class="text-uppercase text-muted fw-semibold mb-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">Total Approved</div>
                <div class="h3 fw-bold mb-0 text-dark"><%= @total_approved_count || 0 %></div>
              </div>
              <div class="inst-kpi-icon inst-kpi-icon-primary">
                <i class="bi bi-person-check-fill"></i>
              </div>
            </div>
            <div class="inst-kpi-breakdown">
              <span class="inst-kpi-pill inst-kpi-pill-stu" title="Students">
                <i class="bi bi-mortarboard"></i>Stu: <%= @approved_by_type&.fetch('student', 0) || 0 %>
              </span>
              <span class="inst-kpi-pill inst-kpi-pill-gua" title="Guardians">
                <i class="bi bi-shield-shaded"></i>Gua: <%= @approved_by_type&.fetch('guardian', 0) || 0 %>
              </span>
              <span class="inst-kpi-pill inst-kpi-pill-emp" title="Employees">
                <i class="bi bi-briefcase"></i>Emp: <%= @approved_by_type&.fetch('employee', 0) || 0 %>
              </span>
            </div>
          </div>
        </div>

        <!-- Card 2: Students -->
        <div class="col-12 col-sm-6 col-xl-3">
          <div class="inst-kpi-card flex-column justify-content-between h-100 p-3">
            <div class="d-flex align-items-center justify-content-between mb-3">
              <div>
                <div class="text-uppercase text-muted fw-semibold mb-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">Students</div>
                <div class="h3 fw-bold mb-0 text-primary"><%= @approved_by_type&.fetch('student', 0) || 0 %></div>
              </div>
              <div class="inst-kpi-icon inst-kpi-icon-primary">
                <i class="bi bi-mortarboard-fill"></i>
              </div>
            </div>
            <div class="pt-2 border-top border-light-subtle d-flex align-items-center justify-content-between text-muted mt-auto" style="font-size: 0.75rem;">
              <span class="fw-medium text-secondary">Share of participants</span>
              <span class="badge bg-primary-subtle text-primary rounded-pill fw-semibold px-2.5 py-1">
                <%= @total_approved_count && @total_approved_count > 0 ? sprintf("%g%%", (((@approved_by_type&.fetch('student', 0) || 0).to_f / @total_approved_count) * 100).round(1)) : "0%" %>
              </span>
            </div>
          </div>
        </div>

        <!-- Card 3: Guardians -->
        <div class="col-12 col-sm-6 col-xl-3">
          <div class="inst-kpi-card flex-column justify-content-between h-100 p-3">
            <div class="d-flex align-items-center justify-content-between mb-3">
              <div>
                <div class="text-uppercase text-muted fw-semibold mb-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">Guardians</div>
                <div class="h3 fw-bold mb-0" style="color: #7e22ce;"><%= @approved_by_type&.fetch('guardian', 0) || 0 %></div>
              </div>
              <div class="inst-kpi-icon inst-kpi-icon-purple">
                <i class="bi bi-shield-shaded"></i>
              </div>
            </div>
            <div class="pt-2 border-top border-light-subtle d-flex align-items-center justify-content-between text-muted mt-auto" style="font-size: 0.75rem;">
              <span class="fw-medium text-secondary">Share of participants</span>
              <span class="badge rounded-pill fw-semibold px-2.5 py-1" style="background-color: #f3e8ff; color: #7e22ce; border: 1px solid #e9d5ff;">
                <%= @total_approved_count && @total_approved_count > 0 ? sprintf("%g%%", (((@approved_by_type&.fetch('guardian', 0) || 0).to_f / @total_approved_count) * 100).round(1)) : "0%" %>
              </span>
            </div>
          </div>
        </div>

        <!-- Card 4: Employees -->
        <div class="col-12 col-sm-6 col-xl-3">
          <div class="inst-kpi-card flex-column justify-content-between h-100 p-3">
            <div class="d-flex align-items-center justify-content-between mb-3">
              <div>
                <div class="text-uppercase text-muted fw-semibold mb-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">Employees</div>
                <div class="h3 fw-bold mb-0 text-warning"><%= @approved_by_type&.fetch('employee', 0) || 0 %></div>
              </div>
              <div class="inst-kpi-icon inst-kpi-icon-warning">
                <i class="bi bi-briefcase-fill"></i>
              </div>
            </div>
            <div class="pt-2 border-top border-light-subtle d-flex align-items-center justify-content-between text-muted mt-auto" style="font-size: 0.75rem;">
              <span class="fw-medium text-secondary">Share of participants</span>
              <span class="badge bg-warning-subtle text-warning rounded-pill fw-semibold px-2.5 py-1 border border-warning-subtle">
                <%= @total_approved_count && @total_approved_count > 0 ? sprintf("%g%%", (((@approved_by_type&.fetch('employee', 0) || 0).to_f / @total_approved_count) * 100).round(1)) : "0%" %>
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- FILTER SECTION WITH MULTI-SELECT & MOBILE SEARCH (ITEM 19a, e, f) -->
      <%
        part_active_filters_count = 0
        part_active_filters_count += 1 if params[:search].present?
        part_active_filters_count += 1 if @selected_participant_types.present? && @selected_participant_types.size < 3
        part_active_filters_count += 1 if @selected_section_ids.present? && !@selected_section_ids.include?('all')
      %>
      <div class="filter-toolbar-card bg-white rounded-4 shadow-sm border mb-4 p-3 p-md-4">
        <%= form_with url: institute_admin_participants_path, method: :get, local: true, id: "approvedParticipantsForm", class: "filter-form" do |f| %>
          <%= hidden_field_tag :approved, params[:approved] %>
          
          <div class="row g-2 g-md-3 align-items-center mb-3">
            <!-- Search by Name or Mobile (Item 19a) -->
            <div class="col-12 col-md-7 col-lg-8">
              <div class="input-group">
                <span class="input-group-text bg-white border-end-0 ps-3 pe-2">
                  <i class="bi bi-search text-primary"></i>
                </span>
                <%= text_field_tag :search, params[:search], 
                    id: "participantSearchInput",
                    class: "form-control border-start-0 border-end-0 ps-1 text-dark fw-medium", 
                    placeholder: "Search by name, email, or mobile number...", 
                    autocomplete: "off" %>
                <% if params[:search].present? %>
                  <button type="button" 
                          class="btn btn-link text-muted pe-3 text-decoration-none border-start-0 border-end-0" 
                          onclick="document.getElementById('participantSearchInput').value=''; document.getElementById('approvedParticipantsForm').submit();" 
                          title="Clear search">
                    <i class="bi bi-x-circle-fill"></i>
                  </button>
                <% end %>
                <button type="submit" class="btn btn-primary px-3 rounded-end-3 d-inline-flex align-items-center gap-1.5 fw-semibold shadow-sm">
                  <i class="bi bi-search"></i>
                  <span>Search</span>
                </button>
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="col-12 col-md-5 col-lg-4 d-flex align-items-center justify-content-md-end gap-2">
              <%= link_to institute_admin_participants_path(approved: params[:approved]), class: "btn btn-outline-secondary px-3 rounded-3 d-inline-flex align-items-center justify-content-center gap-1.5 w-50 w-md-auto flex-md-grow-0", title: "Reset All Filters" do %>
                <i class="bi bi-arrow-counterclockwise"></i>
                <span>Reset</span>
                <% if part_active_filters_count > 0 %>
                  <span class="badge bg-secondary text-white rounded-pill ms-1" style="font-size: 0.72rem;"><%= part_active_filters_count %></span>
                <% end %>
              <% end %>

              <button type="submit" class="btn btn-primary px-3 px-sm-4 rounded-3 d-inline-flex align-items-center justify-content-center gap-1.5 fw-semibold shadow-sm w-50 w-md-auto flex-md-grow-0">
                <i class="bi bi-funnel-fill"></i>
                <span>Apply Filters</span>
              </button>
            </div>
          </div>

          <div class="row g-2 g-md-3 align-items-center">
            <!-- Filter by Type (Multi-Select) (Item 19e) -->
            <div class="col-12 col-md-6 col-lg-4">
              <div class="dropdown multiselect-dropdown">
                <button class="filter-dropdown-btn dropdown-toggle w-100 text-start d-flex align-items-center justify-content-between <%= 'filter-active-indigo' if @selected_participant_types.present? && @selected_participant_types.size < 3 %>" 
                        type="button" 
                        data-bs-toggle="dropdown" 
                        data-bs-display="static"
                        data-bs-auto-close="outside"
                        aria-expanded="false">
                  <span class="d-inline-flex align-items-center text-truncate">
                    <i class="bi bi-person-badge me-2 text-primary flex-shrink-0"></i>
                    <span class="dropdown-label text-truncate" id="typeLabel">
                      Type (<%= @selected_participant_types.blank? || @selected_participant_types.size == 3 ? 'All' : @selected_participant_types.map(&:titleize).join(', ') %>)
                    </span>
                  </span>
                </button>
                <div class="dropdown-menu dropdown-menu-start p-2 shadow-lg rounded-3 border">
                  <div class="d-flex justify-content-between px-1 mb-2 pb-1 border-bottom">
                    <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none fw-semibold text-primary" style="font-size: 0.75rem;" onclick="selectAllDropdownCheckboxes(this, true, 'typeLabel', 'Type', 'participant_types[]')">Select All</button>
                    <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none text-muted" style="font-size: 0.75rem;" onclick="selectAllDropdownCheckboxes(this, false, 'typeLabel', 'Type', 'participant_types[]')">Clear</button>
                  </div>
                  <div class="multiselect-options-list">
                    <% [ ['Student', 'student'], ['Guardian', 'guardian'], ['Employee', 'employee'] ].each do |label, val| %>
                      <div class="form-check dropdown-item rounded px-2 py-1.5 multiselect-item d-flex align-items-center gap-2">
                        <input class="form-check-input flex-shrink-0" 
                               type="checkbox" 
                               name="participant_types[]" 
                               value="<%= val %>" 
                               id="ptype_cb_<%= val %>" 
                               <%= 'checked' if @selected_participant_types.blank? || @selected_participant_types.include?(val) %>
                               onchange="updateParticipantTypeCounter()">
                        <label class="form-check-label flex-grow-1 cursor-pointer small" for="ptype_cb_<%= val %>">
                          <%= label %>
                        </label>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>

            <!-- Filter by Section (Multi-Select) (Item 19f) -->
            <div class="col-12 col-md-6 col-lg-4">
              <div class="dropdown multiselect-dropdown">
                <button class="filter-dropdown-btn dropdown-toggle w-100 text-start d-flex align-items-center justify-content-between <%= 'filter-active-indigo' if @selected_section_ids.present? && !@selected_section_ids.include?('all') %>" 
                        type="button" 
                        data-bs-toggle="dropdown" 
                        data-bs-display="static"
                        data-bs-auto-close="outside"
                        aria-expanded="false">
                  <span class="d-inline-flex align-items-center text-truncate">
                    <i class="bi bi-people me-2 text-primary flex-shrink-0"></i>
                    <span class="dropdown-label text-truncate" id="partSecLabel">
                      Sections (<%= @selected_section_ids.blank? || @selected_section_ids.include?('all') ? 'All' : @selected_section_ids.size %>)
                    </span>
                  </span>
                </button>
                <div class="dropdown-menu dropdown-menu-start p-2 shadow-lg rounded-3 border">
                  <div class="px-1 mb-2">
                    <input type="text" class="form-control form-control-sm multiselect-search" placeholder="Search sections..." oninput="filterDropdownList(this)">
                  </div>
                  <div class="d-flex justify-content-between px-1 mb-2 pb-1 border-bottom">
                    <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none fw-semibold text-primary" style="font-size: 0.75rem;" onclick="selectAllDropdownCheckboxes(this, true, 'partSecLabel', 'Sections', 'section_ids[]')">Select All</button>
                    <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none text-muted" style="font-size: 0.75rem;" onclick="selectAllDropdownCheckboxes(this, false, 'partSecLabel', 'Sections', 'section_ids[]')">Clear</button>
                  </div>
                  <div class="multiselect-options-list">
                    <% @sections.each do |sec| %>
                      <div class="form-check dropdown-item rounded px-2 py-1.5 multiselect-item d-flex align-items-start gap-2">
                        <input class="form-check-input mt-1 flex-shrink-0" 
                               type="checkbox" 
                               name="section_ids[]" 
                               value="<%= sec.id %>" 
                               id="sec_cb_<%= sec.id %>" 
                               <%= 'checked' if @selected_section_ids&.include?(sec.id.to_s) %>
                               onchange="updateDropdownCounter('partSecLabel', 'Sections', 'section_ids[]')">
                        <label class="form-check-label flex-grow-1 cursor-pointer small" for="sec_cb_<%= sec.id %>" title="<%= sec.name %>">
                          <%= sec.name %>
                        </label>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
      
      <!-- DATA TABLE WITH SERIAL NUMBER & MOBILE NUMBER (ITEM 19b, d) -->
      <% if @participants.any? %>
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead>
              <tr>
                <th style="width: 40px;" class="text-center">
                  <input type="checkbox" id="selectAllApproved" class="form-check-input" onchange="toggleSelectAllApproved(this)">
                </th>
                <th style="width: 50px;" class="text-center">#</th>
                <th>Name</th>
                <th>Mobile Number</th>
                <th>Type</th>
                <th>Section</th>
                <th class="text-center">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @participants.each_with_index do |participant, idx| %>
                <tr>
                  <td class="text-center">
                    <input type="checkbox" class="form-check-input approved-participant-checkbox" 
                           value="<%= participant.id %>" 
                           onchange="updateApprovedSelectedCount()">
                  </td>
                  <td class="text-center fw-medium text-secondary">
                    <%= @participants.offset_value + idx + 1 %>
                  </td>
                  <td>
                    <div class="fw-semibold text-dark"><%= participant.user.full_name %></div>
                    <div class="text-muted small"><%= participant.user.email %></div>
                  </td>
                  <td>
                    <% mobile_no = participant.user&.phone.presence || participant.phone_number.presence %>
                    <% if mobile_no.present? %>
                      <span class="d-inline-flex align-items-center gap-1.5 text-dark fw-medium">
                        <i class="bi bi-telephone text-primary small"></i>
                        <span><%= mobile_no %></span>
                      </span>
                    <% else %>
                      <span class="text-muted small">N/A</span>
                    <% end %>
                  </td>
                  <td>
                    <% badge_class = case participant.participant_type&.downcase
                                     when 'student', nil then 'badge-student'
                                     when 'guardian'     then 'badge-guardian'
                                     when 'employee'     then 'badge-employee'
                                     else 'bg-secondary'
                                     end %>
                    <span class="badge <%= badge_class %>">
                      <%= participant.participant_type&.titleize || "Student" %>
                    </span>
                  </td>
                  <td>
                    <% if participant.student? || participant.participant_type.nil? %>
                      <%= participant.section&.name || 'Not Assigned' %>
                    <% elsif participant.employee? %>
                      <%= participant.section&.name || 'Not Assigned' %>
                    <% elsif participant.guardian? %>
                      <% if participant.guardian_for_participant&.section %>
                        <%= participant.guardian_for_participant.section.name %>
                      <% else %>
                        <span class="text-muted">Student's Section</span>
                      <% end %>
                    <% end %>
                  </td>
                  <td class="text-center">
                    <%= link_to institute_admin_participant_path(participant), class: "btn action-btn btn-view me-2", title: "View" do %>
                      <i class="bi bi-eye"></i>
                    <% end %>
                    <%= link_to edit_institute_admin_participant_path(participant), class: "btn action-btn btn-edit me-2", title: "Edit" do %>
                      <i class="bi bi-pencil"></i>
                    <% end %>
                    <button type="button" class="btn action-btn btn-suspend me-2" title="Suspend / Deactivate" 
                            onclick="showSuspendModal('<%= escape_javascript(participant.user.full_name) %>', '<%= toggle_status_institute_admin_participant_path(participant) %>')">
                      <i class="bi bi-pause-circle"></i>
                    </button>
                    <button type="button" class="btn action-btn btn-delete" title="Delete" 
                            onclick="showDeleteModal('<%= escape_javascript(participant.user.full_name) %>', '<%= institute_admin_participant_path(participant) %>')">
                      <i class="bi bi-trash"></i>
                    </button>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        
        <!-- Pagination for Approved -->
        <% if @participants.total_pages > 1 %>
          <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="text-muted">
              Showing <%= @participants.offset_value + 1 %> to <%= [@participants.offset_value + @participants.limit_value, @participants.total_count].min %> of <%= @participants.total_count %> participants
            </div>
            <div>
              <%= paginate @participants, params: { approved: 'true', search: params[:search], participant_types: @selected_participant_types, section_ids: @selected_section_ids } %>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="text-center py-4">
          <i class="bi bi-people fs-1 text-muted mb-3"></i>
          <p class="text-muted mb-0">No approved participants found</p>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<!-- Beautiful Delete Confirmation Modal -->
<div id="deleteModal" class="custom-modal" style="display: none;">
  <div class="modal-overlay"></div>
  <div class="modal-container">
    <div class="modal-content">
      <!-- Icon -->
      <div class="modal-icon">
        <div class="icon-circle">
          <i class="bi bi-exclamation-triangle"></i>
        </div>
      </div>
      
      <!-- Content -->
      <h3 class="modal-title">Delete Participant?</h3>
      <p class="modal-message">
        Are you sure you want to delete <strong id="participantName"></strong>? 
        The participant will be deactivated and removed from active institute records.
      </p>
      
      <!-- Actions -->
      <div class="modal-actions">
        <button type="button" class="btn-modal btn-cancel" onclick="closeDeleteModal()">
          <i class="bi bi-x-circle me-2"></i>Cancel
        </button>
        <form id="deleteForm" method="post" style="display: inline-block;">
          <input type="hidden" name="_method" value="delete">
          <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
          <button type="submit" class="btn-modal btn-delete-confirm">
            <i class="bi bi-trash me-2"></i>Yes, Delete
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Beautiful Approve Confirmation Modal -->
<div id="approveModal" class="custom-modal" style="display: none;">
  <div class="modal-overlay"></div>
  <div class="modal-container">
    <div class="modal-content">
      <!-- Icon -->
      <div class="modal-icon">
        <div class="icon-circle-approve">
          <i class="bi bi-check-circle"></i>
        </div>
      </div>
      
      <!-- Content -->
      <h3 class="modal-title">Approve Participant?</h3>
      <p class="modal-message">
        Are you sure you want to approve <strong id="approveParticipantName"></strong>? 
        They will be granted access to the system immediately.
      </p>
      
      <!-- Actions -->
      <div class="modal-actions">
        <button type="button" class="btn-modal btn-cancel" onclick="closeApproveModal()">
          <i class="bi bi-x-circle me-2"></i>Cancel
