<script>
  function filterDropdownList(input) {
    const term = input.value.toLowerCase().trim();
    const dropdownMenu = input.closest('.dropdown-menu');
    const items = dropdownMenu.querySelectorAll('.multiselect-item');
    items.forEach(item => {
      const text = item.textContent.toLowerCase();
      item.style.display = text.includes(term) ? 'flex' : 'none';
    });
  }

  function selectAllDropdownCheckboxes(btn, selectAll, labelId, prefix, inputName) {
    const dropdownMenu = btn.closest('.dropdown-menu');
    const checkboxes = dropdownMenu.querySelectorAll(`.multiselect-options-list input[name="${inputName}"]`);
    checkboxes.forEach(cb => {
      const itemWrapper = cb.closest('.multiselect-item');
      if (!itemWrapper || itemWrapper.style.display !== 'none') {
        cb.checked = selectAll;
      }
    });
    if (inputName === 'participant_types[]') {
      updateParticipantTypeCounter();
    } else {
      updateDropdownCounter(labelId, prefix, inputName);
    }
  }

  function updateDropdownCounter(labelId, prefix, inputName) {
    if (!inputName) return;
    const checkedBoxes = document.querySelectorAll(`input[name="${inputName}"]:checked`);
    const allBoxes = document.querySelectorAll(`input[name="${inputName}"]`);
    const labelEl = document.getElementById(labelId);
    if (!labelEl) return;

    const btn = labelEl.closest('.filter-dropdown-btn');

    if (checkedBoxes.length === 0 || checkedBoxes.length === allBoxes.length) {
      labelEl.innerText = `${prefix} (All)`;
      if (btn) btn.classList.remove('filter-active-indigo');
    } else {
      labelEl.innerText = `${prefix} (${checkedBoxes.length})`;
      if (btn) btn.classList.add('filter-active-indigo');
    }
  }

  function updateParticipantTypeCounter() {
    const checked = document.querySelectorAll('input[name="participant_types[]"]:checked');
    const labelEl = document.getElementById('typeLabel');
    if (!labelEl) return;

    const btn = labelEl.closest('.filter-dropdown-btn');

    if (checked.length === 0 || checked.length === 3) {
      labelEl.innerText = 'Type (All)';
      if (btn) btn.classList.remove('filter-active-indigo');
    } else {
      const types = Array.from(checked).map(c => {
        return c.value.charAt(0).toUpperCase() + c.value.slice(1);
      }).join(', ');
      labelEl.innerText = `Type (${types})`;
      if (btn) btn.classList.add('filter-active-indigo');
    }
  }

  function clearFilters() {
    const form = document.querySelector('.filter-form');
    const searchInput = form.querySelector('input[name="search"]');
    const typeSelect = form.querySelector('select[name="participant_type"]');
    const sectionSelect = form.querySelector('select[name="section_id"]');
    
    if (searchInput) searchInput.value = '';
    if (typeSelect) typeSelect.value = '';
    if (sectionSelect) sectionSelect.value = '';
  }
  
  // Multi-select functions
  function toggleSelectAll(checkbox) {
    const checkboxes = document.querySelectorAll('.participant-checkbox');
    checkboxes.forEach(cb => {
      cb.checked = checkbox.checked;
    });
    updateSelectedCount();
  }
  
  function updateSelectedCount() {
    const checkboxes = document.querySelectorAll('.participant-checkbox:checked');
    const count = checkboxes.length;
    const approveBtn = document.getElementById('approveSelectedBtn');
