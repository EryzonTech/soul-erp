  // Close modal when clicking overlay
  document.addEventListener('DOMContentLoaded', function() {
    const deleteModal = document.getElementById('deleteModal');
    const approveModal = document.getElementById('approveModal');
    const approveAllModal = document.getElementById('approveAllModal');
    const approveSelectedModal = document.getElementById('approveSelectedModal');
    const suspendModal = document.getElementById('suspendModal');
    const deactivateSelectedModal = document.getElementById('deactivateSelectedModal');
    const reactivateModal = document.getElementById('reactivateModal');
    const reactivateSelectedModal = document.getElementById('reactivateSelectedModal');
    
    if (deleteModal) {
      const overlay = deleteModal.querySelector('.modal-overlay');
      if (overlay) overlay.addEventListener('click', closeDeleteModal);
    }
    
    if (approveModal) {
      const overlay = approveModal.querySelector('.modal-overlay');
      if (overlay) overlay.addEventListener('click', closeApproveModal);
    }
    
    if (approveAllModal) {
      const overlay = approveAllModal.querySelector('.modal-overlay');
      if (overlay) overlay.addEventListener('click', closeApproveAllModal);
    }

    if (approveSelectedModal) {
      const overlay = approveSelectedModal.querySelector('.modal-overlay');
      if (overlay) overlay.addEventListener('click', closeApproveSelectedModal);
    }

    if (suspendModal) {
      const overlay = suspendModal.querySelector('.modal-overlay');
      if (overlay) overlay.addEventListener('click', closeSuspendModal);
    }

    if (deactivateSelectedModal) {
      const overlay = deactivateSelectedModal.querySelector('.modal-overlay');
      if (overlay) overlay.addEventListener('click', closeDeactivateSelectedModal);
    }

    if (reactivateModal) {
      const overlay = reactivateModal.querySelector('.modal-overlay');
      if (overlay) overlay.addEventListener('click', closeReactivateModal);
    }

    if (reactivateSelectedModal) {
      const overlay = reactivateSelectedModal.querySelector('.modal-overlay');
      if (overlay) overlay.addEventListener('click', closeReactivateSelectedModal);
    }
  });
  
  // Close modal with Escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeDeleteModal();
      closeApproveModal();
      closeApproveAllModal();
      closeApproveSelectedModal();
      closeSuspendModal();
      closeDeactivateSelectedModal();
      closeReactivateModal();
      closeReactivateSelectedModal();
    }
  });
</script>
 