<% content_for :styles do %>
  <style>
    .stat-card {
      border: none;
      border-radius: 20px;
      position: relative;
      overflow: hidden;
      transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      min-height: 140px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .stat-card:hover {
      transform: translateY(-5px); /* Reduced movement */
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    }

    /* ... (rest of stat-card styles unchanged) ... */

    .stat-card .card-body {
      position: relative;
      z-index: 1;
      padding: 1.25rem; /* Reduced padding */
    }

    .stat-card .stat-title {
      font-size: 0.85rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      opacity: 0.9;
      margin-bottom: 0.25rem;
      color: rgba(255, 255, 255, 0.9);
    }

    .stat-card .stat-value {
      font-size: 2rem; /* Slightly smaller */
      font-weight: 700;
      line-height: 1;
      color: #fff;
      margin-bottom: 0;
    }

    .stat-card .stat-icon {
      position: absolute;
      right: 1.25rem;
      top: 50%;
      transform: translateY(-50%);
      font-size: 3rem; /* Slightly smaller */
      color: rgba(255, 255, 255, 0.2);
      transition: all 0.3s ease;
    }

    /* ... (hover effect unchanged) ... */

    /* Card Variants Row 1 */
    .stat-card-participants {
      background: linear-gradient(135deg, #4f46e5 0%, #818cf8 100%);
      box-shadow: 0 8px 20px rgba(79, 70, 229, 0.25);
    }

    .stat-card-questions {
      background: linear-gradient(135deg, #059669 0%, #34d399 100%);
      box-shadow: 0 8px 20px rgba(5, 150, 105, 0.25);
    }

    .stat-card-assignments {
      background: linear-gradient(135deg, #d97706 0%, #fbbf24 100%);
      box-shadow: 0 8px 20px rgba(217, 119, 6, 0.25);
    }

    .stat-card-sections {
      background: linear-gradient(135deg, #e11d48 0%, #fb7185 100%);
      box-shadow: 0 8px 20px rgba(225, 29, 72, 0.25);
    }

    /* Operational Metric Cards (Row 2 - Distinguished Identity) */
    .op-stat-card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 16px;
      position: relative;
      overflow: hidden;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      min-height: 128px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04), 0 4px 12px rgba(15, 23, 42, 0.02);
    }

    .op-stat-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
      border-color: #cbd5e1;
    }

    .op-stat-card .card-body {
      padding: 1.1rem 1.25rem;
      position: relative;
      display: flex;
      flex-direction: column;
      height: 100%;
      justify-content: space-between;
    }

    .op-stat-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 0.5rem;
    }

    .op-stat-title {
      font-size: 0.74rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      color: #64748b;
      margin-bottom: 0.35rem;
    }

    .op-stat-value {
      font-size: 1.85rem;
      font-weight: 700;
      color: #0f172a;
      line-height: 1.1;
      letter-spacing: -0.5px;
    }

    .op-stat-icon-box {
      width: 42px;
      height: 42px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      flex-shrink: 0;
      transition: transform 0.2s ease;
    }

    .op-stat-card:hover .op-stat-icon-box {
      transform: scale(1.08);
    }

    /* Distinct Card Identity & Border Top Accents */
    .op-stat-card-responses {
      border-top: 3.5px solid #06b6d4;
      background: linear-gradient(180deg, #ffffff 65%, rgba(6, 182, 212, 0.04) 100%);
    }
    .op-stat-card-responses .op-stat-icon-box {
      background: rgba(6, 182, 212, 0.12);
      color: #0891b2;
    }

    .op-stat-card-trainers {
      border-top: 3.5px solid #8b5cf6;
      background: linear-gradient(180deg, #ffffff 65%, rgba(139, 92, 246, 0.04) 100%);
    }
    .op-stat-card-trainers .op-stat-icon-box {
      background: rgba(139, 92, 246, 0.12);
      color: #7c3aed;
    }

    .op-stat-card-programs {
      border-top: 3.5px solid #10b981;
      background: linear-gradient(180deg, #ffffff 65%, rgba(16, 185, 129, 0.04) 100%);
    }
    .op-stat-card-programs .op-stat-icon-box {
      background: rgba(16, 185, 129, 0.12);
      color: #059669;
    }

    .op-stat-card-feedback {
      border-top: 3.5px solid #ec4899;
      background: linear-gradient(180deg, #ffffff 65%, rgba(236, 72, 153, 0.04) 100%);
    }
    .op-stat-card-feedback .op-stat-icon-box {
      background: rgba(236, 72, 153, 0.12);
      color: #db2777;
    }

    /* Breakdown in Operational Cards */
    .op-stat-card .stat-breakdown,
    .op-stat-breakdown {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      flex-wrap: wrap;
      margin-top: 0.65rem;
      padding-top: 0.5rem;
      border-top: 1px dashed #e2e8f0;
    }

    .op-stat-card .stat-breakdown-pill,
    .op-stat-breakdown-pill {
      font-size: 0.72rem;
      font-weight: 500;
      padding: 0.2rem 0.55rem;
      border-radius: 9999px;
      background: #f1f5f9;
      color: #334155 !important;
      border: 1px solid #e2e8f0;
      backdrop-filter: none;
      white-space: nowrap;
      letter-spacing: 0.1px;
    }

    .op-stat-card .stat-breakdown-pill strong,
    .op-stat-breakdown-pill strong {
      color: #0f172a !important;
      font-weight: 700;
    }

    /* Modern Table Styles with mobile touch momentum */
    .table-responsive {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch !important;
      touch-action: pan-x pan-y !important;
      width: 100% !important;
      max-width: 100% !important;
      overscroll-behavior-x: contain;
    }

    .modern-table {
      width: 100%;
      min-width: 540px;
      border-collapse: separate;
      border-spacing: 0 0.75rem;
      margin-top: -0.75rem;
    }

    .modern-table thead th {
      background: #1e293b;
      color: #fff;
      font-weight: 600;
      text-transform: uppercase;
      font-size: 0.75rem;
      letter-spacing: 1px;
      padding: 1rem 1.5rem;
      border: none;
    }

    .modern-table thead th:first-child {
      border-top-left-radius: 8px;
      border-bottom-left-radius: 8px;
    }

    .modern-table thead th:last-child {
      border-top-right-radius: 8px;
      border-bottom-right-radius: 8px;
    }

    .modern-table tbody tr {
      background: #fff;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
      transition: all 0.2s ease;
    }

    .modern-table tbody tr:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    }

    .modern-table tbody td {
      padding: 1.25rem 1.5rem;
      vertical-align: middle;
      border: none;
      font-size: 0.95rem;
      color: #475569;
    }

    .modern-table tbody td:first-child {
      border-top-left-radius: 8px;
      border-bottom-left-radius: 8px;
    }

    .modern-table tbody td:last-child {
      border-top-right-radius: 8px;
      border-bottom-right-radius: 8px;
    }

    .status-badge {
      padding: 0.35em 0.85em;
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .status-badge-ongoing {
      background-color: #dcfce7;
      color: #166534;
    }

    .status-badge-completed {
      background-color: #f1f5f9;
      color: #475569;
      background-color: #475569;
      color: white;
    }

    .action-btn {
      width: 32px;
      height: 32px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background-color: #f8fafc;
      color: #64748b;
      transition: all 0.2s;
    }

    .stat-breakdown {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      flex-wrap: wrap;
      margin-top: 0.65rem;
      padding-top: 0.5rem;
      border-top: 1px solid rgba(255, 255, 255, 0.2);
    }

    .stat-card .stat-breakdown-pill {
      font-size: 0.7rem;
      font-weight: 600;
      padding: 0.2rem 0.55rem;
      border-radius: 9999px;
      background: rgba(255, 255, 255, 0.22);
      color: #ffffff;
      backdrop-filter: blur(4px);
      letter-spacing: 0.2px;
      white-space: nowrap;
    }

    .chart-controls-toolbar {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      flex-wrap: wrap;
    }

    .chart-nav-btn {
      padding: 0.25rem 0.65rem;
      font-size: 0.78rem;
      border-radius: 8px;
    }

    .pointer-events-none {
      pointer-events: none;
    }
  </style>
<% end %>

<!-- Institute Admin Dashboard -->
<div class="container-fluid py-4">
  <!-- KPI Cards Row 1 -->
  <div class="row g-4 mb-4">
    <!-- Total Participants -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="stat-card stat-card-participants">
        <div class="card-body">
          <div class="stat-title">Total Participants</div>
          <h2 class="stat-value"><%= @total_participants %></h2>
          <i class="bi bi-people-fill stat-icon"></i>
          <div class="stat-breakdown">
            <span class="stat-breakdown-pill">Students: <%= @participant_type_distribution["student"] || 0 %></span>
            <span class="stat-breakdown-pill">Guardians: <%= @participant_type_distribution["guardian"] || 0 %></span>
            <span class="stat-breakdown-pill">Employees: <%= @participant_type_distribution["employee"] || 0 %></span>
          </div>
        </div>
      </div>
    </div>

    <!-- Total Questions -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="stat-card stat-card-questions">
        <div class="card-body">
          <div class="stat-title">Total Questions</div>
          <h2 class="stat-value"><%= @total_questions %></h2>
          <i class="bi bi-question-circle-fill stat-icon"></i>
        </div>
      </div>
    </div>

    <!-- Total Assignments -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="stat-card stat-card-assignments">
        <div class="card-body">
          <div class="stat-title">Total Assignments</div>
          <h2 class="stat-value"><%= @total_assignments %></h2>
          <i class="bi bi-clipboard-check-fill stat-icon"></i>
          <div class="stat-breakdown">
            <span class="stat-breakdown-pill">Students: <%= @assignment_type_distribution["student"] || 0 %></span>
            <span class="stat-breakdown-pill">Guardians: <%= @assignment_type_distribution["guardian"] || 0 %></span>
            <span class="stat-breakdown-pill">Employees: <%= @assignment_type_distribution["employee"] || 0 %></span>
          </div>
        </div>
      </div>
    </div>

    <!-- Total Sections -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="stat-card stat-card-sections">
        <div class="card-body">
          <div class="stat-title">Total Sections</div>
          <h2 class="stat-value"><%= @total_sections %></h2>
          <i class="bi bi-grid-fill stat-icon"></i>
        </div>
      </div>
    </div>
  </div>

  <!-- KPI Cards Row 2: Operational & Activity Metrics (Distinguished Identity) -->
  <div class="row g-4 mb-4">
    <!-- Today Responses -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="op-stat-card op-stat-card-responses">
        <div class="card-body">
          <div class="op-stat-header">
            <div>
              <div class="op-stat-title">Today Responses</div>
              <div class="op-stat-value"><%= @today_responses_count || 0 %></div>
            </div>
            <div class="op-stat-icon-box">
              <i class="bi bi-file-earmark-check-fill"></i>
            </div>
          </div>
          <div class="op-stat-breakdown stat-breakdown">
            <span class="op-stat-breakdown-pill">Students: <strong><%= @today_responses_by_type["student"] || 0 %></strong></span>
            <span class="op-stat-breakdown-pill">Guardians: <strong><%= @today_responses_by_type["guardian"] || 0 %></strong></span>
            <span class="op-stat-breakdown-pill">Employees: <strong><%= @today_responses_by_type["employee"] || 0 %></strong></span>
          </div>
        </div>
      </div>
    </div>

    <!-- Total Trainers -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="op-stat-card op-stat-card-trainers">
        <div class="card-body">
          <div class="op-stat-header">
            <div>
              <div class="op-stat-title">Total Trainers</div>
              <div class="op-stat-value"><%= @total_trainers %></div>
            </div>
            <div class="op-stat-icon-box">
              <i class="bi bi-person-workspace"></i>
            </div>
          </div>
          <div class="op-stat-breakdown stat-breakdown">
            <span class="op-stat-breakdown-pill"><i class="bi bi-person-badge me-1" style="color: #7c3aed;"></i>Active Staff</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Training Programs -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="op-stat-card op-stat-card-programs">
        <div class="card-body">
          <div class="op-stat-header">
            <div>
              <div class="op-stat-title">Training Programs</div>
              <div class="op-stat-value"><%= @total_training_programs %></div>
            </div>
            <div class="op-stat-icon-box">
              <i class="bi bi-mortarboard-fill"></i>
            </div>
          </div>
          <div class="op-stat-breakdown stat-breakdown">
            <span class="op-stat-breakdown-pill">Students: <strong><%= @training_programs_by_type["student"] || 0 %></strong></span>
            <span class="op-stat-breakdown-pill">Guardians: <strong><%= @training_programs_by_type["guardian"] || 0 %></strong></span>
            <span class="op-stat-breakdown-pill">Employees: <strong><%= @training_programs_by_type["employee"] || 0 %></strong></span>
          </div>
        </div>
      </div>
    </div>

    <!-- Feedback Received -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="op-stat-card op-stat-card-feedback">
        <div class="card-body">
          <div class="op-stat-header">
            <div>
              <div class="op-stat-title">Feedback Received</div>
              <div class="op-stat-value"><%= @total_feedback_received || 0 %></div>
            </div>
            <div class="op-stat-icon-box">
              <i class="bi bi-chat-square-text-fill"></i>
            </div>
          </div>
          <div class="op-stat-breakdown stat-breakdown">
            <span class="op-stat-breakdown-pill">Students: <strong><%= @feedback_by_type["student"] || 0 %></strong></span>
            <span class="op-stat-breakdown-pill">Guardians: <strong><%= @feedback_by_type["guardian"] || 0 %></strong></span>
            <span class="op-stat-breakdown-pill">Employees: <strong><%= @feedback_by_type["employee"] || 0 %></strong></span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Assignment submission (Submissions Over Time & Backlog Trend) -->
  <div class="row g-4 mb-4">
    <div class="col-12">
      <div class="card card-custom h-100 shadow-sm border-0">
        <div class="card-header border-0 pt-3 pb-2 bg-white d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-2">
          <div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
              <h5 class="card-title mb-0 fw-bold text-dark">Assignment submission</h5>
              <span id="submission-date-range-badge" class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1">
                <%= @submission_start_date.strftime("%b %d") %> – <%= @submission_end_date.strftime("%b %d, %Y") %>
              </span>
              <span id="submission-active-series-badge" class="badge bg-secondary-subtle text-dark border border-secondary-subtle rounded-pill px-2.5 py-1">
                Viewing: Combined (Total &amp; Backlog)
              </span>
            </div>
            <small class="text-muted">Multi-series submission trends & backlog analysis</small>
          </div>

          <div class="chart-controls-toolbar">
            <!-- View Mode Pills -->
            <div class="btn-group btn-group-sm" role="group" aria-label="View Mode">
              <button type="button" class="btn btn-outline-primary active fw-semibold" id="btn-sub-view-combined" onclick="setSubmissionViewMode('combined')">Combined</button>
              <button type="button" class="btn btn-outline-primary fw-semibold" id="btn-sub-view-submissions" onclick="setSubmissionViewMode('submissions')">Submissions Only</button>
              <button type="button" class="btn btn-outline-primary fw-semibold" id="btn-sub-view-backlog" onclick="setSubmissionViewMode('backlog')">Backlog Only</button>
            </div>

            <!-- Participant Type Filter (Active in Submissions Only mode) -->
            <div class="btn-group btn-group-sm" role="group" id="sub-ptype-group" aria-label="Participant Type Filter" style="display: none;">
              <button type="button" class="btn btn-outline-secondary active btn-sm" id="btn-sub-ptype-all" onclick="filterSubmissionType('all')">All</button>
              <button type="button" class="btn btn-outline-secondary btn-sm" id="btn-sub-ptype-student" onclick="filterSubmissionType('student')">Students</button>
              <button type="button" class="btn btn-outline-secondary btn-sm" id="btn-sub-ptype-guardian" onclick="filterSubmissionType('guardian')">Guardians</button>
              <button type="button" class="btn btn-outline-secondary btn-sm" id="btn-sub-ptype-employee" onclick="filterSubmissionType('employee')">Employees</button>
            </div>

            <!-- Date Nav Controls -->
            <div class="d-flex align-items-center gap-1">
              <button type="button" class="btn btn-sm btn-outline-secondary chart-nav-btn" onclick="shiftAssignmentSubmission(false)" title="Previous 14 Days">
                <i class="bi bi-chevron-left"></i> Prev 14d
              </button>
              <button type="button" class="btn btn-sm btn-outline-secondary chart-nav-btn" onclick="shiftAssignmentSubmission(true)" title="Next 14 Days">
                Next 14d <i class="bi bi-chevron-right"></i>
              </button>
              <button type="button" class="btn btn-sm btn-light border chart-nav-btn" onclick="resetAssignmentSubmissionLatest()" title="Latest 14 Days">
                Latest
              </button>
            </div>

            <!-- Flatpickr Custom Range -->
            <div style="min-width: 215px;">
              <input type="text" id="assignment_submission_range_picker" class="form-control form-control-sm bg-light border-secondary-subtle text-center"
                     placeholder="Custom Date Range" readonly>
            </div>
          </div>
        </div>
        <div class="card-body pt-1">
          <div id="submission-zero-notice" class="alert alert-light border border-secondary-subtle text-muted py-2 px-3 mb-2 small d-none align-items-center gap-2 rounded-3">
            <i class="bi bi-info-circle text-primary fs-6"></i>
            <span>No submissions recorded in this date range. Use <strong>&lt; Prev 14d</strong> or pick a custom date range to view earlier activity.</span>
          </div>
          <div id="submissions-over-time-chart" style="height: 330px;"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Submissions by Assignment & Submissions by Section -->
  <div class="row g-4 mb-4">
    <!-- Submissions by Assignment -->
    <div class="col-xl-6">
      <div class="card card-custom h-100 shadow-sm border-0">
        <div class="card-header border-0 pt-3 pb-2 bg-white d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2">
          <div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
              <h5 class="card-title mb-0 fw-bold text-dark">Submissions by Assignment</h5>
              <span id="by-assignment-date-badge" class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-2.5 py-1">
                <%= @assignment_date.strftime("%b %d, %Y") %>
              </span>
            </div>
            <small class="text-muted">Top assignments by distinct participants submitted</small>
          </div>
          <div class="chart-controls-toolbar">
            <div class="d-flex align-items-center gap-1">
              <button type="button" class="btn btn-sm btn-outline-secondary chart-nav-btn" onclick="shiftAssignmentDay(false)" title="Previous Day">
                <i class="bi bi-chevron-left"></i>
              </button>
              <button type="button" class="btn btn-sm btn-light border chart-nav-btn fw-semibold" onclick="resetAssignmentDayToday()" title="Jump to Today">
                Today
              </button>
              <button type="button" class="btn btn-sm btn-outline-secondary chart-nav-btn" onclick="shiftAssignmentDay(true)" title="Next Day">
                <i class="bi bi-chevron-right"></i>
              </button>
            </div>
            <div style="width: 170px;">
              <input type="text" id="by_assignment_picker" class="form-control form-control-sm bg-light border-secondary-subtle text-center"
                     placeholder="Pick Date / Range" readonly>
            </div>
          </div>
        </div>
        <div class="card-body pt-1">
          <div id="submissions-by-assignment-chart" style="height: 360px;"></div>
        </div>
      </div>
    </div>

    <!-- Submissions by Section -->
    <div class="col-xl-6">
      <div class="card card-custom h-100 shadow-sm border-0">
        <div class="card-header border-0 pt-3 pb-2 bg-white d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2">
          <div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
              <h5 class="card-title mb-0 fw-bold text-dark">Submissions by Section</h5>
              <span id="by-section-date-badge" class="badge bg-warning-subtle text-dark border border-warning-subtle rounded-pill px-2.5 py-1">
                <%= @section_date.strftime("%b %d, %Y") %>
              </span>
            </div>
            <small class="text-muted">Top sections by distinct submissions</small>
          </div>
          <div class="chart-controls-toolbar">
            <div class="d-flex align-items-center gap-1">
              <button type="button" class="btn btn-sm btn-outline-secondary chart-nav-btn" onclick="shiftSectionDay(false)" title="Previous Day">
                <i class="bi bi-chevron-left"></i>
              </button>
              <button type="button" class="btn btn-sm btn-light border chart-nav-btn fw-semibold" onclick="resetSectionDayToday()" title="Jump to Today">
                Today
              </button>
              <button type="button" class="btn btn-sm btn-outline-secondary chart-nav-btn" onclick="shiftSectionDay(true)" title="Next Day">
                <i class="bi bi-chevron-right"></i>
              </button>
            </div>
            <div style="width: 170px;">
              <input type="text" id="by_section_picker" class="form-control form-control-sm bg-light border-secondary-subtle text-center"
                     placeholder="Pick Date / Range" readonly>
            </div>
          </div>
        </div>
        <div class="card-body pt-1">
          <div id="submissions-by-section-chart" style="height: 360px;"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Charts: Not-submitted & Pending by Section -->
  <div class="row g-4 mb-4">
    <!-- Not Submitted by Assignment -->
    <div class="col-xl-6">
      <div class="card card-custom h-100 shadow-sm border-0">
        <div class="card-header border-0 pt-3 pb-2 bg-white d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2">
          <div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
              <h5 class="card-title mb-0 fw-bold text-dark">Not Submitted by Assignment</h5>
              <span id="not-submitted-date-badge" class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1">
                <%= @not_submitted_date.strftime("%b %d, %Y") %>
              </span>
            </div>
            <small class="text-muted">Top 10 assignments with highest pending participant count</small>
          </div>
          <div class="chart-controls-toolbar">
            <div class="d-flex align-items-center gap-1">
              <button type="button" class="btn btn-sm btn-outline-secondary chart-nav-btn" onclick="shiftNotSubmittedDay(false)" title="Previous Day">
                <i class="bi bi-chevron-left"></i>
              </button>
              <button type="button" class="btn btn-sm btn-light border chart-nav-btn fw-semibold" onclick="resetNotSubmittedToday()" title="Jump to Today">
                Today
              </button>
              <button type="button" class="btn btn-sm btn-outline-secondary chart-nav-btn" onclick="shiftNotSubmittedDay(true)" title="Next Day">
                <i class="bi bi-chevron-right"></i>
              </button>
            </div>
            <div style="width: 145px;">
              <input type="text" id="not_submitted_picker" class="form-control form-control-sm bg-light border-secondary-subtle text-center"
                     placeholder="Pick Date" readonly>
            </div>
          </div>
        </div>
        <div class="card-body pt-1">
          <div id="not-submitted-assignment-chart" style="height:320px;"></div>
        </div>
      </div>
    </div>

    <!-- Pending by Section -->
    <div class="col-xl-6">
      <div class="card card-custom h-100 shadow-sm border-0">
        <div class="card-header border-0 pt-3 pb-2 bg-white d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2">
          <div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
              <h5 class="card-title mb-0 fw-bold text-dark">Pending by Section</h5>
              <span id="pending-section-date-badge" class="badge bg-secondary-subtle text-dark border border-secondary-subtle rounded-pill px-2.5 py-1">
                <%= @pending_section_date.strftime("%b %d, %Y") %>
              </span>
            </div>
            <small class="text-muted">Top 10 sections with pending submissions</small>
          </div>
          <div class="chart-controls-toolbar">
            <div class="d-flex align-items-center gap-1">
              <button type="button" class="btn btn-sm btn-outline-secondary chart-nav-btn" onclick="shiftPendingSectionDay(false)" title="Previous Day">
                <i class="bi bi-chevron-left"></i>
              </button>
              <button type="button" class="btn btn-sm btn-light border chart-nav-btn fw-semibold" onclick="resetPendingSectionToday()" title="Jump to Today">
                Today
              </button>
              <button type="button" class="btn btn-sm btn-outline-secondary chart-nav-btn" onclick="shiftPendingSectionDay(true)" title="Next Day">
                <i class="bi bi-chevron-right"></i>
              </button>
            </div>
            <div style="width: 145px;">
              <input type="text" id="pending_section_picker" class="form-control form-control-sm bg-light border-secondary-subtle text-center"
                     placeholder="Pick Date" readonly>
            </div>
          </div>
        </div>
        <div class="card-body pt-1">
          <div id="pending-section-chart" style="height:320px;"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Charts Row -->
  <div class="row g-4 mb-4">
    <!-- Participants by Section -->
    <div class="col-xl-6">
      <div class="card card-custom h-100">
        <div class="card-header border-0 pt-3">
          <h5 class="card-title mb-0">Participants by Section</h5>
        </div>
        <div class="card-body">
          <!-- Participants by Section Chart Container -->
          <div id="participants-section-chart"></div>
        </div>
      </div>
    </div>

    <!-- Participants by Type -->
    <div class="col-xl-6">
      <div class="card card-custom h-100">
        <div class="card-header border-0 pt-3">
          <h5 class="card-title mb-0">Participants by Type</h5>
        </div>
        <div class="card-body">
          <!-- Participants by Type Chart Container -->
          <div id="participants-type-chart"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Unified Feedback by Training Program Section -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card card-custom">
        <div class="card-header border-0 pt-3 pb-2 d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-3">
          <div>
            <div class="d-flex align-items-center gap-2">
              <div class="p-2 rounded-3 bg-purple-subtle text-purple">
                <i class="bi bi-bar-chart-line-fill fs-5" style="color: #8b5cf6;"></i>
              </div>
              <div>
                <h5 class="card-title mb-0 fw-bold">Feedback by Training Program</h5>
                <small class="text-muted">Combined received & pending responses by program and audience</small>
              </div>
            </div>
            <!-- Overview Summary KPI Banner -->
            <div class="d-flex flex-wrap align-items-center gap-2 mt-2 pt-1">
              <span class="badge border px-2.5 py-1.5 fw-semibold" id="tpf-received-summary" style="background: rgba(139, 92, 246, 0.12); color: #6d28d9; border-color: rgba(139, 92, 246, 0.25) !important;">
                <i class="bi bi-check2-circle me-1"></i>Received: <%= @feedback_received_percentage || 0 %>% (<%= @total_feedback_received || 0 %>)
              </span>
              <span class="badge border px-2.5 py-1.5 fw-semibold" id="tpf-pending-summary" style="background: rgba(251, 113, 133, 0.12); color: #be123c; border-color: rgba(251, 113, 133, 0.25) !important;">
                <i class="bi bi-hourglass-split me-1"></i>Pending: <%= @feedback_pending_percentage || 0 %>% (<%= @total_feedback_pending || 0 %>)
              </span>
              <span class="op-stat-breakdown-pill" id="tpf-students-summary">
                Students: <strong><%= @feedback_by_type['student'] || 0 %></strong>
              </span>
              <span class="op-stat-breakdown-pill" id="tpf-guardians-summary">
                Guardians: <strong><%= @feedback_by_type['guardian'] || 0 %></strong>
              </span>
              <span class="op-stat-breakdown-pill" id="tpf-employees-summary">
                Employees: <strong><%= @feedback_by_type['employee'] || 0 %></strong>
              </span>
            </div>
          </div>

          <!-- Header Toolbar: Multi-select Filter & View Mode Switcher -->
          <div class="d-flex flex-wrap align-items-center gap-2 w-100 w-lg-auto justify-content-between justify-content-lg-end">
            <!-- Multi-Select Training Program Dropdown -->
            <div class="dropdown">
              <button class="btn btn-sm btn-outline-secondary dropdown-toggle d-flex align-items-center gap-1.5 rounded-3 px-3 py-1.5" 
                      type="button" 
                      id="tpfProgramDropdown" 
                      data-bs-toggle="dropdown" 
                      data-bs-display="static"
                      data-bs-auto-close="outside" 
                      aria-expanded="false">
                <i class="bi bi-funnel-fill text-primary"></i>
                <span id="tpfSelectedProgramLabel">All Programs (<%= @program_feedback_data.size %>)</span>
              </button>
              <div class="dropdown-menu dropdown-menu-end p-2.5 shadow-lg rounded-3 border" style="min-width: 280px; max-height: 340px; overflow-y: auto;" aria-labelledby="tpfProgramDropdown">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-2">
                  <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" id="tpfSelectAll" checked onchange="toggleAllFeedbackPrograms(this)">
                    <label class="form-check-label fw-bold small" for="tpfSelectAll">Select All</label>
                  </div>
                  <small class="text-muted" id="tpfCounterText"><%= @program_feedback_data.size %> selected</small>
                </div>
                <div id="tpfProgramCheckboxes">
                  <% @program_feedback_data.each do |p| %>
                    <div class="form-check py-1 px-1 rounded hover-bg-light">
                      <input class="form-check-input tpf-program-cb me-2" type="checkbox" value="<%= p[:id] %>" id="tpf_prog_<%= p[:id] %>" checked onchange="handleFeedbackProgramChange()">
                      <label class="form-check-label small text-truncate d-block cursor-pointer" for="tpf_prog_<%= p[:id] %>" title="<%= p[:name] %>">
                        <%= p[:name] %>
                      </label>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>

            <!-- View Mode Switcher -->
            <div class="btn-group btn-group-sm rounded-3 shadow-none border" role="group">
              <button type="button" class="btn btn-outline-primary active px-2.5 py-1.5" id="tpfModeReceivedPending" onclick="switchFeedbackViewMode('received_pending')">
                Received vs Pending
              </button>
              <button type="button" class="btn btn-outline-primary px-2.5 py-1.5" id="tpfModeParticipantType" onclick="switchFeedbackViewMode('participant_type')">
                By Participant Type
              </button>
            </div>
          </div>
        </div>
        <div class="card-body pt-2">
          <!-- Feedback by Training Program Chart Container -->
          <div id="feedback-training-chart" style="min-height:350px;"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Recent Feedback Accordion Section (Item 20) -->
  <div class="card card-custom mb-4">
    <div class="card-header border-0 pt-3 pb-2 d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2.5">
      <div class="d-flex align-items-center gap-2">
        <div class="p-2 rounded-3 bg-purple-subtle text-purple">
          <i class="bi bi-chat-square-quote-fill fs-5" style="color: #8b5cf6;"></i>
        </div>
        <div>
          <h5 class="card-title mb-0 fw-bold">Recent Feedback</h5>
          <small class="text-muted">User reviews and rating distributions by training program</small>
        </div>
      </div>
      <div>
        <%= link_to feedback_reports_institute_admin_reports_path, class: "btn btn-sm btn-outline-primary rounded-3 px-3" do %>
          <i class="bi bi-list-ul me-1"></i> View Feedback Reports
        <% end %>
      </div>
    </div>
    <div class="card-body pt-2">
      <% if @recent_feedback_programs.present? %>
        <div class="accordion accordion-custom" id="recentFeedbackAccordion">
          <% @recent_feedback_programs.each_with_index do |prog, idx| %>
            <div class="accordion-item border rounded-3 mb-2.5 overflow-hidden shadow-sm">
              <h2 class="accordion-header" id="heading_feedback_<%= prog[:id] %>">
                <button class="accordion-button <%= 'collapsed' unless idx == 0 %> d-flex flex-wrap align-items-center justify-content-between gap-2.5 py-3" 
                        type="button" 
                        data-bs-toggle="collapse" 
                        data-bs-target="#collapse_feedback_<%= prog[:id] %>" 
                        aria-expanded="<%= idx == 0 ? 'true' : 'false' %>" 
                        aria-controls="collapse_feedback_<%= prog[:id] %>"
                        style="background: <%= idx == 0 ? '#f8fafc' : '#ffffff' %>;">
                  
                  <!-- Program Title & Status -->
                  <div class="d-flex align-items-center gap-2 flex-grow-1 min-w-0" style="max-width: 360px;">
                    <i class="bi bi-mortarboard text-primary fs-5"></i>
                    <span class="fw-bold text-dark text-truncate" title="<%= prog[:title] %>"><%= prog[:title] %></span>
                    <span class="badge bg-light text-muted border small"><%= prog[:status]&.titleize %></span>
                  </div>

                  <!-- Rating Badge -->
                  <div class="d-flex align-items-center gap-1.5 me-2">
                    <div class="badge bg-warning-subtle text-warning-emphasis d-inline-flex align-items-center gap-1 px-2 py-1">
                      <i class="bi bi-star-fill text-warning"></i>
                      <span class="fw-bold"><%= prog[:avg_rating] %></span>
                    </div>
                    <span class="text-muted small">(<%= prog[:received_count] %> reviews)</span>
                  </div>

                  <!-- Stacked Mini Progress Bar (Received vs Pending) -->
                  <div class="d-flex align-items-center gap-2 flex-grow-1 w-100 w-sm-auto" style="min-width: 160px; max-width: 340px;">
                    <div class="progress flex-grow-1 rounded-pill" style="height: 10px; background-color: #f1f5f9;">
                      <div class="progress-bar" role="progressbar" 
                           style="width: <%= prog[:received_percentage] %>%; background: linear-gradient(90deg, #8b5cf6 0%, #06b6d4 100%);" 
                           title="Received: <%= prog[:received_count] %> (<%= prog[:received_percentage] %>%)"></div>
                      <div class="progress-bar" role="progressbar" 
                           style="width: <%= prog[:pending_percentage] %>%; background: linear-gradient(90deg, #fb7185 0%, #fb923c 100%);" 
                           title="Pending: <%= prog[:pending_count] %> (<%= prog[:pending_percentage] %>%)"></div>
                    </div>
                    <span class="small fw-semibold text-muted text-nowrap"><%= prog[:received_percentage] %>% received</span>
                  </div>
                </button>
              </h2>
              <div id="collapse_feedback_<%= prog[:id] %>" 
                   class="accordion-collapse collapse <%= 'show' if idx == 0 %>" 
                   aria-labelledby="heading_feedback_<%= prog[:id] %>" 
                   data-bs-parent="#recentFeedbackAccordion">
                <div class="accordion-body bg-light-subtle p-3 p-md-4">
                  
                  <!-- Distribution Summary Bar -->
                  <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3 pb-3 border-bottom">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                      <span class="text-muted small fw-semibold">Audience Breakdown:</span>
                      <span class="op-stat-breakdown-pill">Students: <strong><%= prog[:type_distribution]["student"] %></strong></span>
                      <span class="op-stat-breakdown-pill">Guardians: <strong><%= prog[:type_distribution]["guardian"] %></strong></span>
                      <span class="op-stat-breakdown-pill">Employees: <strong><%= prog[:type_distribution]["employee"] %></strong></span>
                    </div>
                    <div class="d-flex align-items-center gap-2 text-muted small">
                      <span>Total Participants: <strong><%= prog[:total_participants] %></strong></span>
                      <span>•</span>
                      <span>Received: <strong class="text-success"><%= prog[:received_count] %></strong></span>
                      <span>•</span>
                      <span>Pending: <strong class="text-warning"><%= prog[:pending_count] %></strong></span>
                    </div>
                  </div>

                  <!-- Reviews List (Referencing Master Admin recent feedback style) -->
                  <div class="row g-3">
                    <% if prog[:recent_feedbacks].any? %>
                      <% prog[:recent_feedbacks].each do |fb| %>
                        <div class="col-12 col-md-6 col-xl-4">
                          <div class="card h-100 border-0 shadow-sm rounded-3 p-3 bg-white">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                              <div class="d-flex text-warning" style="font-size: 0.85rem;">
                                <% fb.rating.to_i.times do %>
                                  <i class="bi bi-star-fill me-0.5"></i>
                                <% end %>
                                <% (5 - fb.rating.to_i).times do %>
                                  <i class="bi bi-star text-muted opacity-25 me-0.5"></i>
                                <% end %>
                              </div>
                              <small class="text-muted" style="font-size: 0.75rem;">
                                <i class="bi bi-clock me-1"></i><%= time_ago_in_words(fb.created_at) %> ago
                              </small>
                            </div>
                            <p class="text-dark small mb-3 flex-grow-1" style="line-height: 1.5; font-style: italic;">
                              "<%= truncate(fb.content, length: 120) %>"
                            </p>
                            <div class="d-flex align-items-center justify-content-between pt-2 border-top" style="border-color: #f1f5f9 !important;">
                              <div class="d-flex align-items-center gap-2">
                                <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center fw-bold" style="width: 28px; height: 28px; font-size: 0.75rem;">
                                  <%= fb.participant&.user&.first_name&.first || 'U' %>
                                </div>
                                <div class="small fw-semibold text-dark text-truncate" style="max-width: 140px;">
                                  <%= fb.participant&.user&.full_name %>
                                </div>
                              </div>
                              <% p_type = fb.participant&.participant_type %>
                              <span class="badge badge-<%= p_type || 'student' %> small" style="font-size: 0.65rem;">
                                <%= p_type&.titleize || 'Student' %>
                              </span>
                            </div>
                          </div>
                        </div>
                      <% end %>
                    <% else %>
                      <div class="col-12">
                        <div class="alert alert-light border mb-0 text-muted small">
                          <i class="bi bi-info-circle me-1"></i> No written feedback reviews submitted for this program yet.
                        </div>
                      </div>
                    <% end %>
                  </div>

                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="alert alert-info mb-0">
          <i class="bi bi-info-circle me-2"></i> No training programs with feedback recorded yet.
        </div>
      <% end %>
    </div>
  </div>

  <!-- Top and Bottom Submitting Participants Leaderboard Row (Items 15 & 16) -->
  <div class="row g-4 mb-4">
    <!-- Top Submitting Participants (Streak without break) -->
    <div class="col-xl-6 col-12">
      <div class="card card-custom h-100">
        <div class="card-header border-0 pt-3 pb-2 d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2.5">
          <div class="d-flex align-items-center gap-2">
            <div class="p-2 rounded-3 bg-warning-subtle text-warning">
              <i class="bi bi-trophy-fill fs-5"></i>
            </div>
            <div>
              <h5 class="card-title mb-0 fw-bold">Top Submitting Participants</h5>
              <small class="text-muted">Follows streak without break</small>
            </div>
          </div>
          
          <div class="d-flex flex-wrap align-items-center gap-2 w-100 w-sm-auto justify-content-between justify-content-sm-end">
            <!-- Assignment filter -->
            <select class="form-select form-select-sm rounded-3 flex-grow-1 flex-sm-grow-0" id="topLeaderboardAssignment" style="min-width: 140px; max-width: 220px;" onchange="updateStreakLeaderboard('top')">
              <% (@available_assignments || []).each do |asg| %>
                <option value="<%= asg.id %>" <%= 'selected' if asg.id == @default_assignment&.id %>><%= asg.title %></option>
              <% end %>
            </select>

            <!-- Limit selector -->
            <div class="d-flex align-items-center gap-1">
              <span class="text-muted small">Show:</span>
              <select class="form-select form-select-sm rounded-3" id="topLeaderboardLimit" style="width: 75px;" onchange="updateStreakLeaderboard('top')">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="15">15</option>
                <option value="20">20</option>
                <option value="25">25</option>
                <option value="50">50</option>
              </select>
            </div>
          </div>
        </div>
        <div class="card-body p-0">
          <div class="d-lg-none px-3 pt-2 text-muted small">
            <i class="bi bi-arrow-left-right me-1"></i> Swipe table horizontally to view all columns &rarr;
          </div>
          <div class="table-responsive">
            <table class="table modern-table mb-0" id="topLeaderboardTable">
              <thead>
                <tr>
                  <th style="width: 60px;">Rank</th>
                  <th>Name</th>
                  <th>Section</th>
                  <th>Assignment</th>
                  <th class="text-center">Streak</th>
                </tr>
              </thead>
              <tbody id="topLeaderboardBody">
                <% if @top_submitting_participants.present? %>
                  <% @top_submitting_participants.each do |p| %>
                    <tr>
                      <td>
                        <span class="badge <%= p[:rank] == 1 ? 'bg-warning text-dark' : (p[:rank] == 2 ? 'bg-secondary text-white' : (p[:rank] == 3 ? 'bg-bronze text-white' : 'bg-light text-dark border')) %> rounded-pill fw-bold">
                          #<%= p[:rank] %>
                        </span>
                      </td>
                      <td class="fw-semibold text-dark"><%= p[:name] %></td>
                      <td><span class="badge bg-light text-secondary border"><%= p[:section] %></span></td>
                      <td class="text-muted small text-truncate" style="max-width: 150px;" title="<%= p[:assignment_name] %>"><%= p[:assignment_name] %></td>
                      <td class="text-center">
                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                          <i class="bi bi-fire text-danger me-1"></i><%= pluralize(p[:streak], 'day') %>
                        </span>
                      </td>
                    </tr>
                  <% end %>
                <% else %>
                  <tr><td colspan="5" class="text-center py-4 text-muted">No participants found for this assignment</td></tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Submitting Participants (Never follows streak) -->
    <div class="col-xl-6 col-12">
      <div class="card card-custom h-100">
        <div class="card-header border-0 pt-3 pb-2 d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2.5">
          <div class="d-flex align-items-center gap-2">
            <div class="p-2 rounded-3 bg-danger-subtle text-danger">
              <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            </div>
            <div>
              <h5 class="card-title mb-0 fw-bold">Bottom Submitting Participants</h5>
              <small class="text-muted">Never follows streak / broken streak</small>
            </div>
          </div>

          <div class="d-flex flex-wrap align-items-center gap-2 w-100 w-sm-auto justify-content-between justify-content-sm-end">
            <!-- Assignment filter -->
            <select class="form-select form-select-sm rounded-3 flex-grow-1 flex-sm-grow-0" id="bottomLeaderboardAssignment" style="min-width: 140px; max-width: 220px;" onchange="updateStreakLeaderboard('bottom')">
              <% (@available_assignments || []).each do |asg| %>
                <option value="<%= asg.id %>" <%= 'selected' if asg.id == @default_assignment&.id %>><%= asg.title %></option>
              <% end %>
            </select>

            <!-- Limit selector -->
            <div class="d-flex align-items-center gap-1">
              <span class="text-muted small">Show:</span>
              <select class="form-select form-select-sm rounded-3" id="bottomLeaderboardLimit" style="width: 75px;" onchange="updateStreakLeaderboard('bottom')">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="15">15</option>
                <option value="20">20</option>
                <option value="25">25</option>
                <option value="50">50</option>
              </select>
            </div>
          </div>
        </div>
        <div class="card-body p-0">
          <div class="d-lg-none px-3 pt-2 text-muted small">
            <i class="bi bi-arrow-left-right me-1"></i> Swipe table horizontally to view all columns &rarr;
          </div>
          <div class="table-responsive">
            <table class="table modern-table mb-0" id="bottomLeaderboardTable">
              <thead>
                <tr>
                  <th style="width: 60px;">Rank</th>
                  <th>Name</th>
                  <th>Section</th>
                  <th>Participant Type</th>
                  <th>Assignment</th>
                  <th class="text-center">Streak</th>
                </tr>
              </thead>
              <tbody id="bottomLeaderboardBody">
                <% if @bottom_submitting_participants.present? %>
                  <% @bottom_submitting_participants.each do |p| %>
                    <tr>
                      <td>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill fw-bold">
                          #<%= p[:rank] %>
                        </span>
                      </td>
                      <td class="fw-semibold text-dark"><%= p[:name] %></td>
                      <td><span class="badge bg-light text-secondary border"><%= p[:section] %></span></td>
                      <td>
                        <% p_badge = case p[:raw_participant_type]
                                     when 'student' then 'badge-student'
                                     when 'guardian' then 'badge-guardian'
                                     when 'employee' then 'badge-employee'
                                     else 'bg-secondary'
                                     end %>
                        <span class="badge <%= p_badge %>"><%= p[:participant_type] %></span>
                      </td>
                      <td class="text-muted small text-truncate" style="max-width: 140px;" title="<%= p[:assignment_name] %>"><%= p[:assignment_name] %></td>
                      <td class="text-center">
                        <span class="badge bg-light text-muted border">
                          <i class="bi bi-x-circle text-danger me-1"></i><%= p[:streak] %> days
                        </span>
                      </td>
                    </tr>
                  <% end %>
                <% else %>
                  <tr><td colspan="6" class="text-center py-4 text-muted">No participants found for this assignment</td></tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Recent Training Programs Table (Item 13 with Duration Column) -->
  <div class="card card-custom border-0 bg-transparent shadow-none">
    <div class="card-header border-0 pt-0 px-0 pb-4 bg-transparent">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h5 class="card-title mb-0 fw-bold">Recent Training Programs</h5>
        <%= link_to "View All", institute_admin_training_programs_path, class: "btn btn-primary" %>
      </div>
    </div>
    <div class="card-body p-0">
      <div class="d-lg-none px-3 pt-2 text-muted small">
        <i class="bi bi-arrow-left-right me-1"></i> Swipe table horizontally to view all columns &rarr;
      </div>
      <div class="table-responsive">
        <% if @recent_programs.present? %>
          <table class="table modern-table">
            <thead>
              <tr>
                <th>Program</th>
                <th>Duration</th>
                <th>Participants</th>
                <th>Feedback Rate</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @recent_programs.each do |program| %>
                <tr>
                  <td>
                    <div class="d-flex align-items-center">
                      <div class="me-3 p-2 rounded-3 bg-light text-primary">
                        <i class="bi bi-book fs-5"></i>
                      </div>
                      <div>
                        <div class="fw-bold text-dark"><%= program.title %></div>
                        <small class="text-muted"><%= program.start_date&.strftime("%b %d, %Y") %></small>
                      </div>
                    </div>
                  </td>
                  <td>
                    <% if program.start_date.present? && program.end_date.present? %>
                      <% days = (program.end_date.to_date - program.start_date.to_date).to_i + 1 %>
                      <div class="fw-semibold text-dark"><%= pluralize(days, "day") %></div>
                      <small class="text-muted"><%= program.start_date.strftime("%b %d") %> - <%= program.end_date.strftime("%b %d, %Y") %></small>
                    <% else %>
                      <span class="text-muted">-</span>
                    <% end %>
                  </td>
                  <td class="fw-bold text-center"><%= program.participants_count %></td>
                  <td>
                    <div class="d-flex align-items-center">
                      <div class="progress flex-grow-1 me-2" style="height: 6px; background-color: #e2e8f0;">
                        <div class="progress-bar bg-success" role="progressbar" 
                             style="width: <%= program.feedback_percentage %>%" 
                             aria-valuenow="<%= program.feedback_percentage %>" 
                             aria-valuemin="0" aria-valuemax="100"></div>
                      </div>
                      <span class="small fw-semibold text-muted"><%= program.feedback_percentage %>%</span>
                    </div>
                  </td>
                  <td>
                    <span class="status-badge status-badge-<%= program.status %>">
                      <%= program.status %>
                    </span>
                  </td>
                  <td>
                    <%= link_to institute_admin_training_program_path(program), class: "action-btn" do %>
                      <i class="bi bi-eye"></i>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <div class="alert alert-info">No recent training programs found</div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<script>
  // Track if we're on the dashboard page
  let isDashboardPage = true;

  // Global state variables for dates and multi-series datasets
  let currentSubStartDate = new Date("<%= @submission_start_date.iso8601 %>T00:00:00");
  let currentSubEndDate = new Date("<%= @submission_end_date.iso8601 %>T00:00:00");
  let currentAssignDate = new Date("<%= @assignment_date.iso8601 %>T00:00:00");
  let currentSectionDate = new Date("<%= @section_date.iso8601 %>T00:00:00");
  let currentNotSubDate = new Date("<%= @not_submitted_date.iso8601 %>T00:00:00");
  let currentPendSecDate = new Date("<%= @pending_section_date.iso8601 %>T00:00:00");

  let submissionRawData = {
    labels: <%= raw @submissions_time_labels.to_json %>,
    student: <%= @student_submissions_data.to_json %>,
    guardian: <%= @guardian_submissions_data.to_json %>,
    employee: <%= @employee_submissions_data.to_json %>,
    total: <%= @submissions_time_data.to_json %>,
    backlog: <%= @backlog_data.to_json %>
  };
  let submissionViewMode = 'combined'; // 'combined', 'submissions', 'backlog'
  let submissionPTypeFilter = 'all'; // 'all', 'student', 'guardian', 'employee'
  
  // Function to initialize dashboard charts
  function initializeDashboardCharts() {
    if (!isDashboardPage) return;
    
  // initializing dashboard charts
    
    // Check if chart containers exist before initializing
    var sectionChartContainer = document.querySelector("#participants-section-chart");
    var typeChartContainer = document.querySelector("#participants-type-chart");
    var feedbackChartContainer = document.querySelector("#feedback-training-chart");

    // Only destroy and recreate charts if we're on the dashboard page
    if (window.sectionChart) {
  // destroying existing section chart
      window.sectionChart.destroy();
    }
    if (window.typeChart) {
  // destroying existing type chart
      window.typeChart.destroy();
    }
    if (window.feedbackChart) {
  // destroying existing feedback chart
      window.feedbackChart.destroy();
    }

    if (sectionChartContainer) {
  // initializing Participants by Section Chart
      var sectionChartOptions = {
        chart: { 
          type: 'bar', 
          height: 350,
          toolbar: {
            show: true,
            tools: {
              download: true,
              selection: false,
              zoom: false,
              zoomin: false,
              zoomout: false,
              pan: false,
              reset: false
            }
          },
          animations: {
            enabled: true,
            easing: 'easeinout',
            speed: 800,
            animateGradually: {
              enabled: true,
              delay: 150
            },
            dynamicAnimation: {
              enabled: true,
              speed: 350
            }
          }
        },
        series: [{
          name: 'Participants',
          data: <%= @section_data[:participants] %>
        }, {
          name: 'Capacity',
          data: <%= @section_data[:capacity] %>
        }],
        plotOptions: {
          bar: {
            horizontal: false,
            columnWidth: '70%',
            borderRadius: 0,
            dataLabels: {
              position: 'top'
            }
          }
        },
        dataLabels: {
          enabled: true,
          offsetY: -25,
          style: {
            fontSize: '12px',
            fontWeight: 600,
            colors: ['#4f46e5', '#818cf8']
          },
          background: {
            enabled: false
          }
        },
        stroke: {
          show: true,
          width: 2,
          colors: ['transparent']
        },
        xaxis: { 
          categories: <%= raw @section_labels.to_json %>,
          labels: {
            style: {
              colors: '#64748b',
              fontSize: '12px',
              fontWeight: 500
            }
          },
          axisBorder: {
            show: true,
            color: '#e2e8f0'
          },
          axisTicks: {
            show: true,
            color: '#e2e8f0'
          }
        },
        yaxis: {
          title: {
            text: 'Count',
            style: {
              color: '#64748b',
              fontSize: '13px',
              fontWeight: 600
            }
          },
          labels: {
            style: {
              colors: '#64748b',
              fontSize: '12px'
            }
          }
        },
        colors: ['#6366f1', '#a5b4fc'],
        fill: {
          opacity: 1,
          type: 'gradient',
          gradient: {
            shade: 'light',
            type: 'vertical',
            shadeIntensity: 0.3,
            gradientToColors: ['#4f46e5', '#c7d2fe'],
            inverseColors: false,
            opacityFrom: 1,
            opacityTo: 0.85,
            stops: [0, 100]
          }
        },
        legend: {
          position: 'bottom',
          horizontalAlign: 'left',
          fontSize: '13px',
          fontWeight: 500,
          offsetY: 20,
          labels: {
            colors: '#475569'
          },
          markers: {
            width: 12,
            height: 12,
            radius: 3
          },
          itemMargin: {
            horizontal: 10,
            vertical: 5
          }
        },
        grid: {
          borderColor: '#f1f5f9',
          strokeDashArray: 3,
          xaxis: {
            lines: {
              show: false
            }
          },
          yaxis: {
            lines: {
              show: true
            }
          },
          padding: {
            top: 0,
            right: 10,
            bottom: 0,
            left: 10
          }
        },
        tooltip: {
          theme: 'light',
          shared: true,
          intersect: false,
          style: {
            fontSize: '13px',
            fontFamily: 'inherit'
          },
          x: {
            show: true,
            formatter: function(val) {
              return val;
            }
          },
          y: {
            formatter: function(val, opts) {
              var seriesName = opts.w.globals.seriesNames[opts.seriesIndex];
              return seriesName + ': ' + val;
            },
            title: {
              formatter: function() {
                return '';
              }
            }
          },
          marker: {
            show: true
          },
          custom: undefined
        },
        responsive: [{
          breakpoint: 768,
          options: {
            plotOptions: {
              bar: {
                columnWidth: '80%'
              }
            },
            dataLabels: {
              style: {
                fontSize: '10px'
              }
            }
          }
        }]
      };
      window.sectionChart = new ApexCharts(sectionChartContainer, sectionChartOptions);
      window.sectionChart.render();
    }
      // State variables for dates and multi-series datasets
      currentSubStartDate = new Date("<%= @submission_start_date.iso8601 %>T00:00:00");
      currentSubEndDate = new Date("<%= @submission_end_date.iso8601 %>T00:00:00");
      currentBacklogStartDate = new Date("<%= @submission_start_date.iso8601 %>T00:00:00");
      currentBacklogEndDate = new Date("<%= @submission_end_date.iso8601 %>T00:00:00");
      currentAssignDate = new Date("<%= @assignment_date.iso8601 %>T00:00:00");
      currentSectionDate = new Date("<%= @section_date.iso8601 %>T00:00:00");
      currentNotSubDate = new Date("<%= @not_submitted_date.iso8601 %>T00:00:00");
      currentPendSecDate = new Date("<%= @pending_section_date.iso8601 %>T00:00:00");

      submissionRawData = {
        labels: <%= raw @submissions_time_labels.to_json %>,
        student: <%= @student_submissions_data.to_json %>,
        guardian: <%= @guardian_submissions_data.to_json %>,
        employee: <%= @employee_submissions_data.to_json %>,
        total: <%= @submissions_time_data.to_json %>,
        backlog: <%= @backlog_data.to_json %>
      };
      submissionViewMode = 'combined'; // 'combined', 'submissions', 'backlog'
      submissionPTypeFilter = 'all'; // 'all', 'student', 'guardian', 'employee'

      // Assignment Submission Chart (Apex)
      var submissionsContainer = document.querySelector('#submissions-over-time-chart');
      if (window.submissionsChart) {
        try { window.submissionsChart.destroy(); } catch(e) { /* ignore */ }
      }
      if (submissionsContainer) {
        var submissionsOptions = {
          chart: {
            type: 'area',
            height: 330,
            toolbar: { show: true },
            animations: { enabled: true, easing: 'easeinout', speed: 600 }
          },
          series: [
            { name: 'Total Submissions', data: submissionRawData.total },
            { name: 'Backlog', data: submissionRawData.backlog }
          ],
          stroke: { curve: 'smooth', width: [2.5, 2.5] },
          markers: { size: 4, strokeColors: '#ffffff', hover: { sizeOffset: 2 } },
          colors: ['#4f46e5', '#ef4444'],
          fill: {
            type: 'gradient',
            gradient: { shade: 'light', type: 'vertical', shadeIntensity: 0.8, opacityFrom: 0.5, opacityTo: 0.05 }
          },
          xaxis: {
            categories: submissionRawData.labels,
            labels: { rotate: -35, style: { fontSize: '12px' } }
          },
          yaxis: {
            title: { text: 'Count' },
            min: 0,
            forceNiceScale: true,
            labels: { formatter: function(val) { return Math.round(val); } }
          },
          tooltip: {
            shared: true,
            intersect: false,
            y: { formatter: function(val) { return val + (val === 1 ? ' item' : ' items'); } }
          },
          legend: {
            show: true,
            position: 'top',
            horizontalAlign: 'left',
            offsetY: -5,
            fontSize: '13px',
            fontWeight: 500,
            markers: { width: 10, height: 10, radius: 10 },
            itemMargin: { horizontal: 8, vertical: 0 }
          },
          grid: { borderColor: '#eef2f6' },
          responsive: [{
            breakpoint: 768,
            options: { chart: { height: 260 }, xaxis: { labels: { rotate: -25 } } }
          }]
        };

        window.submissionsChart = new ApexCharts(submissionsContainer, submissionsOptions);
        window.submissionsChart.render();
      }

      // Submissions by Assignment (bar) - Full Name in x-axis
      var byAssignmentContainer = document.querySelector('#submissions-by-assignment-chart');
      if (window.byAssignmentChart) { try { window.byAssignmentChart.destroy(); } catch(e) {} }
      if (byAssignmentContainer) {
        var assignOptions = {
          chart: { type: 'bar', height: 360, toolbar: { show: true } },
          series: [{ name: 'Participants', data: <%= raw @assignment_data.to_json %> }],
          plotOptions: { 
            bar: { 
              horizontal: false, 
              columnWidth: '55%', 
              borderRadius: 4, 
              distributed: false 
            } 
          },
          dataLabels: { enabled: true, formatter: function(val){ return val; }, style: { fontSize: '12px', colors: ['#243b53'] } },
          xaxis: { 
            categories: <%= raw @assignment_labels.to_json %>, 
            labels: { 
              rotate: -40,
              rotateAlways: true,
              trim: false,
              style: { fontSize: '12px', fontWeight: 500 }
            } 
          },
          yaxis: { title: { text: 'Participants' }, min: 0 },
          colors: ['#06b6d4'],
          fill: { type: 'gradient', gradient: { shade: 'light', type: 'vertical', shadeIntensity: 0.6, gradientToColors: ['#3b82f6'], inverseColors: false, opacityFrom: 0.95, opacityTo: 0.7, stops: [0, 100] } },
          tooltip: { y: { formatter: function(val){ return val + ' participants'; } }, x: { formatter: function(val){ return val; } } },
          legend: { show: false },
          responsive: [{
            breakpoint: 768,
            options: {
              chart: { height: 300 },
              plotOptions: { bar: { columnWidth: '70%' } },
              xaxis: { labels: { rotate: -25 } }
            }
          }]
        };

        window.byAssignmentChart = new ApexCharts(byAssignmentContainer, assignOptions);
        window.byAssignmentChart.render();
      }

      // Submissions by Section (today) - Full Name in x-axis
      var bySectionContainer = document.querySelector('#submissions-by-section-chart');
      if (window.bySectionChart) { try { window.bySectionChart.destroy(); } catch(e) {} }
      if (bySectionContainer) {
        var sectionOptions = {
          chart: { type: 'bar', height: 360, toolbar: { show: true } },
          series: [{ name: 'Submissions', data: <%= raw @submissions_section_data.to_json %> }],
          plotOptions: { bar: { horizontal: false, columnWidth: '55%', borderRadius: 4 } },
          dataLabels: { enabled: true, style: { fontSize: '12px' }, formatter: function(val){ return val; } },
          xaxis: { 
            categories: <%= raw @submissions_section_labels.to_json %>, 
            labels: { 
              rotate: -40,
              rotateAlways: true,
              trim: false,
              style: { fontSize: '12px', fontWeight: 500 }
            } 
          },
          yaxis: { title: { text: 'Submissions' }, min: 0 },
          colors: ['#f97316'],
          fill: { type: 'gradient', gradient: { shade: 'light', type: 'vertical', shadeIntensity: 0.6, gradientToColors: ['#fb923c'], inverseColors: false, opacityFrom: 0.95, opacityTo: 0.7, stops: [0, 100] } },
          tooltip: { y: { formatter: function(val){ return val + ' submissions'; } } },
          legend: { show: false },
          responsive: [{ breakpoint: 768, options: { chart: { height: 300 }, xaxis: { labels: { rotate: -25 } } } }]
        };

        window.bySectionChart = new ApexCharts(bySectionContainer, sectionOptions);
        window.bySectionChart.render();
      }

      if (typeChartContainer) {
        var optionsType = {
          chart: { 
            type: 'pie', 
            height: 350,
            animations: { enabled: true, easing: 'easeinout', speed: 800 }
          },
          series: <%= @type_data %>,
          labels: <%= raw @type_labels.to_json %>,
          colors: ['#10b981', '#ec4899', '#8b5cf6'],
          fill: {
            type: 'gradient',
            gradient: { shade: 'dark', type: 'vertical', shadeIntensity: 0.5, gradientToColors: ['#059669', '#db2777', '#7c3aed'], inverseColors: false, opacityFrom: 1, opacityTo: 0.9, stops: [0, 100] }
          },
          stroke: { show: true, width: 2, colors: ['#ffffff'] },
          dataLabels: {
            enabled: true,
            formatter: function(val) { return val.toFixed(1) + '%'; },
            style: { fontSize: '14px', fontWeight: 600, colors: ['#ffffff'] }
          },
          legend: { position: 'right', fontSize: '13px', fontWeight: 500 },
          tooltip: { theme: 'light', y: { formatter: function(val) { return val; } } }
        };
        window.typeChart = new ApexCharts(typeChartContainer, optionsType);
        window.typeChart.render();
      }

      // Feedback by Training Program (Interactive & Combined)
      window.programFeedbackRawData = <%= raw @program_feedback_data.to_json %> || [];
      window.feedbackViewMode = 'received_pending'; // 'received_pending' or 'participant_type'
      window.selectedFeedbackProgramIds = window.programFeedbackRawData.map(function(p) { return p.id; });

      function getFilteredFeedbackPrograms() {
        return window.programFeedbackRawData.filter(function(p) {
          return window.selectedFeedbackProgramIds.indexOf(p.id) !== -1;
        });
      }

      function buildFeedbackSeries() {
        var filtered = getFilteredFeedbackPrograms();
        if (window.feedbackViewMode === 'participant_type') {
          return [
            { name: 'Students', data: filtered.map(function(p) { return p.student || 0; }) },
            { name: 'Guardians', data: filtered.map(function(p) { return p.guardian || 0; }) },
            { name: 'Employees', data: filtered.map(function(p) { return p.employee || 0; }) },
            { name: 'Pending', data: filtered.map(function(p) { return p.pending || 0; }) }
          ];
        } else {
          return [
            { name: 'Received', data: filtered.map(function(p) { return p.received || 0; }) },
            { name: 'Pending', data: filtered.map(function(p) { return p.pending || 0; }) }
          ];
        }
      }

      if (feedbackChartContainer) {
        var feedbackChartOptions = {
          chart: {
            type: 'bar',
            height: 350,
            stacked: true,
            toolbar: { show: false }
          },
          plotOptions: {
            bar: {
              horizontal: false,
              columnWidth: '55%',
              borderRadius: 4,
              dataLabels: {
                total: {
                  enabled: true,
                  style: { fontSize: '12px', fontWeight: 600, color: '#475569' },
                  formatter: function(val) {
                    return val > 0 ? val : '';
                  }
                }
              }
            }
          },
          dataLabels: {
            enabled: true,
            formatter: function(val, opts) {
              if (!val || val === 0) return '';
              var pIdx = opts.dataPointIndex;
              var filtered = getFilteredFeedbackPrograms();
              var prog = filtered[pIdx];
              var total = prog ? prog.total : 0;
              var pct = total > 0 ? Math.round((val / total) * 100) : 0;
              return pct + '% (' + val + ')';
            },
            style: {
              fontSize: '11px',
              fontWeight: 600,
              colors: ['#ffffff']
            }
          },
          series: buildFeedbackSeries(),
          xaxis: {
            categories: window.programFeedbackRawData.map(function(p) { return p.name; }),
            labels: {
              rotate: -25,
              rotateAlways: false,
              trim: true,
              maxHeight: 80,
              style: { fontSize: '12px', fontWeight: 500 }
            }
          },
          yaxis: {
            title: { text: 'Responses / Participants' },
            forceNiceScale: true,
            labels: {
              formatter: function(val) { return Math.round(val); }
            }
          },
          colors: ['#8b5cf6', '#fb7185'],
          tooltip: {
            theme: 'light',
            shared: true,
            intersect: false,
            y: {
              formatter: function(val, opts) {
                if (val === undefined || val === null) return '';
                var pIdx = opts.dataPointIndex;
                var filtered = getFilteredFeedbackPrograms();
                var prog = filtered[pIdx];
                var total = prog ? prog.total : 0;
                var pct = total > 0 ? Math.round((val / total) * 100) : 0;
                return pct + '% (' + val + ') [Total: ' + total + ']';
              }
            }
          },
          legend: {
            position: 'top',
            horizontalAlign: 'right',
            fontSize: '12px',
            itemMargin: { horizontal: 8, vertical: 4 }
          },
          responsive: [{
            breakpoint: 768,
            options: {
              chart: {
                height: 320
              },
              legend: {
                position: 'bottom',
                horizontalAlign: 'center',
                fontSize: '11px',
                itemMargin: { horizontal: 6, vertical: 4 }
              },
              xaxis: {
                labels: {
                  rotate: -35,
                  style: { fontSize: '10px' }
                }
              }
            }
          }]
        };
        window.feedbackChart = new ApexCharts(feedbackChartContainer, feedbackChartOptions);
        window.feedbackChart.render();
      }

      // Not-submitted by Assignment (Top 10) - bar with full name
      var notSubmittedContainer = document.querySelector('#not-submitted-assignment-chart');
      if (window.notSubmittedChart) { try { window.notSubmittedChart.destroy(); } catch(e) {} }
      if (notSubmittedContainer) {
        var notSubmittedOptions = {
          chart: { type: 'bar', height: 320 },
          series: [{ name: 'Pending', data: <%= raw @not_submitted_assignment_data.to_json %> }],
          xaxis: { 
            categories: <%= raw @not_submitted_assignment_labels.to_json %>, 
            labels: { 
              rotate: -40,
              rotateAlways: true,
              trim: false,
              style: { fontSize: '12px', fontWeight: 500 }
            } 
          },
          plotOptions: { bar: { horizontal: false, columnWidth: '60%', borderRadius: 4 } },
          dataLabels: { enabled: true, style: { fontSize: '12px' } },
          colors: ['#ef4444'],
          fill: { type: 'gradient', gradient: { shade: 'light', type: 'vertical', shadeIntensity: 0.6, gradientToColors: ['#f43f5e'], inverseColors: false, opacityFrom: 0.95, opacityTo: 0.7, stops: [0,100] } },
          tooltip: { y: { formatter: function(val){ return val + ' pending'; } } },
          legend: { show: false }
        };
        window.notSubmittedChart = new ApexCharts(notSubmittedContainer, notSubmittedOptions);
        window.notSubmittedChart.render();
      }

      // Pending by Section (Top 10) - bar with full name
      var pendingSectionContainer = document.querySelector('#pending-section-chart');
      if (window.pendingSectionChart) { try { window.pendingSectionChart.destroy(); } catch(e) {} }
      if (pendingSectionContainer) {
        var pendingSectionOptions = {
          chart: { type: 'bar', height: 320 },
          series: [{ name: 'Pending', data: <%= raw @pending_section_data.to_json %> }],
          xaxis: { 
            categories: <%= raw @pending_section_labels.to_json %>, 
            labels: { 
              rotate: -40,
              rotateAlways: true,
              trim: false,
              style: { fontSize: '12px', fontWeight: 500 }
            } 
          },
          plotOptions: { bar: { horizontal: false, columnWidth: '60%', borderRadius: 4 } },
          dataLabels: { enabled: true, style: { fontSize: '12px' } },
          colors: ['#8b5cf6'],
          fill: { type: 'gradient', gradient: { shade: 'light', type: 'vertical', shadeIntensity: 0.6, gradientToColors: ['#ec4899'], inverseColors: false, opacityFrom: 0.95, opacityTo: 0.7, stops: [0,100] } },
          tooltip: { y: { formatter: function(val){ return val + ' pending'; } } },
          legend: { show: false }
        };
        window.pendingSectionChart = new ApexCharts(pendingSectionContainer, pendingSectionOptions);
        window.pendingSectionChart.render();
      }

      // Initialize Flatpickr instances
      initDashboardDatepickers();
    }

    // Date formatting helper functions
    function formatDateIso(d) {
      if (!d) return '';
      const year = d.getFullYear();
      const month = String(d.getMonth() + 1).padStart(2, '0');
      const day = String(d.getDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    }

    function formatDayDisplay(d) {
      if (!d) return '';
      return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    }

    function formatRangeDisplay(d1, d2) {
      if (!d1 || !d2) return '';
      const opt1 = { month: 'short', day: 'numeric' };
      const opt2 = { month: 'short', day: 'numeric', year: 'numeric' };
      return `${d1.toLocaleDateString('en-US', opt1)} – ${d2.toLocaleDateString('en-US', opt2)}`;
    }

    // Dynamic series update for Assignment submission chart
    function updateAssignmentSubmissionSeries() {
      if (!window.submissionsChart) return;
      
      let series = [];
      let colors = [];
      
      if (submissionViewMode === 'combined') {
        series = [
          { name: 'Total Submissions', data: submissionRawData.total },
          { name: 'Backlog', data: submissionRawData.backlog }
        ];
        colors = ['#4f46e5', '#ef4444'];
      } else if (submissionViewMode === 'submissions') {
        if (submissionPTypeFilter === 'all') {
          series = [
            { name: 'Students', data: submissionRawData.student },
            { name: 'Guardians', data: submissionRawData.guardian },
            { name: 'Employees', data: submissionRawData.employee }
          ];
          colors = ['#06b6d4', '#f59e0b', '#10b981'];
        } else if (submissionPTypeFilter === 'student') {
          series = [{ name: 'Students', data: submissionRawData.student }];
          colors = ['#06b6d4'];
        } else if (submissionPTypeFilter === 'guardian') {
          series = [{ name: 'Guardians', data: submissionRawData.guardian }];
          colors = ['#f59e0b'];
        } else if (submissionPTypeFilter === 'employee') {
          series = [{ name: 'Employees', data: submissionRawData.employee }];
          colors = ['#10b981'];
        }
      } else if (submissionViewMode === 'backlog') {
        series = [{ name: 'Backlog', data: submissionRawData.backlog }];
        colors = ['#ef4444'];
      }
      
      // Update badge label
      const activeBadge = document.getElementById('submission-active-series-badge');
      if (activeBadge) {
        if (submissionViewMode === 'combined') {
          activeBadge.textContent = 'Viewing: Combined (Total & Backlog)';
        } else if (submissionViewMode === 'submissions') {
          if (submissionPTypeFilter === 'all') {
            activeBadge.textContent = 'Viewing: Submissions (All Types)';
          } else if (submissionPTypeFilter === 'student') {
            activeBadge.textContent = 'Viewing: Submissions (Students)';
          } else if (submissionPTypeFilter === 'guardian') {
            activeBadge.textContent = 'Viewing: Submissions (Guardians)';
          } else if (submissionPTypeFilter === 'employee') {
            activeBadge.textContent = 'Viewing: Submissions (Employees)';
          }
        } else if (submissionViewMode === 'backlog') {
          activeBadge.textContent = 'Viewing: Backlog Only';
        }
      }

      // Check if all series data points are 0
      const isAllZero = series.every(s => !s.data || s.data.every(v => Number(v) === 0));
      const zeroNotice = document.getElementById('submission-zero-notice');
      if (zeroNotice) {
        if (isAllZero) {
          zeroNotice.classList.remove('d-none');
          zeroNotice.classList.add('d-flex');
        } else {
          zeroNotice.classList.add('d-none');
          zeroNotice.classList.remove('d-flex');
        }
      }

      window.submissionsChart.updateOptions({
        series: series,
        xaxis: { categories: submissionRawData.labels },
        colors: colors,
        stroke: {
          curve: 'smooth',
          width: series.map(() => 2.5)
        }
      }, true, true);
    }

    function setSubmissionViewMode(mode) {
      submissionViewMode = mode;
      document.querySelectorAll('#btn-sub-view-combined, #btn-sub-view-submissions, #btn-sub-view-backlog').forEach(btn => btn.classList.remove('active'));
      const activeBtn = document.getElementById(`btn-sub-view-${mode}`);
      if (activeBtn) activeBtn.classList.add('active');

      const ptypeGroup = document.getElementById('sub-ptype-group');
      if (ptypeGroup) {
        ptypeGroup.style.display = (mode === 'submissions' ? 'inline-flex' : 'none');
      }
      updateAssignmentSubmissionSeries();
    }

    function filterSubmissionType(type) {
      submissionPTypeFilter = type;
      document.querySelectorAll('#sub-ptype-group button').forEach(btn => btn.classList.remove('active'));
      const activeBtn = document.getElementById(`btn-sub-ptype-${type}`);
      if (activeBtn) activeBtn.classList.add('active');
      updateAssignmentSubmissionSeries();
    }

    // 14-day shift navigation for Assignment submission
    function shiftAssignmentSubmission(forward) {
      const delta = forward ? 14 : -14;
      currentSubStartDate.setDate(currentSubStartDate.getDate() + delta);
      currentSubEndDate.setDate(currentSubEndDate.getDate() + delta);
      fetchAssignmentSubmissionData();
    }

    function resetAssignmentSubmissionLatest() {
      currentSubEndDate = new Date();
      currentSubStartDate = new Date();
      currentSubStartDate.setDate(currentSubEndDate.getDate() - 13);
      fetchAssignmentSubmissionData();
    }

    function fetchAssignmentSubmissionData(startStr = null, endStr = null) {
      const sStr = startStr || formatDateIso(currentSubStartDate);
      const eStr = endStr || formatDateIso(currentSubEndDate);
      if (!startStr) {
        const badge = document.getElementById('submission-date-range-badge');
        if (badge) badge.textContent = formatRangeDisplay(currentSubStartDate, currentSubEndDate);
      }

      fetch(`/institute_admin/dashboard/chart_data?chart=assignment_submission&start_date=${sStr}&end_date=${eStr}`)
        .then(r => r.json())
        .then(res => {
          if (res.success) {
            submissionRawData = {
              labels: res.labels,
              student: res.student_data,
              guardian: res.guardian_data,
              employee: res.employee_data,
              total: res.total_data,
              backlog: res.backlog_data
            };
            updateAssignmentSubmissionSeries();
          }
        })
        .catch(err => console.error('Failed to update assignment submission chart:', err));
    }

    // Submissions by Assignment navigation
    function shiftAssignmentDay(forward) {
      currentAssignDate.setDate(currentAssignDate.getDate() + (forward ? 1 : -1));
      fetchSubmissionsByAssignment();
    }

    function resetAssignmentDayToday() {
      currentAssignDate = new Date();
      fetchSubmissionsByAssignment();
    }

    function fetchSubmissionsByAssignment(startDate = null, endDate = null) {
      const sStr = startDate || formatDateIso(currentAssignDate);
      const eStr = endDate || sStr;
      const isRange = sStr !== eStr;
      const badge = document.getElementById('by-assignment-date-badge');
      if (badge) {
        badge.textContent = isRange ? `${sStr} – ${eStr}` : formatDayDisplay(currentAssignDate);
      }

      fetch(`/institute_admin/dashboard/chart_data?chart=submissions_by_assignment&start_date=${sStr}&end_date=${eStr}`)
        .then(r => r.json())
        .then(res => {
          if (res.success && window.byAssignmentChart) {
            window.byAssignmentChart.updateOptions({
              xaxis: { 
                categories: res.labels,
                labels: { rotate: -40, rotateAlways: true, trim: false, style: { fontSize: '12px' } }
              }
            });
            window.byAssignmentChart.updateSeries([{ name: 'Participants', data: res.data }]);
          }
        })
        .catch(err => console.error('Failed to update by assignment chart:', err));
    }

