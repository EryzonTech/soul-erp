      }

      fetch(`/institute_admin/dashboard/chart_data?chart=submissions_by_section&start_date=${sStr}&end_date=${eStr}`)
        .then(r => r.json())
        .then(res => {
          if (res.success && window.bySectionChart) {
            window.bySectionChart.updateOptions({
              xaxis: { 
                categories: res.labels,
                labels: { rotate: -35, rotateAlways: true, trim: false, maxHeight: 180, style: { fontSize: '11px', fontWeight: 500 } }
              }
            });
            window.bySectionChart.updateSeries([{ name: 'Submissions', data: res.data }]);
          }
        })
        .catch(err => console.error('Failed to update by section chart:', err));
    }

    // Not Submitted by Assignment navigation
    function shiftNotSubmittedDay(forward) {
      const step = forward ? 1 : -1;
      const diffDays = Math.round((currentNotSubEndDate - currentNotSubStartDate) / (1000 * 60 * 60 * 24));
      currentNotSubStartDate.setDate(currentNotSubStartDate.getDate() + step);
      currentNotSubEndDate.setDate(currentNotSubEndDate.getDate() + step);
      const sStr = formatDateIso(currentNotSubStartDate);
      const eStr = formatDateIso(currentNotSubEndDate);
      const picker = document.querySelector('#not_submitted_picker')?._flatpickr;
      if (picker) {
        picker.setDate(sStr === eStr ? [currentNotSubStartDate] : [currentNotSubStartDate, currentNotSubEndDate]);
      }
      fetchNotSubmittedByAssignment(sStr, eStr);
    }

    function resetNotSubmittedToday() {
      const diffDays = Math.round((currentNotSubEndDate - currentNotSubStartDate) / (1000 * 60 * 60 * 24));
      currentNotSubEndDate = new Date();
      currentNotSubStartDate = new Date();
      if (diffDays > 0) {
        currentNotSubStartDate.setDate(currentNotSubEndDate.getDate() - diffDays);
      }
      const sStr = formatDateIso(currentNotSubStartDate);
      const eStr = formatDateIso(currentNotSubEndDate);
      const picker = document.querySelector('#not_submitted_picker')?._flatpickr;
      if (picker) {
        picker.setDate(sStr === eStr ? [currentNotSubStartDate] : [currentNotSubStartDate, currentNotSubEndDate]);
      }
      fetchNotSubmittedByAssignment(sStr, eStr);
    }

    function fetchNotSubmittedByAssignment(startDate = null, endDate = null) {
      const sStr = startDate || formatDateIso(currentNotSubStartDate);
      const eStr = endDate || sStr;
      const isRange = sStr !== eStr;
      const badge = document.getElementById('not-submitted-date-badge');
      if (badge) {
        badge.textContent = isRange ? formatRangeDisplay(currentNotSubStartDate, currentNotSubEndDate) : formatDayDisplay(currentNotSubStartDate);
      }

      fetch(`/institute_admin/dashboard/chart_data?chart=not_submitted_assignment&start_date=${sStr}&end_date=${eStr}`)
        .then(r => r.json())
        .then(res => {
          if (res.success && window.notSubmittedChart) {
            window.notSubmittedChart.updateOptions({
              xaxis: { 
                categories: res.labels,
                labels: { rotate: -35, rotateAlways: true, trim: false, maxHeight: 115, style: { fontSize: '11px', fontWeight: 500 } }
              }
            });
            window.notSubmittedChart.updateSeries([{ name: 'Pending', data: res.data }]);
          }
        })
        .catch(err => console.error('Failed to update not submitted chart:', err));
    }

