  </div>

  <!-- Assignment submission (Submissions Over Time & Backlog Trend) -->
  <div class="row g-4 mb-4">
    <div class="col-12">
      <div class="card card-custom h-100">
        <div class="card-header chart-card-header border-0 d-flex flex-column flex-xl-row justify-content-between align-items-start align-items-xl-center gap-3">
          <div class="d-flex align-items-center gap-3 min-width-0">
            <div class="chart-icon-box flex-shrink-0" style="background: rgba(79,70,229,0.1); color: #4f46e5;">
              <i class="bi bi-graph-up-arrow"></i>
            </div>
            <div class="min-width-0">
              <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                <h5 class="chart-header-title mb-0">Assignment Submissions</h5>
                <span id="submission-date-range-badge" class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill d-inline-flex align-items-center" style="font-size:0.72rem; padding: 0.22rem 0.62rem; font-weight: 600;">
                  <i class="bi bi-calendar3 me-1"></i><%= @submission_start_date.strftime("%b %d") %> – <%= @submission_end_date.strftime("%b %d, %Y") %>
                </span>
                <span id="submission-active-series-badge" class="badge bg-secondary-subtle text-dark border border-secondary-subtle rounded-pill d-none" style="font-size:0.7rem; padding: 0.18rem 0.55rem; font-weight: 600;">
                </span>
              </div>
              <div class="d-flex align-items-center gap-2 flex-wrap">
                <p class="chart-header-subtitle mb-0">Multi-series submission trends &amp; backlog analysis</p>
                <span class="text-muted opacity-50 d-none d-sm-inline">·</span>
                <!-- Custom Legend -->
                <div class="d-inline-flex align-items-center gap-2 flex-wrap" id="submission-chart-legend">
                  <div class="sub-legend-chip">
                    <span class="sub-legend-indicator" style="background:#4f46e5;"></span>
                    <span>Total Submissions</span>
                  </div>
                  <div class="sub-legend-chip">
                    <span class="sub-legend-indicator" style="background:#ef4444;"></span>
                    <span>Backlog</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="chart-controls-toolbar">
            <!-- Row 1: Filters (View Mode & Participant Type) -->
            <div class="chart-toolbar-row scrollable-row">
              <!-- View Mode Pills -->
              <div class="chart-segmented-control" role="group" aria-label="View Mode">
                <button type="button" class="btn-segment active" id="btn-sub-view-combined" onclick="setSubmissionViewMode('combined')">Combined</button>
                <button type="button" class="btn-segment" id="btn-sub-view-submissions" onclick="setSubmissionViewMode('submissions')">Submissions Only</button>
                <button type="button" class="btn-segment" id="btn-sub-view-backlog" onclick="setSubmissionViewMode('backlog')">Backlog Only</button>
              </div>

              <!-- Participant Type Filter (Active in Submissions Only mode) -->
              <div class="chart-segmented-control sub-segmented-control" id="sub-ptype-group" role="group" aria-label="Participant Type Filter" style="display: none;">
                <button type="button" class="btn-sub-segment active" id="btn-sub-ptype-all" onclick="filterSubmissionType('all', event)" title="View all participant types">All</button>
                <button type="button" class="btn-sub-segment active" id="btn-sub-ptype-student" onclick="filterSubmissionType('student', event)" title="Toggle Students">
                  <span class="sub-ptype-dot" style="background-color: #06b6d4;"></span>Students
                </button>
                <button type="button" class="btn-sub-segment active" id="btn-sub-ptype-guardian" onclick="filterSubmissionType('guardian', event)" title="Toggle Guardians">
                  <span class="sub-ptype-dot" style="background-color: #f59e0b;"></span>Guardians
                </button>
                <button type="button" class="btn-sub-segment active" id="btn-sub-ptype-employee" onclick="filterSubmissionType('employee', event)" title="Toggle Employees">
                  <span class="sub-ptype-dot" style="background-color: #10b981;"></span>Employees
                </button>
              </div>
            </div>

            <!-- Row 2: Date Nav & Range Picker -->
            <div class="chart-toolbar-row">
              <!-- Date Nav Controls -->
              <div class="chart-nav-group" role="group" aria-label="Date Navigation">
                <button type="button" class="chart-nav-btn" onclick="shiftAssignmentSubmission(false)" title="Previous 14 Days">
                  <i class="bi bi-chevron-left"></i> Prev 14d
                </button>
                <button type="button" class="chart-nav-btn" onclick="shiftAssignmentSubmission(true)" title="Next 14 Days">
                  Next 14d <i class="bi bi-chevron-right"></i>
                </button>
                <button type="button" class="chart-nav-btn chart-nav-today" onclick="resetAssignmentSubmissionLatest()" title="Latest 14 Days">
                  Latest
                </button>
              </div>

              <!-- Flatpickr Custom Range -->
              <div class="chart-datepicker-wrapper">
                <input type="text" id="assignment_submission_range_picker" class="form-control form-control-sm chart-datepicker-input"
                       placeholder="Custom Date Range" readonly>
              </div>
            </div>
          </div>
        </div>
        <div class="card-body pt-1">
          <div id="submission-zero-notice" class="alert alert-light border border-secondary-subtle text-muted py-2 px-3 mb-2 small d-none align-items-center gap-2 rounded-3">
            <i class="bi bi-info-circle text-primary fs-6"></i>
            <span>No submissions recorded in this date range. Use <strong>&lt; Prev 14d</strong> or pick a custom date range to view earlier activity.</span>
          </div>
          <div id="submissions-over-time-chart" style="height: 330px;"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Top and Bottom Submitting Participants Leaderboard Row (Items 15 & 16) -->
  <div class="row g-4 mb-4">
    <!-- Top Submitting Participants (Streak without break) -->
    <div class="col-xl-6 col-12">
      <div class="card card-custom h-100">
        <div class="card-header chart-card-header border-0 d-flex flex-column gap-2">
          <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
            <div class="d-flex align-items-center gap-3 min-width-0">
