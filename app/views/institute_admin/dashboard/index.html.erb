            </div>
            <div class="op-stat-icon-box">
              <i class="bi bi-chat-square-text-fill"></i>
            </div>
          </div>
          <div class="op-stat-breakdown stat-breakdown">
            <span class="op-stat-breakdown-pill">Students: <strong><%= @feedback_by_type["student"] || 0 %></strong></span>
            <span class="op-stat-breakdown-pill">Guardians: <strong><%= @feedback_by_type["guardian"] || 0 %></strong></span>
