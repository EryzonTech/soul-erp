    <div class="col-12 col-sm-6 col-xl-3 d-flex">
      <div class="op-stat-card op-stat-card-responses w-100 h-100">
        <i class="bi bi-file-earmark-check-fill op-stat-watermark"></i>
        <div class="card-body">
