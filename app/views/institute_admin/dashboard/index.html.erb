                          <div class="sub-progress-bar-track">
                            <div class="sub-progress-bar-fill" style="width: <%= [pct, 100].min %>%; background: <%= fill_color %>;"></div>
                          </div>
                          <span class="sub-pct-chip"><%= pct %>%</span>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                <% else %>
                  <tr><td colspan="5" class="text-center py-4 text-muted">No participants found for this assignment</td></tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
