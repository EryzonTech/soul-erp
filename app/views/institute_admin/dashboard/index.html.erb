    // Flatpickr initialization
    function initDashboardDatepickers() {
      if (typeof flatpickr === "undefined") return;

      flatpickr("#assignment_submission_range_picker", {
        mode: "range",
        dateFormat: "Y-m-d",
        defaultDate: ["<%= @submission_start_date.iso8601 %>", "<%= @submission_end_date.iso8601 %>"],
        onClose: function(selectedDates) {
          if (selectedDates.length === 2) {
            currentSubStartDate = selectedDates[0];
            currentSubEndDate = selectedDates[1];
            const sStr = formatDateIso(selectedDates[0]);
            const eStr = formatDateIso(selectedDates[1]);
            const badge = document.getElementById('submission-date-range-badge');
            if (badge) badge.textContent = formatRangeDisplay(selectedDates[0], selectedDates[1]);
            fetchAssignmentSubmissionData(sStr, eStr);
          }
        }
      });

      flatpickr("#by_assignment_picker", {
        mode: "range",
        dateFormat: "Y-m-d",
        defaultDate: ["<%= @assignment_date.iso8601 %>"],
        onClose: function(selectedDates) {
          if (selectedDates.length >= 1) {
            currentAssignDate = selectedDates[0];
            const sStr = formatDateIso(selectedDates[0]);
            const eStr = selectedDates.length === 2 ? formatDateIso(selectedDates[1]) : sStr;
            fetchSubmissionsByAssignment(sStr, eStr);
          }
        }
      });

      flatpickr("#by_section_picker", {
        mode: "range",
        dateFormat: "Y-m-d",
        defaultDate: ["<%= @section_date.iso8601 %>"],
        onClose: function(selectedDates) {
          if (selectedDates.length >= 1) {
            currentSectionDate = selectedDates[0];
            const sStr = formatDateIso(selectedDates[0]);
            const eStr = selectedDates.length === 2 ? formatDateIso(selectedDates[1]) : sStr;
            fetchSubmissionsBySection(sStr, eStr);
          }
        }
      });

      flatpickr("#not_submitted_picker", {
        dateFormat: "Y-m-d",
        defaultDate: "<%= @not_submitted_date.iso8601 %>",
        onClose: function(selectedDates) {
          if (selectedDates.length === 1) {
            currentNotSubDate = selectedDates[0];
            fetchNotSubmittedByAssignment(formatDateIso(selectedDates[0]));
          }
        }
      });

      flatpickr("#pending_section_picker", {
        dateFormat: "Y-m-d",
        defaultDate: "<%= @pending_section_date.iso8601 %>",
        onClose: function(selectedDates) {
          if (selectedDates.length === 1) {
            currentPendSecDate = selectedDates[0];
            fetchPendingBySection(formatDateIso(selectedDates[0]));
          }
        }
      });
    }

    // Interactive helper functions for Feedback by Training Program
    window.switchFeedbackViewMode = function(mode) {
      window.feedbackViewMode = mode;
      var btnRec = document.getElementById('tpfModeReceivedPending');
      var btnPart = document.getElementById('tpfModeParticipantType');
      if (btnRec && btnPart) {
        if (mode === 'received_pending') {
          btnRec.classList.add('active');
          btnPart.classList.remove('active');
        } else {
          btnPart.classList.add('active');
          btnRec.classList.remove('active');
        }
      }
      renderFeedbackChartAndSummary();
    };

    window.toggleAllFeedbackPrograms = function(cb) {
      var check = cb.checked;
      var cbs = document.querySelectorAll('.tpf-program-cb');
      window.selectedFeedbackProgramIds = [];
      cbs.forEach(function(c) {
        c.checked = check;
        if (check) window.selectedFeedbackProgramIds.push(parseInt(c.value));
      });
      renderFeedbackChartAndSummary();
    };

    window.handleFeedbackProgramChange = function() {
      var cbs = document.querySelectorAll('.tpf-program-cb');
      window.selectedFeedbackProgramIds = [];
      var allChecked = true;
      cbs.forEach(function(c) {
        if (c.checked) {
          window.selectedFeedbackProgramIds.push(parseInt(c.value));
        } else {
          allChecked = false;
        }
      });
      var selectAllCb = document.getElementById('tpfSelectAll');
      if (selectAllCb) selectAllCb.checked = allChecked;
      renderFeedbackChartAndSummary();
    };

    window.renderFeedbackChartAndSummary = function() {
      var filtered = window.programFeedbackRawData.filter(function(p) {
        return window.selectedFeedbackProgramIds.indexOf(p.id) !== -1;
      });

      var totalReceived = filtered.reduce(function(sum, p) { return sum + (p.received || 0); }, 0);
      var totalPending = filtered.reduce(function(sum, p) { return sum + (p.pending || 0); }, 0);
      var totalPossible = totalReceived + totalPending;
      var recPct = totalPossible > 0 ? Math.round((totalReceived / totalPossible) * 100) : 0;
      var pendPct = totalPossible > 0 ? Math.round((totalPending / totalPossible) * 100) : 0;
      var totalStudents = filtered.reduce(function(sum, p) { return sum + (p.student || 0); }, 0);
      var totalGuardians = filtered.reduce(function(sum, p) { return sum + (p.guardian || 0); }, 0);
      var totalEmployees = filtered.reduce(function(sum, p) { return sum + (p.employee || 0); }, 0);

      var recEl = document.getElementById('tpf-received-summary');
      if (recEl) recEl.innerHTML = '<i class="bi bi-check2-circle me-1"></i>Received: ' + recPct + '% (' + totalReceived + ')';
      var pendEl = document.getElementById('tpf-pending-summary');
      if (pendEl) pendEl.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Pending: ' + pendPct + '% (' + totalPending + ')';
      var stuEl = document.getElementById('tpf-students-summary');
      if (stuEl) stuEl.innerHTML = 'Students: <strong>' + totalStudents + '</strong>';
      var guarEl = document.getElementById('tpf-guardians-summary');
      if (guarEl) guarEl.innerHTML = 'Guardians: <strong>' + totalGuardians + '</strong>';
      var empEl = document.getElementById('tpf-employees-summary');
      if (empEl) empEl.innerHTML = 'Employees: <strong>' + totalEmployees + '</strong>';

      var labelEl = document.getElementById('tpfSelectedProgramLabel');
      if (labelEl) {
        if (window.selectedFeedbackProgramIds.length === window.programFeedbackRawData.length) {
          labelEl.textContent = 'All Programs (' + window.programFeedbackRawData.length + ')';
        } else {
          labelEl.textContent = window.selectedFeedbackProgramIds.length + ' Programs Selected';
        }
      }
      var counterTextEl = document.getElementById('tpfCounterText');
      if (counterTextEl) counterTextEl.textContent = window.selectedFeedbackProgramIds.length + ' selected';

      if (window.feedbackChart) {
        var colors = window.feedbackViewMode === 'participant_type' ? ['#0ea5e9', '#a855f7', '#f59e0b', '#fb7185'] : ['#8b5cf6', '#fb7185'];
        window.feedbackChart.updateOptions({
          colors: colors,
          xaxis: { categories: filtered.map(function(p) { return p.name; }) }
        }, false, true);

        var newSeries = window.feedbackViewMode === 'participant_type' ? [
          { name: 'Students', data: filtered.map(function(p) { return p.student || 0; }) },
          { name: 'Guardians', data: filtered.map(function(p) { return p.guardian || 0; }) },
          { name: 'Employees', data: filtered.map(function(p) { return p.employee || 0; }) },
          { name: 'Pending', data: filtered.map(function(p) { return p.pending || 0; }) }
        ] : [
          { name: 'Received', data: filtered.map(function(p) { return p.received || 0; }) },
          { name: 'Pending', data: filtered.map(function(p) { return p.pending || 0; }) }
        ];
        window.feedbackChart.updateSeries(newSeries, true);
      }
    };

    // Streak Leaderboards AJAX Handler
    window.updateStreakLeaderboard = function(type) {
      var asgSelect = document.getElementById(type + 'LeaderboardAssignment');
      var limitSelect = document.getElementById(type + 'LeaderboardLimit');
      if (!asgSelect || !limitSelect) return;

      var asgId = asgSelect.value;
      var limit = limitSelect.value;
      var tbody = document.getElementById(type + 'LeaderboardBody');
      if (tbody) tbody.style.opacity = '0.4';

      var url = '/institute_admin/dashboard/streak_leaderboards?assignment_id=' + encodeURIComponent(asgId) + '&' + type + '_limit=' + encodeURIComponent(limit);
      fetch(url, { headers: { 'Accept': 'application/json' } })
        .then(function(res) { return res.json(); })
        .then(function(json) {
          if (tbody) tbody.style.opacity = '1';
          if (!json.success) return;
          var list = type === 'top' ? json.top : json.bottom;
          var html = '';
          if (list && list.length > 0) {
            list.forEach(function(p) {
              if (type === 'top') {
                var badgeClass = p.rank === 1 ? 'bg-warning text-dark' : (p.rank === 2 ? 'bg-secondary text-white' : (p.rank === 3 ? 'bg-bronze text-white' : 'bg-light text-dark border'));
                html += '<tr>' +
                  '<td><span class="badge ' + badgeClass + ' rounded-pill fw-bold">#' + p.rank + '</span></td>' +
                  '<td class="fw-semibold text-dark">' + p.name + '</td>' +
                  '<td><span class="badge bg-light text-secondary border">' + p.section + '</span></td>' +
                  '<td class="text-muted small text-truncate" style="max-width: 150px;" title="' + p.assignment_name + '">' + p.assignment_name + '</td>' +
                  '<td class="text-center"><span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-fire text-danger me-1"></i>' + p.streak + ' ' + (p.streak === 1 ? 'day' : 'days') + '</span></td>' +
                  '</tr>';
              } else {
                var pBadge = p.raw_participant_type === 'student' ? 'badge-student' : (p.raw_participant_type === 'guardian' ? 'badge-guardian' : (p.raw_participant_type === 'employee' ? 'badge-employee' : 'bg-secondary'));
                html += '<tr>' +
                  '<td><span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill fw-bold">#' + p.rank + '</span></td>' +
                  '<td class="fw-semibold text-dark">' + p.name + '</td>' +
                  '<td><span class="badge bg-light text-secondary border">' + p.section + '</span></td>' +
                  '<td><span class="badge ' + pBadge + '">' + p.participant_type + '</span></td>' +
                  '<td class="text-muted small text-truncate" style="max-width: 140px;" title="' + p.assignment_name + '">' + p.assignment_name + '</td>' +
                  '<td class="text-center"><span class="badge bg-light text-muted border"><i class="bi bi-x-circle text-danger me-1"></i>' + p.streak + ' days</span></td>' +
                  '</tr>';
              }
            });
          } else {
            var cols = type === 'top' ? 5 : 6;
            html = '<tr><td colspan="' + cols + '" class="text-center py-4 text-muted">No participants found for this assignment</td></tr>';
          }
          if (tbody) tbody.innerHTML = html;
        })
        .catch(function(err) {
          if (tbody) tbody.style.opacity = '1';
          console.error('Failed to update streak leaderboard:', err);
        });
    };

    // Initialize on first load
    document.addEventListener('DOMContentLoaded', initializeDashboardCharts);
    
    // Handle navigation to/from dashboard page
    document.addEventListener('turbo:load', function() {
      isDashboardPage = document.querySelector("#participants-section-chart") !== null;
      if (isDashboardPage) {
        initializeDashboardCharts();
      }
    });

    // Clean up only when leaving dashboard page
    document.addEventListener('turbo:before-visit', function() {
      if (isDashboardPage) {
        if (window.sectionChart) { window.sectionChart.destroy(); window.sectionChart = null; }
        if (window.typeChart) { window.typeChart.destroy(); window.typeChart = null; }
        if (window.feedbackChart) { window.feedbackChart.destroy(); window.feedbackChart = null; }
        if (window.submissionsChart) { window.submissionsChart.destroy(); window.submissionsChart = null; }
        if (window.byAssignmentChart) { window.byAssignmentChart.destroy(); window.byAssignmentChart = null; }
