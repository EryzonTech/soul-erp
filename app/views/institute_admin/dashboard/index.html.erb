<% content_for :styles do %>
  <style>
    .stat-card,
    .op-stat-card {
      border: none;
      border-radius: 20px;
      position: relative;
      overflow: hidden;
      transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      min-height: 180px;
      height: 100%;
      width: 100%;
      display: flex;
      flex-direction: column;
    }

    .stat-card:hover,
    .op-stat-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 16px 32px rgba(0, 0, 0, 0.18);
    }

    .stat-card .card-body,
    .op-stat-card .card-body {
      padding: 1.2rem 1.25rem;
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      height: 100%;
      width: 100%;
      justify-content: space-between;
    }

    .stat-card .stat-title,
    .op-stat-title {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: rgba(255, 255, 255, 0.85);
      margin-bottom: 0.25rem;
    }

    .stat-card .stat-value,
    .op-stat-value {
      font-size: 2.1rem;
      font-weight: 800;
      line-height: 1;
      color: #fff;
      margin-bottom: 0;
      letter-spacing: -0.5px;
    }

    .stat-card .stat-icon {
      position: absolute;
      right: 1.25rem;
      top: 2.2rem;
      transform: translateY(-50%);
      font-size: 2.75rem;
      color: rgba(255, 255, 255, 0.2);
      transition: all 0.3s ease;
      pointer-events: none;
    }

    .stat-card:hover .stat-icon {
      transform: translateY(-50%) scale(1.1);
      color: rgba(255, 255, 255, 0.28);
    }

    /* Card Variants Row 1 */
    .stat-card-participants {
      background: linear-gradient(135deg, #4f46e5 0%, #818cf8 100%);
      box-shadow: 0 8px 20px rgba(79, 70, 229, 0.25);
    }

    .stat-card-questions {
      background: linear-gradient(135deg, #059669 0%, #34d399 100%);
      box-shadow: 0 8px 20px rgba(5, 150, 105, 0.25);
    }

    .stat-card-assignments {
      background: linear-gradient(135deg, #d97706 0%, #fbbf24 100%);
      box-shadow: 0 8px 20px rgba(217, 119, 6, 0.25);
    }

    .stat-card-sections {
      background: linear-gradient(135deg, #e11d48 0%, #fb7185 100%);
      box-shadow: 0 8px 20px rgba(225, 29, 72, 0.25);
    }

    /* ── Operational KPI Cards (Row 2) — Vivid Gradient Redesign ── */
    .op-stat-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 0.5rem;
    }

    .op-stat-icon-box {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      flex-shrink: 0;
      background: rgba(255, 255, 255, 0.2);
      color: #ffffff;
      backdrop-filter: blur(4px);
      transition: transform 0.25s ease;
    }

    .op-stat-card:hover .op-stat-icon-box {
      transform: scale(1.12) rotate(-4deg);
    }

    /* Decorative watermark icon behind the value */
    .op-stat-watermark {
      position: absolute;
      right: -10px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 6.5rem;
      color: rgba(255, 255, 255, 0.08);
      pointer-events: none;
      z-index: 0;
    }

    /* Breakdown row on colored background */
    .stat-card .stat-breakdown,
    .op-stat-card .stat-breakdown,
    .op-stat-breakdown {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      flex-wrap: wrap;
      margin-top: auto;
      padding-top: 0.55rem;
      border-top: 1px solid rgba(255, 255, 255, 0.2);
      min-height: 52px;
    }

    .stat-card .stat-breakdown-pill,
    .op-stat-card .stat-breakdown-pill,
    .op-stat-breakdown-pill {
      font-size: 0.69rem;
      font-weight: 600;
      padding: 0.18rem 0.5rem;
      border-radius: 9999px;
      background: rgba(255, 255, 255, 0.18);
      color: #ffffff !important;
      border: 1px solid rgba(255, 255, 255, 0.25);
      white-space: nowrap;
      letter-spacing: 0.1px;
      backdrop-filter: blur(4px);
      line-height: 1.3;
    }

    .stat-card .stat-breakdown-pill strong,
    .op-stat-card .stat-breakdown-pill strong,
    .op-stat-breakdown-pill strong {
      color: #ffffff !important;
      font-weight: 800;
    }

    /* Card gradient variants */
    .op-stat-card-responses {
      background: linear-gradient(135deg, #0ea5e9 0%, #06b6d4 50%, #0891b2 100%);
      box-shadow: 0 8px 20px rgba(6, 182, 212, 0.35);
    }

    .op-stat-card-trainers {
      background: linear-gradient(135deg, #7c3aed 0%, #8b5cf6 50%, #a78bfa 100%);
      box-shadow: 0 8px 20px rgba(139, 92, 246, 0.35);
    }

    .op-stat-card-programs {
      background: linear-gradient(135deg, #059669 0%, #10b981 50%, #34d399 100%);
      box-shadow: 0 8px 20px rgba(16, 185, 129, 0.35);
    }

    .op-stat-card-feedback {
      background: linear-gradient(135deg, #db2777 0%, #ec4899 50%, #f472b6 100%);
      box-shadow: 0 8px 20px rgba(236, 72, 153, 0.35);
    }

    /* Coloured participant type pill variants */
    .tpf-pill-students {
      background: rgba(14, 165, 233, 0.10);
      color: #0369a1 !important;
      border-color: rgba(14, 165, 233, 0.30) !important;
    }
    .tpf-pill-students strong { color: #0c4a6e !important; }

    .tpf-pill-guardians {
      background: rgba(139, 92, 246, 0.10);
      color: #6d28d9 !important;
      border-color: rgba(139, 92, 246, 0.30) !important;
    }
    .tpf-pill-guardians strong { color: #4c1d95 !important; }

    .tpf-pill-employees {
      background: rgba(245, 158, 11, 0.10);
      color: #b45309 !important;
      border-color: rgba(245, 158, 11, 0.30) !important;
    }
    .tpf-pill-employees strong { color: #78350f !important; }

    /* Modern Table Styles with mobile touch momentum */
    .table-responsive {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch !important;
      touch-action: pan-x pan-y !important;
      width: 100% !important;
      max-width: 100% !important;
      overscroll-behavior-x: contain;
    }

    .modern-table {
      width: 100%;
      min-width: 700px;
      border-collapse: separate;
      border-spacing: 0 0.75rem;
      margin-top: -0.75rem;
    }

    .modern-table thead th {
      background: #1e293b;
      color: #fff;
      font-weight: 600;
      text-transform: uppercase;
      font-size: 0.75rem;
      letter-spacing: 1px;
      padding: 1rem 1.5rem;
      border: none;
    }

    .modern-table thead th:first-child {
      border-top-left-radius: 8px;
      border-bottom-left-radius: 8px;
    }

    .modern-table thead th:last-child {
      border-top-right-radius: 8px;
      border-bottom-right-radius: 8px;
    }

    .modern-table tbody tr {
      background: #fff;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
      transition: all 0.2s ease;
    }

    .modern-table tbody tr:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    }

    .modern-table tbody td {
      padding: 1.25rem 1.5rem;
      vertical-align: middle;
      border: none;
      font-size: 0.95rem;
      color: #475569;
    }

    .modern-table tbody td:first-child {
      border-top-left-radius: 8px;
      border-bottom-left-radius: 8px;
    }

    .modern-table tbody td:last-child {
      border-top-right-radius: 8px;
      border-bottom-right-radius: 8px;
    }

    /* Leaderboard container, scroll area, & margins */
    .leaderboard-card-body {
      padding: 1.1rem 1.25rem;
    }

    .leaderboard-table-scroll {
      height: 520px;
      min-height: 520px;
      max-height: 520px;
      overflow-y: auto;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      touch-action: pan-x pan-y;
      overscroll-behavior-x: contain;
      width: 100%;
      border-radius: 8px;
    }

    /* Submission progress cell */
    .sub-progress-wrap {
      display: flex;
      flex-direction: column;
      gap: 3px;
      min-width: 110px;
    }
    .sub-progress-label {
      font-size: 0.75rem;
      font-weight: 600;
      white-space: nowrap;
    }
    .sub-progress-bar-track {
      height: 5px;
      border-radius: 99px;
      background: #e2e8f0;
      overflow: hidden;
    }
    .sub-progress-bar-fill {
      height: 100%;
      border-radius: 99px;
      transition: width 0.4s ease;
    }
    .sub-pct-chip {
      font-size: 0.68rem;
      font-weight: 700;
      color: #64748b;
    }

    /* Export buttons */
    .leaderboard-export-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      font-size: 0.72rem;
      font-weight: 600;
      padding: 0.28rem 0.6rem;
      border-radius: 6px;
      border: 1.5px solid #e2e8f0;
      background: #f8fafc;
      color: #475569;
      cursor: pointer;
      transition: all 0.18s ease;
      text-decoration: none;
    }
    .leaderboard-export-btn:hover {
      border-color: #cbd5e1;
      background: #fff;
      color: #0f172a;
    }
    .leaderboard-export-btn.csv-btn:hover  { border-color: #6ee7b7; color: #065f46; }
    .leaderboard-export-btn.pdf-btn:hover  { border-color: #fca5a5; color: #991b1b; }

    .leaderboard-table {
      width: 100%;
      min-width: 680px;
      border-collapse: separate;
      border-spacing: 0 0.65rem;
      margin-top: 0.15rem;
      margin-bottom: 0.5rem;
    }

    .leaderboard-table thead th {
      padding: 0.9rem 1rem;
      background: #1e293b;
      color: #fff;
      white-space: nowrap;
      font-size: 0.85rem;
      font-weight: 700;
    }

    .leaderboard-table tbody td {
      padding: 0.95rem 1rem;
      vertical-align: middle;
      border: none;
      font-size: 0.95rem;
      color: #475569;
      background: #fff;
    }

    /* Remove transform on hover to maintain sticky column stacking context */
    .leaderboard-table tbody tr {
      background: #fff;
      box-shadow: 0 3px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
      transition: box-shadow 0.2s ease;
    }

    .leaderboard-table tbody tr:hover {
      transform: none !important;
      box-shadow: 0 8px 16px -2px rgba(0, 0, 0, 0.08), 0 4px 8px -2px rgba(0, 0, 0, 0.04);
    }

    .leaderboard-table tbody tr:hover td {
      background-color: #f8fafc !important;
    }

    /* Scroll container and custom scrollbar */
    .leaderboard-table-scroll {
      overflow-x: auto;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      touch-action: pan-x pan-y;
    }

    .leaderboard-table-scroll .leaderboard-sticky-head th {
      position: sticky;
      top: 0;
      z-index: 15;
      background: #1e293b;
      white-space: nowrap;
    }

    .leaderboard-table-scroll::-webkit-scrollbar {
      width: 5px;
      height: 5px;
    }
    .leaderboard-table-scroll::-webkit-scrollbar-track {
      background: #f1f5f9;
      border-radius: 99px;
    }
    .leaderboard-table-scroll::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 99px;
    }
    .leaderboard-table-scroll::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }

    /* First and last column border radii on desktop */
    .leaderboard-table thead th:first-child {
      border-top-left-radius: 8px;
      border-bottom-left-radius: 8px;
    }
    .leaderboard-table thead th:last-child {
      border-top-right-radius: 8px;
      border-bottom-right-radius: 8px;
    }
    .leaderboard-table tbody td:first-child {
      border-top-left-radius: 8px;
      border-bottom-left-radius: 8px;
    }
    .leaderboard-table tbody td:last-child {
      border-top-right-radius: 8px;
      border-bottom-right-radius: 8px;
    }

    /* ── Desktop Frozen Sticky Columns (Rank & Participant Name) ───────── */
    .leaderboard-table .sticky-col-rank {
      left: 0 !important;
      width: 68px !important;
      min-width: 68px !important;
      max-width: 68px !important;
      text-align: center;
    }

    .leaderboard-table tbody td.sticky-col-rank {
      position: sticky !important;
      left: 0 !important;
      z-index: 6 !important;
      background-color: #ffffff !important;
      border-top-left-radius: 8px;
      border-bottom-left-radius: 8px;
      will-change: transform;
    }

    .leaderboard-table thead th.sticky-col-rank {
      position: sticky !important;
      top: 0 !important;
      left: 0 !important;
      z-index: 30 !important;
      background: #1e293b !important;
      color: #fff !important;
      border-top-left-radius: 8px;
      border-bottom-left-radius: 8px;
      will-change: transform;
    }

    .leaderboard-table .sticky-col-name {
      left: 68px !important;
      min-width: 130px !important;
      max-width: 190px !important;
      overflow: hidden !important;
      text-overflow: ellipsis !important;
      white-space: nowrap !important;
    }

    .leaderboard-table tbody td.sticky-col-name {
      position: sticky !important;
      left: 68px !important;
      z-index: 6 !important;
      background-color: #ffffff !important;
      box-shadow: 4px 0 8px -2px rgba(0, 0, 0, 0.08) !important;
      will-change: transform;
    }

    .leaderboard-table thead th.sticky-col-name {
      position: sticky !important;
      top: 0 !important;
      left: 68px !important;
      z-index: 30 !important;
      background: #1e293b !important;
      color: #fff !important;
      box-shadow: 4px 0 8px -2px rgba(0, 0, 0, 0.25) !important;
      will-change: transform;
    }

    .leaderboard-table tbody tr:hover td.sticky-col-rank,
    .leaderboard-table tbody tr:hover td.sticky-col-name {
      background-color: #f8fafc !important;
    }

    /* Bronze rank badge (rank #3) */
    .bg-bronze {
      background-color: #cd7f32 !important;
    }

    /* ── Tablet View (768px - 991.98px) ─────────────────────────────────── */
    @media (min-width: 768px) and (max-width: 991.98px) {
      .leaderboard-table thead th,
      .leaderboard-table tbody td {
        padding: 0.55rem 0.6rem !important;
        font-size: 0.8rem;
        white-space: nowrap;
      }
      .leaderboard-card-body {
        padding: 0.75rem 0.85rem;
      }
      .leaderboard-table-scroll {
        height: 420px;
        min-height: 420px;
        max-height: 420px;
      }
      .sub-progress-wrap { min-width: 90px; }
      .sub-progress-label { font-size: 0.7rem; }
      .leaderboard-table .sticky-col-name {
        min-width: 110px !important;
        max-width: 150px !important;
      }
    }

    /* ── Mobile View (< 768px): Frozen Sticky Columns (Rank & Name) & Fluid Horizontal Swipe ── */
    @media (max-width: 767.98px) {
      .leaderboard-table {
        min-width: 540px !important;
        border-spacing: 0 0.45rem !important;
      }

      .leaderboard-table-scroll {
        height: 360px;
        min-height: 360px;
        max-height: 360px;
        -webkit-overflow-scrolling: touch !important;
        touch-action: pan-x pan-y !important;
        overscroll-behavior-x: contain;
      }

      .leaderboard-card-body {
        padding: 0.5rem 0.65rem !important;
      }

      /* Base headers and cells on mobile */
      .leaderboard-table thead th {
        position: sticky !important;
        top: 0 !important;
        z-index: 15 !important;
        padding: 0.45rem 0.4rem !important;
        font-size: 0.75rem;
        white-space: nowrap;
        background: #1e293b !important;
        color: #ffffff !important;
      }

      .leaderboard-table tbody td {
        padding: 0.45rem 0.4rem !important;
        font-size: 0.75rem;
        white-space: nowrap;
        background-color: #ffffff !important;
      }

      /* First and last column rounded outer corners on mobile */
      .leaderboard-table thead th:first-child,
      .leaderboard-table thead th.sticky-col-rank {
        border-top-left-radius: 8px !important;
        border-bottom-left-radius: 8px !important;
        border-top-right-radius: 0 !important;
        border-bottom-right-radius: 0 !important;
      }
      .leaderboard-table thead th:last-child {
        border-top-right-radius: 8px !important;
        border-bottom-right-radius: 8px !important;
        border-top-left-radius: 0 !important;
        border-bottom-left-radius: 0 !important;
      }
      .leaderboard-table tbody td:first-child,
      .leaderboard-table tbody td.sticky-col-rank {
        border-top-left-radius: 8px !important;
        border-bottom-left-radius: 8px !important;
        border-top-right-radius: 0 !important;
        border-bottom-right-radius: 0 !important;
      }
      .leaderboard-table tbody td:last-child {
        border-top-right-radius: 8px !important;
        border-bottom-right-radius: 8px !important;
        border-top-left-radius: 0 !important;
        border-bottom-left-radius: 0 !important;
      }

      /* Frozen Rank column on mobile (sticky left: 0) */
      .leaderboard-table .sticky-col-rank {
        left: 0 !important;
        width: 48px !important;
        min-width: 48px !important;
        max-width: 48px !important;
        padding-left: 0.2rem !important;
        padding-right: 0.2rem !important;
        text-align: center;
      }

      .leaderboard-table tbody td.sticky-col-rank {
        position: sticky !important;
        left: 0 !important;
        z-index: 8 !important;
        background-color: #ffffff !important;
        will-change: transform;
      }

      .leaderboard-table thead th.sticky-col-rank {
        position: sticky !important;
        top: 0 !important;
        left: 0 !important;
        z-index: 35 !important;
        background: #1e293b !important;
        color: #ffffff !important;
        will-change: transform;
      }

      .leaderboard-table .sticky-col-rank .badge {
        font-size: 0.7rem !important;
        padding: 0.2rem 0.35rem !important;
      }

      /* Frozen Name column on mobile (sticky left: 48px matching rank width) */
      .leaderboard-table .sticky-col-name {
        left: 48px !important;
        width: 115px !important;
        min-width: 105px !important;
        max-width: 125px !important;
        padding-left: 0.35rem !important;
        padding-right: 0.35rem !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        white-space: nowrap !important;
      }

      .leaderboard-table tbody td.sticky-col-name {
        position: sticky !important;
        left: 48px !important;
        z-index: 8 !important;
        background-color: #ffffff !important;
        box-shadow: 4px 0 8px -2px rgba(0, 0, 0, 0.12) !important;
        will-change: transform;
      }

      .leaderboard-table thead th.sticky-col-name {
        position: sticky !important;
        top: 0 !important;
        left: 48px !important;
        z-index: 35 !important;
        background: #1e293b !important;
        color: #ffffff !important;
        box-shadow: 4px 0 8px -2px rgba(0, 0, 0, 0.28) !important;
        will-change: transform;
      }

      .leaderboard-table tbody tr:hover td.sticky-col-rank,
      .leaderboard-table tbody tr:hover td.sticky-col-name {
        background-color: #f8fafc !important;
      }

      /* Section column badge on mobile */
      .leaderboard-table td:nth-child(3) .badge {
        max-width: 75px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 0.68rem;
        display: inline-block;
        vertical-align: middle;
      }

      .sub-progress-wrap  { min-width: 80px; }
      .sub-progress-label { font-size: 0.68rem; }
      .sub-pct-chip       { font-size: 0.62rem; }
    }


    .status-badge {
      padding: 0.35em 0.85em;
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .status-badge-ongoing {
      background-color: #dcfce7;
      color: #166534;
    }

    .status-badge-completed {
      background-color: #f1f5f9;
      color: #475569;
      background-color: #475569;
      color: white;
    }

    .action-btn {
      width: 32px;
      height: 32px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background-color: #f8fafc;
      color: #64748b;
      transition: all 0.2s;
    }


    /* ── Responsive Controls Toolbar & Modern Segmented Controls ────────── */
    .chart-controls-toolbar {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 0.5rem;
      width: 100%;
    }

    .chart-controls-toolbar .chart-toolbar-row {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 0.5rem;
      flex-wrap: wrap;
      max-width: 100%;
    }

    /* Modern Segmented Control Pills */
    .chart-segmented-control {
      display: inline-flex;
      align-items: center;
      background: #f1f5f9;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      padding: 3px;
      gap: 2px;
      user-select: none;
      flex-shrink: 0;
    }

    .chart-segmented-control .btn-segment {
      border: none;
      outline: none;
      background: transparent;
      color: #64748b;
      font-size: 0.76rem;
      font-weight: 600;
      padding: 0.32rem 0.72rem;
      border-radius: 7px;
      transition: all 0.18s cubic-bezier(0.4, 0, 0.2, 1);
      white-space: nowrap;
      cursor: pointer;
      line-height: 1.25;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      text-decoration: none;
    }

    .chart-segmented-control .btn-segment:hover:not(.active) {
      color: #1e293b;
      background: rgba(255, 255, 255, 0.7);
    }

    .chart-segmented-control .btn-segment.active {
      background: #4f46e5;
      color: #ffffff;
      font-weight: 600;
      box-shadow: 0 1px 3px rgba(79, 70, 229, 0.3), 0 1px 2px rgba(79, 70, 229, 0.18);
    }

    /* Secondary sub-segmented control (Participant Type Filter) */
    .chart-segmented-control.sub-segmented-control {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      gap: 2px;
      padding: 2px;
    }

    .sub-segmented-control .btn-sub-segment {
      border: none;
      outline: none;
      background: transparent;
      color: #64748b;
      font-size: 0.74rem;
      font-weight: 500;
      padding: 0.28rem 0.62rem;
      border-radius: 6px;
      transition: all 0.15s ease;
      white-space: nowrap;
      cursor: pointer;
      line-height: 1.25;
      display: inline-flex;
      align-items: center;
      user-select: none;
    }

    .sub-segmented-control .btn-sub-segment:hover:not(.active) {
      color: #0f172a;
      background: rgba(255, 255, 255, 0.85);
    }

    .sub-segmented-control .btn-sub-segment.active {
      background: #ffffff;
      color: #0f172a;
      font-weight: 700;
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.08), 0 1px 1px rgba(0, 0, 0, 0.04);
    }

    .sub-ptype-dot {
      display: inline-block;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      margin-right: 5px;
      vertical-align: middle;
      transition: transform 0.15s ease, opacity 0.15s ease;
    }

    .btn-sub-segment:not(.active) .sub-ptype-dot {
      opacity: 0.35;
      transform: scale(0.85);
    }

    .btn-sub-segment.active .sub-ptype-dot {
      opacity: 1;
      transform: scale(1);
    }

    #btn-sub-ptype-student.active {
      color: #0e7490;
    }

    #btn-sub-ptype-guardian.active {
      color: #b45309;
    }

    #btn-sub-ptype-employee.active {
      color: #047857;
    }

    #btn-sub-ptype-all.active {
      color: #4338ca;
    }

    /* Date Navigation Group */
    .chart-nav-group {
      display: inline-flex;
      align-items: center;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      overflow: hidden;
      background: #ffffff;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
      flex-shrink: 0;
      height: 33px;
    }

    .chart-nav-group .chart-nav-btn {
      border: none;
      border-right: 1px solid #e2e8f0;
      background: #ffffff;
      color: #475569;
      font-size: 0.75rem;
      font-weight: 500;
      padding: 0.35rem 0.65rem;
      height: 100%;
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      transition: all 0.15s ease;
      white-space: nowrap;
      line-height: 1;
      cursor: pointer;
      text-decoration: none;
    }

    .chart-nav-group .chart-nav-btn:last-child {
      border-right: none;
    }

    .chart-nav-group .chart-nav-btn:hover {
      background: #f8fafc;
      color: #0f172a;
    }

    .chart-nav-group .chart-nav-btn:active {
      background: #f1f5f9;
    }

    .chart-nav-group .chart-nav-btn.chart-nav-today {
      font-weight: 600;
      color: #4f46e5;
    }

    /* Datepicker Wrapper & Input */
    .chart-datepicker-wrapper {
      position: relative;
      display: inline-flex;
      align-items: center;
      min-width: 140px;
      max-width: 100%;
      height: 33px;
    }

    .chart-datepicker-input {
      padding-left: 0.85rem !important;
      padding-right: 2.35rem !important;
      font-size: 0.76rem !important;
      font-weight: 500 !important;
      height: 33px !important;
      border-radius: 8px !important;
      border: 1px solid #e2e8f0 !important;
      background-color: #ffffff !important;
      color: #1e293b !important;
      cursor: pointer !important;
      transition: border-color 0.15s ease, box-shadow 0.15s ease !important;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03) !important;
      text-align: center;
    }

    .chart-datepicker-input:focus,
    .chart-datepicker-input:hover {
      border-color: #cbd5e1 !important;
      box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1) !important;
    }

    .pointer-events-none {
      pointer-events: none;
    }

    /* ── Chart & Graph Card Shading Border System ──────────────────────── */
    .card-custom {
      background: #ffffff !important;
      border: 1px solid #e2e8f0 !important;
      border-radius: 16px !important;
      overflow: visible !important;
      box-shadow: 
        0 1px 3px 0 rgba(15, 23, 42, 0.04),
        0 6px 18px -3px rgba(15, 23, 42, 0.07),
        0 0 0 1px rgba(226, 232, 240, 0.6) !important;
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), 
                  box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1), 
                  border-color 0.25s ease !important;
    }

    .card-custom:hover {
      transform: translateY(-3px);
      border-color: #cbd5e1 !important;
      box-shadow: 
        0 4px 8px 0 rgba(15, 23, 42, 0.04),
        0 14px 28px -4px rgba(15, 23, 42, 0.12),
        0 0 0 1px rgba(199, 210, 254, 0.6) !important;
    }

    .card-custom .card-body {
      background: #ffffff;
      overflow: visible;
    }

    /* Prevent tooltip clipping on bar chart hover */
    .apexcharts-tooltip {
      white-space: normal !important;
      max-width: 340px !important;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15) !important;
      z-index: 100 !important;
    }

    .apexcharts-tooltip-title {
      white-space: normal !important;
      word-break: break-word !important;
      font-weight: 600 !important;
    }

    /* ── Submissions Chart Modern Legend Chips ──────────────────── */
    .sub-legend-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.38rem;
      font-size: 0.74rem;
      font-weight: 600;
      color: #334155;
      background: rgba(241, 245, 249, 0.85);
      border: 1px solid #e2e8f0;
      padding: 0.16rem 0.5rem;
      border-radius: 6px;
      line-height: 1.3;
      letter-spacing: 0.01em;
      transition: all 0.15s ease;
    }

    .sub-legend-chip:hover {
      background: #ffffff;
      border-color: #cbd5e1;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
    }

    .sub-legend-indicator {
      display: inline-block;
      width: 14px;
      height: 4px;
      border-radius: 9999px;
      flex-shrink: 0;
    }

    /* ── Unified Chart Card Header ────────────────────────────── */
    .chart-card-header {
      background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%) !important;
      border-bottom: 1.5px solid #e2e8f0 !important;
      border-top-left-radius: 15px !important;
      border-top-right-radius: 15px !important;
      padding: 1rem 1.25rem 0.85rem;
    }

    /* Override Bootstrap's border-0 helper — keep the separator even when border-0 is applied */
    .chart-card-header.border-0 {
      border-bottom: 1.5px solid #e2e8f0 !important;
    }

    /* Icon accent box shared across chart headers */
    .chart-icon-box {
      width: 40px;
      height: 40px;
      border-radius: 11px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.1rem;
      flex-shrink: 0;
      transition: transform 0.2s ease;
    }

    .card:hover .chart-icon-box,
    .card-custom:hover .chart-icon-box {
      transform: scale(1.08);
    }

    .chart-header-title {
      font-size: 0.975rem;
      font-weight: 700;
      color: #0f172a;
      margin-bottom: 0.1rem;
      line-height: 1.3;
      letter-spacing: -0.01em;
    }

    .chart-header-subtitle {
      font-size: 0.77rem;
      color: #94a3b8;
      font-weight: 400;
      margin: 0;
      line-height: 1.3;
    }

    /* ── Media Queries for Chart Headers & Toolbars ─────────────── */
    @media (min-width: 1200px) {
      .chart-controls-toolbar {
        width: auto !important;
      }
    }

    @media (max-width: 1199.98px) {
      .chart-card-header {
        padding: 0.85rem 1rem !important;
        gap: 0.65rem !important;
      }
      .chart-controls-toolbar {
        width: 100% !important;
        align-items: flex-start !important;
      }
      .chart-controls-toolbar .chart-toolbar-row {
        justify-content: flex-start !important;
      }
    }

    @media (max-width: 767.98px) {
      .chart-card-header {
        padding: 0.75rem 0.85rem !important;
      }

      .chart-controls-toolbar .chart-toolbar-row.scrollable-row {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        padding-bottom: 3px;
        flex-wrap: nowrap !important;
        scrollbar-width: none;
        -ms-overflow-style: none;
      }

      .chart-controls-toolbar .chart-toolbar-row.scrollable-row::-webkit-scrollbar {
        display: none;
      }
    }

    @media (max-width: 575.98px) {
      .chart-controls-toolbar .chart-toolbar-row {
        justify-content: space-between !important;
        width: 100% !important;
        gap: 0.35rem !important;
      }

      .chart-datepicker-wrapper {
        min-width: 120px;
        flex: 1 1 auto;
      }

      .chart-nav-group {
        flex: 1 1 auto;
        display: flex;
      }

      .chart-nav-group .chart-nav-btn {
        flex: 1;
        justify-content: center;
        padding: 0.35rem 0.45rem;
      }
    }

    /* ── Leaderboard assignment filter select ─────────────────────── */
    .leaderboard-asg-select {
      /* Grows to fill available width but caps so it doesn't overflow */
      flex: 1 1 140px;
      min-width: 140px;
      max-width: 100%;
      /* Truncate long assignment names gracefully */
      text-overflow: ellipsis;
      white-space: nowrap;
      overflow: hidden;
    }

    /* Utility: prevent flex children from overflowing their parent */
    .min-width-0 {
      min-width: 0;
    }
  </style>
<% end %>

<!-- Institute Admin Dashboard -->
<div class="container-fluid py-4">
  <!-- KPI Cards Row 1 -->
  <div class="row g-4 mb-4">
