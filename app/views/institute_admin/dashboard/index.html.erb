            <!-- Limit selector -->
            <div class="d-flex align-items-center gap-1 flex-shrink-0">
              <span class="text-muted small">Show:</span>
              <select class="form-select form-select-sm rounded-3" id="topLeaderboardLimit" style="width: 90px;" onchange="updateStreakLeaderboard('top')">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="15">15</option>
                <option value="20">20</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
                <option value="all">All time</option>
              </select>
            </div>
          </div>
        </div>
        <div class="card-body leaderboard-card-body">
          <div class="d-lg-none pb-2 text-muted small">
            <i class="bi bi-arrow-left-right me-1"></i> Swipe table horizontally to view all columns &rarr;
          </div>
          <div class="leaderboard-table-scroll table-responsive">
            <table class="table modern-table leaderboard-table mb-0" id="topLeaderboardTable">
              <thead class="leaderboard-sticky-head">
                <tr>
                  <th class="sticky-col sticky-col-rank">Rank</th>
                  <th class="sticky-col sticky-col-name">Name</th>
                  <th>Section</th>
                  <th>Assignment</th>
                  <th class="text-center">Submitted Days</th>
                </tr>
              </thead>
              <tbody id="topLeaderboardBody">
                <% if @top_submitting_participants.present? %>
                  <% @top_submitting_participants.each do |p| %>
                    <% pct = p[:submission_pct] || 0
                       fill_color = pct >= 80 ? '#16a34a' : (pct >= 50 ? '#d97706' : '#dc2626')
                       label_color = pct >= 80 ? 'text-success' : (pct >= 50 ? 'text-warning' : 'text-danger') %>
                    <tr>
                      <td class="sticky-col sticky-col-rank">
                        <span class="badge <%= p[:rank] == 1 ? 'bg-warning text-dark' : (p[:rank] == 2 ? 'bg-secondary text-white' : (p[:rank] == 3 ? 'bg-bronze text-white' : 'bg-light text-dark border')) %> rounded-pill fw-bold">
                          #<%= p[:rank] %>
                        </span>
                      </td>
                      <td class="sticky-col sticky-col-name fw-semibold text-dark" title="<%= p[:name] %>"><%= p[:name] %></td>
                      <td><span class="badge bg-light text-secondary border"><%= p[:section] %></span></td>
                      <td class="text-muted small text-truncate" style="max-width: 140px;" title="<%= p[:assignment_name] %>"><%= p[:assignment_name] %></td>
                      <td>
                        <div class="sub-progress-wrap">
                          <span class="sub-progress-label <%= label_color %>">
                            <i class="bi bi-fire me-1"></i><%= p[:total_submissions] %> / <%= p[:total_days] %> days
