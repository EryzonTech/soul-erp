<div class="container py-4" style="max-width: 950px;">
  <!-- Breadcrumb -->
  <nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><%= link_to "Assignments", participant_portal_assignments_path, class: "text-decoration-none" %></li>
      <li class="breadcrumb-item active" aria-current="page">Edit Custom Assignment</li>
    </ol>
  </nav>

  <!-- Header -->
  <div class="d-flex align-items-center justify-content-between mb-4">
    <div>
      <h4 class="fw-bold text-dark mb-1">Edit Custom Assignment</h4>
      <p class="text-muted mb-0 small">Update assignment details, date schedule, or assigned questions</p>
    </div>
    <%= link_to participant_portal_assignments_path, class: "btn btn-outline-secondary btn-sm rounded-3" do %>
      <i class="bi bi-arrow-left me-1"></i> Back to Assignments
    <% end %>
  </div>

  <%= render "form" %>
</div>
