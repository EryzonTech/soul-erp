<div class="card card-custom">
  <div class="card-header card-header-custom">
    <h5 class="mb-0">Edit Institute Admin</h5>
  </div>

  <div class="card-body">
    <%= form_with(model: [:admin, @user], local: true) do |f| %>
      <% if @user.errors.any? %>
        <div class="alert alert-danger">
          <h6>Please fix the following errors:</h6>
          <ul>
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="row">
        <div class="col-md-6 mb-3">
          <div class="form-group">
            <%= f.label :username, class: "form-label" %>
            <%= f.text_field :username, class: "form-control", placeholder: "Enter username" %>
          </div>
        </div>

        <div class="col-md-6 mb-3">
          <div class="form-group">
            <%= f.label :email, class: "form-label" %>
            <%= f.email_field :email, class: "form-control", placeholder: "Enter email address" %>
          </div>
        </div>

        <div class="col-md-6 mb-3">
          <div class="form-group">
            <%= f.label :phone, class: "form-label" %>
            <%= f.telephone_field :phone, class: "form-control", placeholder: "Enter phone number" %>
          </div>
        </div>

        <div class="col-md-6 mb-3">
          <div class="form-group">
            <%= f.label :password, class: "form-label" %>
            <%= f.password_field :password, class: "form-control", placeholder: "Enter new password" %>
            <small class="form-text text-muted">Leave blank if you don't want to change it</small>
          </div>
        </div>

        <div class="col-md-6 mb-3">
          <div class="form-group">
            <%= f.label :password_confirmation, class: "form-label" %>
            <%= f.password_field :password_confirmation, class: "form-control", placeholder: "Confirm new password" %>
          </div>
        </div>

        <div class="col-md-12 mb-3">
          <div class="form-group">
            <%= f.label :institute_id, "Select Institute", class: "form-label" %>
            <%= f.collection_select :institute_id, @institutes, :id, :name,
                { prompt: "Choose an institute" },
                { class: "form-select" } %>
          </div>
        </div>

        <div class="col-md-12 mb-2">
          <div class="p-3 rounded-3 border d-flex align-items-center justify-content-between gap-3"
               style="background: linear-gradient(135deg, rgba(99,102,241,0.05) 0%, rgba(139,92,246,0.05) 100%); border-color: rgba(99,102,241,0.2) !important;">
            <div>
              <div class="fw-semibold text-dark mb-1" style="font-size:0.9rem;">
                <i class="bi bi-eye me-1" style="color:#6366f1;"></i> View-Only Access
              </div>
              <div class="text-muted" style="font-size:0.8rem; line-height:1.4;">
                When enabled, this admin can view the Dashboard and Reports but cannot create,
                edit, or delete any data.
              </div>
            </div>
            <div class="form-check form-switch mb-0 flex-shrink-0">
              <%= f.check_box :view_only,
                    { class: "form-check-input", role: "switch", id: "user_view_only", style: "width:2.5em;height:1.4em;cursor:pointer;" },
                    "1", "0" %>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-4">
        <%= f.submit "Update Admin", class: "btn btn-custom-primary" %>
        <%= link_to "Cancel", admin_users_path, class: "btn btn-outline-custom ms-2" %>
      </div>
    <% end %>
  </div>
</div> 