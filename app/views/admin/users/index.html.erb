<% content_for :styles do %>
  <style>
    /* Modern Page Header & Breadcrumb */
    .admin-header-box {
      background: #ffffff;
      border-radius: 20px;
      padding: 1.75rem 2rem;
      border: 1px solid rgba(226, 232, 240, 0.8);
      box-shadow: 0 4px 16px rgba(15, 23, 42, 0.03);
      margin-bottom: 1.5rem;
    }

    .breadcrumb-modern {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.85rem;
      font-weight: 500;
      color: #64748b;
      margin-bottom: 0.75rem;
    }

    .breadcrumb-modern a {
      color: #64748b;
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .breadcrumb-modern a:hover {
      color: #3b82f6;
    }

    .breadcrumb-modern .separator {
      color: #cbd5e1;
      font-size: 0.75rem;
    }

    .breadcrumb-modern .active {
      color: #1e293b;
      font-weight: 600;
    }

    .btn-create-gradient {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: #ffffff;
      border: none;
      padding: 0.65rem 1.4rem;
      border-radius: 12px;
      font-weight: 600;
      font-size: 0.9rem;
      box-shadow: 0 4px 14px rgba(102, 126, 234, 0.35);
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      text-decoration: none;
    }

    .btn-create-gradient:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(102, 126, 234, 0.45);
      color: #ffffff;
    }

    /* Stat Cards */
    .mini-stat-card {
      background: #ffffff;
      border-radius: 16px;
      padding: 1.1rem 1.35rem;
      border: 1px solid rgba(226, 232, 240, 0.8);
      box-shadow: 0 4px 12px rgba(15, 23, 42, 0.03);
      display: flex;
      align-items: center;
      justify-content: space-between;
      transition: transform 0.25s ease;
    }

    .mini-stat-card:hover {
      transform: translateY(-3px);
    }

    .mini-stat-icon {
      width: 42px;
      height: 42px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
    }

    .icon-bg-purple { background: rgba(102, 126, 234, 0.1); color: #667eea; }
    .icon-bg-emerald { background: rgba(16, 185, 129, 0.1); color: #10b981; }
    .icon-bg-rose { background: rgba(244, 63, 94, 0.1); color: #f43f5e; }
    .icon-bg-indigo { background: rgba(99, 102, 241, 0.1); color: #6366f1; }

    /* Glassmorphic Table Container */
    .users-table-card {
      background: #ffffff;
      border-radius: 20px;
      border: 1px solid rgba(226, 232, 240, 0.8);
      box-shadow: 0 4px 20px rgba(15, 23, 42, 0.04);
      overflow: hidden;
    }

    .users-table-header {
      padding: 1.5rem 2rem;
      border-bottom: 1px solid rgba(226, 232, 240, 0.8);
      background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .modern-users-table {
      width: 100%;
      margin-bottom: 0;
      border-collapse: separate;
      border-spacing: 0;
    }

    .modern-users-table thead th {
      background: linear-gradient(135deg, rgba(102, 126, 234, 0.06), rgba(118, 75, 162, 0.08));
      color: #475569;
      font-weight: 700;
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 1.1rem 1.5rem;
      border: none;
    }

    .modern-users-table tbody td {
      padding: 1.15rem 1.5rem;
      vertical-align: middle;
      border-bottom: 1px solid rgba(241, 245, 249, 0.9);
      transition: background-color 0.2s ease;
    }

    .modern-users-table tbody tr:last-child td {
      border-bottom: none;
    }

    .modern-users-table tbody tr:hover td {
      background-color: rgba(248, 250, 252, 0.8);
    }

    /* User Profile Info */
    .user-avatar-badge {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      background: linear-gradient(135deg, #667eea, #764ba2);
      color: #ffffff;
      font-weight: 700;
      font-size: 0.95rem;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 10px rgba(102, 126, 234, 0.25);
      flex-shrink: 0;
    }

    .user-name-title {
      font-weight: 700;
      color: #0f172a;
      font-size: 0.95rem;
      margin-bottom: 0.15rem;
    }

    .user-email-subtitle {
      font-size: 0.8rem;
      color: #64748b;
    }

    /* Institute Badge */
    .institute-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: rgba(102, 126, 234, 0.08);
      color: #4f46e5;
      font-size: 0.83rem;
      font-weight: 600;
      padding: 0.4rem 0.85rem;
      border-radius: 10px;
      border: 1px solid rgba(99, 102, 241, 0.15);
    }

    .institute-badge-unassigned {
      background: #f1f5f9;
      color: #64748b;
      border-color: #e2e8f0;
    }

    /* Status Pill Badges */
    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.35rem 0.85rem;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 600;
    }

    .status-pill-active {
      background: rgba(16, 185, 129, 0.1);
      color: #059669;
      border: 1px solid rgba(16, 185, 129, 0.2);
    }

    .status-pill-inactive {
      background: rgba(244, 63, 94, 0.1);
      color: #e11d48;
      border: 1px solid rgba(244, 63, 94, 0.2);
    }

    /* Date Styling */
    .date-text {
      color: #64748b;
      font-size: 0.85rem;
      font-weight: 500;
    }

    /* Action Buttons (Restored Original Design & Gradients) */
    .action-buttons {
      display: flex;
      gap: 0.5rem;
    }
    .action-btn {
      width: 40px;
      height: 40px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 10px;
      border: none;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
      text-decoration: none;
    }
    .action-btn::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0;
      height: 0;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.3);
      transform: translate(-50%, -50%);
      transition: width 0.4s, height 0.4s;
    }
    .action-btn:hover::before {
      width: 100px;
      height: 100px;
    }
    .action-btn i {
      font-size: 16px;
      position: relative;
      z-index: 1;
    }
    .btn-view {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
    }
    .btn-view:hover {
      box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
      transform: translateY(-2px);
      color: white;
    }
    .btn-edit {
      background: linear-gradient(135deg, #141c2f 0%, #ea02e9 100%);
      color: white;
    }
    .btn-edit:hover {
      box-shadow: 0 4px 14px rgba(234, 2, 233, 0.45);
      transform: translateY(-2px);
      color: white;
    }
    .btn-delete {
      background: linear-gradient(135deg, #ff6b6b 0%, #c92a2a 100%);
      color: white;
    }
    .btn-delete:hover {
      box-shadow: 0 4px 12px rgba(255, 107, 107, 0.4);
      transform: translateY(-2px);
      color: white;
    }

    /* Empty State */
    .empty-state-box {
      padding: 4rem 2rem;
      text-align: center;
    }

    .empty-state-icon {
      width: 72px;
      height: 72px;
      border-radius: 20px;
      background: rgba(102, 126, 234, 0.1);
      color: #667eea;
      font-size: 2rem;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.25rem;
    }
  </style>
<% end %>

<!-- Top Header & Breadcrumb -->
<div class="admin-header-box">
  <div class="breadcrumb-modern">
    <%= link_to "Master Admin", admin_root_path %>
    <span class="separator">›</span>
    <span class="active">Institute Admins</span>
  </div>

  <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
    <div>
      <h3 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
        <span>Institute Admins Management</span>
        <span class="badge bg-indigo-subtle text-indigo rounded-pill fs-6 px-3"><%= @users.count %> Admins</span>
      </h3>
      <p class="text-muted mb-0 font-size-14">
        Manage all institute administrators, credentials, and associated organizational access.
      </p>
    </div>

    <div>
      <%= link_to new_admin_user_path, class: "btn-create-gradient" do %>
        <i class="bi bi-plus-lg"></i>
        <span>Add New Admin</span>
      <% end %>
    </div>
  </div>
</div>

<!-- Quick Stat Cards -->
<div class="row g-3 mb-4">
  <div class="col-12 col-md-3">
    <div class="mini-stat-card">
      <div>
        <span class="text-muted small fw-semibold text-uppercase">Total Admins</span>
        <h3 class="fw-bold text-dark mb-0 mt-1"><%= @users.count %></h3>
      </div>
      <div class="mini-stat-icon icon-bg-purple">
        <i class="bi bi-people-fill"></i>
      </div>
    </div>
  </div>

  <div class="col-12 col-md-3">
    <div class="mini-stat-card">
      <div>
        <span class="text-muted small fw-semibold text-uppercase">Active Accounts</span>
        <h3 class="fw-bold text-emerald mb-0 mt-1"><%= @users.count(&:active?) %></h3>
      </div>
      <div class="mini-stat-icon icon-bg-emerald">
        <i class="bi bi-check-circle-fill"></i>
      </div>
    </div>
  </div>

  <div class="col-12 col-md-3">
    <div class="mini-stat-card">
      <div>
        <span class="text-muted small fw-semibold text-uppercase">Inactive Accounts</span>
        <h3 class="fw-bold text-rose mb-0 mt-1"><%= @users.count { |u| !u.active? } %></h3>
      </div>
      <div class="mini-stat-icon icon-bg-rose">
        <i class="bi bi-x-circle-fill"></i>
      </div>
    </div>
  </div>

  <div class="col-12 col-md-3">
    <div class="mini-stat-card">
      <div>
        <span class="text-muted small fw-semibold text-uppercase">View-Only Admins</span>
        <h3 class="fw-bold mb-0 mt-1" style="color:#6366f1;"><%= @users.count(&:view_only_admin?) %></h3>
      </div>
      <div class="mini-stat-icon icon-bg-indigo">
        <i class="bi bi-eye-fill"></i>
      </div>
    </div>
  </div>
</div>

<!-- Users Table Container -->
<div class="users-table-card">
  <div class="users-table-header">
    <div class="d-flex align-items-center gap-2">
      <i class="bi bi-shield-lock-fill text-indigo fs-5"></i>
      <h5 class="fw-bold text-dark mb-0">System Administrators List</h5>
    </div>
  </div>

  <% if @users.any? %>
    <div class="table-responsive">
      <table class="table modern-users-table">
        <thead>
          <tr>
            <th>User Info</th>
            <th>Institute</th>
            <th>Account Status</th>
            <th>Access Level</th>
            <th>Created Date</th>
            <th class="text-center">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td>
                <div class="d-flex align-items-center gap-3">
                  <div class="user-avatar-badge">
                    <%= user.username.first.upcase rescue 'A' %>
                  </div>
                  <div>
                    <div class="user-name-title"><%= user.username %></div>
                    <div class="user-email-subtitle">
                      <i class="bi bi-envelope me-1"></i><%= user.email.presence || 'No email provided' %>
                    </div>
                  </div>
                </div>
              </td>
              <td>
                <% if user.institute.present? %>
                  <span class="institute-badge">
                    <i class="bi bi-building-fill"></i>
                    <%= user.institute.name %>
                  </span>
                <% else %>
                  <span class="institute-badge institute-badge-unassigned">
                    <i class="bi bi-dash-circle me-1"></i> Not Assigned
                  </span>
                <% end %>
              </td>
              <td>
                <% if user.active? %>
                  <span class="status-pill status-pill-active">
                    <i class="bi bi-check-circle-fill"></i> Active
                  </span>
                <% else %>
                  <span class="status-pill status-pill-inactive">
                    <i class="bi bi-x-circle-fill"></i> Inactive
                  </span>
                <% end %>
              </td>
              <td>
                <% if user.view_only_admin? %>
                  <span class="badge rounded-pill d-inline-flex align-items-center gap-1 px-3 py-2"
                        style="background:rgba(99,102,241,0.1);color:#4f46e5;border:1px solid rgba(99,102,241,0.2);font-size:0.78rem;font-weight:600;">
                    <i class="bi bi-eye-fill"></i> View Only
                  </span>
                <% else %>
                  <span class="badge rounded-pill d-inline-flex align-items-center gap-1 px-3 py-2"
                        style="background:rgba(16,185,129,0.1);color:#059669;border:1px solid rgba(16,185,129,0.2);font-size:0.78rem;font-weight:600;">
                    <i class="bi bi-pencil-fill"></i> Full Access
                  </span>
                <% end %>
              </td>
              <td>
                <span class="date-text">
                  <i class="bi bi-calendar3 me-1"></i><%= user.created_at.strftime("%b %d, %Y") %>
                </span>
              </td>
              <td>
                <div class="action-buttons justify-content-center">
                  <%= link_to admin_user_path(user), class: "action-btn btn-view", title: "View Details" do %>
                    <i class="bi bi-eye"></i>
                  <% end %>
                  <%= link_to edit_admin_user_path(user), class: "action-btn btn-edit", title: "Edit User" do %>
                    <i class="bi bi-pencil"></i>
                  <% end %>
                  <%= button_to admin_user_path(user), method: :delete, class: "action-btn btn-delete", title: "Delete User", form: { style: 'display: inline-block;', data: { turbo_confirm: 'Are you sure you want to remove this administrator?' } } do %>
                    <i class="bi bi-trash"></i>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty-state-box">
      <div class="empty-state-icon">
        <i class="bi bi-people"></i>
      </div>
      <h5 class="fw-bold text-dark mb-1">No Institute Administrators Found</h5>
      <p class="text-muted mb-3">Get started by adding your first institute admin user.</p>
      <%= link_to new_admin_user_path, class: "btn-create-gradient" do %>
        <i class="bi bi-plus-lg"></i>
        <span>Add New Admin</span>
      <% end %>
    </div>
  <% end %>
</div>