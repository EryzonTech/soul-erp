<% content_for :styles do %>
  <style>
    .action-buttons {
      display: flex;
      gap: 0.5rem;
    }
    .action-btn {
      width: 38px;
      height: 38px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 10px;
      border: none;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
      text-decoration: none;
    }
    .action-btn::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0;
      height: 0;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.3);
      transform: translate(-50%, -50%);
      transition: width 0.4s, height 0.4s;
    }
    .action-btn:hover::before {
      width: 100px;
      height: 100px;
    }
    .action-btn i {
      font-size: 16px;
      position: relative;
      z-index: 1;
    }
    .btn-login {
      background: linear-gradient(135deg, #10b981 0%, #047857 100%);
      color: white;
    }
    .btn-login:hover {
      box-shadow: 0 4px 14px rgba(16, 185, 129, 0.45);
      transform: translateY(-2px);
      color: white;
    }
    .btn-view {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
    }
    .btn-view:hover {
      box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
      transform: translateY(-2px);
      color: white;
    }
    .btn-edit {
      background: linear-gradient(135deg, #141c2f 0%, #ea02e9 100%);
      color: white;
    }
    .btn-edit:hover {
      box-shadow: 0 4px 14px rgba(234, 2, 233, 0.45);
      transform: translateY(-2px);
      color: white;
    }

    /* Modern Status Segmented Control */
    .status-filter-wrapper {
      display: inline-flex;
      align-items: center;
      background: #f1f5f9;
      padding: 3px;
      border-radius: 12px;
      border: 1px solid rgba(226, 232, 240, 0.9);
      gap: 3px;
    }

    .status-filter-btn {
      border: none;
      background: transparent;
      padding: 0.4rem 0.95rem;
      border-radius: 9px;
      font-size: 0.82rem;
      font-weight: 600;
      color: #64748b;
      transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      text-decoration: none;
    }

    .status-filter-btn:hover {
      color: #1e293b;
      background: rgba(255, 255, 255, 0.6);
    }

    .status-filter-btn.active[data-filter="all"] {
      background: #ffffff;
      color: #0f172a;
      box-shadow: 0 2px 8px rgba(15, 23, 42, 0.08);
    }

    .status-filter-btn.active[data-filter="active"] {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      color: #ffffff;
      box-shadow: 0 4px 12px rgba(16, 185, 129, 0.35);
    }

    .status-filter-btn.active[data-filter="inactive"] {
      background: linear-gradient(135deg, #f43f5e 0%, #e11d48 100%);
      color: #ffffff;
      box-shadow: 0 4px 12px rgba(244, 63, 94, 0.35);
    }
  </style>
<% end %>

<div class="container-fluid p-0">

  <!-- STANDARD PAGE HEADER (Title on left, CTA Top Right) -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 pb-3 border-bottom gap-3">
    <div>
      <h3 class="fw-bold text-dark mb-1">Institutes</h3>
      <p class="text-muted small mb-0">Manage multi-tenant institutes, tenant codes, and administrative access.</p>
    </div>
    <div class="header-actions">
      <%= link_to new_admin_institute_path, class: "btn btn-primary d-inline-flex align-items-center justify-content-center gap-2 shadow-sm fw-medium px-3 py-2 rounded-3 w-100 w-sm-auto" do %>
        <i class="bi bi-plus-lg"></i>
        <span>Register New Institute</span>
      <% end %>
    </div>
  </div>

  <!-- KPI SUMMARY ROW -->
  <div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="inst-kpi-card">
        <div>
          <div class="text-uppercase text-muted fw-semibold mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">Total Institutes</div>
          <div class="h4 fw-bold mb-0 text-dark"><%= @institutes.count %></div>
        </div>
        <div class="inst-kpi-icon inst-kpi-icon-primary">
          <i class="bi bi-buildings"></i>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="inst-kpi-card">
        <div>
          <div class="text-uppercase text-muted fw-semibold mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">Active Institutes</div>
          <div class="h4 fw-bold mb-0 text-success"><%= @institutes.count(&:active?) %></div>
        </div>
        <div class="inst-kpi-icon inst-kpi-icon-success">
          <i class="bi bi-check-circle"></i>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="inst-kpi-card">
        <div>
          <div class="text-uppercase text-muted fw-semibold mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">Inactive / Suspended</div>
          <div class="h4 fw-bold mb-0 text-warning"><%= @institutes.count { |i| !i.active? } %></div>
        </div>
        <div class="inst-kpi-icon inst-kpi-icon-warning">
          <i class="bi bi-pause-circle"></i>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="inst-kpi-card">
        <div>
          <div class="text-uppercase text-muted fw-semibold mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">Institute Types</div>
          <div class="h4 fw-bold mb-0 text-info"><%= @institutes.map(&:institution_type).reject(&:blank?).uniq.count %></div>
        </div>
        <div class="inst-kpi-icon inst-kpi-icon-info">
          <i class="bi bi-diagram-3"></i>
        </div>
      </div>
    </div>
  </div>

  <!-- FILLED MULTI-CRITERIA FILTER TOOLBAR -->
  <div class="filled-toolbar mb-4">
    <div class="row g-3 align-items-center">
      <!-- Search Input -->
      <div class="col-12 col-md-5 col-lg-5">
        <div class="input-group">
          <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-search"></i></span>
          <input type="text" id="instituteSearchInput" class="form-control border-start-0 ps-0" placeholder="Search institute by name or code..." onkeyup="filterInstitutesTable()">
        </div>
      </div>

      <!-- Institute Type Filter -->
      <div class="col-12 col-sm-6 col-md-3 col-lg-3">
        <div class="input-group">
          <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-diagram-3"></i></span>
          <select id="typeFilter" class="form-select border-start-0 ps-0" onchange="filterInstitutesTable()">
            <option value="all">All Institute Types</option>
            <% @institutes.map(&:institution_type).reject(&:blank?).uniq.sort.each do |type_name| %>
              <option value="<%= type_name.downcase %>"><%= type_name.titleize %></option>
            <% end %>
          </select>
        </div>
      </div>

      <!-- Status Filter Buttons -->
      <div class="col-12 col-sm-6 col-md-4 col-lg-4 text-md-end">
        <div class="d-flex align-items-center justify-content-sm-end gap-2">
          <span class="text-muted small fw-medium">Status:</span>
          <div class="status-filter-wrapper">
            <button type="button" class="status-filter-btn active" data-filter="all" onclick="setStatusFilter('all', this)">
              <span>All</span>
            </button>
            <button type="button" class="status-filter-btn" data-filter="active" onclick="setStatusFilter('active', this)">
              <i class="bi bi-check-circle-fill"></i>
              <span>Active</span>
            </button>
            <button type="button" class="status-filter-btn" data-filter="inactive" onclick="setStatusFilter('inactive', this)">
              <i class="bi bi-x-circle-fill"></i>
              <span>Inactive</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- MAIN TABLE CARD -->
  <div class="table-card">
    <!-- Header Info Bar -->
    <div class="table-card-header d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-buildings text-primary fs-5"></i>
        <h6 class="fw-bold mb-0 text-dark">Registered Institutes</h6>
      </div>
      <span class="badge bg-light text-secondary border px-2.5 py-1" id="visibleInstituteCount">
        Showing <%= @institutes.count %> of <%= @institutes.count %>
      </span>
    </div>

    <!-- Data Table -->
    <div class="table-responsive">
      <table class="table institutes-table align-middle" id="institutesTable">
        <thead>
          <tr>
            <th>Institute</th>
            <th>Tenant Code</th>
            <th>Type</th>
            <th>Contact</th>
            <th>Status</th>
            <th class="text-end pe-4">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if @institutes.empty? %>
            <tr id="emptyInstituteRow">
              <td colspan="6" class="text-center py-5">
                <div class="text-muted mb-2"><i class="bi bi-buildings fs-1"></i></div>
                <h6 class="fw-bold text-dark mb-1">No Institutes Found</h6>
                <p class="text-muted small mb-3">Get started by creating your first institute.</p>
                <%= link_to new_admin_institute_path, class: "btn btn-primary btn-sm rounded-2 px-3" do %>
                  <i class="bi bi-plus-lg me-1"></i> Add Institute
                <% end %>
              </td>
            </tr>
          <% else %>
            <% @institutes.each do |institute| %>
              <tr class="institute-row" 
                  data-name="<%= institute.name.downcase %>" 
                  data-code="<%= (institute.code || '').downcase %>" 
                  data-type="<%= (institute.institution_type || '').downcase %>" 
                  data-status="<%= institute.active? ? 'active' : 'inactive' %>">
                <td>
                  <div class="d-flex align-items-center gap-3">
                    <div class="institute-avatar">
                      <%= institute.name.presence ? institute.name.strip.first.upcase : 'I' %>
                    </div>
                    <div>
                      <div class="fw-semibold text-dark mb-0" style="font-size: 0.9rem;"><%= institute.name %></div>
                      <div class="text-muted small"><%= institute.email.presence || 'No email provided' %></div>
                    </div>
                  </div>
                </td>

                <td>
                  <span class="code-pill"><%= institute.code %></span>
                </td>

                <td>
                  <% if institute.institution_type.present? %>
                    <span class="badge bg-light text-secondary border px-2 py-1 font-monospace" style="font-size: 0.75rem;">
                      <%= institute.institution_type.titleize %>
                    </span>
                  <% else %>
                    <span class="text-muted small">—</span>
                  <% end %>
                </td>

                <td>
                  <div class="small text-dark fw-medium">
                    <%= institute.contact_number.presence || 'N/A' %>
                  </div>
                  <% if institute.owner_name.present? %>
                    <div class="text-muted extra-small" style="font-size: 0.75rem;">
                      Owner: <%= institute.owner_name %>
                    </div>
                  <% end %>
                </td>

                <td>
                  <% if institute.active? %>
                    <span class="status-badge-active">
                      <i class="bi bi-check-circle-fill"></i> Active
                    </span>
                  <% else %>
                    <span class="status-badge-inactive">
                      <i class="bi bi-x-circle-fill"></i> Inactive
                    </span>
                  <% end %>
                </td>

                <td class="text-end pe-4">
                  <div class="action-buttons justify-content-end">
                    <!-- Login as Admin -->
                    <%= button_to login_as_institute_admin_admin_institute_path(institute), 
                                method: :post,
                                form: { class: "d-inline m-0", data: { turbo: false } },
                                data: { bs_toggle: "tooltip" }, 
                                class: "action-btn btn-login", 
                                title: "Login as Institute Admin" do %>
                      <i class="bi bi-box-arrow-in-right"></i>
                    <% end %>

                    <!-- View -->
                    <%= link_to admin_institute_path(institute), 
                                data: { bs_toggle: "tooltip" }, 
                                class: "action-btn btn-view", 
                                title: "View Details" do %>
                      <i class="bi bi-eye"></i>
                    <% end %>

                    <!-- Edit -->
                    <%= link_to edit_admin_institute_path(institute), 
                                data: { bs_toggle: "tooltip" }, 
                                class: "action-btn btn-edit", 
                                title: "Edit Institute" do %>
                      <i class="bi bi-pencil"></i>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<!-- Filter JavaScript -->
<script>
  let currentStatusFilter = 'all';

  function filterInstitutesTable() {
    const searchVal = document.getElementById('instituteSearchInput').value.toLowerCase().trim();
    const typeVal = document.getElementById('typeFilter') ? document.getElementById('typeFilter').value.toLowerCase() : 'all';
    const rows = document.querySelectorAll('.institute-row');
    let visibleCount = 0;

    rows.forEach(row => {
      const name = row.getAttribute('data-name') || '';
      const code = row.getAttribute('data-code') || '';
      const type = row.getAttribute('data-type') || '';
      const status = row.getAttribute('data-status') || '';

      const matchesSearch = !searchVal || name.includes(searchVal) || code.includes(searchVal);
      const matchesType = (typeVal === 'all') || (type === typeVal);
      const matchesStatus = (currentStatusFilter === 'all') || (status === currentStatusFilter);

      if (matchesSearch && matchesType && matchesStatus) {
        row.style.display = '';
        visibleCount++;
      } else {
        row.style.display = 'none';
      }
    });

    const countBadge = document.getElementById('visibleInstituteCount');
    if (countBadge) {
      countBadge.textContent = `Showing ${visibleCount} of <%= @institutes.count %>`;
    }
  }

  function setStatusFilter(status, btnElement) {
    currentStatusFilter = status;
    const wrapper = btnElement.closest('.status-filter-wrapper');
    if (wrapper) {
      wrapper.querySelectorAll('.status-filter-btn').forEach(btn => btn.classList.remove('active'));
    }
    btnElement.classList.add('active');
    filterInstitutesTable();
  }
</script>
 